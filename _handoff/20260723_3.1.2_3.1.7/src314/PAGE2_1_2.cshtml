@model WCals.ViewModels.NewModels.TDE0040Model

@{

    Layout = null;

    bool isNew = ViewBag.IsNew ?? false;

    var data = ViewBag.Data as System.Data.DataRow;

    var fundList = ViewBag.FundList as System.Data.DataTable;

}



<!DOCTYPE html>

<html>

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <script type="text/javascript" src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <title>預算分配編輯</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>

        html, body {

            height: 100%;

            margin: 0;

            padding: 0;

        }



        body {

            padding: 10px;

            box-sizing: border-box;

        }



        .form-group {

            margin-bottom: 10px;

        }



        .btn-toolbar {

            margin-top: 15px;

            margin-bottom: 15px;

        }



        .info-row {

            background-color: #e8f4fc;

            padding: 10px;

            border-radius: 4px;

            margin-bottom: 15px;

        }



        .info-label {

            font-weight: bold;

            color: #555;

        }



        .readonly-field {

            background-color: #eee;

        }



        .calc-row {

            background-color: #f5f5f5;

            padding: 10px;

            border-radius: 4px;

            margin-top: 15px;

        }



        .table th {

            background-color: #4472C4;

            color: white;

            text-align: center;

            vertical-align: middle;

        }



        .table td {

            text-align: center;

            vertical-align: middle;

        }



            .table td.text-left {

                text-align: left;

            }



            .table td.text-right {

                text-align: right;

            }



        .table input, .table select {

            margin: 0;

        }



        .table .form-control {

            font-size: 12px;

            padding: 4px 8px;

            height: 30px;

        }



        .new-row {

            background-color: #fffde7;

        }

    
        /* 表格框線與排版美化 */
        .table-bordered { border: 0 !important; }
        .table-bordered th, .table-bordered td { border: 0 !important; border-bottom: 1px solid #e2e8f0 !important; }
        .table > thead > tr > th { 
            border-bottom: 2px solid #337ab7 !important; 
            background-color: #f8fafc; 
            color: #334155; 
        }
        .table > tbody > tr:last-child > td { border-bottom: 0 !important; }
</style>

</head>

<body>

    @if(TempData["Success"] != null) {

        <div class="alert alert-success alert-dismissible" id="successAlert">

            @TempData["Success"]

            <button type="button" class="close" onclick="$('#successAlert').hide();">&times;</button>

        </div>

    }

    @if(TempData["Error"] != null) {

        <div class="alert alert-danger alert-dismissible" id="errorAlert">

            @TempData["Error"]

            <button type="button" class="close" onclick="$('#errorAlert').hide();">&times;</button>

        </div>

    }



    @using(Html.BeginForm("PAGE2_1_2_Save", "TDE0042", FormMethod.Post, new { id = "mainForm" })) {

        @Html.AntiForgeryToken()



        <input type="hidden" name="TID" value="@ViewBag.TID" />

        <input type="hidden" name="PID" value="@ViewBag.PID" />

        <input type="hidden" name="TD_CODE" value="@ViewBag.TD_CODE" />

        <input type="hidden" name="CITY" value="@ViewBag.CITY" />

        <input type="hidden" name="IsNew" value="@(isNew ? "true" : "false")" />



        <div class="card shadow-sm border-0 mb-4">

            <div class="card-header bg-primary text-white fw-bold">

                <strong>預算分配 @(isNew ? "(新增)" : "(編輯)")</strong>

            </div>

            <div class="card-body">

                <!-- 基本資訊（唯讀） -->

                @if(!isNew && data != null) {

                    <div class="info-row">

                        <div class="row">

                            <div class="col-md-4">

                                <span class="info-label">最後修改時間：</span>

                                @(data["UPD_DT"] != DBNull.Value ? Convert.ToDateTime(data["UPD_DT"]).ToString("yyyy/MM/dd HH:mm") : "-")

                            </div>

                            <div class="col-md-4">

                                <span class="info-label">最後修改人員：</span>

                                @(data["UPD_USR_NAME"] != DBNull.Value ? data["UPD_USR_NAME"].ToString() : "-")

                            </div>

                            <div class="col-md-4">

                                <span class="info-label">年度：</span>

                                @(data["SYR"] != DBNull.Value ? data["SYR"].ToString() : "-")

                            </div>

                        </div>

                    </div>

                }



                <!-- 年度預算金額 & 中央款金額（唯讀，由下方經費明細彙總計算） -->

                <div class="row">

                    <div class="col-md-4">

                        <div class="form-group">

                            <label>年度預算金額(元) <small class="text-muted">(自動計算)</small></label>

                            <input type="text" class="form-control readonly-field" id="YR_FUND" readonly

                                   value="@(data != null && data["YR_FUND"] != DBNull.Value ? string.Format("{0:N0}", data["YR_FUND"]) : "0")" />

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="form-group">

                            <label>中央款金額(元) <small class="text-muted">(自動計算)</small></label>

                            <input type="text" class="form-control readonly-field" id="CEN_FUND" readonly

                                   value="@(data != null && data["CEN_FUND"] != DBNull.Value ? string.Format("{0:N0}", data["CEN_FUND"]) : "0")" />

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="form-group">

                            <label>中央款比例(標準) %</label>

                            <input type="number" step="0.01" class="form-control" name="CEN_SP_RATIO_S" id="CEN_SP_RATIO_S"

                                   value="@(data != null && data["CEN_SP_RATIO_S"] != DBNull.Value ? data["CEN_SP_RATIO_S"] : "")" />

                        </div>

                    </div>

                </div>



                <div class="row">

                    <div class="col-md-4">

                        <div class="form-group">

                            <label>中央款比例(運算) %</label>

                            <input type="text" class="form-control readonly-field" id="CEN_SP_RATIO_CALC" readonly

                                   value="@(data != null && data["CEN_SP_RATIO"] != DBNull.Value ? data["CEN_SP_RATIO"] : "")" />

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="form-group">

                            <label>中央款比例(核定) %</label>

                            <input type="text" class="form-control readonly-field" id="CEN_SP_RATIO_D" readonly

                                   value="@(data != null && data["CEN_SP_RATIO_D"] != DBNull.Value ? data["CEN_SP_RATIO_D"] : "")" />

                        </div>

                    </div>

                </div>



                <!-- 計算結果顯示 -->

                <div class="calc-row">

                    <strong>中央款比例(計算)：</strong>

                    <span id="calcRatio">0</span> %

                </div>

            </div>

        </div>



        <div class="btn-toolbar">

            @*<button type="submit" class="btn btn-primary">

                <i class="fa-solid fa-floppy-disk me-1"></i> 儲存

            </button>*@

            <button type="button" class="btn btn-outline-secondary shadow-sm" onclick="closeWindow();">

                <i class="fa-solid fa-xmark me-1"></i> 關閉

            </button>

        </div>

    }



    <!-- 經費明細列表（直接編輯） -->

    <div class="card shadow-sm border-0 mb-4 h-100">

        <div class="card-header bg-primary text-white fw-bold">

            <strong>各年度經費明細</strong>

        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover" id="fundTable">

                    <thead>

                        <tr>

                            <th style="width:100px;">年度</th>

                            <th style="width:200px;">經費層級</th>

                            <th style="width:150px;">金額</th>

                            <th>修正說明</th>

                            @*<th style="width:80px;">操作</th>*@

                        </tr>

                    </thead>

                    <tbody>

                        <!-- 新增列 -->

                        @*<tr class="new-row">

                            <td>

                                <input type="text" class="form-control" id="new_SYR" maxlength="4" placeholder="年度" />

                            </td>

                            <td>

                                @Html.DropDownList("new_FIT_CODE", ViewBag.FIT_CODE_List as SelectList, new { @class = "form-control", id = "new_FIT_CODE" })

                            </td>

                            <td>

                                <input type="number" class="form-control" id="new_FUND" placeholder="金額" />

                            </td>

                            <td>

                                <input type="text" class="form-control" id="new_FUND_DESC" placeholder="修正說明" />

                            </td>

                            <td>

                                <button type="button" class="btn btn-success btn-sm" onclick="addFund();">

                                    <i class="fa-solid fa-plus"></i> 新增

                                </button>

                            </td>

                        </tr>*@

                        <!-- 現有資料列 -->

                        @if(fundList != null && fundList.Rows.Count > 0) {

                            foreach(System.Data.DataRow row in fundList.Rows) {

                                var fid = row["FID"] != DBNull.Value ? row["FID"].ToString() : "";

                                var syr = row["SYR"] != DBNull.Value ? row["SYR"].ToString() : "";

                                var fitDesc = row["FIT_DESC"] != DBNull.Value ? row["FIT_DESC"].ToString() : "";

                                var fund = row["FUND"] != DBNull.Value ? row["FUND"].ToString() : "";

                                var fundDesc = row["FUND_DESC"] != DBNull.Value ? row["FUND_DESC"].ToString() : "";

                                <tr data-fid="@fid">

                                    <td>

                                        <input type="text" class="form-control edit-syr" value="@syr" maxlength="4" />

                                    </td>

                                    <td>

                                        <select class="form-control edit-fit-code">

                                            @foreach(SelectListItem item in ViewBag.FIT_CODE_List) {

                                                var selected = (row["FIT_CODE"] != DBNull.Value && row["FIT_CODE"].ToString() == item.Value) ? "selected" : "";

                                                <option value="@item.Value" @selected>@item.Text</option>

                                            }

                                        </select>

                                    </td>

                                    <td>

                                        <input type="number" class="form-control edit-fund" value="@fund" />

                                    </td>

                                    <td>

                                        <input type="text" class="form-control edit-fund-desc" value="@fundDesc" />

                                    </td>

                                    @*<td>

                                        <button type="button" class="btn btn-warning btn-sm" onclick="updateFund('@fid', this);">

                                            <i class="fa-solid fa-pen"></i>

                                        </button>

                                    </td>*@

                                </tr>

                            }

                        }

                    </tbody>

                </table>

            </div>

            <div id="fundMessage"></div>

        </div>

    </div>

    @*
        3.1.4rev：月分配數
        業主回報「月分配數功能無法使用」，原因是本頁只做了預算分配與經費明細，沒有月分配。
        舊系統同畫面 App_Data\CMETMS\TDE0020B020.Xml 定義：每筆經費明細(FID) 各有 M_01~M_12，
        實體欄位在 CMEPMS.dbo.CTDITFD。此區塊即補上該功能。
    *@
    <div class="card shadow-sm border-0 mb-4 h-100">
        <div class="card-header bg-primary text-white fw-bold">
            <strong>月分配數</strong>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover" id="monthTable">
                    <thead>
                        <tr>
                            <th style="width:80px;">年度</th>
                            @for(int m = 1; m <= 12; m++) {
                                <th style="min-width:90px;">@(m)月</th>
                            }
                            <th style="width:120px;">合計</th>
                            <th style="width:80px;">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var monthList = ViewBag.MonthList as System.Data.DataTable;
                        }
                        @if(monthList != null && monthList.Rows.Count > 0) {
                            foreach(System.Data.DataRow mrow in monthList.Rows) {
                                var mFid = mrow["FID"] != DBNull.Value ? mrow["FID"].ToString() : "";
                                var mSyr = mrow["SYR"] != DBNull.Value ? mrow["SYR"].ToString() : "";
                                decimal mTotal = 0;
                                <tr data-fid="@mFid">
                                    <td>@mSyr</td>
                                    @for(int m = 1; m <= 12; m++) {
                                        var col = "M_" + m.ToString("00");
                                        var val = mrow[col] != DBNull.Value ? mrow[col].ToString() : "";
                                        if(mrow[col] != DBNull.Value) { mTotal += Convert.ToDecimal(mrow[col]); }
                                        <td><input type="number" step="1" class="form-control edit-month" data-m="@m" value="@val" /></td>
                                    }
                                    <td class="text-end month-total">@mTotal.ToString("N0")</td>
                                    <td>
                                        <button type="button" class="btn btn-warning btn-sm" onclick="saveMonth('@mFid', this);" title="儲存本列月分配數">
                                            <i class="fa-solid fa-floppy-disk"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        } else {
                            <tr><td colspan="15" class="text-center">無經費明細，請先於上方新增年度經費明細</td></tr>
                        }
                    </tbody>
                </table>
            </div>
            <div id="monthMessage"></div>
        </div>
    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>

        var TID = '@ViewBag.TID';

        var PID = '@ViewBag.PID';

        var TD_CODE = '@ViewBag.TD_CODE';



        // 計算中央款比例（從顯示的格式化數字中解析）

        function calculateRatio() {

            // 移除千分位逗號後解析數字

            var yrFund = parseFloat($('#YR_FUND').val().replace(/,/g, '')) || 0;

            var cenFund = parseFloat($('#CEN_FUND').val().replace(/,/g, '')) || 0;



            if (yrFund > 0) {

                var ratio = (cenFund / yrFund * 100).toFixed(2);

                $('#calcRatio').text(ratio);

                $('#CEN_SP_RATIO_CALC').val(ratio);

            } else {

                $('#calcRatio').text('0');

                $('#CEN_SP_RATIO_CALC').val('');

            }

        }



// <i class="fa-solid fa-xmark me-1"></i> 關閉視窗

   function closeWindow() {

            if (typeof top.close2_1_2 === 'function') {

                top.close2_1_2();

    } else {

     window.close();

            }

        }



  // 顯示訊息

    // 3.1.4rev：月分配數 —— 儲存單列 12 個月 (CMEPMS.dbo.CTDITFD)
    function recalcMonthTotal(row) {
        var total = 0;
        row.find('.edit-month').each(function () {
            total += parseFloat($(this).val()) || 0;
        });
        row.find('.month-total').text(total.toLocaleString('en-US'));
        return total;
    }

    function saveMonth(fid, btn) {
        var row = $(btn).closest('tr');
        var data = { TID: TID, FID: fid };
        row.find('.edit-month').each(function () {
            var m = parseInt($(this).data('m'), 10);   // 1..12
            var v = $(this).val();
            data['M[' + (m - 1) + ']'] = (v === '' ? '' : v);
        });

        $.ajax({
            url: '@Url.Action("PAGE2_1_2_Month_Ajax", "TDE0042")',
            type: 'POST',
            data: data,
            success: function (res) {
                showMonthMessage(res.message, res.success);
                if (res.success) { recalcMonthTotal(row); }
            },
            error: function (xhr) {
                showMonthMessage('儲存失敗：' + xhr.status, false);
            }
        });
    }

    function showMonthMessage(msg, isSuccess) {
        var cls = isSuccess ? 'alert-success' : 'alert-danger';
        $('#monthMessage').html('<div class="alert ' + cls + ' alert-dismissible">' + msg +
            '<button type="button" class="close" onclick="$(this).parent().hide();">&times;</button></div>');
        setTimeout(function () { $('#monthMessage .alert').fadeOut(); }, 3000);
    }

    $(document).on('input', '.edit-month', function () {
        recalcMonthTotal($(this).closest('tr'));
    });

    function showMessage(msg, isSuccess) {

        var cls = isSuccess ? 'alert-success' : 'alert-danger';

  $('#fundMessage').html('<div class="alert ' + cls + ' alert-dismissible">' + msg +

             '<button type="button" class="close" onclick="$(this).parent().hide();">&times;</button></div>');

            setTimeout(function() { $('#fundMessage .alert').fadeOut(); }, 3000);

        }



        // 新增經費明細

        function addFund() {

    var syr = $('#new_SYR').val();

            var fitCode = $('#new_FIT_CODE').val();

            var fund = $('#new_FUND').val();

            var fundDesc = $('#new_FUND_DESC').val();



            if (!syr) {

     showMessage('請輸入年度', false);

  return;

   }

         if (!fitCode) {

 showMessage('請選擇經費層級', false);

    return;

     }

            if (!fund) {

        showMessage('請輸入金額', false);

          return;

            }



        $.ajax({

      url: '@Url.Action("PAGE2_1_2_Fund_Ajax", "TDE0042")',

        type: 'POST',

   data: {

    action: 'add',

         TID: TID,

       SYR: syr,

     FIT_CODE: fitCode,

       FUND: fund,

 FUND_DESC: fundDesc

      },

    success: function(result) {

            if (result.success) {

            showMessage('新增成功', true);

    // 清空新增列

   $('#new_SYR').val('');

             $('#new_FIT_CODE').val('');

$('#new_FUND').val('');

      $('#new_FUND_DESC').val('');

            // 重新載入頁面

    location.reload();

       } else {

        showMessage('新增失敗：' + result.message, false);

          }

   },

         error: function() {

 showMessage('新增失敗：網路錯誤', false);

   }

            });

        }



      // 更新經費明細

        function updateFund(fid, btn) {

            var row = $(btn).closest('tr');

      var syr = row.find('.edit-syr').val();

 var fitCode = row.find('.edit-fit-code').val();

     var fund = row.find('.edit-fund').val();

            var fundDesc = row.find('.edit-fund-desc').val();



     if (!syr) {

     showMessage('請輸入年度', false);

          return;

   }

 if (!fund) {

 showMessage('請輸入金額', false);

        return;

            }



          $.ajax({

           url: '@Url.Action("PAGE2_1_2_Fund_Ajax", "TDE0042")',

        type: 'POST',

   data: {

action: 'update',

    TID: TID,

    FID: fid,

         SYR: syr,

      FIT_CODE: fitCode,

     FUND: fund,

           FUND_DESC: fundDesc

        },

       success: function(result) {

   if (result.success) {

     showMessage('更新成功', true);

     } else {

               showMessage('更新失敗：' + result.message, false);

         }

 },

      error: function() {

  showMessage('更新失敗：網路錯誤', false);

        }

            });

        }



        $(document).ready(function () {

            // YR_FUND 和 CEN_FUND 是唯讀計算值，不需要綁定事件

            // 初始計算比例（顯示用）

            calculateRatio();

        });

    </script>

</body>

</html>

