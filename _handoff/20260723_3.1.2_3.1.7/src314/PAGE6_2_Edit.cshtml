@model WCals.ViewModels.NewModels.TDE0040Model
@{
    ViewBag.Title = "估驗期別編輯";
    Layout = null;
    bool isNew = ViewBag.IsNew ?? true;
    System.Data.DataRow data = ViewBag.Data;
    bool saveSuccess = TempData["SaveSuccess"] != null && (bool)TempData["SaveSuccess"] == true;
    
    // 格式化日期顯示 - 將 1140601 轉換為 114/06/01
    var eccDtDisplay = "";
    if (!isNew && data != null && data["ECC_DT"] != System.DBNull.Value) {
        var dt = data["ECC_DT"].ToString().Trim();
      if (dt.Length == 7) {
   eccDtDisplay = dt.Substring(0, 3) + "/" + dt.Substring(3, 2) + "/" + dt.Substring(5, 2);
        } else {
            eccDtDisplay = dt;
        }
  }
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://code.jquery.com/ui/1.14.1/themes/base/jquery-ui.css" rel="stylesheet" />
    <script type="text/javascript" src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script type="text/javascript" src="~/Scripts/jquery.datepick.js"></script>
    <script type="text/javascript" src="~/Scripts/MyDatepickerJ.js"></script>
    <style>
        body { padding: 15px; }
      .alert { margin: 10px 0; }
        .form-group { margin-bottom: 15px; }
        .form-group label { font-weight: bold; color: #333; }
        .form-control { border: 1px solid #ccc; padding: 8px; }
        .btn-group { margin-top: 20px; text-align: center; }
      .ui-datepicker { z-index: 2200 !important; background: #ffffff; border: 1px solid #cccccc; border-radius: 4px; }
    </style>
</head>
<body>
    @if (TempData["Success"] != null) {
        <div class="alert alert-success alert-dismissible" role="alert">
            <button type="button" class="btn-close shadow-none" data-bs-dismiss="alert" aria-label="Close"></button>
    @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null) {
        <div class="alert alert-danger alert-dismissible" role="alert">
            <button type="button" class="btn-close shadow-none" data-bs-dismiss="alert" aria-label="Close"></button>
        @TempData["Error"]
        </div>
    }

    <form action="@Url.Action("PAGE6_2_Save", "TDE0046")" method="post" role="form" id="editForm">
        @Html.AntiForgeryToken()
     <input type="hidden" name="TD_CODE" value="@ViewBag.TD_CODE" />
        <input type="hidden" name="IsNew" value="@(isNew ? "true" : "false")" />

   <div class="form-group">
      @* 3.1.4rev：新增時自動帶出下一個可用期別(ViewBag.NextSeqNo)，使用者不必自己想，也不會撞到重複 *@
      <label>期別 <span style="color: red;">*</span></label>
            <input type="number" class="form-control" name="SEQ_NO"
       value="@(isNew ? (ViewBag.NextSeqNo ?? "1") : (data != null ? data["SEQ_NO"] : ""))"
      @(isNew ? "" : "readonly") required min="1" />
            @if(isNew) {
                <small class="text-muted">已自動帶入下一個期別，如需調整可直接修改。</small>
            }
      </div>

      <div class="form-group">
            <label>估驗日期 <span style="color: red;">*</span></label>
    <input type="text" class="form-control dt" name="ECC_DT" 
            value="@eccDtDisplay" 
    placeholder="例: 114/06/01" required />
        </div>

        <div class="form-group">
     <label>估驗金額</label>
  <input type="number" class="form-control" name="ECC_FEE" step="0.01"
            value="@(isNew ? "" : (data != null && data["ECC_FEE"] != System.DBNull.Value ? data["ECC_FEE"] : ""))" />
    </div>

        <div class="form-group">
            <label>已出帳</label>
            <input type="number" class="form-control" name="ECCPRV_FEE" step="0.01"
       value="@(isNew ? "" : (data != null && data["ECCPRV_FEE"] != System.DBNull.Value ? data["ECCPRV_FEE"] : ""))" />
     </div>

    <div class="form-group">
          <label>認可扣款</label>
     <input type="number" class="form-control" name="ECCDIS_FEE" step="0.01"
        value="@(isNew ? "" : (data != null && data["ECCDIS_FEE"] != System.DBNull.Value ? data["ECCDIS_FEE"] : ""))" />
        </div>

        <div class="form-group">
          <label>應付未付</label>
    <input type="number" class="form-control" name="PPAYDIS_FEE" step="0.01"
       value="@(isNew ? "" : (data != null && data["PPAYDIS_FEE"] != System.DBNull.Value ? data["PPAYDIS_FEE"] : ""))" />
        </div>

        <div class="form-group">
   <label>調整金額</label>
         <input type="number" class="form-control" name="ADJ_FEE" step="0.01"
    value="@(isNew ? "" : (data != null && data["ADJ_FEE"] != System.DBNull.Value ? data["ADJ_FEE"] : ""))" />
        </div>

        <div class="form-group">
            <label>備註</label>
            <input type="text" class="form-control" name="NOTE"
    value="@(isNew ? "" : (data != null && data["NOTE"] != System.DBNull.Value ? data["NOTE"] : ""))" />
    </div>

 <div class="btn-group">
    <button type="submit" class="btn btn-primary">
              <i class="fa-solid fa-floppy-disk me-1"></i> 儲存
      </button>
 <button type="button" class="btn btn-success" onclick="saveAndClose();">
          <i class="fa-solid fa-floppy-disk me-1"></i> 儲存並關閉
            </button>
     <button type="button" class="btn btn-secondary" onclick="parent.closeDialog();">
      <i class="fa-solid fa-xmark"></i> 取消
            </button>
        </div>
    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/ui/1.14.1/jquery-ui.min.js"></script>
    <script>
        $(".dt").datepickerTW({
      changeYear: true,
            changeMonth: true,
            yearRange: '68:168',
            dateFormat: 'yymmdd'
        });

  @if (saveSuccess) {
        <text>
$(document).ready(function() {
        setTimeout(function() {
    if (parent && parent.closeDialog) {
        parent.closeDialog();
       }
                }, 1500);
 });
            </text>
    }

        function saveAndClose() {
            var form = document.getElementById('editForm');
  var input = document.createElement('input');
            input.type = 'hidden';
      input.name = 'CloseAfterSave';
     input.value = 'true';
   form.appendChild(input);
          form.submit();
   }
    </script>
</body>
</html>