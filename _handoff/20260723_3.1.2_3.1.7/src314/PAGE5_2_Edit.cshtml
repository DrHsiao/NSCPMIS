@{
    Layout = null;
    var data = ViewBag.Data as System.Data.DataRow;
    bool isNew = ViewBag.IsNew ?? false;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>編輯分月進度</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://code.jquery.com/ui/1.14.1/themes/base/jquery-ui.css" rel="stylesheet" />
    <script type="text/javascript" src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <style>
        body { padding: 15px; font-size: 13px; }
        .form-group { margin-bottom: 10px; }
        .form-control { font-size: 13px; }
        label { font-weight: bold; margin-bottom: 3px; }
        .section-title {
            background-color: #337ab7;
            color: white;
            padding: 8px 12px;
            margin: 15px 0 10px 0;
            border-radius: 4px;
        }
        .readonly-field { background-color: #eee; }
        /* 3.1.4rev：日曆需疊在 jQuery UI Dialog 之上 */
        .ui-datepicker { z-index: 2200 !important; background: #ffffff; border: 1px solid #cccccc; border-radius: 4px; }
        .btn-toolbar { margin-top: 20px; padding-top: 15px; border-top: 1px solid #ddd; }
    </style>
</head>
<body>
    @if(TempData["Success"] != null) {
        <div class="alert alert-success alert-dismissible">
            @TempData["Success"]
            <button type="button" class="close" onclick="$(this).parent().hide();">&times;</button>
        </div>
    }
    @if(TempData["Error"] != null) {
        <div class="alert alert-danger alert-dismissible">
            @TempData["Error"]
            <button type="button" class="close" onclick="$(this).parent().hide();">&times;</button>
        </div>
    }

    @using(Html.BeginForm("PAGE5_2_Edit_Save", "TDE0045", FormMethod.Post, new { id = "editForm" })) {
        @Html.AntiForgeryToken()
        <input type="hidden" name="ID" value="@ViewBag.ID" />
        <input type="hidden" name="TD_CODE" value="@ViewBag.TD_CODE" />

        <!-- 基本資訊 -->
        <div class="section-title">基本資訊</div>
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label>年度</label>
                    <input type="text" class="form-control readonly-field" readonly
                           value="@(data != null && data["SYR"] != DBNull.Value ? data["SYR"] : "")" />
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>月份</label>
                    <input type="text" class="form-control readonly-field" readonly
                           value="@(data != null && data["SMN"] != DBNull.Value ? data["SMN"] : "")" />
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>估驗未撥金額</label>
                    <input type="number" class="form-control" name="ECC_UPAY_FEE"
                           value="@(data != null && data["ECC_UPAY_FEE"] != DBNull.Value ? data["ECC_UPAY_FEE"] : "")" />
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>原始預定支用數</label>
                    <input type="number" step="0.01" class="form-control" name="ORG_SUM_PRE_SCHD"
                           value="@(data != null && data["ORG_SUM_PRE_SCHD"] != DBNull.Value ? data["ORG_SUM_PRE_SCHD"] : "")" />
                </div>
            </div>
        </div>

        <!-- 進度資訊 -->
        <div class="section-title">進度資訊</div>
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label>總累計預定進度(%)</label>
                    <input type="number" step="0.01" class="form-control" name="PRE_SCHD"
                           value="@(data != null && data["PRE_SCHD"] != DBNull.Value ? data["PRE_SCHD"] : "")" />
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>總累計實際進度(%)</label>
                    <input type="number" step="0.01" class="form-control" name="REL_SCHD"
                           value="@(data != null && data["REL_SCHD"] != DBNull.Value ? data["REL_SCHD"] : "")" />
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>年度累計預定進度</label>
                    <input type="number" class="form-control" name="PRE_COST"
                           value="@(data != null && data["PRE_COST"] != DBNull.Value ? data["PRE_COST"] : "")" />
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>年度累計實際進度</label>
                    <input type="number" class="form-control" name="REL_COST"
                           value="@(data != null && data["REL_COST"] != DBNull.Value ? data["REL_COST"] : "")" />
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label>當月預定進度</label>
                    <input type="number" class="form-control" name="CT_PRE_COST"
                           value="@(data != null && data["CT_PRE_COST"] != DBNull.Value ? data["CT_PRE_COST"] : "")" />
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>當月累計進度</label>
                    <input type="number" class="form-control" name="RV_PRE_COST"
                           value="@(data != null && data["RV_PRE_COST"] != DBNull.Value ? data["RV_PRE_COST"] : "")" />
                </div>
            </div>
        </div>

        <!-- 中央款資訊 -->
        <div class="section-title">中央款資訊</div>
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label>中央款累計分配數</label>
                    <input type="number" class="form-control" name="L_PLN_COST"
                           value="@(data != null && data["L_PLN_COST"] != DBNull.Value ? data["L_PLN_COST"] : "")" />
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>中央款累計實際支用數</label>
                    <input type="number" class="form-control" name="L_REL_COST"
                           value="@(data != null && data["L_REL_COST"] != DBNull.Value ? data["L_REL_COST"] : "")" />
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>中央款累計應付未付數</label>
                    <input type="number" class="form-control" name="L_UNPAY_COST"
                           value="@(data != null && data["L_UNPAY_COST"] != DBNull.Value ? data["L_UNPAY_COST"] : "")" />
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>節餘數</label>
                    <input type="number" class="form-control" name="SAVE_FEE"
                           value="@(data != null && data["SAVE_FEE"] != DBNull.Value ? data["SAVE_FEE"] : "")" />
                </div>
            </div>
        </div>

        <!-- 箱涵資訊 -->
        <div class="section-title">箱涵資訊</div>
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label>箱涵設計長(m)</label>
                    <input type="number" step="0.01" class="form-control" name="PRE_CON_LEN"
                           value="@(data != null && data["PRE_CON_LEN"] != DBNull.Value ? data["PRE_CON_LEN"] : "")" />
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>累積箱涵施作長度(m)</label>
                    <input type="number" step="0.01" class="form-control" name="REL_CON_LEN"
                           value="@(data != null && data["REL_CON_LEN"] != DBNull.Value ? data["REL_CON_LEN"] : "")" />
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    @* 3.1.4rev：欄位代碼轉中文，名稱取自舊系統同畫面定義 App_Data\CMETMS\TDE0020B042.Xml *@
                    <label>設計滯洪量(m³)</label>
                    <input type="number" step="0.01" class="form-control" name="PRE_CON_FLOOD"
                           value="@(data != null && data["PRE_CON_FLOOD"] != DBNull.Value ? data["PRE_CON_FLOOD"] : "")" />
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>累積設計施作滯洪量(m³)</label>
                    <input type="number" step="0.01" class="form-control" name="REL_CON_FLOOD"
                           value="@(data != null && data["REL_CON_FLOOD"] != DBNull.Value ? data["REL_CON_FLOOD"] : "")" />
                </div>
            </div>
        </div>

        <!-- 執行說明 -->
        <div class="section-title">執行說明</div>
        <div class="row">
            <div class="col-md-12">
                <div class="form-group">
                    <label>執行情形說明</label>
                    <textarea class="form-control" name="EXECT_DESC" rows="2">@(data != null && data["EXECT_DESC"] != DBNull.Value ? data["EXECT_DESC"] : "")</textarea>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label>落後原因</label>
                    <textarea class="form-control" name="DELAY_RESN" rows="2">@(data != null && data["DELAY_RESN"] != DBNull.Value ? data["DELAY_RESN"] : "")</textarea>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label>解決方法</label>
                    <textarea class="form-control" name="RESLV_MTHD" rows="2">@(data != null && data["RESLV_MTHD"] != DBNull.Value ? data["RESLV_MTHD"] : "")</textarea>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label>預計解決期限</label>
                    @* 3.1.4rev：業主要求提供日曆。TDDMSCD.RESLV_LMT_DT 為 varchar(10) 存民國7碼(如 0970930)，
                       故沿用全站慣用的 datepickerTW + dateFormat:'yymmdd'，原本標成 YYYYMMDD(8) 是錯的。 *@
                    <input type="text" class="form-control dt" name="RESLV_LMT_DT" maxlength="7" placeholder="民國7碼，例 0970930"
                           value="@(data != null && data["RESLV_LMT_DT"] != DBNull.Value ? data["RESLV_LMT_DT"] : "")" />
                </div>
            </div>
        </div>

        <!-- 按鈕 -->
        <div class="btn-toolbar">
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-floppy-disk me-1"></i> 儲存*
            </button>
            <button type="button" class="btn btn-secondary" onclick="closeDialog();">
                <span class="fa-solid fa-xmark"></span> 取消
            </button>
        </div>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @* 3.1.4rev：補上日曆所需的 jQuery UI / datepick（本頁原本只載了 jquery-ui 的 CSS，沒有 JS） *@
    <script src="https://code.jquery.com/ui/1.14.1/jquery-ui.min.js"></script>
    <script type="text/javascript" src="~/Scripts/jquery.datepick.js"></script>
    <script type="text/javascript" src="~/Scripts/MyDatepickerJ.js"></script>
    @* 3.1.4rev：此段原本整段被 Razor 註解掉，導致「取消」鈕呼叫的 closeDialog() 未定義而毫無反應 *@
    <script>
        $(".dt").datepickerTW({
            changeYear: true,
            changeMonth: true,
            yearRange: '68:168',
            dateFormat: 'yymmdd'
        });

        function closeDialog() {
            if (parent && typeof parent.closeEditDialog === 'function') {
                parent.closeEditDialog();
            } else {
                window.close();
            }
        }

        // 儲存成功後自動關閉
        @if(TempData["SaveSuccess"] != null) {
            @:setTimeout(function() { closeDialog(); }, 500);
        }
    </script>
</body>
</html>
