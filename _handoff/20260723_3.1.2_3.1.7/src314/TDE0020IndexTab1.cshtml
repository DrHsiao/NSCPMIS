@using PagedList.Mvc
@model WCals.ViewModels.NewModels.TDE0020Model
@{ 
    Layout = null; 
    System.Data.DataTable cols = ViewBag.cols;
}

<style>
    /* Sticky Column Styles */
    .table-responsive-custom {
        overflow-x: auto;
        position: relative;
        border: 1px solid #dee2e6;
        border-radius: 4px;
        max-height: 600px;
    }
    .table-custom {
        border-collapse: separate;
        border-spacing: 0;
        margin-bottom: 0;
        width: max-content;
        min-width: 100%;
    }
    .table-custom th, .table-custom td {
        vertical-align: middle;
        padding: 0.5rem 0.75rem;
    }
    .sticky-col {
        position: sticky !important;
        z-index: 2;
        background-color: #fff;
        left: 0;
    }
    .sticky-col.st-1 { left: 0; min-width: 70px; z-index: 3; }
    .sticky-col.st-2 { left: 70px; min-width: 70px; z-index: 3; }
    .sticky-col.st-3 { left: 140px; min-width: 250px; z-index: 3; box-shadow: 2px 0 5px -2px rgba(0,0,0,0.1); }
    
    thead .sticky-col { z-index: 4; background-color: #f8f9fa; }
    thead th { position: sticky; top: 0; z-index: 1; background-color: #f8f9fa; border-bottom: 2px solid #dee2e6; }
    
    tbody tr:nth-of-type(odd) .sticky-col { background-color: #f9f9f9; }
    tbody tr:hover .sticky-col { background-color: #e9ecef; }
    tbody tr:hover { background-color: #e9ecef; }

    .input-group-sm-custom { width: 140px; }
    .btn-icon { width: 32px; height: 32px; padding: 0; display: inline-flex; justify-content: center; align-items: center; }
</style>

@if (Model.List1.Count == 0)
{
    <div class="alert alert-info m-3 text-center">
        <i class="fa-solid fa-circle-info me-2"></i>查無資料
    </div>
}
else
{
    <div class="p-3">
        <div class="table-responsive-custom">
            <table class="table table-custom table-hover">
                <thead>
                    <tr>
                        <th class="sticky-col st-1">縣市</th>
                        <th class="sticky-col st-2">鄉鎮</th>
                        <th class="sticky-col st-3">工程編號/名稱</th>
                        <th>累計分配數</th>
                        <th>實際支用數</th>
                        <th>應付未付數</th>
                        <th>結餘數</th>
                        
                        @foreach(System.Data.DataRow d in cols.Rows) {
                            <th>預定@(d["IT_NAME"])</th>
                            <th>實際@(d["IT_NAME"])</th>
                        }
                        <th style="min-width: 200px;">落後原因或辦理情況</th>
                        <th style="min-width: 200px;">落後解決對策</th>
                        <th style="min-width: 200px;">備註</th>
                        <th style="min-width: 100px;">引用前月</th>
                        <th style="min-width: 110px;">一次儲存</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(System.Data.DataRow c in Model.List1) {
                        <tr>
                            <td class="sticky-col st-1 text-center">@c["CITY"]</td>
                            <td class="sticky-col st-2 text-center">@c["TOWN"]</td>
                            <td class="sticky-col st-3">
                                <div class="fw-bold">@c["TD_CODE"]</div>
                                <small class="text-muted">@c["TD_NAME"]</small>
                                <div class="badge bg-light text-dark border">@c["SYR"] / @c["SMN"]</div>
                                <div class="mt-1">
                                    <button type="button" class="btn btn-success btn-sm btn-save-row w-100" title="一次儲存本列所有控制點日期與文字">
                                        <i class="fa-solid fa-floppy-disk me-1"></i>一次儲存
                                    </button>
                                </div>
                            </td>
                            <td class="text-end">@c["L_PLN_COST"]</td>
                            <td class="text-end">@c["L_REL_COST"]</td>
                            <td class="text-end">@c["L_UNPAY_COST"]</td>
                            <td class="text-end">@c["SAVE_FEE"]</td>
                            
                            @foreach(System.Data.DataRow d in cols.Rows) {
                                var itCode = d["IT_CODE"].ToString();
                                <td>
                                    <div class="input-group input-group-sm input-group-sm-custom">
                                        <input type="text" value="@c[itCode + "_REL_SDT"]" class="form-control dt-save"
                                               placeholder="預定日期"
                                               data-td-code="@c["TD_CODE"]" data-syr="@Model.year" data-smn="@Model.month"
                                               data-it-code="@itCode" data-field="REL_SDT" />
                                        <button class="btn btn-outline-secondary btn-save-dt btn-icon" type="button" title="儲存"><i class="fa-solid fa-floppy-disk"></i></button>
                                    </div>
                                    <div class="save-status small mt-1"></div>
                                </td>
                                <td>
                                    <div class="input-group input-group-sm input-group-sm-custom">
                                        <input type="text" value="@c[itCode + "_REL_EDT"]" class="form-control dt-save" 
                                               placeholder="實際日期"
                                               data-td-code="@c["TD_CODE"]" data-syr="@Model.year" data-smn="@Model.month"
                                               data-it-code="@itCode" data-field="REL_EDT" />
                                        <button class="btn btn-outline-secondary btn-save-dt btn-icon" type="button" title="儲存"><i class="fa-solid fa-floppy-disk"></i></button>
                                    </div>
                                    <div class="save-status small mt-1"></div>
                                </td>
                            }
                            
                            <td>
                                <div class="input-group input-group-sm" style="min-width: 200px;">
                                    <textarea class="form-control txt-save" rows="2"
                                              data-td-code="@c["TD_CODE"]" data-syr="@Model.year" data-smn="@Model.month"
                                              data-field="DELAY_RESN">@c["DELAY_RESN"]</textarea>
                                    <button class="btn btn-outline-secondary btn-save-txt btn-icon" type="button" title="儲存"><i class="fa-solid fa-floppy-disk"></i></button>
                                </div>
                                <div class="save-status small mt-1"></div>
                            </td>
                            <td>
                                <div class="input-group input-group-sm" style="min-width: 200px;">
                                    <textarea class="form-control txt-save" rows="2"
                                              data-td-code="@c["TD_CODE"]" data-syr="@Model.year" data-smn="@Model.month"
                                              data-field="RESLV_MTHD">@c["RESLV_MTHD"]</textarea>
                                    <button class="btn btn-outline-secondary btn-save-txt btn-icon" type="button" title="儲存"><i class="fa-solid fa-floppy-disk"></i></button>
                                </div>
                                <div class="save-status small mt-1"></div>
                            </td>
                            <td>
                                <div class="input-group input-group-sm" style="min-width: 200px;">
                                    <textarea class="form-control txt-save" rows="2"
                                              data-td-code="@c["TD_CODE"]" data-syr="@Model.year" data-smn="@Model.month"
                                              data-field="EXECT_DESC">@c["EXECT_DESC"]</textarea>
                                    <button class="btn btn-outline-secondary btn-save-txt btn-icon" type="button" title="儲存"><i class="fa-solid fa-floppy-disk"></i></button>
                                </div>
                                <div class="save-status small mt-1"></div>
                            </td>
                            <td>
                                <button type="button" class="btn btn-outline-primary btn-sm btn-copy-prev w-100"
                                        data-td-code="@c["TD_CODE"]" data-syr="@Model.year" data-smn="@Model.month"
                                        data-type="@Model.type">
                                    <i class="fa-solid fa-paste me-1"></i>引用前月
                                </button>
                                <div class="save-status small mt-1 text-center"></div>
                            </td>
                            <td>
                                <button type="button" class="btn btn-success btn-sm btn-save-row w-100" title="一次儲存本列所有控制點日期與文字">
                                    <i class="fa-solid fa-floppy-disk me-1"></i>一次儲存
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        <div class="mt-3 d-flex justify-content-center ajax-pager">
            @Html.PagedListPager(Model.List1, page1 => Url.Action("TAB1",
             new {
                 page = page1,
                 pid = Model.pid,
                 td_code=Model.td_code,
                 td_name=Model.td_name,
                 city = Model.city,
                 town = Model.town,
                 type = Model.type,
                 year=Model.year,
                 month=Model.month
             }),
             new PagedListRenderOptions {
                 DisplayItemSliceAndTotal = true,
                 DisplayPageCountAndCurrentLocation = true,
                 DisplayLinkToLastPage = PagedListDisplayMode.Never,
                 DisplayLinkToIndividualPages = true,
                 ItemSliceAndTotalFormat = "第 {0} - {1}筆 / 共{2}筆",
                 PageCountAndCurrentLocationFormat = "第 {0} 頁 / 共 {1} 頁",
                 ContainerDivClasses = new[] { "pagination-container" },
                 UlElementClasses = new[] { "pagination" },
                 LiElementClasses = new[] { "page-item" },
                 ClassToApplyToFirstListItemInPager = "page-link",
                 ClassToApplyToLastListItemInPager = "page-link",
                 LinkToPreviousPageFormat = "<i class='fa-solid fa-chevron-left'></i>",
                 LinkToNextPageFormat = "<i class='fa-solid fa-chevron-right'></i>",
                 LinkToFirstPageFormat = "<i class='fa-solid fa-angles-left'></i>",
                 LinkToLastPageFormat = "<i class='fa-solid fa-angles-right'></i>",
                 FunctionToTransformEachPageLink = (li, a) => { a.Attributes.Add("class", "page-link"); return a; }
             }
         )
        </div>
    </div>
}

<script>
    // 綁定 Datepicker
    $(".dt-save").datepickerTW({
        changeYear: true,
        changeMonth: true,
        yearRange: '68:168',
        dateFormat: 'yymmdd'
    });

    // 狀態顯示 Helper
    function showStatus($el, status, msg) {
        var $status = $el.closest('td').find('.save-status');
        $status.removeClass('text-warning text-success text-danger').text(msg);
        
        if(status === 'saving') $status.addClass('text-warning');
        if(status === 'saved') $status.addClass('text-success');
        if(status === 'error') $status.addClass('text-danger');

        if (status === 'saved') {
            setTimeout(function () { $status.fadeOut(function () { $(this).text('').show(); }); }, 2000);
        }
    }

    // 綁定儲存按鈕 - 日期
    $(".btn-save-dt").off('click').on('click', function () {
        var $btn = $(this);
        var $input = $btn.closest('.input-group').find('.dt-save');
        var data = {
            td_code: $input.data('td-code'),
            syr: $input.data('syr'),
            smn: $input.data('smn'),
            it_code: $input.data('it-code'),
            field: $input.data('field'),
            value: $input.val()
        };

        showStatus($input, 'saving', '儲存中...');
        $btn.prop('disabled', true);

        $.ajax({
            url: '@Url.Content("~/TDE0020/SaveDateField")',
            method: 'POST',
            data: data,
            success: function (res) {
                if (res.success) {
                    showStatus($input, 'saved', '已儲存');
                } else {
                    showStatus($input, 'error', res.message || '失敗');
                }
            },
            error: function () { showStatus($input, 'error', '失敗'); },
            complete: function() { $btn.prop('disabled', false); }
        });
    });

    // 綁定儲存按鈕 - 文字
    $(".btn-save-txt").off('click').on('click', function () {
        var $btn = $(this);
        var $input = $btn.closest('.input-group').find('.txt-save');
        var data = {
            td_code: $input.data('td-code'),
            syr: $input.data('syr'),
            smn: $input.data('smn'),
            field: $input.data('field'),
            value: $input.val()
        };

        showStatus($input, 'saving', '儲存中...');
        $btn.prop('disabled', true);

        $.ajax({
            url: '@Url.Content("~/TDE0020/SaveTextField")',
            method: 'POST',
            data: data,
            success: function (res) {
                 if (res.success) {
                    showStatus($input, 'saved', '已儲存');
                } else {
                    showStatus($input, 'error', res.message || '失敗');
                }
            },
            error: function () { showStatus($input, 'error', '失敗'); },
            complete: function() { $btn.prop('disabled', false); }
        });
    });

    // 引用前月
    $(".btn-copy-prev").off('click').on('click', function () {
        var $btn = $(this);
        var $row = $btn.closest('tr');
        var $status = $btn.closest('td').find('.save-status');
        var data = {
            td_code: $btn.data('td-code'),
            syr: $btn.data('syr'),
            smn: $btn.data('smn'),
            type: $btn.data('type')
        };

        showStatus($btn, 'saving', '載入中...');
        $btn.prop('disabled', true);

        $.ajax({
            url: '@Url.Content("~/TDE0020/CopyFromPrevMonth")',
            method: 'POST',
            data: data,
            success: function (res) {
                if (res.success) {
                    $row.find('.txt-save[data-field="DELAY_RESN"]').val(res.data.DELAY_RESN || '');
                    $row.find('.txt-save[data-field="RESLV_MTHD"]').val(res.data.RESLV_MTHD || '');
                    $row.find('.txt-save[data-field="EXECT_DESC"]').val(res.data.EXECT_DESC || '');

                    if (res.data.dateFields) {
                        $.each(res.data.dateFields, function (itCode, fields) {
                            $row.find('.dt-save[data-it-code="' + itCode + '"][data-field="REL_SDT"]').val(fields.REL_SDT || '');
                            $row.find('.dt-save[data-it-code="' + itCode + '"][data-field="REL_EDT"]').val(fields.REL_EDT || '');
                        });
                    }
                    showStatus($btn, 'saved', '完成');
                } else {
                    showStatus($btn, 'error', res.message || '失敗');
                }
            },
            error: function () { showStatus($btn, 'error', '失敗'); },
            complete: function() { $btn.prop('disabled', false); }
        });
    });

    // 一次儲存：觸發整列所有存檔鈕（日期 + 文字），排除「引用前月」
    $(".btn-save-row").off('click').on('click', function () {
        var $row = $(this).closest('tr');
        $row.find('.btn-save-dt, .btn-save-txt').each(function () {
            $(this).trigger('click');
        });
    });

    // 攔截分頁點擊事件 (AJAX Loading)
    $(".ajax-pager a").on('click', function(e) {
        e.preventDefault();
        var url = $(this).attr('href');
        if(url) {
             $('#overlay').fadeIn();
             $("#tabContent").empty();
             $("#tabContent").load(url, function() {
                 $('#overlay').fadeOut();
             });
        }
    });
</script>