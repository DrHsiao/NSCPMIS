@model WCals.Models.CMETMSModels.PJCFORM
@{ Layout = null; }
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>系統資訊維護---</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <style>
        body { padding: 20px; font-size: 14px; background-color: #f8f9fa; }
        .bg-primary { background-color: #337ab7 !important; }
        .card { border-color: #337ab7; }

        

        
    </style>
</head>
<body class="container-fluid">
    @using(Html.BeginForm("SaveSYSInfo", "SYS0030", FormMethod.Post, new { id = "mainForm", enctype = "multipart/form-data" }))
    {
        @Html.HiddenFor(m => m.PJ_ID)

  if(!string.IsNullOrEmpty(ViewBag.Message as string))
   {
         <div class="alert alert-info">
         <strong>@ViewBag.Message</strong>
     </div>
        }

        if(ViewBag.Mode == "copy") {
            <div class="alert alert-warning">
                <strong>複製模式：</strong>您正在複製一筆資料，請修改造冊編碼後儲存為新資料。
            </div>
        }

        <!-- 基本資料 -->
        <div class="card shadow-sm border-primary mb-4">
            <div class="card-header bg-primary text-white fw-bold">基本資料**</div>
            <div class="card-body">
                <div class="row mb-3 align-items-center">
                    <label class="col-sm-2 col-form-label fw-bold">造冊編碼</label>
                    <div class="col-sm-10">
                        @Html.TextBoxFor(m => m.SER_FN_1, new { @class = "form-control", maxlength = "3", style = "width:60px;display:inline-block;margin-right:5px;" })
                        <span> - </span>
                        @Html.TextBoxFor(m => m.SER_FN_2, new { @class = "form-control", maxlength = "5", style = "width:90px;display:inline-block;margin:0 5px;" })
                        <span> - </span>
                        @Html.TextBoxFor(m => m.SER_FN_3, new { @class = "form-control", maxlength = "3", style = "width:60px;display:inline-block;margin:0 5px;" })
                        <span> - </span>
                        @Html.TextBoxFor(m => m.SER_FN_4, new { @class = "form-control", maxlength = "2", style = "width:50px;display:inline-block;margin:0 5px;" })
                        @Html.TextBoxFor(m => m.SER_FN_5, new { @class = "form-control", maxlength = "2", style = "width:50px;display:inline-block;margin:0 5px;" })
                        @Html.TextBoxFor(m => m.SER_FN_6, new { @class = "form-control", maxlength = "2", style = "width:50px;display:inline-block;margin:0 5px;" })
                        @Html.TextBoxFor(m => m.SER_FN_7, new { @class = "form-control", maxlength = "2", style = "width:50px;display:inline-block;margin-left:5px;" })
                    </div>
                </div>

                <div class="row mb-3 align-items-center">
                    <label class="col-sm-2 col-form-label fw-bold">縣市 <span class="text-danger">*</span></label>
                    <div class="col-sm-4">
                        @Html.DropDownListFor(m => m.SER_CITY, (SelectList)ViewBag.cities, "請選擇", new { @class = "form-control", required = "required", Onchange = "GetSystemsByCity(this.value)" })
                    </div>
                    <label class="col-sm-2 col-form-label fw-bold">文件名稱</label>
                    <div class="col-sm-4">
                        @Html.TextBoxFor(m => m.PJ_NAME, new { @class = "form-control" })
                    </div>
                </div>

                <div class="row mb-3 align-items-center">
                    <label class="col-sm-2 col-form-label fw-bold">污水下水道系統 <span class="text-danger">*</span></label>
                    <div class="col-sm-10">
                        @Html.DropDownListFor(m => m.SYS_ID, (SelectList)ViewBag.systems, "請選擇", new { @class = "form-control", required = "required" })
                    </div>
                </div>

                <div class="row mb-3 align-items-center">
                    <label class="col-sm-2 col-form-label fw-bold">文件類別 <span class="text-danger">*</span></label>
                    <div class="col-sm-10">
                        @Html.DropDownListFor(m => m.PJ_ID_TYPE, new SelectList(new[] {
                             new { Value = "A", Text = "A:規劃報告" },
                              new { Value = "C", Text = "C:實施計畫" }
                      }, "Value", "Text"), "請選擇", new { @class = "form-control", required = "required" })
                    </div>
                 </div>

                <div class="row mb-3 align-items-center">
                    <label class="col-sm-2 col-form-label fw-bold">鄉鎮市或計畫區名稱</label>
                    <div class="col-sm-10">
                        @Html.TextBoxFor(m => m.PJ_AREA_NAME, new { @class = "form-control" })
                    </div>
                </div>

                <div class="row mb-3 align-items-center">
                    <label class="col-sm-2 col-form-label fw-bold">核定日期</label>
                    <div class="col-sm-4">
                        @Html.TextBoxFor(m => m.CHK_DT, new { @class = "form-control", maxlength = "10" })
                    </div>
                    <label class="col-sm-2 col-form-label fw-bold">核定文號</label>
                    <div class="col-sm-4">
                        @Html.TextBoxFor(m => m.CHK_FN, new { @class = "form-control" })
                    </div>
                </div>

                <div class="row mb-3 align-items-center">
                    <label class="col-sm-2 col-form-label fw-bold">計畫目標年</label>
                    <div class="col-sm-4">
                        @Html.TextBoxFor(m => m.PJ_YEAR, new { @class = "form-control", maxlength = "3" })
                        <span>(民國年)</span>
                    </div>
                    <label class="col-sm-2 col-form-label fw-bold">主辦機關</label>
                    <div class="col-sm-4">
                        @Html.TextBoxFor(m => m.ADM_NAME, new { @class = "form-control", maxlength = "20" })
                    </div>
                </div>

                <div class="row mb-3 align-items-center">
                    <label class="col-sm-2 col-form-label fw-bold">興建期分期</label>
                    <div class="col-sm-4">
                        @Html.TextBoxFor(m => m.PJ_SEQ, new { @class = "form-control", maxlength = "3" })
                    </div>
                    <label class="col-sm-2 col-form-label fw-bold">第一期興建期</label>
                    <div class="col-sm-4">
                        @Html.TextBoxFor(m => m.PJ_FIRST, new { @class = "form-control", maxlength = "3" })
                        <span>(民國年)</span>
                    </div>
                </div>

                <div class="row mb-3 align-items-center">
                    <label class="col-sm-2 col-form-label fw-bold">規劃面積</label>
                    <div class="col-sm-4">
                        @Html.TextBoxFor(m => m.PJ_AREA, new { @class = "form-control" })
                        <span>(公頃)</span>
                    </div>
                    <label class="col-sm-2 col-form-label fw-bold">計畫人口(人)數</label>
                    <div class="col-sm-4">
                        @Html.TextBoxFor(m => m.PJ_PEO, new { @class = "form-control" })
                        <span>(人)</span>
                    </div>
                </div>

                <div class="row mb-3 align-items-center">
                    <label class="col-sm-2 col-form-label fw-bold">計畫污水量</label>
                    <div class="col-sm-10">
                        @Html.TextBoxFor(m => m.PJ_WATER, new { @class = "form-control" })
                        <span>(CMD)</span>
                    </div>
                </div>

                <div class="row mb-3 align-items-center">
                    <label class="col-sm-2 col-form-label fw-bold">計畫污染量(流進 BOD)</label>
                    <div class="col-sm-4">
                        @Html.TextBoxFor(m => m.PJ_IN_BOD, new { @class = "form-control" })
                        <span>mg/L</span>
                    </div>
                    <label class="col-sm-2 col-form-label fw-bold">計畫污染量(流進 SS)</label>
                    <div class="col-sm-4">
                        @Html.TextBoxFor(m => m.PJ_IN_SS, new { @class = "form-control" })
                        <span>mg/L</span>
                    </div>
                </div>

                <div class="row mb-3 align-items-center">
                    <label class="col-sm-2 col-form-label fw-bold">計畫污染量(放流 BOD)</label>
                    <div class="col-sm-4">
                        @Html.TextBoxFor(m => m.PJ_OUT_BOD, new { @class = "form-control" })
                        <span>mg/L</span>
                    </div>
                    <label class="col-sm-2 col-form-label fw-bold">計畫污染量(放流 SS)</label>
                    <div class="col-sm-4">
                        @Html.TextBoxFor(m => m.PJ_OUT_SS, new { @class = "form-control" })
                        <span>mg/L</span>
                    </div>
                </div>

                <div class="row mb-3 align-items-center">
                    <label class="col-sm-2 col-form-label fw-bold">污水處理方式</label>
                    <div class="col-sm-10">
                        @Html.TextBoxFor(m => m.WATER_TYPE, new { @class = "form-control" })
                    </div>
                </div>

                <div class="row mb-3 align-items-center">
                    <label class="col-sm-2 col-form-label fw-bold">承受水體</label>
                    <div class="col-sm-10">
                        @Html.TextBoxFor(m => m.WATER_AREA, new { @class = "form-control" })
                    </div>
                </div>

                <div class="row mb-3 align-items-center">
                    <label class="col-sm-2 col-form-label fw-bold">污泥處置方式</label>
                    <div class="col-sm-10">
                        @Html.TextBoxFor(m => m.MUD_TYPE, new { @class = "form-control" })
                    </div>
                </div>
            </div>
        </div>

        <!-- 經費資料 -->
        <div class="card shadow-sm border-primary mb-4">
            <div class="card-header bg-primary text-white fw-bold">經費資料</div>
            <div class="card-body">
                <div class="row mb-3 align-items-center">
                    <label class="col-sm-2 col-form-label fw-bold">計畫內用地取得總經費</label>
                    <div class="col-sm-10">
                        @Html.TextBoxFor(m => m.PJ_FUND, new { @class = "form-control" })
                        <span>元</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 主次幹管與分支管網資料 -->
        <div class="card shadow-sm border-primary mb-4">
            <div class="card-header bg-primary text-white fw-bold">主次幹管與分支管網資料</div>
            <div class="card-body">
                <div class="row mb-3 align-items-center">
                    <label class="col-sm-2 col-form-label fw-bold">主次幹管</label>
                    <div class="col-sm-4">
                        @Html.TextBoxFor(m => m.MAIN_PIPO, new { @class = "form-control" })
                        <span>公尺</span>
                    </div>
                    <label class="col-sm-2 col-form-label fw-bold">分支管網長度</label>
                    <div class="col-sm-4">
                        @Html.TextBoxFor(m => m.BRANCH_PIPO, new { @class = "form-control" })
                        <span>公尺</span>
                    </div>
                </div>
                <div class="row mb-3 align-items-center">
                    <label class="col-sm-2 col-form-label fw-bold">BOT經費</label>
                    <div class="col-sm-4">
                        @Html.TextBoxFor(m => m.PIPO_BOT_FUND, new { @class = "form-control" })
                        <span>(元)</span>
                    </div>
                    <label class="col-sm-2 col-form-label fw-bold">政府自辦經費</label>
                    <div class="col-sm-4">
                        @Html.TextBoxFor(m => m.PIPO_SELF_FUND, new { @class = "form-control" })
                        <span>(元)</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 用戶接管資料 -->
        <div class="card shadow-sm border-primary mb-4">
            <div class="card-header bg-primary text-white fw-bold">用戶接管資料</div>
            <div class="card-body">
                <div class="row mb-3 align-items-center">
                    <label class="col-sm-2 col-form-label fw-bold">用戶接管數(BOT)</label>
                    <div class="col-sm-4">
                        @Html.TextBoxFor(m => m.USER_BOT, new { @class = "form-control" })
                        <span>(戶)</span>
                    </div>
                    <label class="col-sm-2 col-form-label fw-bold">用戶接管數(政府自辦)</label>
                    <div class="col-sm-4">
                        @Html.TextBoxFor(m => m.USER_SELF, new { @class = "form-control" })
                        <span>(戶)</span>
                    </div>
                </div>
                <div class="row mb-3 align-items-center">
                    <label class="col-sm-2 col-form-label fw-bold">BOT經費</label>
                    <div class="col-sm-4">
                        @Html.TextBoxFor(m => m.USER_BOT_FUND, new { @class = "form-control" })
                        <span>(元)</span>
                    </div>
                    <label class="col-sm-2 col-form-label fw-bold">政府自辦經費</label>
                    <div class="col-sm-4">
                        @Html.TextBoxFor(m => m.USER_SELF_FUND, new { @class = "form-control" })
                        <span>(元)</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 汙水處理廠資料 -->
        <div class="card shadow-sm border-primary mb-4">
            <div class="card-header bg-primary text-white fw-bold">汙水處理廠資料</div>
            <div class="card-body">
                <div class="row mb-3 align-items-center">
                    <label class="col-sm-2 col-form-label fw-bold">汙水處理廠</label>
                    <div class="col-sm-10">
                        @Html.TextBoxFor(m => m.SEWAGE_NUM, new { @class = "form-control", maxlength = "3" })
                        <span>(座)</span>
                    </div>
                </div>
                <div class="row mb-3 align-items-center">
                    <label class="col-sm-2 col-form-label fw-bold">用地面積</label>
                    <div class="col-sm-4">
                        @Html.TextBoxFor(m => m.SEWAGE_AREA, new { @class = "form-control" })
                        <span>(公頃)</span>
                    </div>
                    <label class="col-sm-2 col-form-label fw-bold">用地費</label>
                    <div class="col-sm-4">
                        @Html.TextBoxFor(m => m.SEWAGE_LAND_FUND, new { @class = "form-control" })
                        <span>(元)</span>
                    </div>
                </div>
                <div class="row mb-3 align-items-center">
                    <label class="col-sm-2 col-form-label fw-bold">設計量</label>
                    <div class="col-sm-4">
                        @Html.TextBoxFor(m => m.SEWAGE_CMD, new { @class = "form-control" })
                        <span>(CMD)</span>
                    </div>
                    <label class="col-sm-2 col-form-label fw-bold">建設費</label>
                    <div class="col-sm-4">
                        @Html.TextBoxFor(m => m.SEWAGE_BUILD_FUND, new { @class = "form-control" })
                        <span>(元)</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 揚水站資料 -->
        <div class="card shadow-sm border-primary mb-4">
            <div class="card-header bg-primary text-white fw-bold">揚水站資料</div>
            <div class="card-body">
                <div class="row mb-3 align-items-center">
                    <label class="col-sm-2 col-form-label fw-bold">揚水站</label>
                    <div class="col-sm-10">
                        @Html.TextBoxFor(m => m.PUMPING_NUM, new { @class = "form-control", maxlength = "3" })
                        <span>(座)</span>
                    </div>
                </div>
                <div class="row mb-3 align-items-center">
                    <label class="col-sm-2 col-form-label fw-bold">用地面積</label>
                    <div class="col-sm-4">
                        @Html.TextBoxFor(m => m.PUMPING_AREA, new { @class = "form-control" })
                        <span>(公頃)</span>
                    </div>
                    <label class="col-sm-2 col-form-label fw-bold">用地費</label>
                    <div class="col-sm-4">
                        @Html.TextBoxFor(m => m.PUMPING_LAND_FUND, new { @class = "form-control" })
                        <span>(元)</span>
                    </div>
                </div>
                <div class="row mb-3 align-items-center">
                    <label class="col-sm-2 col-form-label fw-bold">設計量(CMD)</label>
                    <div class="col-sm-4">
                        @Html.TextBoxFor(m => m.PUMPING_CMD, new { @class = "form-control" })
                    </div>
                    <label class="col-sm-2 col-form-label fw-bold">建設費(元)</label>
                    <div class="col-sm-4">
                        @Html.TextBoxFor(m => m.PUMPING_BUILD_FUND, new { @class = "form-control" })
                    </div>
                </div>
            </div>
        </div>

        <!-- 截流站資料 -->
        <div class="card shadow-sm border-primary mb-4">
            <div class="card-header bg-primary text-white fw-bold">截流站資料</div>
            <div class="card-body">
                <div class="row mb-3 align-items-center">
                    <label class="col-sm-2 col-form-label fw-bold">截流站(座)</label>
                    <div class="col-sm-10">
                        @Html.TextBoxFor(m => m.CUT_NUM, new { @class = "form-control", maxlength = "3" })
                    </div>
                </div>
                <div class="row mb-3 align-items-center">
                    <label class="col-sm-2 col-form-label fw-bold">設計量(CMD)</label>
                    <div class="col-sm-4">
                        @Html.TextBoxFor(m => m.CUT_CMD, new { @class = "form-control" })
                    </div>
                    <label class="col-sm-2 col-form-label fw-bold">建設費(元)</label>
                    <div class="col-sm-4">
                        @Html.TextBoxFor(m => m.CUT_BUILD_FUND, new { @class = "form-control" })
                    </div>
                </div>
            </div>
        </div>

        <!-- 總工程費概況 -->
        <div class="card shadow-sm border-primary mb-4">
            <div class="card-header bg-primary text-white fw-bold">總工程費概況</div>
            <div class="card-body">
                <div class="row mb-3 align-items-center">
                    <label class="col-sm-2 col-form-label fw-bold">總工程費(民間機構總投資金額，不含重置費)(元)</label>
                    <div class="col-sm-10">
                        @Html.TextBoxFor(m => m.TD_ALL_FUND, new { @class = "form-control" })
                    </div>
                </div>
                <div class="row mb-3 align-items-center">
                    <label class="col-sm-2 col-form-label fw-bold">特許期間政府支付污水處理費上限(當年值)(元)</label>
                    <div class="col-sm-10">
                        @Html.TextBoxFor(m => m.PUMPING_FUND, new { @class = "form-control" })
                    </div>
                </div>
                <div class="row mb-3 align-items-center">
                    <label class="col-sm-2 col-form-label fw-bold">特許期間固定及變動操作維護費上限(當年值)(元)</label>
                    <div class="col-sm-10">
                        @Html.TextBoxFor(m => m.WORK_FUND, new { @class = "form-control" })
                    </div>
                </div>
                <div class="row mb-3 align-items-center">
                    <label class="col-sm-2 col-form-label fw-bold">物價基準年</label>
                    <div class="col-sm-4">
                        @Html.TextBoxFor(m => m.PRICES_YEAR, new { @class = "form-control", maxlength = "3" })
                        <span>民國年</span>
                    </div>
                    <label class="col-sm-2 col-form-label fw-bold">特許年限</label>
                    <div class="col-sm-4">
                        @Html.TextBoxFor(m => m.OVER_YEAR, new { @class = "form-control", maxlength = "3" })
                        <span>民國年</span>
                    </div>
                </div>
                <div class="row mb-3 align-items-center">
                    <label class="col-sm-2 col-form-label fw-bold">備註</label>
                    <div class="col-sm-10">
                        @Html.TextAreaFor(m => m.SER_NOTE, new { @class = "form-control", rows = "5" })
                    </div>
                </div>
            </div>
        </div>

        <!-- 檔案上傳區塊 -->
      <div class="card shadow-sm border-primary mb-4">
      <div class="card-header bg-primary text-white fw-bold">附件上傳</div>
       <div class="card-body">
 <div class="row mb-3 align-items-center">
 <div class="col-sm-12">
            <input type="file" name="files" multiple class="form-control" style="height: auto;" accept="*/*" />
           <small class="text-muted">可同時選擇多個檔案上傳（單檔上限 100MB）</small>
           </div>
          </div>
  
      <div class="row mb-3 align-items-center">
   <div class="col-sm-12">
       <h4>已上傳檔案</h4>
   <table class="table table-hover" id="fileListTable">
           <thead>
   <tr>
<th style="width: 50%;">檔案名稱</th>
   <th style="width: 15%;">檔案大小(KB)</th>
  <th style="width: 20%;">上傳日期</th>
      <th style="width: 15%;">操作</th>
  </tr>
    </thead>
    <tbody id="fileListBody">
  @{
      var db = new WCals.Models.CMETMSModels.CMETMSEntities();
var files = db.PJCFILE.Where(x => x.PJ_ID == Model.PJ_ID).OrderByDescending(x => x.ADD_DT).ToList();
  if(files.Count == 0) {
   <tr><td colspan="4" class="text-center">尚無上傳檔案</td></tr>
   } else {
    foreach(var file in files) {
          <tr>
              <td>@file.FILE_NAME, @file.FILE_ID</td>
  <td class="text-right">@(file.FILE_SIZE.HasValue ? file.FILE_SIZE.Value.ToString("N2") : "0")</td>
 <td>@(file.ADD_DT.HasValue ? file.ADD_DT.Value.ToString("yyyy/MM/dd HH:mm") : "")</td>
    <td>
    <a href="@Url.Action("DownloadFile", "SYS0030", new { fileId = file.FILE_ID })" class="btn btn-sm btn-info">下載</a>
      <button type="button" class="btn btn-sm btn-danger" onclick="DeleteFile('@file.FILE_ID');">刪除*</button>
   </td>
   </tr>
      }
         }
      }
     </tbody>
    </table>
 </div>
   </div>
    </div>
        </div>

  <!-- 按鈕 -->
        <div class="row mb-3 align-items-center">
            <div class="col-sm-offset-2 col-sm-10">
   @if(!string.IsNullOrEmpty(Model.PJ_ID) && ViewBag.Mode != "copy") {
        <button type="button" onclick="return DeleteRecord();" class="btn btn-danger">刪除</button>
     }
      <button type="submit" class="btn btn-primary" name="action" value="SaveSYSInfo">確定儲存</button>
 <button type="button" onclick="CloseDialog();" class="btn btn-outline-secondary">關閉</button>
            </div>
        </div>
  }

    <script>
      // 系統別與縣市別連動 (3.1.7 需求)：使用者切換縣市時重新載入對應系統別
      function GetSystemsByCity(city) {
          var $sys = $('#SYS_ID');
          $.getJSON('@Url.Action("GetSystemsByCity", "SYS0030")', { city: city }, function (data) {
              $sys.empty();
              $sys.append('<option value="">請選擇</option>');
              $.each(data, function (i, item) {
                  $sys.append($('<option></option>').val(item.SYS_ID).text(item.SYS_NAME));
              });
          });
      }

