@using PagedList.Mvc
@model WCals.ViewModels.NewModels.TDE0040Model
@{
    ViewBag.Title = "計畫經費來源";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script type="text/javascript" src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <title>@ViewBag.Title - My ASP.NET Application</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="~/Scripts/modernizr-2.8.3.js"></script>
    <link href="https://code.jquery.com/ui/1.14.1/themes/base/jquery-ui.css" rel="stylesheet" />
    <style>
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
        }

        body {
            padding: 5px;
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
        }

        #mainForm {
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 0;
        }

        .card {
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 0;
            margin-bottom: 10px;
        }

        .card-body {
            flex: 1;
            overflow-y: auto;
            min-height: 0;
        }

        .form-group {
            flex-shrink: 0;
        }

        .table-responsive {
            overflow-x: auto;
        }

        .locked {
            color: #d9534f;
            font-weight: bold;
        }

        .unlocked {
            color: #5cb85c;
        }
    
        /* 表格框線與排版美化 */
        .table-bordered { border: 0 !important; }
        .table-bordered th, .table-bordered td { border: 0 !important; border-bottom: 1px solid #e2e8f0 !important; }
        .table > thead > tr > th { 
            border-bottom: 2px solid #337ab7 !important; 
            background-color: #f8fafc; 
            color: #334155; 
        }
        .table > tbody > tr:last-child > td { border-bottom: 0 !important; }
</style>
</head>
<body>
    @using(Html.BeginForm("PAGE2_1", "TDE0042", FormMethod.Post, new { data_toggle = "validator", role = "form", id = "mainForm", enctype = "multipart/form-data" })) {

        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.TD_CODE)

        <div class="card shadow-sm border-0 mb-4 h-100">
            <div class="card-header bg-primary text-white fw-bold">
                <strong>@Model.TDMFORM.TD_NAME</strong> - 計畫經費來源
            </div>

            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr style="background-color: #5599dd; color: white;">
                                <th style="text-align: center;">年度</th>
                                <th>計畫名稱</th>
                                <th>承辦單位</th>
                                <th style="text-align: center;">期別</th>
                                <th style="text-align: right;">年度預算金額(元)</th>
                                <th style="text-align: right;">年度中央款金額(元)</th>
                                <th style="text-align: center;">經費鎖定</th>
                                <th style="text-align: center;">操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if(ViewBag.List1 != null && ViewBag.List1.Rows.Count > 0) {
                                foreach(System.Data.DataRow row in ViewBag.List1.Rows) {
                                    string flockFg = row["FLOCK_FG"] != DBNull.Value ? row["FLOCK_FG"].ToString() : "0";
                                    bool isLocked = flockFg == "1";
                                    string yrFund = row["YR_FUND"] != DBNull.Value ? Convert.ToDecimal(row["YR_FUND"]).ToString("N0") : "0";
                                    string cenFund = row["CEN_FUND"] != DBNull.Value ? Convert.ToDecimal(row["CEN_FUND"]).ToString("N0") : "0";

                                    <tr>
                                        @* 3.1.4rev：年度欄原本串出 SYR,PID,TID(如「097 ,14, 875」)，業主要求只留年度 *@
                                        <td style="text-align: center;">@row["SYR"]</td>
                                        <td>@row["PJ_NAME"]</td>
                                        <td>@row["ADV_DP_NAME"]</td>
                                        <td style="text-align: center;">@row["SEQ_NAME"]</td>
                                        <td style="text-align: right;">@yrFund</td>
                                        <td style="text-align: right;">@cenFund</td>
                                        <td style="text-align: center;">
                                            @if(isLocked) {
                                                <span class="locked">已鎖定</span>
                                            } else {
                                                <span class="unlocked">未鎖定</span>
                                            }
                                        </td>
                                        <td style="text-align: center;" nowrap>
                                            <button type="button" class="btn btn-primary btn-sm" onclick="top.open2_1_1('@row["PID"]', '@row["TID"]', '@WCals.Helpers.WebSiteHelper.getUserId()', '@row["TD_CODE"]')" @(isLocked ? "disabled" : "")>
                                                預算分配
                                            </button>
                                            @* 3.1.4rev：業主指示「進入畫面中央款分配數不需要」，移除此鈕
                                               (top.open2_1_2 與 #PAGE2_1_2 對話框保留，供預算分配頁內的月分配數使用) *@
                                        </td>
                                    </tr>
                                }
                            } else {
                                <tr>
                                    <td colspan="8" style="text-align: center;">無資料</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="form-group">
            @*<button type="button" class="btn btn-success" onclick="addFund();">新增經費來源</button>*@
            <button type="button" class="btn btn-outline-secondary shadow-sm" onclick="top.close2();"><i class="fa-solid fa-xmark me-1"></i> 關閉</button>
        </div>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/ui/1.14.1/jquery-ui.min.js"></script>
    <script>
    var TD_CODE = '@Model.TD_CODE';

 // 編輯經費
        function editFund(pid, tid, tdCode) {
   // TODO: 實作編輯功能，可開啟編輯視窗或導向編輯頁面
     if (typeof top.open2_1_Edit === 'function') {
    top.open2_1_Edit(pid, tid, tdCode);
        } else {
     alert('編輯功能：PID=' + pid + ', TID=' + tid + ', TD_CODE=' + tdCode);
            }
    }

  // 查看明細
        function viewDetail(pid, tid, tdCode) {
       // TODO: 實作查看明細功能
   if (typeof top.open2_1_Detail === 'function') {
           top.open2_1_Detail(pid, tid, tdCode);
            } else {
    alert('查看明細：PID=' + pid + ', TID=' + tid + ', TD_CODE=' + tdCode);
            }
    }

        // 新增經費來源
        function addFund() {
            var url = '@Url.Action("PAGE2_1_Add", "TDE0042")?TD_CODE=' + encodeURIComponent(TD_CODE);
            if (typeof top.open2_1_Add === 'function') {
                top.open2_1_Add(TD_CODE);
            } else {
                // 開啟新視窗
                var width = 600;
                var height = 500;
                var left = (screen.width - width) / 2;
                var top_ = (screen.height - height) / 2;
                window.open(url, 'addFund', 'width=' + width + ',height=' + height + ',left=' + left + ',top=' + top_ + ',resizable=yes,scrollbars=yes');
            }
        }

        // 重新載入列表（供子視窗呼叫）
        function refreshList() {
            location.reload();
        }
    </script>
</body>
</html>
