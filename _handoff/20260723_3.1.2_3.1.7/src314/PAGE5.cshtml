@using PagedList.Mvc

@model WCals.ViewModels.NewModels.TDE0040Model

@{ ViewBag.Title = "工程登記冊編輯";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <script type="text/javascript" src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://code.jquery.com/ui/1.14.1/themes/base/jquery-ui.css" rel="stylesheet" />
    <style>

        /* === 全視窗高度 flex 佈局 === */
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
            overflow: hidden;
        }

        body {
            padding: 8px;
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
        }

        /* form 撐滿 body */
        #mainForm {
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 0;
        }

        /* form 的第一層 div 撐滿 */
        #mainForm > div {
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 0;
        }

        /* === BS5 card 撐滿 === */
        .with-nav-tabs {
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 0;
            margin-bottom: 0;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
        }

        .with-nav-tabs .card-header {
            flex-shrink: 0;
            background: linear-gradient(135deg, #337ab7, #286090);
            padding-top: 10px;
            padding-bottom: 0;
            border-bottom: none;
        }

        .with-nav-tabs .card-body {
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 0;
            padding: 0;
            overflow: hidden;
            background-color: #ffffff;
        }

        /* tab-content 撐滿 card-body */
        .tab-content {
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 0;
        }

        /* 非 active tab-pane 隱藏 */
        .tab-pane {
            flex: 1;
            display: none;
            min-height: 0;
        }

        .tab-pane.show.active {
            display: flex;
            flex-direction: column;
        }

        /* iframe 撐滿 tab-pane */
        .tab-pane iframe {
            flex: 1;
            width: 100%;
            border: 0;
            min-height: 0;
        }

        /* 頁籤樣式 */
        .card-header-tabs {
            margin-bottom: -1px;
        }

        .card-header-tabs .nav-link {
            border: 1px solid transparent;
            border-top-left-radius: 6px;
            border-top-right-radius: 6px;
            padding: 10px 18px;
            transition: background-color 0.15s;
        }

        .card-header-tabs .nav-link:not(.active) {
            color: #ffffff !important;
            opacity: 0.85;
        }

        .card-header-tabs .nav-link:not(.active):hover {
            opacity: 1;
            color: #ffffff !important;
            background-color: rgba(255, 255, 255, 0.12);
        }

        .card-header-tabs .nav-link.active {
            color: #286090 !important;
            font-weight: bold;
            background-color: #ffffff;
            border-color: #dee2e6 #dee2e6 #ffffff;
        }

    </style>
    <link href="~/Content/bs3-compat.css" rel="stylesheet" />
</head>
<body>

    @using(Html.BeginForm("PAGE5", "TDE0045", FormMethod.Post, new { role = "form", id = "mainForm", enctype = "multipart/form-data" })) {

        @Html.AntiForgeryToken()

        <div>
            <div class="card border-0 with-nav-tabs">

                <div class="card-header px-3">
                    <ul class="nav nav-tabs card-header-tabs border-0" role="tablist">
                        <li id="li1" role="presentation" class="nav-item">
                            <button type="button" class="nav-link active" data-bs-target="#tab1" aria-controls="tab1" role="tab" data-bs-toggle="tab">
                                <i class="fa-solid fa-file-lines me-1"></i>工作控制點
                            </button>
                        </li>
                        <li id="li2" role="presentation" class="nav-item">
                            <button type="button" class="nav-link" data-bs-target="#tab2" aria-controls="tab2" role="tab" data-bs-toggle="tab" onclick="ch2('@Model.TD_CODE');">
                                <i class="fa-solid fa-calendar-days me-1"></i>辦理情形及施工進度
                            </button>
                        </li>
                        <li id="li3" role="presentation" class="nav-item">
                            <button type="button" class="nav-link" data-bs-target="#tab3" aria-controls="tab3" role="tab" data-bs-toggle="tab" onclick="ch3('@Model.TD_CODE');">
                                <i class="fa-solid fa-list-check me-1"></i>地方預算執行數填報
                            </button>
                        </li>
                    </ul>
                </div>

                <div class="card-body">
                    <div class="tab-content">
                        <div class="tab-pane fade show active" id="tab1">
                            <iframe id="t1" src="@Url.Content("~/TDE0045/")PAGE5_1?TD_CODE=@Model.TD_CODE"></iframe>
                        </div>
                        <div class="tab-pane fade" id="tab2">
                            <iframe id="t2" src=""></iframe>
                        </div>
                        <div class="tab-pane fade" id="tab3">
                            <iframe id="t3" src=""></iframe>
                        </div>
                    </div>
                </div>

            </div>
        </div>

    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function ch2(tdcode) {
            $("#t2").attr("src", "@Url.Content("~/TDE0045/")PAGE5_2?TD_CODE=" + tdcode);
        }

        function ch3(tdcode) {
            $("#t3").attr("src", "@Url.Content("~/TDE0045/")PAGE5_3?TD_CODE=" + tdcode);
        }
    </script>

</body>
</html>