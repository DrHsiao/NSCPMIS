@model WCals.ViewModels.NewModels.TDE0040Model
@{
    ViewBag.Title = "驗收紀錄";
    Layout = null;

    System.Data.DataTable dtList = ViewBag.List1 as System.Data.DataTable;
    System.Data.DataTable dtRecTp = ViewBag.RecTpList as System.Data.DataTable;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script type="text/javascript" src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <title>@ViewBag.Title</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://code.jquery.com/ui/1.14.1/themes/base/jquery-ui.css" rel="stylesheet" />
    <style>
        body {
            padding: 10px;
        }
        .section-header {
            background-color: #f5f5f5;
            border-left: 4px solid #0275d8;
            padding: 10px 15px;
            margin-top: 20px;
            margin-bottom: 15px;
            font-weight: bold;
            font-size: 14px;
        }
        .table th {
            background-color: #558DCC;
            color: white;
            text-align: center;
            font-size: 12px;
        }
        .table td {
            font-size: 12px;
            vertical-align: middle;
        }
        .form-control-sm {
            font-size: 12px;
            padding: 2px 5px;
            height: 28px;
        }
        textarea.form-control-sm {
            height: auto;
        }
        .btn-sm {
            font-size: 11px;
            padding: 3px 8px;
        }
        .add-row {
            background-color: #f9f9f9;
        }
        .add-row td {
            padding: 8px 4px;
        }
        .required-field {
            color: red;
        }
        .dt {
            width: 85px !important;
        }
        .ui-datepicker { z-index: 2200 !important; background: #ffffff; border: 1px solid #cccccc; border-radius: 4px; }
    
        /* 表格框線與排版美化 */
        .table-bordered { border: 0 !important; }
        .table-bordered th, .table-bordered td { border: 0 !important; border-bottom: 1px solid #e2e8f0 !important; }
        .table > thead > tr > th { 
            border-bottom: 2px solid #337ab7 !important; 
            background-color: #f8fafc; 
            color: #334155; 
        }
        .table > tbody > tr:last-child > td { border-bottom: 0 !important; }
</style>
</head>
<body>
    <div id="messageDiv"></div>

    <button type="button" onclick="top.closePage6_3();" class="btn btn-outline-secondary shadow-sm"><i class="fa-solid fa-xmark me-1"></i> 關閉</button>

    <h4 class="page-header">驗收紀錄</h4>
    <p>工程編號：@ViewBag.TD_CODE</p>

    <div class="section-header">驗收紀錄列表</div>

    <div class="table-responsive">
        <table class="table table-sm" id="dataTable">
            <thead>
                <tr>
                    <th style="width: 80px;">類別</th>
                    <th style="width: 50px;">次數</th>
                    <th style="width: 90px;"><span class="required-field">*</span>驗收日</th>
                    <th style="width: 90px;">合格日</th>
                    <th style="width: 80px;">驗收人</th>
                    <th style="width: 80px;">會驗人員</th>
                    <th style="width: 80px;">監驗人</th>
                    <th style="width: 100px;">核准驗收文號</th>
                    <th style="width: 120px;">驗收意見</th>
                    <th style="width: 120px;">不合格原因</th>
                    <th style="width: 120px;">其它事項</th>
                    <th style="width: 100px;">操作</th>
                </tr>
            </thead>
            <tbody id="dataBody">
                <tr class="add-row">
                    <td>
                        <select id="new_REC_TP" class="form-control form-control-sm" onchange="getNextSeqNo();">
                            <option value="">請選擇</option>
                            @if(dtRecTp != null) {
                                foreach(System.Data.DataRow row in dtRecTp.Rows) {
                                    string code = row["CATY_COD"].ToString();
                                    string desc = row["CODE_DESC"].ToString();
                                    <option value="@code">@desc</option>
                                }
                            }
                        </select>
                    </td>
                    <td style="text-align: center;"><span id="new_SEQ_NO">1</span></td>
                    <td><input type="text" id="new_ACPCHK_DT" class="form-control form-control-sm dt" /></td>
                    <td><input type="text" id="new_ACPPASS_DT" class="form-control form-control-sm dt" /></td>
                    <td><input type="text" id="new_ACP_USR" class="form-control form-control-sm" /></td>
                    <td><input type="text" id="new_JON_USR" class="form-control form-control-sm" /></td>
                    <td><input type="text" id="new_CHK_USR" class="form-control form-control-sm" /></td>
                    <td><input type="text" id="new_ACPPASS_FN" class="form-control form-control-sm" /></td>
                    <td><textarea id="new_ACP_NOTE" class="form-control form-control-sm" rows="2"></textarea></td>
                    <td><textarea id="new_UNOK_RESN" class="form-control form-control-sm" rows="2"></textarea></td>
                    <td><textarea id="new_OTHE_RESN" class="form-control form-control-sm" rows="2"></textarea></td>
                    <td style="text-align: center;">
                        <button type="button" class="btn btn-success btn-sm" onclick="addRow();">新增</button>
                    </td>
                </tr>
                @if(dtList != null && dtList.Rows.Count > 0) {
                    foreach(System.Data.DataRow row in dtList.Rows) {
                        string recTp = row["REC_TP"] != DBNull.Value ? row["REC_TP"].ToString() : "";
                        string recTpDesc = row["REC_TP_DESC"] != DBNull.Value ? row["REC_TP_DESC"].ToString() : "";
                        int seqNo = row["SEQ_NO"] != DBNull.Value ? Convert.ToInt32(row["SEQ_NO"]) : 0;
                        @* TDDACPR.ACPCHK_DT / ACPPASS_DT 為 varchar(7) 民國日期字串(如 0980213)，
                           不可用 Convert.ToDateTime 轉型(會拋「字串未被辨認為有效的 DateTime」)。
                           存檔端亦是存原字串，故此處直接輸出，與估驗進度(ECC_DT)的既有作法一致。 *@
                        string acpchkDt = row["ACPCHK_DT"] != DBNull.Value ? row["ACPCHK_DT"].ToString().Trim() : "";
                        string acppassDt = row["ACPPASS_DT"] != DBNull.Value ? row["ACPPASS_DT"].ToString().Trim() : "";
                        string acpUsr = row["ACP_USR"] != DBNull.Value ? row["ACP_USR"].ToString() : "";
                        string jonUsr = row["JON_USR"] != DBNull.Value ? row["JON_USR"].ToString() : "";
                        string chkUsr = row["CHK_USR"] != DBNull.Value ? row["CHK_USR"].ToString() : "";
                        string acppassFn = row["ACPPASS_FN"] != DBNull.Value ? row["ACPPASS_FN"].ToString() : "";
                        string acpNote = row["ACP_NOTE"] != DBNull.Value ? row["ACP_NOTE"].ToString() : "";
                        string unokResn = row["UNOK_RESN"] != DBNull.Value ? row["UNOK_RESN"].ToString() : "";
                        string otheResn = row["OTHE_RESN"] != DBNull.Value ? row["OTHE_RESN"].ToString() : "";

                        <tr data-rectp="@recTp" data-seqno="@seqNo">
                            <td style="text-align: center;">@recTpDesc</td>
                            <td style="text-align: center;">@seqNo</td>
                            <td><input type="text" value="@acpchkDt" class="form-control form-control-sm dt edit-field" data-field="ACPCHK_DT" /></td>
                            <td><input type="text" value="@acppassDt" class="form-control form-control-sm dt edit-field" data-field="ACPPASS_DT" /></td>
                            <td><input type="text" value="@acpUsr" class="form-control form-control-sm edit-field" data-field="ACP_USR" /></td>
                            <td><input type="text" value="@jonUsr" class="form-control form-control-sm edit-field" data-field="JON_USR" /></td>
                            <td><input type="text" value="@chkUsr" class="form-control form-control-sm edit-field" data-field="CHK_USR" /></td>
                            <td><input type="text" value="@acppassFn" class="form-control form-control-sm edit-field" data-field="ACPPASS_FN" /></td>
                            <td><textarea class="form-control form-control-sm edit-field" data-field="ACP_NOTE" rows="2">@acpNote</textarea></td>
                            <td><textarea class="form-control form-control-sm edit-field" data-field="UNOK_RESN" rows="2">@unokResn</textarea></td>
                            <td><textarea class="form-control form-control-sm edit-field" data-field="OTHE_RESN" rows="2">@otheResn</textarea></td>
                            <td style="text-align: center;">
                                <button type="button" class="btn btn-primary btn-sm" onclick="updateRow(this);"><i class="fa-solid fa-floppy-disk me-1"></i> 儲存</button>
                                <button type="button" class="btn btn-danger btn-sm" onclick="deleteRow(this);">刪除</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <table class="table">
        <tr>
            <td>
                <button type="button" onclick="top.closePage6_3();" class="btn btn-outline-secondary shadow-sm"><i class="fa-solid fa-xmark me-1"></i> 關閉</button>
            </td>
        </tr>
    </table>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/ui/1.14.1/jquery-ui.min.js"></script>
    <script type="text/javascript" src="~/Scripts/jquery.datepick.js"></script>
    <script type="text/javascript" src="~/Scripts/MyDatepickerJ.js"></script>
    <script>
        var TD_CODE = '@Model.TD_CODE';

        // 日期選擇器初始化
        $(".dt").datepickerTW({
            changeYear: true,
            changeMonth: true,
            yearRange: '68:168',
            dateFormat: 'yymmdd'
        });

        $('.dt').click(function () {
            $(this).delay(600).val("");
        });

        function showMessage(type, message) {
            var alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
            var html = '<div class="alert ' + alertClass + ' alert-dismissible" role="alert">' +
                '<button type="button" class="btn-close shadow-none" data-bs-dismiss="alert" aria-label="Close"></button>' +
                message + '</div>';
            $('#messageDiv').html(html);
            setTimeout(function () {
                $('#messageDiv').html('');
            }, 3000);
        }

        // 取得下一個 SEQ_NO
        function getNextSeqNo() {
            var recTp = $('#new_REC_TP').val();
            if (!recTp) {
                $('#new_SEQ_NO').text('1');
                return;
            }
            $.ajax({
                url: '@Url.Action("PAGE6_3_GetNextSeqNo", "TDE0046")',
                type: 'POST',
                data: { TD_CODE: TD_CODE, REC_TP: recTp },
                success: function (result) {
                    if (result.success) {
                        $('#new_SEQ_NO').text(result.nextSeqNo);
                    }
                }
            });
        }

        // 新增資料
        function addRow() {
            var recTp = $('#new_REC_TP').val();
            var seqNo = parseInt($('#new_SEQ_NO').text()) || 1;
            var acpchkDt = $('#new_ACPCHK_DT').val();

            // 驗證必填欄位
            if (!recTp) {
                showMessage('error', '請選擇類別');
                return;
            }
            if (!acpchkDt) {
                showMessage('error', '請填寫驗收日');
                return;
            }

            $.ajax({
                url: '@Url.Action("PAGE6_3_Add", "TDE0046")',
                type: 'POST',
                data: {
                    TD_CODE: TD_CODE,
                    REC_TP: recTp,
                    SEQ_NO: seqNo,
                    ACPCHK_DT: acpchkDt,
                    ACP_USR: $('#new_ACP_USR').val(),
                    JON_USR: $('#new_JON_USR').val(),
                    CHK_USR: $('#new_CHK_USR').val(),
                    ACPPASS_DT: $('#new_ACPPASS_DT').val(),
                    ACPPASS_FN: $('#new_ACPPASS_FN').val(),
                    ACP_NOTE: $('#new_ACP_NOTE').val(),
                    UNOK_RESN: $('#new_UNOK_RESN').val(),
                    OTHE_RESN: $('#new_OTHE_RESN').val()
                },
                success: function (result) {
                    if (result.success) {
                        showMessage('success', result.message);
                        location.reload();
                    } else {
                        showMessage('error', result.message);
                    }
                },
                error: function (e) {
                    showMessage('error', '新增失敗：' + e.statusText);
                }
            });
        }

        // 更新資料
        function updateRow(btn) {
            var row = $(btn).closest('tr');
            var recTp = row.data('rectp');
            var seqNo = row.data('seqno');
            var acpchkDt = row.find('[data-field="ACPCHK_DT"]').val();

            // 驗證必填欄位
            if (!acpchkDt) {
                showMessage('error', '請填寫驗收日');
                return;
            }

            $.ajax({
                url: '@Url.Action("PAGE6_3_Update", "TDE0046")',
                type: 'POST',
                data: {
                    TD_CODE: TD_CODE,
                    REC_TP: recTp,
                    SEQ_NO: seqNo,
                    ACPCHK_DT: acpchkDt,
                    ACP_USR: row.find('[data-field="ACP_USR"]').val(),
                    JON_USR: row.find('[data-field="JON_USR"]').val(),
                    CHK_USR: row.find('[data-field="CHK_USR"]').val(),
                    ACPPASS_DT: row.find('[data-field="ACPPASS_DT"]').val(),
                    ACPPASS_FN: row.find('[data-field="ACPPASS_FN"]').val(),
                    ACP_NOTE: row.find('[data-field="ACP_NOTE"]').val(),
                    UNOK_RESN: row.find('[data-field="UNOK_RESN"]').val(),
                    OTHE_RESN: row.find('[data-field="OTHE_RESN"]').val()
                },
                success: function (result) {
                    if (result.success) {
                        showMessage('success', result.message);
                    } else {
                        showMessage('error', result.message);
                    }
                },
                error: function () {
                    showMessage('error', '更新失敗');
                }
            });
        }

        // 刪除資料
        function deleteRow(btn) {
            if (!confirm('確定要刪除此筆驗收紀錄嗎？')) {
                return;
            }

            var row = $(btn).closest('tr');
            var recTp = row.data('rectp');
            var seqNo = row.data('seqno');

            $.ajax({
                url: '@Url.Action("PAGE6_3_Delete", "TDE0046")',
                type: 'POST',
                data: {
                    TD_CODE: TD_CODE,
                    REC_TP: recTp,
                    SEQ_NO: seqNo
                },
                success: function (result) {
                    if (result.success) {
                        showMessage('success', result.message);
                        row.remove();
                    } else {
                        showMessage('error', result.message);
                    }
                },
                error: function () {
                    showMessage('error', '刪除失敗');
                }
            });
        }
    </script>
</body>
</html>
