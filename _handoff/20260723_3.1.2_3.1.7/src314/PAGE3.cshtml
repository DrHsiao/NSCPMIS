@using PagedList.Mvc
@model WCals.ViewModels.NewModels.TDE0040Model
@{ ViewBag.Title = "工程登記冊編輯";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script type="text/javascript" src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <title>@ViewBag.Title - My ASP.NET Application</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="~/Scripts/modernizr-2.8.3.js"></script>
    <link href="https://code.jquery.com/ui/1.14.1/themes/base/jquery-ui.css" rel="stylesheet" />

    <link rel="stylesheet" href="~/Scripts/plugins/bootstrap-fileinput/icon.mini.css" crossorigin="anonymous">
    <link href="~/Scripts/plugins/bootstrap-fileinput/fileinput.min.css" media="all" rel="stylesheet" type="text/css" />
    <style>
  html, body {
         height: 100%;
            margin: 0;
 padding: 0;
        }
        
   body {
   padding: 5px;
 box-sizing: border-box;
     display: flex;
   flex-direction: column;
        }
        
  #mainForm {
      flex: 1;
         display: flex;
flex-direction: column;
       min-height: 0;
      }
      
        #mainForm > div {
       flex: 1;
        display: flex;
    flex-direction: column;
      min-height: 0;
        }
      
  .card.with-nav-tabs {
    flex: 1;
     display: flex;
      flex-direction: column;
            min-height: 0;
 margin-bottom: 0;
        }
    
        .card-header {
            flex-shrink: 0;
        }
      
        .card-body {
 flex: 1;
            display: flex;
          flex-direction: column;
          min-height: 0;
        overflow: hidden;
            padding: 0;
        }
        
     .tab-content {
      flex: 1;
            display: flex;
            flex-direction: column;
       min-height: 0;
        }
        
   .tab-pane {
            flex: 1;
        display: none;
  min-height: 0;
      }
        
        .tab-pane.active {
      display: flex;
  flex-direction: column;
        }
        
        .tab-pane iframe {
         flex: 1;
            width: 100%;
            border: 0;
        min-height: 0;
}
    
        /* 頁籤顏色修正 */
        .card-header-tabs .nav-link:not(.active) {
            color: #ffffff !important;
            opacity: 0.85;
        }
        .card-header-tabs .nav-link:not(.active):hover {
            opacity: 1;
            color: #ffffff !important;
        }
        .card-header-tabs .nav-link.active {
            color: #337ab7 !important;
            font-weight: bold;
        }
    .ui-datepicker { z-index: 2200 !important; background: #ffffff; border: 1px solid #cccccc; border-radius: 4px; }
    </style>
    <link href="~/Content/bs3-compat.css" rel="stylesheet" />
</head>

<body>
    @using(Html.BeginForm("PAGE3", "TDE0043", FormMethod.Post, new { data_toggle = "validator", role = "form", id = "mainForm", enctype = "multipart/form-data" })) {

        @Html.AntiForgeryToken()
        <div>
         <div class="card shadow-sm border-0 mb-4 with-nav-tabs">
    <div class="card-header bg-primary text-white fw-bold">
        <ul class="nav nav-tabs card-header-tabs" role="tablist">
              <li id="li1" role="presentation"  class="nav-item"><button type="button" class="nav-link active" data-bs-target="#tab1"    aria-controls="tab1" role="tab"  data-bs-toggle="tab">預算資料</button></li>
        <li id="li2" role="presentation" class="nav-item"><button type="button" class="nav-link" data-bs-target="#tab2"    aria-controls="tab2" role="tab"  data-bs-toggle="tab">契約資料</button></li>
           <li id="li3" role="presentation" class="nav-item"><button type="button" class="nav-link" data-bs-target="#tab3"    aria-controls="tab3" role="tab"  data-bs-toggle="tab">結算資料</button></li>
         <li id="li4" role="presentation" class="nav-item"><button type="button" class="nav-link" data-bs-target="#tab4"    aria-controls="tab4" role="tab"  data-bs-toggle="tab">決算資料</button></li>
        </ul>
  </div>

        <div class="card-body">
      <div class="tab-content">
       <!-- Tab1 panes -->
 <div class="tab-pane fade show active" id="tab1">
<iframe src="@Url.Content("~/TDE0043/PAGE3_1")?REC_TP=B&TD_CODE=@Model.TDMFORM.TD_CODE"></iframe>
       </div>
   <div class="tab-pane fade" id="tab2">
      <iframe src="@Url.Content("~/TDE0043/PAGE3_1")?REC_TP=C&TD_CODE=@Model.TDMFORM.TD_CODE"></iframe>
        </div>
               <div class="tab-pane fade" id="tab3">
   <iframe src="@Url.Content("~/TDE0043/PAGE3_1")?REC_TP=S&TD_CODE=@Model.TDMFORM.TD_CODE"></iframe>
                </div>
             <div class="tab-pane fade" id="tab4">
      <iframe src="@Url.Content("~/TDE0043/PAGE3_1")?REC_TP=F&TD_CODE=@Model.TDMFORM.TD_CODE"></iframe>
     </div>
    </div>
    </div>
            </div>
 </div>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/ui/1.14.1/jquery-ui.min.js"></script>
    <script type="text/javascript" src="~/Scripts/jquery.datepick.js"></script>
    <script type="text/javascript" src="~/Scripts/MyDatepickerJ.js"></script>
    <script src="~/Scripts/plugins/bootstrap-fileinput/fileinput.js"></script>
    <script src="~/Scripts/plugins/bootstrap-fileinput/zh-TW.js"></script>
    <script src="~/Scripts/validator.min.js"></script>
    <script>
        // 日期選擇器初始化
        $(".dt").datepickerTW({
            changeYear: true,
   changeMonth: true,
  yearRange: '68:168',
      dateFormat: 'yymmdd'
        });

        $(".dt").datepickerTW({
  onSelect: function (dateText) {
    $('#mainForm').validator('validate');
            }
        });

   $('.dt').click(function () {
            $(this).delay(600).val("");
        });
    </script>
</body>
</html>