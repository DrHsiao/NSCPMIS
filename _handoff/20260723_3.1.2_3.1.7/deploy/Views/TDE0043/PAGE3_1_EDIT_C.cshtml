@using PagedList.Mvc
@model WCals.ViewModels.NewModels.TDE0040Model
@{
    ViewBag.Title = "招標資料編輯";
  Layout = null;
  
 string bgrcName = "";
    if(Model.TDDBDRC != null) {
    if(Model.TDDBDRC.SEQ_NO == 0) {
  bgrcName = "原契約";
  } else {
 bgrcName = "第" + Model.TDDBDRC.SEQ_NO + "次契約變更";
   }
    }
    
    string tdName = "";
  if(Model.TDMFORM != null) {
  tdName = Model.TDMFORM.TD_NAME;
    }
    
 bool isNew = ViewBag.IsNew != null && (bool)ViewBag.IsNew;
string pageTitle = isNew ? "招標資料新增" : "招標資料編輯";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script type="text/javascript" src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<title>@ViewBag.Title - My ASP.NET Application</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
     <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="~/Scripts/modernizr-2.8.3.js"></script>
    <link href="https://code.jquery.com/ui/1.14.1/themes/base/jquery-ui.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/Scripts/plugins/bootstrap-fileinput/icon.mini.css" crossorigin="anonymous">
 <link href="~/Scripts/plugins/bootstrap-fileinput/fileinput.min.css" media="all" rel="stylesheet" type="text/css" />
    <style>
    .section-header {
       background-color: #f5f5f5;
 border-left: 4px solid #0275d8;
      padding: 10px 15px;
       margin-top: 20px;
      margin-bottom: 15px;
      font-weight: bold;
  font-size: 14px;
 }
        
        .new-mode-badge {
   background-color: #5cb85c;
color: white;
 padding: 3px 10px;
     border-radius: 3px;
    font-size: 12px;
    margin-left: 10px;
        }
        .ui-datepicker { z-index: 2200 !important; background: #ffffff; border: 1px solid #cccccc; border-radius: 4px; }
    
        /* 表格框線與排版美化 */
        .table-bordered { border: 0 !important; }
        .table-bordered th, .table-bordered td { border: 0 !important; border-bottom: 1px solid #e2e8f0 !important; }
        .table > thead > tr > th { 
            border-bottom: 2px solid #337ab7 !important; 
            background-color: #f8fafc; 
            color: #334155; 
        }
        .table > tbody > tr:last-child > td { border-bottom: 0 !important; }
</style>
    <link href="~/Content/bs3-compat.css" rel="stylesheet" />
</head>
<body style="padding:5px;">
    @if(TempData["Success"] != null) {
     <div class="alert alert-success alert-dismissible" role="alert">
     <button type="button" class="btn-close shadow-none" data-bs-dismiss="alert" aria-label="Close"></button>
    @TempData["Success"]
   </div>
 }
    @if(TempData["Error"] != null) {
<div class="alert alert-danger alert-dismissible" role="alert">
<button type="button" class="btn-close shadow-none" data-bs-dismiss="alert" aria-label="Close"></button>
     @TempData["Error"]
        </div>
    }

    @using(Html.BeginForm("PAGE3_1_EDIT_C_Save", "TDE0043", FormMethod.Post, new { data_toggle = "validator", role = "form", id = "mainForm", enctype = "multipart/form-data" })) {

        @Html.AntiForgeryToken()
   <input type="hidden" name="IsNew" value="@isNew.ToString().ToLower()" />

   <button type="submit" class="btn btn-primary shadow-sm btn-lg">@if(isNew) { <i class="fa-solid fa-plus me-1"></i><text>新增</text> } else { <i class="fa-solid fa-floppy-disk me-1"></i><text>儲存</text> }</button>
        <button type="button" onclick="parent.close3_1_Edit_c();" class="btn btn-outline-secondary shadow-sm btn-lg"><i class="fa-solid fa-xmark me-1"></i> 關閉</button>

  <h1 class="page-header">
        @pageTitle - @tdName
  @if(isNew) {
     <span class="new-mode-badge">新增模式</span>
 }
  </h1>
     <h4>@bgrcName</h4>

 @Html.HiddenFor(m => m.TDDBDRC.TD_CODE)
  @Html.HiddenFor(m => m.TDDBDRC.SEQ_NO)

        <!-- 基本資料 Section -->
        <div class="section-header">基本資料</div>
    <table class="table table-sm">
        <tr>
<td>
     <div class="row">
  <div class="col-md-6">
         <div class="form-group">
             <div class="input-group">
                 <span class="input-group-text">工程編號</span>
                 @Html.TextBoxFor(m => m.TDDBDRC.TD_CODE, new { @class = "form-control", @readonly = "readonly" })

                 @Html.TextBoxFor(m => m.SEQ_NO, new { @class = "form-control", @readonly = "readonly" })
                 
             </div>
  </div>
   </div>
 <div class="col-md-6">
       <div class="form-group">
    <div class="input-group">
  <span class="input-group-text">期別</span>
 <input type="text" class="form-control" value="@bgrcName" readonly="readonly" />
     </div>
  </div>
   </div>
   </div>
   </td>
    </tr>
        </table>

      <!-- 招標資料 Section -->
       <div class="section-header">招標資料</div>
     <table class="table table-sm">
 <tr>
<td>
     <div class="row">
  <div class="col-md-6">
      <div class="form-group">
        <div class="input-group">
<span class="input-group-text">上網日期</span>
       @Html.TextBoxFor(m => m.TDDBDRC.INET_DT, new { @class = "form-control dt" })
 </div>
   </div>
         </div>
      <div class="col-md-6">
 <div class="form-group">
     <div class="input-group">
 <span class="input-group-text">公告日期</span>
      @Html.TextBoxFor(m => m.TDDBDRC.PUB_DT, new { @class = "form-control dt" })
    </div>
   </div>
   </div>
  </div>
    </td>
 </tr>
 <tr>
    <td>
   <div class="row">
<div class="col-md-12">
     <div class="form-group">
         <div class="input-group">
  <span class="input-group-text">公告文號</span>
         @Html.TextBoxFor(m => m.TDDBDRC.PUB_FN, new { @class = "form-control" })
   </div>
    </div>
       </div>
     </div>
       </td>
    </tr>
<tr>
 <td>
  <div class="row">
    <div class="col-md-6">
    <div class="form-group">
<div class="input-group">
     <span class="input-group-text">收件日期</span>
     @Html.TextBoxFor(m => m.TDDBDRC.RCVFM_DT, new { @class = "form-control dt" })
   </div>
    </div>
       </div>
            <div class="col-md-6">
           <div class="form-group">
        <div class="input-group">
     <span class="input-group-text">開標日期</span>
      @Html.TextBoxFor(m => m.TDDBDRC.OPBD_DT, new { @class = "form-control dt" })
       </div>
 </div>
       </div>
    </div>
        </td>
  </tr>
        <tr>
   <td>
     <div class="row">
     <div class="col-md-6">
   <div class="form-group">
            <div class="input-group">
       <span class="input-group-text">決標日期</span>
    @Html.TextBoxFor(m => m.TDDBDRC.ASGMAST_DT, new { @class = "form-control dt" })
    </div>
       </div>
     </div>
 <div class="col-md-6">
     <div class="form-group">
     <div class="input-group">
  <span class="input-group-text">得標廠商</span>
   @Html.TextBoxFor(m => m.TDDBDRC.MASER, new { @class = "form-control" })
    </div>
 </div>
    </div>
   </div>
        </td>
     </tr>
        <tr>
        <td>
    <div class="row">
     <div class="col-md-6">
     <div class="form-group">
    <div class="input-group">
  <span class="input-group-text">送審日期</span>
        @Html.TextBoxFor(m => m.TDDBDRC.SENFM_DT, new { @class = "form-control dt" })
    </div>
  </div>
    </div>
     <div class="col-md-6">
      <div class="form-group">
       <div class="input-group">
   <span class="input-group-text">執行人員</span>
          @Html.TextBoxFor(m => m.TDDBDRC.EXE_UID, new { @class = "form-control" })
      </div>
      </div>
 </div>
     </div>
          </td>
 </tr>
        </table>

        <!-- 金額資料 Section -->
  <div class="section-header">金額資料</div>
  <table class="table table-sm">
 <tr>
    <td>
        <div class="row">
      <div class="col-md-6">
 <div class="form-group">
      <div class="input-group">
   <span class="input-group-text">建議底價(元)</span>
     @Html.TextBoxFor(m => m.TDDBDRC.SUG_HARDPN, new { @class = "form-control", type = "number" })
     </div>
    </div>
      </div>
     <div class="col-md-6">
   <div class="form-group">
        <div class="input-group">
      <span class="input-group-text">核定底價(元)</span>
        @Html.TextBoxFor(m => m.TDDBDRC.DES_HARDPN, new { @class = "form-control", type = "number" })
  </div>
   </div>
      </div>
     </div>
</td>
    </tr>
        </table>

        <!-- 招標結果 Section -->
        <div class="section-header">招標結果</div>
      <table class="table table-sm">
   <tr>
      <td>
     <div class="row">
  <div class="col-md-6">
      <div class="form-group">
    <div class="input-group">
     <span class="input-group-text">招標結果</span>
 @Html.DropDownListFor(m => m.TDDBDRC.BID_RES, new SelectList(new[] {
     new { value = "", text = "請選擇" },
  new { value = "1", text = "決標" },
   new { value = "2", text = "流標" },
   new { value = "3", text = "廢標" }
  }, "value", "text"), new { @class = "form-control" })
     </div>
  </div>
     </div>
      <div class="col-md-6">
 <div class="form-group">
            <div class="input-group">
   <span class="input-group-text">流/廢標原因</span>
   @Html.TextBoxFor(m => m.TDDBDRC.FAIL_RESN, new { @class = "form-control" })
   </div>
     </div>
   </div>
      </div>
     </td>
   </tr>
        <tr>
  <td>
 <div class="row">
 <div class="col-md-12">
       <div class="form-group">
          <div class="input-group">
   <span class="input-group-text">審標意見</span>
         @Html.TextAreaFor(m => m.TDDBDRC.SVEY_MEMO, new { @class = "form-control", rows = "3" })
   </div>
   </div>
       </div>
    </div>
  </td>
     </tr>
            <tr>
    <td>
      <div class="row">
 <div class="col-md-12">
 <div class="form-group">
         <div class="input-group">
     <span class="input-group-text">備註</span>
 @Html.TextAreaFor(m => m.TDDBDRC.NOTE, new { @class = "form-control", rows = "3" })
     </div>
       </div>
   </div>
             </div>
      </td>
  </tr>
      </table>

    <!-- 按鈕區 -->
       <table class="table">
  <tr>
           <td>
     <button type="submit" class="btn btn-primary shadow-sm btn-lg">@if(isNew) { <i class="fa-solid fa-plus me-1"></i><text>新增</text> } else { <i class="fa-solid fa-floppy-disk me-1"></i><text>儲存</text> }</button>
    <button type="button" onclick="parent.close3_1_Edit_c();" class="btn btn-outline-secondary shadow-sm btn-lg"><i class="fa-solid fa-xmark me-1"></i> 關閉</button>
        </td>
    </tr>
      </table>
  }

   <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
 <script src="https://code.jquery.com/ui/1.14.1/jquery-ui.min.js"></script>
    <script type="text/javascript" src="~/Scripts/jquery.datepick.js"></script>
  <script type="text/javascript" src="~/Scripts/MyDatepickerJ.js"></script>
    <script src="~/Scripts/plugins/bootstrap-fileinput/fileinput.js"></script>
    <script src="~/Scripts/plugins/bootstrap-fileinput/zh-TW.js"></script>
    <script src="~/Scripts/validator.min.js"></script>
    <script>
        // 日期選擇器初始化
      $(".dt").datepickerTW({
    changeYear: true,
     changeMonth: true,
 yearRange: '68:168',
   dateFormat: 'yymmdd'
        });

      $(".dt").datepickerTW({
    onSelect: function (dateText) {
      $('#mainForm').validator('validate');
   }
   });

        $('.dt').click(function () {
  $(this).delay(600).val("");
        });
    </script>
</body>
</html>
