@using PagedList.Mvc
@model WCals.ViewModels.NewModels.SYS0030Model

@{Layout = null;}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>系統別管理</title>
    <meta charset="utf-8" />
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <script type="text/javascript" src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <style>
        body { padding: 15px; background-color: #f8f9fa; }
        .bg-primary { background-color: #337ab7 !important; }
        .text-primary { color: #337ab7 !important; }
        .btn-primary { background-color: #337ab7; border-color: #2e6da4; }
        .btn-primary:hover { background-color: #286090; border-color: #204d74; }
        .card { border-color: #337ab7; }
        .pagination { margin: 0; }
    </style>
    <link href="~/Content/bs3-compat.css" rel="stylesheet" />
</head>
<body>
    @using(Html.BeginForm("", "SYS0030", FormMethod.Post, new { id = "mainForm" })) {
        if(ViewBag.Message != null) {
            <div class="alert alert-info shadow-sm mb-3"><i class="fa-solid fa-circle-info me-2"></i>@ViewBag.Message</div>
        }
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white fw-bold"><i class="fa-solid fa-list-check me-2"></i>新增與查詢</div>
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="text-nowrap text-center">縣市別</th>
                            <th class="text-nowrap text-center">下水道系統編號</th>
                            <th class="text-nowrap text-center">下水道系統名稱</th>
                            <th class="text-nowrap text-center">建設情形</th>
                            <th class="text-nowrap text-center">是否補助</th>
                            <th class="text-nowrap text-center">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>

                        <td>
                            <select name="CITY" class="form-select">
                                <option value="">縣市別</option>
                                @foreach(System.Data.DataRow c in ViewBag.Cities.Rows) {
                                    if(Convert.ToString(c["CITY"]).Equals(Model.CITY)) {
                                        <option selected value="@c["CITY"]">@c["CITY"]</option>
                                    } else {
                                        <option value="@c["CITY"]">@c["CITY"]</option>
                                    }
                                }
                            </select>
                        </td>


                        <td>@Html.TextBoxFor(x => x.SYS_ID, new { @class = "form-control", placeholder = "系統編號", AutoComplete = "Off" })</td>
                        <td>@Html.TextBoxFor(x => x.SYS_NAME, new { @class = "form-control", placeholder = "系統名稱", AutoComplete = "Off" })</td>
                        <td>
                            @Html.TextBoxFor(x => x.CONST_TP, new { @class = "form-control", placeholder = "建設中", AutoComplete = "Off" })
                        </td>
                        <td>
                            @Html.DropDownListFor(x => x.IS_SUP, new SelectList(new[] { new { Value = "Y", Text = "Y" }, new { Value = "N", Text = "N" } }, "Value", "Text"),
                           "是否補助", new { @class = "form-select", form = "mainForm" })
                        </td>
                        <td class="text-center">
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-primary" type="submit" formaction="@Url.Action("SYSManagerSearch", "SYS0030")"><i class="fa-solid fa-magnifying-glass me-1"></i>查詢</button>
                                <button class="btn btn-success" type="submit" formaction="@Url.Action("SYSManagerAdd", "SYS0030")"><i class="fa-solid fa-plus me-1"></i>新增</button>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        </div>
        if(Model.List1 != null) {
                <div class="pagination-container mb-2 text-center">
                    @Html.PagedListPager(Model.List1, page => Url.Action("SYSManagerSearch", "SYS0030",
                    new {
                        page = page,
                        CITY = Model.CITY,
                        SYS_ID = Model.SYS_ID,
                        SYS_NAME = Model.SYS_NAME,
                        CONST_TP = Model.CONST_TP,
                        IS_SUP = Model.IS_SUP,
                    }), new PagedListRenderOptions { ContainerDivClasses = new[] { "pagination pagination-sm m-0" } })
                </div>
                <div class="card shadow-sm border-0">
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="text-nowrap text-center">縣市別</th>
                                <th class="text-nowrap text-center">下水道系統編號</th>
                                <th class="text-nowrap text-center">下水道系統名稱</th>
                                <th class="text-nowrap text-center">建設情形</th>
                                <th class="text-nowrap text-center">是否補助</th>
                                <th class="text-nowrap text-center">操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach(System.Data.DataRow d in Model.List1) {
                                <tr>
                                    <td>
                                        <select name="CITYS" class="form-select">
                                            <option value="">縣市別</option>
                                            @foreach(System.Data.DataRow c in ViewBag.Cities.Rows) {
                                                if(Convert.ToString(c["CITY"]).Equals(Convert.ToString(d["CITY"]))) {
                                                    <option selected value="@c["CITY"]">@c["CITY"]</option>
                                                } else {
                                                    <option value="@c["CITY"]">@c["CITY"]</option>
                                                }
                                            }
                                        </select>
                                    </td>
                                    <td><input type="text" name="SYS_IDS" value="@d["SYS_ID"]" class="form-control" /></td>
                                    <td><input type="text" name="SYS_NAMES" value="@d["SYS_NAME"]" class="form-control" /></td>
                                    <td>
                                        <input type="text" name="CONST_TPS" value="@d["CONST_TP"]" class="form-control" />
                                    </td>
                                    <td>
                                        <select name="IS_SUPS" class="form-select">
                                            <option value="">是否補助</option>
                                            @if(Convert.ToString(d["IS_SUP"]).Equals("Y")) {
                                                <option selected value="Y">Y</option>
                                                <option value="N">N</option>
                                            } else {
                                                <option value="Y">Y</option>
                                                <option selected value="N">N</option>
                                            }
                                        </select>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-warning" type="submit" formaction="@Url.Action("SYSManagerSearch", "SYS0030")">修改</button>
                                            <button class="btn btn-danger" name="action" type="button" onclick="if(!confirm('確定刪除？')) return false;" value="Del">刪除</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                </div>


            }
     }
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
