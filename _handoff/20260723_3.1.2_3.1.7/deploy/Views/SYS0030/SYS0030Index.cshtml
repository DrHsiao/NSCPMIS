@using PagedList.Mvc

@model WCals.ViewModels.NewModels.SYS0030Model

@{ ViewBag.Title = "3.1.7 污水下水道計畫文件";

    Layout = "~/Views/Shared/_Layout2_v2.cshtml"; }





@section head{

    <style>

        .pagination {

            margin: 0;

        }

        .ui-dialog {

            z-index: 4000;

        }



        /* 查詢區 input-group 標籤統一寬度 */

        .search-area .input-group-text {

            min-width: 100px;

            justify-content: center;

        }

    </style>

}



<div class="row mb-3">

    <div class="col-lg-12">

        <h2 class="border-bottom pb-2 mb-3">

            3.1.7 污水下水道計畫文件

        </h2>

        <nav aria-label="breadcrumb">

            <ol class="breadcrumb bg-light p-2 rounded">

                <li class="breadcrumb-item"><i class="fa-solid fa-house me-1"></i><a href="@Url.Content("~/")Home" class="text-decoration-none">首頁</a></li>

                <li class="breadcrumb-item active" aria-current="page"><i class="fa-solid fa-file me-1"></i> 3.1.7 污水下水道計畫文件</li>

            </ol>

        </nav>

    </div>

</div>



@using(Html.BeginForm("", "SYS0030", FormMethod.Post, new { id = "mainForm" })) {



    <div class="card border-primary shadow-sm mb-4 search-area">

        <div class="card-header bg-primary text-white fw-bold"><i class="fa-solid fa-magnifying-glass me-2"></i>查詢</div>

        <div class="card-body">

            <div class="mb-3">

                <button onclick="Open_SYSManager();" class="btn btn-outline-primary" name="action" type="button" value="Save">

                    <i class="fa-solid fa-list-check me-1"></i>污水下水道系統別管理

                </button>

                <button class="btn btn-success" onclick="Open_SYSInfo();" name="action" type="button" value="Save"><i class="fa-solid fa-plus me-1"></i>新增文件</button>
                <button class="btn btn-warning" id="ButPRT_SYS" name="action" type="button" onclick="Open_PRT_SYS('S');"><i class="fa-solid fa-print me-1"></i>經費統計表</button>

            </div>

            <div class="row g-3">

                <div class="col-md-3">

                    <div class="input-group">

                        <span class="input-group-text">縣市別</span>

                        @Html.DropDownList("CITY", (SelectList)ViewBag.cities, "縣市", new { @class = "form-select", form = "mainForm", Onchange = "GetSystemsByCity(this.value)" })

                    </div>

                </div>

                <div class="col-md-3">

                    <div class="input-group">

                        <span class="input-group-text">系統別</span>

                        @Html.DropDownListFor(m => m.sys, (SelectList)ViewBag.systems, "請選擇", new { @class = "form-select" })

                    </div>

                </div>

                <div class="col-md-3">

                    <div class="input-group">

                        <span class="input-group-text">文件類別</span>

                        @Html.DropDownListFor(m => m.doc_type, new SelectList(new[] {

                             new { Value = "A", Text = "A:規劃報告" },

                              new { Value = "C", Text = "C:實施計畫" }

                        }, "Value", "Text"), "請選擇", new { @class = "form-select" })

                    </div>

                </div>

                <div class="col-md-3">

                    <div class="input-group">

                        <span class="input-group-text">文件名稱</span>

                        @Html.TextBoxFor(x => x.doc_name, new { @class = "form-control", placeholder = "文件名稱", AutoComplete = "Off" })

                    </div>

                </div>

            </div>

        </div>

        <div class="card-footer bg-light text-end">

            <button class="btn btn-primary" type="submit" formaction="@Url.Action("Search", "SYS0030")"><i class="fa-solid fa-magnifying-glass me-1"></i>查詢</button>

        </div>

    </div>



    if(Model.List1 != null) {



        <div class="pagination-container mb-2">

            @Html.PagedListPager(Model.List1, page => Url.Action("Search",

                new { page = page,

                sys=Model.sys,

                doc_name=Model.doc_name,

                doc_type=Model.doc_type,

                city=Model.CITY

                }), new PagedListRenderOptions { ContainerDivClasses = new[] { "pagination pagination-sm m-0" } })

        </div>

        <div class="card border-primary shadow-sm mb-4">

            <div class="card-header bg-primary text-white fw-bold"><i class="fa-solid fa-table border-white border text-white rounded p-1 me-2"></i>查詢列表 @Html.HiddenFor(m => m.PJ_ID, new {id = "PJ_ID" })</div>

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th class="text-nowrap text-center">縣市別</th>

                            <th class="text-nowrap text-center">下水道系統別</th>

                            <th class="text-nowrap text-center">文件類別</th>

                            <th class="text-nowrap text-center">造冊編號</th>

                            <th class="text-nowrap text-center">文件名稱</th>

                            <th class="text-nowrap text-center">操作</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach(System.Data.DataRow c in Model.List1) {

                            <tr>



                                <td>@c["SER_CITY"]</td>

                                <td>@c["SYS_NAME"]</td>

                                <td>@c["PJ_ID_TYPE"]</td>

                                <td>

                                    <span>@c["SER_FN_1"]</span>

                                    @if(!Convert.ToString(c["SER_FN_2"]).Equals("")) {

                                        <span>- @c["SER_FN_2"]</span>

                                    }

                                    @if(!Convert.ToString(c["SER_FN_3"]).Equals("")) {

                                        <span>- @c["SER_FN_3"]</span>

                                    }

                                    @if(!Convert.ToString(c["SER_FN_4"]).Equals("")) {

                                        <span>- @c["SER_FN_4"]</span>

                                    }

                                    @if(!Convert.ToString(c["SER_FN_5"]).Equals("")) {

                                        <span>- @c["SER_FN_5"]</span>

                                    }

                                    @if(!Convert.ToString(c["SER_FN_6"]).Equals("")) {

                                        <span>- @c["SER_FN_6"]</span>

                                    }

                                    @if(!Convert.ToString(c["SER_FN_7"]).Equals("")) {

                                        <span>- @c["SER_FN_7"]</span>

                                    }









                                </td>

                                <td>@c["PJ_NAME"]</td>

                                <td class="text-center">

                                    <div class="btn-group btn-group-sm">

                                        <button class="btn btn-outline-primary" name="action" type="button" onclick="Open_SYSInfo('@c["PJ_ID"]');">編輯</button>

                                        <button class="btn btn-outline-danger" name="action" type="submit" onclick="if (!confirm('確定刪除？')) { return false; } else {$('#PJ_ID').val('@c["PJ_ID"]')} " value="Del">刪除</button>

                                        <button class="btn btn-outline-secondary" name="action" type="button" onclick="Open_SYSInfo('@c["PJ_ID"]', 'copy');">複製</button>

                                    </div>

                                </td>

                            </tr>

                        }

                    </tbody>

                </table>

            </div>



        </div>



    }

















    <div id="SYSManager" title="系統別管理" style="padding:5px; color:#ffffff;">

        <iframe id="editor" src="" style="width: 100%; height: 100%; border: 0px;"></iframe>

    </div>



    <div id="SYSInfo" title="系統別內容" style="padding:5px; color:#ffffff;">

        <iframe id="SYSInfoFrame" src="" style="width: 100%; height: 100%; border: 0px;"></iframe>

    </div>



    <div id="PRT_SYS_Dialog" title="列印下水道系統經費統計表" style="padding:5px; display:none;">
        <iframe id="PRT_SYS_Frame" src="" style="width: 100%; height: 100%; border: 0px;"></iframe>
    </div>

    <div id="SYSStat" title="系統別狀態" style="padding:5px; color:#ffffff;">

        <iframe id="SYSStatFrame" src="" style="width: 100%; height: 100%; border: 0px;"></iframe>

    </div>

    <script>

        //系統別與縣市別連動：選擇縣市後重新載入對應系統別 (3.1.7 需求)
        function GetSystemsByCity(city) {
            var $sys = $('#sys');
            $.getJSON('@Url.Action("GetSystemsByCity", "SYS0030")', { city: city }, function (data) {
                $sys.empty();
                $sys.append('<option value="">請選擇</option>');
                $.each(data, function (i, item) {
                    $sys.append($('<option></option>').val(item.SYS_ID).text(item.SYS_NAME));
                });
            });
        }

        //開啟系統別管理

        function Open_SYSManager() {

            $("#editor").attr("src", '@Url.Action("SYSManager", "SYS0030")');

            $("#SYSManager").dialog("open");

        }





        //開啟系統別內容

        function Open_SYSInfo(pjId, mode) {

            var url = '@Url.Action("SYSInfo", "SYS0030")';

            var params = [];

            if (pjId) {

                params.push('pjId=' + encodeURIComponent(pjId));

            }

            if (mode) {

                params.push('mode=' + encodeURIComponent(mode));

            }

            if (params.length > 0) {

                url = url + '?' + params.join('&');

            }

            $('#SYSInfoFrame').attr('src', url);

            $('#SYSInfo').dialog('open');

        }



        //開啟系統別狀態

        // 開啟下水道系統經費統計表彈窗
        function Open_PRT_SYS(STAT_NO) {
            var url = '@Url.Action("PrtSysPopup", "SYS0030")';
            if (STAT_NO) {
                url += '?STAT_NO=' + encodeURIComponent(STAT_NO);
            }
            $("#PRT_SYS_Frame").attr("src", url);
            $("#PRT_SYS_Dialog").dialog("open");
        }

        function Open_SYSStat(Pid) {

            $("#SYSStatFrame").attr("src", "@Url.Content("~/")SYSStat");

            $("#SYSStat").dialog("open");

        }





        $(function () {

            var h = $(window).height();

            var w = $(window).width();



            //系統別管理

            $("#SYSManager").dialog({

                autoOpen: false,

                show: {duration: 300 },

                hide: { duration: 300 },

                width: w * 0.7,

                height: h * 0.9,

                modal: true,

                close: function (event, ui) {

                    location.reload();

                }

            });



            //系統別內容管理

            $("#SYSInfo").dialog({

                autoOpen: false,

                show: { duration: 300 },

                hide: { duration: 300 },

                width: w * 0.7,

                height: h * 0.9,

                modal: true,

                close: function (event, ui) {

                    location.reload();

                }

            });



            //系統別狀態管理

            $("#PRT_SYS_Dialog").dialog({
                autoOpen: false,
                show: { duration: 500 },
                hide: { duration: 500 },
                width: w * 0.75,
                height: h * 0.85,
                modal: true
            });

            $("#SYSStat").dialog({

                autoOpen: false,

                show: { duration: 300 },

                hide: { duration: 300 },

                width: w * 0.4,

                height: h * 0.6,

                modal: true,

                close: function (event, ui) {

                    //location.reload();

                }

            });

        });



    </script>

}

