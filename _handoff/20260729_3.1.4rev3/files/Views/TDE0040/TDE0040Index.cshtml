    // 3.1.4rev3：改成只重載「進度管制」裡目前那個子頁籤的 iframe；
    // 原本重載整個 PAGE5Frame 會把使用者踢回第一個頁籤（工作控制點）。
    function closeEditDialog() {
        $("#PAGE5_2_Edit").dialog("close");
        var f = document.getElementById("PAGE5Frame");
        if (!f || !f.contentWindow) { return; }
        try {
            var inner = f.contentWindow.document.getElementById(_mscdEditTab);
            if (inner && inner.contentWindow && inner.src) {
                inner.contentWindow.location.reload();
                return;
            }
        } catch (e) { }
        f.contentWindow.location.reload();
    }

