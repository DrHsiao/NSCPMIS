@using PagedList.Mvc
@model WCals.ViewModels.NewModels.TDE0040Model
@{ ViewBag.Title = "3.1.4 工程登記冊";
    Layout = "~/Views/Shared/_Layout2_v2.cshtml"; }


@section head{
    <style>
        .pagination { margin: 0; }

        /* jQuery UI Dialog z-index (確保在 navbar 之上) */
        .ui-dialog { z-index: 4000; }

        

        /* 查詢區 input-group 標籤統一寬度 */
        .search-area .input-group-text {
            min-width: 100px;
            justify-content: center;
            background-color: #f8f9fa;
            font-weight: 500;
            color: #555;
            border-color: #ccc;
        }
        .search-area .form-control,
        .search-area .form-select {
            border-color: #ccc;
        }

        /* 填報按鈕群組 */
        .btn-group .btn-outline-primary {
            color: #337ab7;
            border-color: #337ab7;
        }
        .btn-group .btn-outline-primary:hover,
        .btn-group .btn-outline-primary:active {
            background-color: #337ab7;
            border-color: #286090;
            color: #fff;
        }
    </style>
    <script type="text/javascript" src="~/Scripts/jquery.datepick.js"></script>
    <script type="text/javascript" src="~/Scripts/MyDatepickerJ.js"></script>
}

<div class="row">
    <div class="col-lg-12">
        <h1 class="h2 border-bottom pb-2 mb-3">
            3.1.4 工程登記冊
            <small class="text-muted"></small>
        </h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <i class="fa-solid fa-gauge"></i><a href="@Url.Content("~/")Home"> 首頁</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">
                    <i class="fa-solid fa-file"></i>
                    3.1.4 工程登記冊
                </li>
            </ol>
        </nav>
    </div>
</div>

@using(Html.BeginForm("", "TDE0040", FormMethod.Post, new { id = "mainForm" })) {

    <div class="card border-primary mb-3 shadow-sm">
        <div class="card-header bg-primary text-white fw-bold">
            <i class="fa-solid fa-magnifying-glass me-1"></i> 查詢
        </div>
        <div class="card-body search-area">
            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text">工程編號</span>
                        @Html.TextBoxFor(x => x.TD_CODE, new { @class = "form-control", form = "mainForm", placeholder = "工程編號" })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text">工程名稱</span>
                        @Html.TextBoxFor(x => x.TD_NAME, new { @class = "form-control", form = "mainForm", placeholder = "工程名稱" })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text">案件類別</span>
                        @Html.DropDownListFor(x => x.CATY_CODE, (SelectList)ViewBag.TD_CATY, "類型", new { @class = "form-select", form = "mainForm" })
                    </div>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text">縣市別</span>
                        @Html.DropDownListFor(x => x.CITY, (SelectList)ViewBag.cities, "縣市", new { @class = "form-select", form = "mainForm", id = "CITY", onchange = "GetTowns(this.value)" })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text">鄉鎮別</span>
                        @Html.DropDownListFor(x => x.TOWN, (SelectList)ViewBag.towns, "鄉鎮", new { @class = "form-select", form = "mainForm", id = "TOWN" })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text">辦理層級</span>
                        @Html.DropDownListFor(x => x.IPJ_CODE, (SelectList)ViewBag.N_IPJ_CODE, "辦理層級", new { @class = "form-select", form = "mainForm" })
                    </div>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text">執行狀況</span>
                        <select name="TD_STAT_DESC" class="form-select">
                            <option value="">請選擇</option>
                            <option value="未發包" @(Model.TD_STAT_DESC == "未發包" ? "selected" : "")>未發包</option>
                            <option value="已發包" @(Model.TD_STAT_DESC == "已發包" ? "selected" : "")>已發包</option>
                            <option value="停工中" @(Model.TD_STAT_DESC == "停工中" ? "selected" : "")>停工中</option>
                            <option value="已開工施工中" @(Model.TD_STAT_DESC == "已開工施工中" ? "selected" : "")>已開工施工中</option>
                            <option value="已完工" @(Model.TD_STAT_DESC == "已完工" ? "selected" : "")>已完工</option>
                            <option value="尚未完成規劃設計" @(Model.TD_STAT_DESC == "尚未完成規劃設計" ? "selected" : "")>尚未完成規劃設計</option>
                            <option value="已完成規劃設計" @(Model.TD_STAT_DESC == "已完成規劃設計" ? "selected" : "")>已完成規劃設計</option>
                            <option value="尚未完成用地取得" @(Model.TD_STAT_DESC == "尚未完成用地取得" ? "selected" : "")>尚未完成用地取得</option>
                            <option value="已完成用地取得" @(Model.TD_STAT_DESC == "已完成用地取得" ? "selected" : "")>已完成用地取得</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text">年度</span>
                        @Html.DropDownList("SYR", (SelectList)ViewBag.SYRS, "請選擇", new { @class = "form-select", form = "mainForm", onchange = "GetPids(this.value)" })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text">計畫別</span>
                        @Html.DropDownList("PID", (SelectList)ViewBag.PIDS, "請選擇(請先選擇年度)", new { @class = "form-select", form = "mainForm" })
                    </div>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text">下水道系統</span>
                        <select name="SYS_ID_FG" class="form-select">
                            <option value="">請選擇</option>
                            <option value="Y" @(Model.SYS_ID_FG == "Y" ? "selected" : "")>已填寫</option>
                            <option value="N" @(Model.SYS_ID_FG == "N" ? "selected" : "")>尚未填寫</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text">實施計畫</span>
                        <select name="SYS_PJ_FG" class="form-select">
                            <option value="">請選擇</option>
                            <option value="Y" @(Model.SYS_PJ_FG == "Y" ? "selected" : "")>已填寫</option>
                            <option value="N" @(Model.SYS_PJ_FG == "N" ? "selected" : "")>尚未填寫</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-4 d-flex align-items-end gap-2">
                    <button class="btn btn-primary" type="submit" formaction="@Url.Action("Search", "TDE0040")">
                        <i class="fa-solid fa-magnifying-glass me-1"></i>查詢
                    </button>
                    <button class="btn btn-success" value="Save">
                        <i class="fa-solid fa-print me-1"></i>列印
                    </button>
                </div>
            </div>
        </div>
    </div>


    if(Model.List1 != null) {

        <div class="pagination-container">
        @Html.PagedListPager(Model.List1, page => Url.Action("Search",
            new {
                PID = Model.PID,
                TD_CODE = Model.TD_CODE,
                TD_NAME = Model.TD_NAME,
                CITY = Model.CITY,
                TOWN = Model.TOWN,
                CATY_CODE = Model.CATY_CODE,
                IPJ_CODE = Model.IPJ_CODE,
                TD_STAT_DESC = Model.TD_STAT_DESC,
                SYR = Model.SYR,
                SYS_ID_FG = Model.SYS_ID_FG,
                SYS_PJ_FG = Model.SYS_PJ_FG,
                page1 = page
            }))
        </div>
        <div class="card border-primary mb-3 shadow-sm">
            <div class="card-header bg-primary text-white fw-bold">
                <i class="fa-solid fa-list me-1"></i> 查詢列表
            </div>
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th class="text-nowrap"></th>
                            <th class="text-nowrap">工程編號</th>
                            <th class="text-nowrap">工程名稱</th>
                            <th class="text-nowrap">執行單位</th>
                            <th class="text-nowrap">案件類別</th>
                            <th class="text-nowrap">執行狀態</th>
                            <th class="text-nowrap">下水道系統</th>
                            <th class="text-nowrap">GIS圖資檢覈</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(System.Data.DataRow c in Model.List1) {
                            <tr>
                                <td style="width:90px;">
                                    <div class="btn-group">
                                        <button type="button" class="btn btn-sm btn-outline-primary">填報</button>
                                        <button type="button" class="btn btn-sm btn-outline-primary dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false">
                                            <span class="visually-hidden">Toggle Dropdown</span>
                                        </button>
                                        <ul class="dropdown-menu">
                                            <li><a class="dropdown-item" href="javascript:void(0);" onclick="open1('@c["TD_CODE"]');"><i class="fa-solid fa-file-lines me-2 text-primary"></i>工程資料</a></li>
                                            <li><a class="dropdown-item" href="javascript:void(0);" onclick="open2('@c["TD_CODE"]');"><i class="fa-solid fa-money-bill-wave me-2 text-success"></i>經費來源</a></li>
                                            <li><a class="dropdown-item" href="javascript:void(0);" onclick="open3('@c["TD_CODE"]');"><i class="fa-solid fa-calculator me-2 text-info"></i>預算管制</a></li>
                                            <li><a class="dropdown-item" href="javascript:void(0);" onclick="open4('@c["TD_CODE"]');"><i class="fa-solid fa-images me-2 text-warning"></i>圖文管制</a></li>
                                            <li><a class="dropdown-item" href="javascript:void(0);" onclick="open5('@c["TD_CODE"]');"><i class="fa-solid fa-chart-line me-2 text-danger"></i>進度管制</a></li>
                                            <li><a class="dropdown-item" href="javascript:void(0);" onclick="open6('@c["TD_CODE"]');"><i class="fa-solid fa-hard-hat me-2 text-secondary"></i>施工資料</a></li>
                                            <li><a class="dropdown-item" href="javascript:void(0);" onclick="open7('@c["TD_CODE"]');"><i class="fa-solid fa-clipboard-check me-2 text-danger"></i>查核缺失</a></li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li><a class="dropdown-item" href="javascript:void(0);" onclick="open8('@c["TD_CODE"]');"><i class="fa-solid fa-cloud-rain me-2 text-info"></i>工程填報(雨)</a></li>
                                            <li><a class="dropdown-item" href="javascript:void(0);" onclick="open9('@c["TD_CODE"]');"><i class="fa-solid fa-water me-2 text-primary"></i>工程填報(污)</a></li>
                                        </ul>
                                    </div>
                                </td>

                                <td class="text-nowrap">@c["TD_CODE"]</td>
                                <td class="text-nowrap">@c["TD_NAME"]</td>
                                <td class="text-nowrap">@c["ADV_DP_DESC"]</td>
                                <td class="text-nowrap">@c["CATY_CODE_DESC"]</td>
                                <td class="text-nowrap">@c["TD_STAT_DESC"]</td>
                                <td class="text-nowrap">@c["SYS_ID_FG"]</td>
                                <td class="text-nowrap">未匯入GN</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }


    <!-- ====== jQuery UI Dialog 容器 (各自獨立 Iframe) ====== -->
    <div id="editDiv" title="編輯" style="padding:5px; display:none;">
        <iframe id="editFrame" src="" style="width: 100%; height: 100%; border: 0px;"></iframe>
    </div>

    <div id="PAGE3_1_EDIT" title="編輯" style="padding:5px; display:none;">
        <iframe id="PAGE3_1_EDITFrame" src="" style="width: 100%; height: 100%; border: 0px;"></iframe>
    </div>

    <div id="PAGE3_1_EDIT_C" title="編輯" style="padding:5px; display:none;">
        <iframe id="PAGE3_1_EDITFrame_c" src="" style="width: 100%; height: 100%; border: 0px;"></iframe>
    </div>

    <div id="PAGE3_1_EDIT_E" title="編輯" style="padding:5px; display:none;">
        <iframe id="PAGE3_1_EDITFrame_e" src="" style="width: 100%; height: 100%; border: 0px;"></iframe>
    </div>

    <div id="PAGE3_1_EDIT_F" title="編輯" style="padding:5px; display:none;">
        <iframe id="PAGE3_1_EDITFrame_f" src="" style="width: 100%; height: 100%; border: 0px;"></iframe>
    </div>

    <div id="PAGE2" title="經費來源" style="padding:5px; display:none;">
        <iframe id="PAGE2Frame" src="" style="width: 100%; height: 100%; border: 0px;"></iframe>
    </div>

    <div id="PAGE2_1" title="年度經費" style="padding:5px; display:none;">
        <iframe id="PAGE2_1Frame" src="" style="width: 100%; height: 100%; border: 0px;"></iframe>
    </div>

    <div id="PAGE2_1_1" title="預算分配" style="padding:5px; display:none;">
        <iframe id="PAGE2_1_1Frame" src="" style="width: 100%; height: 100%; border: 0px;"></iframe>
    </div>

    <div id="PAGE2_1_2" title="中央款分配數" style="padding:5px; display:none;">
        <iframe id="PAGE2_1_2Frame" src="" style="width: 100%; height: 100%; border: 0px;"></iframe>
    </div>

    <div id="PAGE2_2" title="保留款" style="padding:5px; display:none;">
        <iframe id="PAGE2_2Frame" src="" style="width: 100%; height: 100%; border: 0px;"></iframe>
    </div>

    <div id="PAGE5" title="進度管制" style="padding:5px; display:none;">
        <iframe id="PAGE5Frame" src="" style="width: 100%; height: 100%; border: 0px;"></iframe>
    </div>

    <div id="PAGE4" title="圖文管制" style="padding:5px; display:none;">
        <iframe id="PAGE4Frame" src="" style="width: 100%; height: 100%; border: 0px;"></iframe>
    </div>

    <div id="PAGE6" title="施工資料" style="padding:5px; display:none;">
        <iframe id="PAGE6Frame" src="" style="width: 100%; height: 100%; border: 0px;"></iframe>
    </div>

    <div id="PAGE6_2" title="估驗進度" style="padding:5px; display:none;">
        <iframe id="PAGE6_2Frame" src="" style="width: 100%; height: 100%; border: 0px;"></iframe>
    </div>

    <div id="PAGE7" title="查核缺失" style="padding:5px; display:none;">
        <iframe id="PAGE7Frame" src="" style="width: 100%; height: 100%; border: 0px;"></iframe>
    </div>

    <div id="PAGE8" title="工程填報(雨)" style="padding:5px; display:none;">
        <iframe id="PAGE8Frame" src="" style="width: 100%; height: 100%; border: 0px;"></iframe>
    </div>

    <div id="PAGE9" title="工程填報(污)" style="padding:5px; display:none;">
        <iframe id="PAGE9Frame" src="" style="width: 100%; height: 100%; border: 0px;"></iframe>
    </div>

    <div id="PAGE5_2_Edit" title="編輯分月進度" style="padding: 5px; display: none;">
        <iframe id="PAGE5_2_EditFrame" src="" style="width: 100%; height: 100%; border: 0px;"></iframe>
    </div>

}


<script>
    var h = $(window).height();
    var w = $(window).width();

    // ========================================
    //  3.1.4rev：查詢列表的「填報」下拉被裁切
    //  查詢列表包在 .table-responsive(overflow:auto) 內，BS5 的 dropdown-menu
    //  預設用 position:absolute，會被這個捲動容器裁掉。改用 Popper 的
    //  strategy:'fixed'（相對視窗定位，不受祖先 overflow 裁切），
    //  同時保留 .table-responsive 原本的捲動行為。
    // ========================================
    document.addEventListener("DOMContentLoaded", function () {
        if (!window.bootstrap || !bootstrap.Dropdown) return;
        document.querySelectorAll('.table-responsive [data-bs-toggle="dropdown"]').forEach(function (el) {
            bootstrap.Dropdown.getOrCreateInstance(el, {
                popperConfig: function (defaultConfig) {
                    return Object.assign({}, defaultConfig, { strategy: "fixed" });
                }
            });
        });
    });

    // ========================================
    //  jQuery UI Dialog 初始化
    // ========================================
    function ActionDialog(id, wRatio, hRatio) {
        wRatio = (typeof wRatio === "number" && !isNaN(wRatio)) ? wRatio : 0.8;
        hRatio = (typeof hRatio === "number" && !isNaN(hRatio)) ? hRatio : 0.9;

        $("#" + id).dialog({
            autoOpen: false,
            show: { duration: 300 },
            hide: { duration: 300 },
            maxWidth: w,
            maxHeight: h,
            width: w * wRatio,
            height: h * hRatio,
            modal: true
        });
    }

    // 初始化所有 Dialog
    ActionDialog("editDiv", 0.8, 0.9);
    ActionDialog("PAGE3_1_EDIT", 0.75, 0.85);
    ActionDialog("PAGE3_1_EDIT_C", 0.75, 0.85);
    ActionDialog("PAGE3_1_EDIT_E", 0.75, 0.85);
    ActionDialog("PAGE3_1_EDIT_F", 0.75, 0.85);
    ActionDialog("PAGE4", 0.8, 0.9);
    ActionDialog("PAGE2", 0.8, 0.9);
    ActionDialog("PAGE2_1_1", 0.75, 0.85);
    ActionDialog("PAGE2_1_2", 0.75, 0.85);
    ActionDialog("PAGE2_2", 0.75, 0.85);
    ActionDialog("PAGE5", 0.8, 0.9);
    ActionDialog("PAGE5_2_Edit", 0.75, 0.85);
    ActionDialog("PAGE6", 0.8, 0.9);
    ActionDialog("PAGE6_2", 0.85, 0.9);
    ActionDialog("PAGE7", 0.8, 0.9);
    ActionDialog("PAGE8", 0.8, 0.9);
    ActionDialog("PAGE9", 0.8, 0.9);

    

    // ========================================
    //  縣市鄉鎮動態對應
    // ========================================
    function GetTowns(city) {
        // 3.1.4rev2：未選縣市時不可帶出全台鄉鎮，直接清空
        if (!city) {
            $("#TOWN").html("<option value=''>鄉鎮</option>");
            return;
        }
        $("#TOWN").html("<option value=''>載入中...</option>");
        $.ajax({
            url: '@Url.Content("~/")ASYNC/GetTowns',
            method: 'post',
            data: { "city": city },
            success: function (d) {
                var p = JSON.parse(d);
                $("#TOWN").empty().append("<option value=''>鄉鎮</option>");
                for (var i = 0; i < p.length; i++) {
                    $("#TOWN").append("<option value='" + p[i].TOWN + "'>" + p[i].TOWN + "</option>");
                }
            },
            error: function() {
                $("#TOWN").html("<option value=''>載入失敗</option>");
            }
        });
    }

    // ========================================
    //  PAGE1 - 工程資料 (使用共用 editDiv)
    // ========================================
    function open1(tdcode) {
        $("#editFrame").attr("src", "@Url.Content("~/TDE0040/")PAGE1?TD_CODE=" + tdcode);
        $("#editDiv").dialog("option", "title", "工程資料").dialog("open");
    }
    function close1() {
        $("#editDiv").dialog("close");
    }

    // ========================================
    //  PAGE2 - 經費來源
    // ========================================
    function open2(tdcode) {
        $("#PAGE2Frame").attr("src", "@Url.Content("~/TDE0042/")PAGE2?TD_CODE=" + tdcode);
        $("#PAGE2").dialog("open");
    }
    function close2() {
        $("#PAGE2").dialog("close");
    }

    function open2_1_1(PID, TID, USR_ID, TD_CODE) {
        $("#PAGE2_1_1Frame").attr("src", "@Url.Content("~/TDE0042/")PAGE2_1_1?PID=" + PID + "&TID=" + TID + "&USR_ID=" + USR_ID + "&TD_CODE=" + TD_CODE);
        $("#PAGE2_1_1").dialog("open");
    }
    function close2_1_1() {
        $("#PAGE2_1_1").dialog("close");
    }

    // 當 PAGE2_1_1 選取期別時，載入對應的 CTDMNDS 資料到 PAGE2_1_2
    function onSeqNoSelected(TD_CODE, SEQ_NO, PID) {
        console.log('onSeqNoSelected: TD_CODE=' + TD_CODE + ', SEQ_NO=' + SEQ_NO + ', PID=' + PID);
        $("#PAGE2_1_2Frame").attr("src", "@Url.Content("~/TDE0042/")PAGE2_1_2?TD_CODE=" + TD_CODE + "&SEQ_NO=" + SEQ_NO + "&PID=" + PID);
    }

    function open2_1_2(PID, TID, TD_CODE) {
        $("#PAGE2_1_2Frame").attr("src", "@Url.Content("~/TDE0042/")PAGE2_1_2?PID=" + PID + "&TID=" + TID + "&TD_CODE=" + TD_CODE);
        $("#PAGE2_1_2").dialog("open");
    }
    function close2_1_2() {
        $("#PAGE2_1_2").dialog("close");
    }

    // ========================================
    //  PAGE3 - 預算管制 (使用共用 editDiv)
    // ========================================
    function open3(tdcode) {
        $("#editFrame").attr("src", "@Url.Content("~/TDE0043/")PAGE3?TD_CODE=" + tdcode);
        $("#editDiv").dialog("option", "title", "預算管制").dialog("open");
    }
    function close3() {
        $("#editDiv").dialog("close");
    }

    function open3_1_Edit(tdcode, seq_no, rec_tp) {
        $("#PAGE3_1_EDITFrame").attr("src", "@Url.Content("~/TDE0043")/PAGE3_1_EDIT?TD_CODE=" + tdcode + "&SEQ_NO=" + seq_no + "&REC_TP=" + rec_tp);
        $("#PAGE3_1_EDIT").dialog("open");
    }
    function close3_1_Edit() {
        $("#PAGE3_1_EDIT").dialog("close");
    }

    function open3_1_Edit_c(tdcode, seq_no, rec_tp) {
        $("#PAGE3_1_EDITFrame_c").attr("src", "@Url.Content("~/TDE0043")/PAGE3_1_EDIT_C?TD_CODE=" + tdcode + "&SEQ_NO=" + seq_no + "&REC_TP=" + rec_tp);
        $("#PAGE3_1_EDIT_C").dialog("open");
    }
    function close3_1_Edit_c() {
        $("#PAGE3_1_EDIT_C").dialog("close");
