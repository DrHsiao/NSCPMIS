+                              WHERE a.PJ_NAME LIKE @PJ AND a.SYR=@SYR AND a.PID=b.PID AND a.SYR=c.SYR
+                                AND b.TD_CODE=@TD_CODE AND b.TD_CODE=c.TD_CODE1 AND b.FD_CODE=c.FD_CODE",
