@{
    ViewBag.Title = "雨水工程建設成果";
    Layout = "~/Views/Shared/_Layout2_v2.cshtml";
}

@section head{
    <link href="https://fonts.googleapis.com/css?family=Roboto:100" rel="stylesheet">

    <link rel="stylesheet" href="~/Content/views/report.css">

    <link rel="stylesheet" href="~/Content/views/loading-spinner.css">
}

<div class="row">
    <div class="col-lg-12">
        <h1 class="h2 border-bottom pb-2 mb-3">
            雨水工程建設成果[0.1.3]

            <small> </small>
        </h1>
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <i class="fa-solid fa-dashboard"></i><a href="@Url.Content("~/Home")"> 首頁</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                <i class="fa-solid fa-file"></i>
                (雨水)例行性管考報表
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                <i class="fa-solid fa-file"></i>
                雨水工程建設成果
            </li>
        </ol>
    </div>
</div>

<form method="post" @*action="@Url.Action("ReportPrint11")"*@ class="my-text">
    @*<h2>例行性管考報表:</h2>*@

    報表類型:
    <select id="choose">
        <option value="11" @{if (ViewBag.State == "11") { <text> selected</text> }}>G-1.雨水下水道控管表</option>
    </select>
    <br />

    <table class="table table-bordered table-hover" style="text-align:left; width:95%">
        <tr>
            <td class="fixed-column">
                計畫分類:
            </td>
            <td id="Plan">
                <div>
                    <input type="radio" style="transform:scale(1.5)" id="one" name="plan" value="01,02,03" class="Plan-checkbox" />
                    <span>
                        前瞻基礎建設計畫-縣市管河川及區域排水整體改善計畫
                    </span>
                    <br />
                </div>
                <div>
                    <input type="radio" style="transform:scale(1.5)" id="two" name="plan" value="04,05" class="Plan-checkbox" />
                    <span>都市總合治水建設計畫(公務預算)</span>
                    <br />
                </div>
                <div>
                    <input type="radio" style="transform:scale(1.5)" id="three" name="plan" value="07" class="Plan-checkbox" />
                    <span>因應氣候變遷縣市管河川及排水整體改善計畫</span>
                    <br />
                </div>
            </td>
        </tr>
        <tr>
            <td class="fixed-column">
                縣市別:
            </td>
            <td id="Year">
                <input type="checkbox" class="selectALL">
                <span>全選框</span>
                <br />
                @{ int i = 0;}
                @foreach (var item in ViewBag.CITY)
                {
                    if (i > 1 && i % 8 == 0)
                    {
                        <br />
                    }
                    <input type="checkbox" value="@item.CITY" data-id="@item.CITY" name="CITY" class="City-checkbox">
                    <span>@item.CITY</span>
                    i++;
                }
            </td>
        </tr>
        <tr>
        <tr>
            <td class="fixed-column">
                年度區間:
            </td>
            <td>
                <select name="year1">
                    @foreach (var item4 in ViewBag.Year2)
                    {
                        <option>@item4.SYR</option>
                    }
                </select>
                -
                <select name="year2">
                    @foreach (var item3 in ViewBag.Year)
                    {
                        <option>@item3.SYR</option>
                    }
                </select>

                月份:
                <select name="month" id="monthSelect">
                    @for (int m = 1; m <= 12; m++)
                    {
                        var monthValue = m.ToString("D2");
                        <option value="@monthValue">@monthValue</option>
                    }
                </select>
            </td>
        </tr>
        <tr>
            <td colspan="2" align="center" style="text-align:center">
                <button id="downloadButton" type="button">EXCEL匯出</button>
                <button id="downloadButton2" type="button">ODS匯出</button>
            </td>
        </tr>
        <tr id="downloadMessage" style="display: none">
            <td class="fixed-column">
                下載成功:
            </td>
            <td>
                <a id="downloadLink" href="#" download>Download Excel File</a>
            </td>
        </tr>
    </table>
</form>

@section scripts {
    <script type="text/javascript">
        var reportUrl = '@Url.Action("ReportPrint11", "RainReport")';
        var stateUrl = '@Url.Action("ChooseState", "Report")';
    </script>

    @*<script src="~/Scripts/Report/State11.js" type="text/javascript"></script>*@
    <script src="~/Scripts/Report/State11.js?v=@DateTime.Now.Ticks"></script>
}