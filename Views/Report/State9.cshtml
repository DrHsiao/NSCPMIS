@model WCals.Models.CMBASEModels.state9ViewModel

@{
    ViewBag.Title = "例行性管考報表：E-1功能細項執行表(自訂欄位)";
    Layout = "~/Views/Shared/_Layout2_v2.cshtml";
}

@section head{
    <link rel="stylesheet" href="~/Content/views/report.css">

    <link rel="stylesheet" href="~/Content/views/loading-spinner.css">
}

<div class="row">
    <div class="col-lg-12">
        <h1 class="h2 border-bottom pb-2 mb-3">
            例行性管考報表[0.1.1]

            <small> </small>
        </h1>
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <i class="fa-solid fa-dashboard"></i><a href="@Url.Content("~/Home")"> 首頁</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                <i class="fa-solid fa-file"></i>
                例行性管考報表
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                <i class="fa-solid fa-file"></i>
                E-1.工程細項執行表(自訂欄位)
            </li>
        </ol>
    </div>
</div>

<form method="post" action="@Url.Action("ReportPrint9")" class="my-text" id="myForm">
    @*<h2>例行性管考報表:</h2>*@

    報表類型:
    <select id="choose">
        <option value="1" @{if (ViewBag.State == "1") { <text> selected</text> }}>A-1.一億元以上工程計畫執行情形表</option>
        <option value="2" @{if (ViewBag.State == "2") { <text> selected</text> }}>A-2.細項執行情形表</option>
        <option value="3" @{if (ViewBag.State == "3") { <text> selected</text> }}>A-3.跨年度一億元以上工程計畫執行情形表</option>
        <option value="4" @{if (ViewBag.State == "4") { <text> selected</text> }}>A-4.跨年度細項執行情形表</option>
        <option value="5" @{if (ViewBag.State == "5") { <text> selected</text> }}>A-5.細項執行情形表(前瞻計畫)</option>
        <option value="6" @{if (ViewBag.State == "6") { <text> selected</text> }}>B-1.修正預算作業表</option>
        <option value="7" @{if (ViewBag.State == "7") { <text> selected</text> }}>C-1.99年振興經濟表格</option>
        <option value="8" @{if (ViewBag.State == "8") { <text> selected</text> }}>D-1.公共建設推動會報執行情形表</option>
        <option value="9" @{if (ViewBag.State == "9") { <text> selected</text> }}>E-1.工程細項執行表(自訂欄位)</option>
        <option value="10" @{if (ViewBag.State == "10") { <text> selected</text> }}>F-1.相關計畫年度補助經費表</option>
        <option value="12" @{if (ViewBag.State == "12") { <text> selected</text> }}>H-1.在建工程抽查/查核/督導統計表</option>
    </select>
    <br />

    <table class="table table-bordered table-hover" style="text-align: left; width:95%">
        <tr>
            <td>
                計畫種類:
            </td>
            <td id="Water_Type" colspan="4">
                <input type="radio" name="water_type" value="雨水使用" class="Type-checkbox" /><span> </span>雨水
                <input type="radio" name="water_type" value="污水使用" class="Type-checkbox" /><span> </span>污水
                <input type="radio" name="water_type" value="再生水使用" class="Type-checkbox" /><span> </span>再生水
            </td>
        </tr>
        <tr>
            <td class="fixed-column">
                年度區間:
            </td>
            <td id="Year" colspan="4">
                <select name="StartYear" id="yearStart">
                    <option value="" selected disabled>選擇</option>

                    @foreach (var year in ViewBag.year2)
                    {
                        <option value="@year.SYR">@year.SYR</option>
                    }
                </select>
                <label>年度~</label>
                <select name="EndYear" id="yearEnd">
                    @foreach (var year in ViewBag.year)
                    {
                        <option value="@year.SYR">@year.SYR</option>
                    }
                </select>
                <label>年度</label>
            </td>
        </tr>
        <tr>
            <td>
                計畫名稱:
            </td>
            <td id="Plan" colspan="4">
                @foreach (var item in Model.Water_Type)
                {
                    <div class="plan-item" data-id="@item.SYR" data-PID="@item.PID" data-Water_Type="@item.Water_Type" hidden>

                        <input type="checkbox" data-id="@item.SYR" data-PID="@item.PID" data-Water_Type="@item.Water_Type" name="plan" value="@item.SYR+@item.AN_PJ_NAME+@item.PJ_NAME" class="Plan-checkbox" />
                        <span>(@item.SYR)@item.AN_PJ_NAME-@item.PJ_NAME</span>
                        <br />
                    </div>
                }
            </td>
        </tr>
        <tr>
            <td>
                異常狀況:
            </td>
            <td colspan="4">
                <select id="abnormal" name="abnormal">
                    <option value="0" data-cond="x">無</option>
                    <option value="1" data-cond="辦理情形">進度未登錄清單</option>
                    <option value="2" data-cond="進度差異(預定-實際)">施工落後表</option>
                    <option value="3" data-cond="實際竣工日期,實際驗收完成日期">已完工未驗收</option>
                    <option value="4" data-cond="預定竣工日期,實際竣工日期">逾期未完工表</option>
                </select>
            </td>
        </tr>
        <tr>
            <td>
                排列方式:
            </td>
            <td colspan="4">
                <input type="checkbox" name="Row" onclick="uncheckCancel()" />
                <span> </span>
                縣市在列
                <span> </span>
                <input type="checkbox" name="Field" onclick="uncheckFinish()" />
                <span> </span>
                縣市在欄
                <span> </span>
            </td>
        </tr>
        <tr>
            <td>
                縣市別:
            </td>
            <td colspan="4" id="City">
                <input type="checkbox" id="selectAll" onclick="toggleCheckboxes()">
                全選框
                <br />

                @for (int i = 0; i < 23; i++)
                {
                    if (i == 7 || i == 14 || i == 21)
                    {
                        <br />
                    }
                    <input type="checkbox" name="CITY" value="@Model.SMCPOSTN[i].CITY" class="city-checkbox" />
                    <span> </span>
                    @Model.SMCPOSTN[i].CITY
                    <span> </span>
                }
            </td>
        </tr>
        <tr>
            <td rowspan="30">
                顯示欄位:
            </td>
            <td colspan="4">
                <input type="checkbox" id="selectAll2" onclick="toggleCheckboxes2()">
                全選框
                <span>　</span>
                <input type="checkbox" id="selectAll3" onclick="toggleCheckboxes3()">
                擴充工程基本資料
                <span>　</span>
                <input type="checkbox" id="selectAll4" onclick="toggleCheckboxes4()">
                經費支用情形
                <span>　</span>
                <input type="checkbox" id="selectAll5" onclick="toggleCheckboxes5()">
                工作控制點
                <br />
            </td>
        </tr>

        @* 20241022 修改項目 => 新增欄位需求 *@
        @***@
        @for (int i = 0; i < Model.OGCTITLE.Count; i++) //-k 2411-2 修改i < xxx的條件
        {
            if (i > 1 && i % 4 == 0)
            {
                @:<tr>
                }
                if (Model.OGCTITLE[i].TITLE == "工程地點(址)")
                {
                    <td>
                        <input type="checkbox" name="COLUMN1" checked="checked" value="@Model.OGCTITLE[i].TITLE" hidden />
                    </td>
                }
                else if (Model.OGCTITLE[i].TITLE == "縣市別" ||
                        Model.OGCTITLE[i].TITLE == "雨水管線新(改)建長度(m)" ||
                        Model.OGCTITLE[i].TITLE == "雨水管線修繕長度(m)" ||
                        Model.OGCTITLE[i].TITLE == "滯洪量(m3)" ||
                        Model.OGCTITLE[i].TITLE == "總抽水量(CMS)" ||
                        Model.OGCTITLE[i].TITLE == "水位計站數")
                {
                }
                else
                {
                    <td>
                        <input type="checkbox" name="COLUMN1" data-id="@Model.OGCTITLE[i].ID" value="@Model.OGCTITLE[i].TITLE" class="column-checkbox" />
                        <span> </span>
                        @Model.OGCTITLE[i].TITLE
                        <span> </span>
                    </td>
                }
                if (i % 4 == 3)
                {
                @:</tr><tr>
                }
            }
    </tr> @* 關閉最後一行 *@
    <tr>
        <td colspan="5" align="center">
            <button type="submit"> EXCEL匯出</button>
            <button type="submit" name="pdf" value="1">ODS匯出</button>
        </td>
    </tr>
</table>
</form>

@section scripts {
    <script type="text/javascript">
        var reportUrl = '@Url.Action("ReportPrint9", "Report")';
        var stateUrl = '@Url.Action("ChooseState", "Report")';
    </script>

    <script src="~/Scripts/Report/State9.js" type="text/javascript"></script>

    <script>
        $(document).ready(function () {
            // 監聽：計畫種類(Radio)、起點年度、終點年度 的變更事件
            $('input[name="water_type"], #yearStart, #yearEnd').on('change', function () {
                filterPlans();
            });

            function filterPlans() {
                // 1. 取得目前選取的計畫種類 (如果沒選則為 undefined)
                var selectedType = $('input[name="water_type"]:checked').val();

                // 2. 取得選取的起點與終點年度數字
                var startYear = parseInt($('#yearStart').val());
                var endYear = parseInt($('#yearEnd').val());

                // 【防呆機制】
                // 如果「計畫種類」或「年度區間」其中一個還沒選好，就維持全部隱藏
                if (!selectedType || isNaN(startYear) || isNaN(endYear)) {
                    $('.plan-item').attr('hidden', true);
                    return;
                }

                // 如果起點年度大於終點年度，提示使用者並中止
                if (startYear > endYear) {
                    alert('起點年度不能大於終點年度');
                    return;
                }

                // 3. 跑迴圈檢查每一個計畫項目
                $('.plan-item').each(function () {
                    var $item = $(this);
                    var planYear = parseInt($item.data('id'));         // 取得該計畫的年度 (data-id)
                    var planType = $item.data('water_type');          // 取得該計畫的種類 (data-Water_Type)

                    // 條件：年度必須在區間內，且 種類必須完全相符
                    var isYearMatch = (planYear >= startYear && planYear <= endYear);
                    var isTypeMatch = (planType === selectedType);

                    if (isYearMatch && isTypeMatch) {
                        $item.removeAttr('hidden'); // 同時滿足兩個條件，顯示
                    } else {
                        $item.attr('hidden', true);  // 不滿足，隱藏

                        // 安全機制：被隱藏的項目自動取消勾選，避免送出錯誤資料
                        $item.find('.Plan-checkbox').prop('checked', false);
                    }
                });
            }
        });
    </script>

}