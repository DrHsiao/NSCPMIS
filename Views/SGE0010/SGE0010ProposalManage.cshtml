@using PagedList.Mvc
@model WCals.ViewModels.NewModels.SGE0010Model
@{ ViewBag.Title = "提案初審作業[2.2.2] ";
    Layout = "~/Views/Shared/_Layout2_v2.cshtml"; }

@section head{


    <style>
        .ui-dialog {
            z-index: 4000;
        }
    </style>
}
<div class="row">
    <div class="col-lg-12">
        <h1 class="h2 border-bottom pb-2 mb-3">
            提案初審作業[2.2.2]
            <small class="text-muted fs-6">@ViewBag.PJ_NAME</small>
        </h1>
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <i class="fa-solid fa-gauge"></i><a href="@Url.Content("~/")Home"> 首頁</a>
            </li>
            <li class="breadcrumb-item active">
                <i class="fa-solid fa-file"></i>
                <a href="@Url.Content("~/")SGE0010">提案初審作業[2.2.2]</a>
            </li>
            <li class="breadcrumb-item active">
                <i class="fa-solid fa-file"></i>
                提案管理
            </li>
        </ol>
    </div>
</div>


@using (Html.BeginForm("", "SGE0010", FormMethod.Post, new { id = "mainForm" }))
{
    @Html.HiddenFor(x => x.keyword)
    @Html.HiddenFor(x => x.page1)
    @Html.HiddenFor(x => x.page2)
    @Html.HiddenFor(x => x.AID)
    @Html.HiddenFor(x => x.tab)
    @Html.HiddenFor(x => x.PPID)

    <div style="display:flex;width:100%">
        <div style="width:50%; text-align:left;">
            <table>
                <tr>
                    <td style="padding-left:5px;" class="col-md-4">
                        @Html.DropDownListFor(x => x.YRC_ID, (SelectList)ViewBag.yrcs, new { @class = "form-select", form = "mainForm" })
                    </td>
                    <td class="col-md-2">
                        @Html.DropDownListFor(x => x.city, (SelectList)ViewBag.cities, "所有縣市", new { @class = "form-select", form = "mainForm" })
                    </td>
                    <td class="col-md-3">
                        @Html.TextBoxFor(x => x.keyword2, new { @class = "form-control", placeholder = "輸入工程名稱...", form = "mainForm" })
                    </td>
                    <td class="text-nowrap">

                        <button class="btn btn-secondary" name="action" type="submit" value="ProposalSearch">查詢</button>

                        @if ((/*Model.PJMFORM.STAT_NO.Equals("R") ||*/ Model.PJMFORM.STAT_NO.Equals("S")) && Model.tab == 3)
                        {
                            <button class="btn btn-secondary" name="action" type="submit" value="ExportScoreToExcel">評分表</button>
                            <button class="btn btn-secondary" name="action" type="submit" value="ExportDetailsToExcel">明細表</button>
                        }
                        @if (Model.PJMFORM.STAT_NO.Equals("R") && Model.tab ==1)
                        {
                            <button class="btn btn-secondary" name="action" type="submit" value="ExportScoreToExcel">評分表</button>
                            <button class="btn btn-secondary" name="action" type="submit" value="ExportDetailsToExcel">明細表</button>
                        }
                        @* 20260427 版本修改 => 環境改善計畫，每個頁籤都要有 "評分表" || "明細表" *@
                        else if (Model.PJMFORM.STAT_NO.Equals("E") && (Model.tab >= 1 && Model.tab <= 8))
                        {
                            <button class="btn btn-secondary" name="action" type="submit" value="ExportEnvironmentScoreToExcel">評分表</button>
                            <button class="btn btn-secondary" name="action" type="submit" value="ExportEnvironmentDetailsToExcel">明細表</button>
                        }

                        <a class="btn btn-secondary" href="@Url.Content("~/")SGE0010?page1=@Model.page1">返回</a>
                    </td>
                </tr>
            </table>
        </div>
        @if (Model.List1 != null)
        {
            <div style="width: 50%; text-align: right;">
                @Html.PagedListPager(Model.List1, page2 => Url.Action("ProposalManage",
                    new
                         {
                        page1 = Model.page1,
                        page2 = page2,
                        tab = Model.tab,
                        ppid = @Model.PPID,
                        yrcid = @Model.YRC_ID,
                        city = Model.city,
                        keyword2 = Model.keyword2
                    }),
                    new PagedListRenderOptions
                         {
                        DisplayItemSliceAndTotal = true,
                        DisplayPageCountAndCurrentLocation = true,
                        DisplayLinkToLastPage = PagedListDisplayMode.Never,
                        DisplayLinkToIndividualPages = false,
                        ItemSliceAndTotalFormat = "顯示第 {0} - {1}筆, 共{2}筆",
                        PageCountAndCurrentLocationFormat = "第 {0}頁 / 共 {1}頁",
                    }
                )
            </div>
        }
    </div>

    <div class="card with-nav-tabs border-primary">
        <div class="card-header bg-primary text-white">
            <ul class="nav nav-tabs">
                @if (Model.tab == 1)
                {
                    <li role="presentation" class="nav-item"><a href="@Url.Content("~/")SGE0010/ProposalManage?tab=1&ppid=@Model.PPID&yrc=@Model.YRC&page1=@Model.page1&page2=1&yrcid=@Model.YRC_ID&city=@Model.city&keyword2=@Model.keyword2" class="nav-link active">提案中</a></li>
                }
                else
                {
                    <li class="nav-item"><a role="presentation" href="@Url.Content("~/")SGE0010/ProposalManage?tab=1&ppid=@Model.PPID&yrc=@Model.YRC&page1=@Model.page1&page2=1&yrcid=@Model.YRC_ID&city=@Model.city&keyword2=@Model.keyword2" class="nav-link">提案中</a></li>
                }
                @if (Model.tab == 2)
                {
                    <li class="nav-item"><a href="@Url.Content("~/")SGE0010/ProposalManage?tab=2&ppid=@Model.PPID&yrc=@Model.YRC&page1=@Model.page1&page2=1&yrcid=@Model.YRC_ID&city=@Model.city&keyword2=@Model.keyword2" class="nav-link active">待收件</a></li>
                }
                else
                {
                    <li class="nav-item"><a href="@Url.Content("~/")SGE0010/ProposalManage?tab=2&ppid=@Model.PPID&yrc=@Model.YRC&page1=@Model.page1&page2=1&yrcid=@Model.YRC_ID&city=@Model.city&keyword2=@Model.keyword2" class="nav-link">待收件</a></li>
                }
                @if (Model.tab == 3)
                {
                    <li class="nav-item"><a href="@Url.Content("~/")SGE0010/ProposalManage?tab=3&ppid=@Model.PPID&yrc=@Model.YRC&page1=@Model.page1&page2=1&yrcid=@Model.YRC_ID&city=@Model.city&keyword2=@Model.keyword2" class="nav-link active">初審中</a></li>
                }
                else
                {
                    <li class="nav-item"><a href="@Url.Content("~/")SGE0010/ProposalManage?tab=3&ppid=@Model.PPID&yrc=@Model.YRC&page1=@Model.page1&page2=1&yrcid=@Model.YRC_ID&city=@Model.city&keyword2=@Model.keyword2" class="nav-link">初審中</a></li>
                }
                @if (Model.tab == 4)
                {
                    <li class="nav-item"><a href="@Url.Content("~/")SGE0010/ProposalManage?tab=4&ppid=@Model.PPID&yrc=@Model.YRC&page1=@Model.page1&page2=1&yrcid=@Model.YRC_ID&city=@Model.city&keyword2=@Model.keyword2" class="nav-link active">複審中</a></li>
                }
                else
                {
                    <li class="nav-item"><a href="@Url.Content("~/")SGE0010/ProposalManage?tab=4&ppid=@Model.PPID&yrc=@Model.YRC&page1=@Model.page1&page2=1&yrcid=@Model.YRC_ID&city=@Model.city&keyword2=@Model.keyword2" class="nav-link">複審中</a></li>
                }
                @if (Model.tab == 5)
                {
                    <li class="nav-item"><a href="@Url.Content("~/")SGE0010/ProposalManage?tab=5&ppid=@Model.PPID&yrc=@Model.YRC&page1=@Model.page1&page2=1&yrcid=@Model.YRC_ID&city=@Model.city&keyword2=@Model.keyword2" class="nav-link active">核定中</a></li>
                }
                else
                {
                    <li class="nav-item"><a href="@Url.Content("~/")SGE0010/ProposalManage?tab=5&ppid=@Model.PPID&yrc=@Model.YRC&page1=@Model.page1&page2=1&yrcid=@Model.YRC_ID&city=@Model.city&keyword2=@Model.keyword2" class="nav-link">核定中</a></li>
                }
                @if (Model.tab == 6)
                {
                    <li class="nav-item"><a href="@Url.Content("~/")SGE0010/ProposalManage?tab=6&ppid=@Model.PPID&yrc=@Model.YRC&page1=@Model.page1&page2=1&yrcid=@Model.YRC_ID&city=@Model.city&keyword2=@Model.keyword2" class="nav-link active">已成案</a></li>
                }
                else
                {
                    <li class="nav-item"><a href="@Url.Content("~/")SGE0010/ProposalManage?tab=6&ppid=@Model.PPID&yrc=@Model.YRC&page1=@Model.page1&page2=1&yrcid=@Model.YRC_ID&city=@Model.city&keyword2=@Model.keyword2" class="nav-link">已成案</a></li>
                }
                @if (Model.tab == 7)
                {
                    <li class="nav-item"><a href="@Url.Content("~/")SGE0010/ProposalManage?tab=7&ppid=@Model.PPID&yrc=@Model.YRC&page1=@Model.page1&page2=1&yrcid=@Model.YRC_ID&city=@Model.city&keyword2=@Model.keyword2" class="nav-link active">未過初審</a></li>
                }
                else
                {
                    <li class="nav-item"><a href="@Url.Content("~/")SGE0010/ProposalManage?tab=7&ppid=@Model.PPID&yrc=@Model.YRC&page1=@Model.page1&page2=1&yrcid=@Model.YRC_ID&city=@Model.city&keyword2=@Model.keyword2" class="nav-link">未過初審</a></li>
                }
                @if (Model.tab == 8)
                {
                    <li class="nav-item"><a href="@Url.Content("~/")SGE0010/ProposalManage?tab=8&ppid=@Model.PPID&yrc=@Model.YRC&page1=@Model.page1&page2=1&yrcid=@Model.YRC_ID&city=@Model.city&keyword2=@Model.keyword2" class="nav-link active">未過複審</a></li>
                }
                else
                {
                    <li class="nav-item"><a href="@Url.Content("~/")SGE0010/ProposalManage?tab=8&ppid=@Model.PPID&yrc=@Model.YRC&page1=@Model.page1&page2=1&yrcid=@Model.YRC_ID&city=@Model.city&keyword2=@Model.keyword2" class="nav-link">未過複審</a></li>
                }
            </ul>

        </div>
        <div class="card-body">
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane active" id="tab1">
                    @if (Context.Request.Params["tab"] == "2" && ViewBag.noTab == null)
                    {
                        <table>
                            <tr>
                                <td align="right"><button onclick="return (confirm('確定收件?')); void ('')" class="btn btn-info" name="action" type="submit" value="CheckMyProposal">依行政轄區收件</button></td>
                            </tr>
                        </table>

                    }

                    @if (Model.List1 != null)
                    {
                        if (Request.Params["tab"] == "3" && ViewBag.noTab == null)
                        {
                            <div style="text-align: left; margin-bottom: 10px;">
                                <button type="button" class="btn btn-success btn-sm" onclick="batchSendForwardSecond()">批次送件</button>
                                <!-- 💡 新增的批次退件按鈕 -->
                                <button type="button" class="btn btn-warning btn-sm" onclick="batchSendBackward()">批次退件</button>
                            </div>
                        }

                        <div style="overflow: auto;">
                            <table width="100%" class="table table-hover" style="overflow-x: auto; white-space: nowrap;">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 40px; text-align: center;">
                                            <input type="checkbox" id="checkAll" />
                                        </th>
                                        <th></th> @*<th>提案編號</th>*@
                                        <th>提案計畫名稱</th>
                                        <th>提案工程名稱</th>
                                        <th>年度</th>
                                        <th>縣市別</th>
                                        <th>鄉鎮別
                                        <th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (System.Data.DataRow c in Model.List1)
                                    {
                                        <tr>
                                            <td style="text-align: center; vertical-align: middle;">
                                                @if (Request.Params["tab"] == "3" && ViewBag.noTab == null)
                                                {
                                                    <input type="checkbox" class="chkItem" value="@c["AID"]" />
                                                }
                                            </td>
                                            <td><button type="button" class="btn btn-secondary btn-sm" onclick="getAPDPROC('@c["AID"]')"><span class="fa-solid fa-align-justify" aria-hidden="true"></span></button></td>
                                            @*<td>@c["AP_CODE"]</td>*@
                                            <td>@c["AP_PJ_NAME"] @c["PJ_CATY_CODE"]</td>
                                            <td>@c["AP_NAME"]</td>
                                            <td>@c["SYR"]</td>
                                            <td>@c["CITY"]</td>
                                            <td>@c["TOWN"]</td>
                                            <td>

                                                @if (Request.Params["tab"] == null || ViewBag.noTab != null)
                                                {
                                                    <button class="btn btn-primary" type="button" onclick="viewAPMFORM('@c["AID"]')">內容</button>

                                                }


                                                @if (Request.Params["tab"] == "1" && ViewBag.noTab == null)
                                                {
                                                    <button class="btn btn-primary" type="button" onclick="viewAPMFORM('@c["AID"]')">內容</button>

                                                }

                                                @if (Request.Params["tab"] == "2" && ViewBag.noTab == null)
                                                {
                                                    <button class="btn btn-primary" type="button" onclick="viewAPMFORM('@c["AID"]')">內容</button>
                                                    <button class="btn btn-success" name="action" onclick="$('#AID').val('@c["AID"]'); return (confirm('確定收件?')); void ('');" value="SendForward">收件</button>

                                                }

                                                @if (Request.Params["tab"] == "3" && ViewBag.noTab == null)
                                                {
                                                    <button class="btn btn-primary" type="button" onclick="viewAPMFORM('@c["AID"]')">內容</button>
                                                    <button class="btn btn-secondary" type="button" onclick="editAdvice('@c["AID"]')">初審記錄</button>
                                                    <button class="btn btn-success" name="action" onclick="$('#AID').val('@c["AID"]');return (confirm('確定送件?')); void ('');" value="SendForwardSecond">送件</button>

                                                    <button class="btn btn-warning" onclick="showReson('@c["AID"]', 1);" type="button">退件</button>
                                                    <button class="btn btn-danger" onclick="showReson('@c["AID"]', 2);" type="button">未過初審</button>
                                                }

                                                @if (Request.Params["tab"] == "4" && ViewBag.noTab == null)
                                                {
                                                    <button class="btn btn-primary" type="button" onclick="viewAPMFORM('@c["AID"]')">內容</button>
                                                    <button class="btn btn-secondary" type="button" onclick="editAdviceReadonly('@c["AID"]')">審查記錄</button>
                                                }

                                                @if (Request.Params["tab"] == "5" && ViewBag.noTab == null)
                                                {
                                                    <button class="btn btn-primary" type="button" onclick="viewAPMFORM('@c["AID"]')">內容</button>
                                                    <button class="btn btn-secondary" type="button" onclick="editAdviceReadonly('@c["AID"]')">審查記錄</button>
                                                }

                                                @if (Request.Params["tab"] == "6" && ViewBag.noTab == null)
                                                {
                                                    <button class="btn btn-primary" type="button" onclick="viewAPMFORM('@c["AID"]')">內容</button>
                                                    <button class="btn btn-secondary" type="button" onclick="editAdviceReadonly('@c["AID"]')">審查記錄</button>
                                                }

                                                @if (Request.Params["tab"] == "7" && ViewBag.noTab == null)
                                                {
                                                    <button class="btn btn-primary" type="button" onclick="viewAPMFORM('@c["AID"]')">內容</button>
                                                    <button class="btn btn-secondary" type="button" onclick="editAdviceReadonly('@c["AID"]')">審查記錄</button>
                                                    <button class="btn btn-secondary" name="action" onclick="$('#AID').val('@c["AID"]');return (confirm('確定恢復狀態?')); void ('');" value="SendPrevious">重新審核</button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>




    <div id="resonFrame" title="原因" style="padding:0px;">
        <table width="100%">
            <tr>
                <td><textarea name="PRC_NOTE" class="form-control" style="width:100%; height:260px;" form="mainForm"></textarea></td>
            </tr>
            <tr>
                <td align="center" style="padding:5px;">
                    <button class="btn btn-primary" name="action" id="SendBackward" value="SendBackward" form="mainForm">退件</button>
                    <button class="btn btn-danger" name="action" id="SendDroppend" value="SendDroppend" form="mainForm">未過初審</button>
                </td>
            </tr>
        </table>
    </div>

    if (Model.List1 != null)
    {
        string yrcid = Model.YRC_ID;
        @Html.PagedListPager(Model.List1, page2 => Url.Action("ProposalManage",
                         new
                         {
                             page1 = Model.page1,
                             page2 = page2,
                             tab = Model.tab,
                             ppid = Model.PPID,
                             yrcid = yrcid,
                             city = Model.city,
                             keyword2 = Model.keyword2
                         }))

    }

    <div id="viewFrame" title="檢視" style="padding:1px;">

        <iframe id="viewer" src="" style="width: 100%; height: 100%; border: 0px; "></iframe>


    </div>

    <div id="editAdvice" title="初審記錄" style="padding:1px;">

        <iframe id="advicer" src="" style="width:100%; height:100%; border:0px;"></iframe>


    </div>

    <div id="histFrame" title="歷程" style="padding:0px;">

        <div style="overflow: auto;">
            <table class="table">
                <thead class="table-light">
                    <tr>
                        <th>動作*</th>
                        <th>新狀態</th>
                        <th>執行人員</th>
                        <th>執行時間</th>
                        <th>備註</th>
                    </tr>
                </thead>
                <tbody id="hister"></tbody>
            </table>
            <button type="button" class="btn btn-secondary" onclick='$("#histFrame").dialog("close");'>關閉</button>
        </div>

    </div>

    <div id="editFrame" title="編輯" style="padding:0px;">

        <iframe id="editor" src="" style="border:0px;"></iframe>

    </div>

}

<script>
    // 💡 擴充 showReson 以支援「批次作業」參數 (isBatch)
    function showReson(aid, type, isBatch) {

        if (type == 1) {
            //退件
            $("#SendBackward").show();
            $("#SendDroppend").hide();

            // 💡 動態調整 Button 的 Value，讓後端知道是單筆還是批次
            if (isBatch) {
                $("#SendBackward").val("SendBackwardBatch");
            } else {
                $("#SendBackward").val("SendBackward");
            }
        } else {
            //未通過
            $("#SendBackward").hide();
            $("#SendDroppend").show();
        }

        $('#AID').val(aid);
        $("#resonFrame").dialog("open");
    }

    function CloseEditAdvice() {
        $("#editAdvice").dialog("close");
    }


    $(function () {


        var h = $(window).height();
        var w = $(window).width();

        var h1 = h * 0.7;
        var w1 = w * 0.7;

        $("#viewFrame").dialog({
            autoOpen: false,
            show: {
                //effect: "blind",
                //effect: "drop",
                duration: 1000
            },
            hide: {
                //effect: "explode",
                //effect: "drop",
                duration: 1000
            },
            autoOpen: false,
            maxWidth: 1440,
            maxHeight: 900,
            width: 1024,
            height:640,
            modal: true
        });

        $("#editAdvice").dialog({
            autoOpen: false,
            show: {
                //effect: "blind",
                //effect: "drop",
                duration: 1000
            },
            hide: {
                //effect: "explode",
                //effect: "drop",
                duration: 1000
            },
            autoOpen: false,
            maxWidth: w,
            maxHeight: h,
            width: w1,
            height: h1,
            modal: true
        });

        $("#resonFrame").dialog({
            autoOpen: false,
            show: {
                //effect: "blind",
                //effect: "drop",
                duration: 1000
            },
            hide: {
                //effect: "explode",
                //effect: "drop",
                duration: 1000
            },
            autoOpen: false,
            maxWidth: w,
            maxHeight: h,
            width: w1,
            height: h1,
            modal: true
        });

        $("#histFrame").dialog({
            autoOpen: false,
            show: {
                //effect: "blind",
                //effect: "drop",
                duration: 1000
            },
            hide: {
                //effect: "explode",
                //effect: "drop",
                duration: 1000
            },
            autoOpen: false,
            maxWidth: w,
            maxHeight: h,
            width: w1,
            height: h1,
            modal: true
        });

        $("#editor").width(w - 200);
        $("#editor").height(h);
        $("#editFrame").dialog({
            autoOpen: false,
            show: {
                //effect: "blind",
                //effect: "drop",
                duration: 1000
            },
            hide: {
                //effect: "explode",
                //effect: "drop",
                duration: 1000
            },
            autoOpen: false,
            //maxWidth: w,
            //maxHeight: h,
            width: w - 200,
            height: h - 100,
            modal: true
        });

    });
    function viewAPMFORM(aid) {
        //$("#viewer").attr("src","@Url.Content("~/SGE0000/ViewAPMFORM")?aid="+aid );
        $("#viewer").attr("src", "@Url.Content("~/SGE0000/STEP01")?aid=" + aid+"&dis=true");
        $("#viewFrame").dialog("open");

    }

    function editAdvice(aid) {

        $("#advicer").attr("src","@Url.Content("~/SGE0010/EditAdvice")?aid="+aid );
        $("#editAdvice").dialog("open");
    }

    function editAdviceReadonly(aid) {

        $("#advicer").attr("src","@Url.Content("~/SGE0010/EditAdvice")?aid="+aid+"&locked=y");
        $("#editAdvice").dialog("open");
    }

    function getAPDPROC(aid) {

        $("#hister").html("");
        $("#histFrame").dialog("open");

        $.ajax({
            url: '@Url.Content("~/")ASYNC/GetAPDPROC',
            method: 'post',
            data: { "aid": aid },
            success: function (d) {
                var p = jQuery.parseJSON(d);

                for (i = 0; i < p.length; i++) {
                    p[i].UPD_DT = p[i].UPD_DT.replace(/T/, ' ');
                    $("#hister").append("<tr><td>" +
                        p[i].PROC_ACT + "</td><td>" + p[i].NAP_STAT + "</td><td>" + p[i].USR_NAME + "</td><td>" + p[i].UPD_DT + "</td><td>" + p[i].PRC_NOTE + "</td></tr>");
                    //$('#hister').append('<p>這是一段新內容</p>');
                }

            }
        });
    }

    function editAPMFORM(aid) {
        $("#editor").attr("src","@Url.Content("~/SGE0000/STEP01")?aid="+aid);
        $("#editFrame").dialog("open");
    }

    // 全選 / 全不選 功能
    $(function () {
        $("#checkAll").click(function () {
            var checkedStatus = this.checked;
            $(".chkItem").each(function () {
                $(this).prop("checked", checkedStatus);
            });
        });

        $(document).on('click', '.chkItem', function () {
            if (!$(this).prop("checked")) {
                $("#checkAll").prop("checked", false);
            } else {
                if ($(".chkItem:checked").length === $(".chkItem").length) {
                    $("#checkAll").prop("checked", true);
                }
            }
        });
    });

    // 批次送件 功能
    function batchSendForwardSecond() {
        var selectedAids = [];
        $('.chkItem:checked').each(function () {
            selectedAids.push($(this).val());
        });

        if (selectedAids.length === 0) {
            alert("請至少勾選一筆要送件的資料！");
            return;
        }

        if (confirm("確定要將勾選的 " + selectedAids.length + " 筆資料批次送件嗎？")) {
            $('#AID').val(selectedAids.join(','));

            // 對應到後端的 Action 名稱：SendForwardSecondBatch
            $('<input>').attr({
                type: 'hidden',
                name: 'action',
                value: 'SendForwardSecondBatch'
            }).appendTo('#mainForm');

            $('#mainForm').submit();
        }
    }

    // 💡 批次退件 功能
    function batchSendBackward() {
        var selectedAids = [];
        $('.chkItem:checked').each(function () {
            selectedAids.push($(this).val());
        });

        if (selectedAids.length === 0) {
            alert("請至少勾選一筆要退件的資料！");
            return;
        }

        // 將多筆 ID 串成字串傳給 showReson，並標示為批次作業(isBatch = true)
        showReson(selectedAids.join(','), 1, true);
    }

</script>


