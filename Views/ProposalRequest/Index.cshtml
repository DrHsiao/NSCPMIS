<script>
    function Search() {
        var Search_thing = document.getElementById('TD_NAME_SEARCH').value;
        $.ajax({
            url: '@Url.Action("Search","ProposalRequest")',
            type: 'POST',
            data: { Search_thing: Search_thing },
            success: function (result) {
                var page = document.getElementById('page');
                page.textContent = 1;
                var Count = document.getElementById('count_page');
                var Count_Value = Math.round(parseInt(result.length) / 10);
                Count.textContent = "共" + Count_Value + "頁";
                const tableBody = document.querySelector('table.table-bordered tbody');
                tableBody.innerHTML = '';
                var i = 1;
                // 遍歷返回的數據,創建新的表格行
                result.forEach(item => {

                    if (i === 11) { // 如果計數器達到 11 (即第10次迭代)
                        return; // 退出迭圈
                    }
                    const row = document.createElement('tr');
                    const selectCell = document.createElement('td');
                    const selectButton = document.createElement('button');
                    selectButton.type = 'button';
                    selectButton.id = 'TD_NAME_Button';
                    selectButton.value = item.TD_NAME;
                    selectButton.textContent = '選擇';
                    selectButton.setAttribute('data-dismiss', 'modal'); // 添加 data-bs-dismiss="modal" 屬性
                    selectCell.appendChild(selectButton);

                    const codeCell = document.createElement('td');
                    codeCell.textContent = item.TD_CODE;

                    const nameCell = document.createElement('td');
                    nameCell.textContent = item.TD_NAME;

                    const cityCell = document.createElement('td');
                    cityCell.textContent = item.TD_CITY;

                    const townCell = document.createElement('td');
                    townCell.textContent = item.TD_TOWN;

                    row.appendChild(selectCell);
                    row.appendChild(codeCell);
                    row.appendChild(nameCell);
                    row.appendChild(cityCell);
                    row.appendChild(townCell);

                    tableBody.appendChild(row);

                    i++;
                });
            }

        })
    }
</script>

