<script>
 $(function () {
    $("#CITY").change(function () {
        var SelectValue = $(this).val();
        $.ajax({
            url: '@Url.Action("GetTown","ProposalRequest")',
            type: 'POST',
            data: { CITY: SelectValue },
            success: function (result) {
                // 獲取所有 class="Town" 的 <select> 元素
                var townSelects = document.querySelectorAll('.Town');

                // 遍歷每個 <select> 元素
                townSelects.forEach(function (townSelect) {
                    // 清空現有的選項
                    townSelect.innerHTML = "<option value='' disabled selected>請選擇一個鄉鎮</option>";

                    // 遍歷 result 列表,並將每個值作為新選項插入到 <select> 中
                    result.forEach(function (result) {
                        var option = document.createElement("option");
                        option.value = result.TOWNName;
                        option.text = result.TOWNName;
                        townSelect.appendChild(option);
                    });
                });
            }
        })
    })
})
</script>

