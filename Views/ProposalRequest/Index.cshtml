        const cityBlocks = document.querySelectorAll('#FirstCity .city-block');
        let lastId = 0;

        cityBlocks.forEach(function (cityBlock) {
            const id = parseInt(cityBlock.id.replace('City', ''));
            if (id > lastId) {
                lastId = id;
            }
        });

        return lastId;
    }



