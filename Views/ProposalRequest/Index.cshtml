<script>
    // 獲取下拉選單元素
    const selectElement = document.getElementById('TD_TYPE');

    // 獲取需要操作的 div 元素
    const divElement = document.getElementById('Change');

    // 監聽下拉選單的 change 事件
    selectElement.addEventListener('change', function () {
        // 如果下拉選單的值為 "新建工程"
        if (this.value === 'false') {
            // 尋找 div 內部 id 為 "TD_CODE" 的 input 元素
            const inputElement = divElement.querySelector('#TD_NAME');

            // 如果找到該 input 元素
            if (inputElement) {
                // 將其從 DOM 中移除
                inputElement.remove();
            }

            divElement.innerHTML += '<input type="text" required id="TD_NAME" name="AP_NAME" placeholder="工程名稱："/>';

        } else {

            const inputElement = divElement.querySelector('#TD_NAME');

            // 如果找到該 input 元素
            if (inputElement) {
                // 將其從 DOM 中移除
                inputElement.remove();
            }
            // 直接使用 innerHTML 添加 HTML 標籤
            divElement.innerHTML += '<input type="text" required id="TD_NAME" name="AP_NAME" placeholder="工程名稱：" data-bs-toggle="modal" data-bs-target="#myModal" class="modal-dialog modal-lg" />';
        }
    });
</script>

