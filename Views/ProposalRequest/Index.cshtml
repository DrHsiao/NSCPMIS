<script>
    window.addEventListener('DOMContentLoaded', function () {
        const firstCity = document.getElementById('FirstCity');
        const firstTown = document.getElementById('FirstTown');

        firstCity.addEventListener('click', function (event) {
            const button = event.target.closest('.city-block button.closebtn');
            if (button) {
                const citySource = button.parentNode.nextElementSibling;
                if (citySource.style.display === 'none') {
                    citySource.style.display = 'block';
                    button.textContent = '-';
                } else {
                    citySource.style.display = 'none';
                    button.textContent = '+';
                }
            }
        });

        firstTown.addEventListener('click', function (event) {
            const button = event.target.closest('.Town-block button.closebtn');
            if (button) {
                const TownSource = button.parentNode.nextElementSibling;
                if (TownSource.style.display === 'none') {
                    TownSource.style.display = 'block';
                    button.textContent = '-';
                } else {
                    TownSource.style.display = 'none';
                    button.textContent = '+';
                }
            }
        });
    });
</script>

