@model WCals.Models.CMBASEModels.DeptViewModel

@{
    ViewBag.Title = "部門管理";
    Layout = "~/Views/Shared/_Layout2_v2.cshtml";
}

@section head{
    <link rel="stylesheet" href="~/Content/views/tree-view.css">
}

<div class="row">
    <div class="col-lg-12">
        <h1 class="h2 border-bottom pb-2 mb-3">
            部門管理 [99.1.2]

            <small> 部門管理</small>
        </h1>
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <i class="fa-solid fa-dashboard"></i><a href="@Url.Content("~/Home")"> 首頁</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                <i class="fa-solid fa-file"></i>
                部門管理 [99.1.2]
            </li>
        </ol>
    </div>
</div>

<table>
    <tr>
        <td height="600" style="padding:20px;" valign="top">
            <ul id="tree1">
                <li>
                    <span><i class="fa-solid fa-minus-square"></i> 內政部國土管理署</span>
                    @foreach (var item1 in Model.Dept1)
                    {
                        <ul>
                            <li>
                                <a href="#" id="@item1.DEPT_NO" onClick="TreeViewClick(this)">@item1.DEPT_NAME</a>

                                @foreach (var item2 in Model.Dept2.Where(m => m.AN_DEPT_NO == item1.DEPT_NO))
                                {
                                    <ul>
                                        <li>
                                            <a href="#" id="@item2.DEPT_NO" onClick="TreeViewClick(this)">@item2.DEPT_NAME</a>

                                            @if (Model.Dept2.Where(m => m.AN_DEPT_NO == item2.DEPT_NO).Count() == 0)
                                            {

                                            }
                                            @foreach (var item3 in Model.Dept2.Where(m => m.AN_DEPT_NO == item2.DEPT_NO))
                                            {
                                                <ul>
                                                    <li>

                                                        <a href="#" id="@item3.DEPT_NO" onClick="TreeViewClick(this)">@item3.DEPT_NAME</a>

                                                    </li>
                                                </ul>
                                            }
                                        </li>
                                    </ul>
                                }
                            </li>
                        </ul>
                    }
                </li>
            </ul>
        </td>
        <td style="padding:20px;" valign="top">
            <a href="@Url.Action("Create", "Dept")" class="btn btn-primary">
                新增部門
            </a>
            <h1>部門資訊</h1>
            <table class="table" id="dept">
                <tr>
                    <th>部門編號</th>
                    <th>部門名稱</th>
                    <th>經管部門</th>
                    <th>部門主管</th>
                </tr>
            </table>
            <h1>部門使用者</h1>
            <table class="table" id="user">
                <tr>
                    <th>使用者編號</th>
                    <th>使用者名稱</th>
                </tr>
            </table>
            <table>
            </table>
        </td>
    </tr>
</table>

@{
    string EditUrl = Url.Action("Edit", "Dept");
    string DeleteUrl = Url.Action("Delete", "Dept");
}

@section scripts {

    <script type="text/javascript" language="javascript">

    function TreeViewClick(element)
    {
        //所選到的權限文字變色
        const className = 'selected';
        const links = document.querySelectorAll('a.' + className);
        links.forEach(link => {
            link.classList.remove(className);
        });
        element.classList.add(className);

        var clicked_id = element.id;
        $.ajax({
            url: '@Url.Action("TreeVieww", "Dept")',
            type: 'post',
            dataType: 'json',
            /*            contentType: 'application/json; charset=utf-8',*/
            data: { deptno: clicked_id }, //json format

            success: function (returnData) {
                //部門資訊
                $('#dept').empty();
                $("#dept").append("<th>部門編號</th><th>部門名稱</th><th>經管部門</th><th>部門主管</th>");
                for (var i = 0; i < 1; i++) {
                    var EditUrlWithId = "@EditUrl" + "?id=" + returnData[i].DEPT_NO;
                    var DeleteUrlWithId = "@DeleteUrl" + "?id=" + returnData[i].DEPT_NO;

                    $("#dept").append(
                        "<tr>" +
                        "<td>" + returnData[i].DEPT_NO + "</td>" +
                        "<td>" + returnData[i].DEPT_NAME + "</td>" +
                        "<td><input id=chkb type=checkbox disabled=disabled /></td>" +
                        "<td>" + returnData[i].DEPT_CHIEF + "</td>" +
                        "<td><a class='btn btn-primary' href='" + EditUrlWithId + "'>修改</a></td>" +
                        "<td><a class='btn btn-danger' href='" + DeleteUrlWithId + "'>刪除</a></td>" +
                        "</tr>"
                    );

                    var checkbox = document.getElementById('chkb');
                    checkbox.checked = returnData[i].MGR_FG;
                }
                //部門使用者
                $('#user').empty();
                $("#user").append("<th>使用者編號</th><th>使用者名稱</th>")
                for (var i = 0; i < returnData.length; i++) {
                    $("#user").append(
                        "<tr>" +
                        "<td>" + returnData[i].USR_ID + "</td>" +
                        "<td>" + returnData[i].USR_NAME + "</td>" +
                        "</tr>"
                    );
                }
            }
        });
    }
    </script>

    <script src="~/Scripts/User/tree-view.js" type="text/javascript"></script>
}