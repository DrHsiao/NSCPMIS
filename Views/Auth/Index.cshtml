@model WCals.Models.CMBASEModels.AuthViewModel

@{
    ViewBag.Title = "權限管理";
    Layout = "~/Views/Shared/_Layout2_v2.cshtml";
}

@section head{
    <link rel="stylesheet" href="~/Content/views/tree-view.css">
}

<div class="row">
    <div class="col-lg-12">
        <h1 class="h2 border-bottom pb-2 mb-3">
            權限管理 [99.1.4]

            <small> 權限管理</small>
        </h1>
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <i class="fa-solid fa-dashboard"></i><a href="@Url.Content("~/Home")"> 首頁</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                <i class="fa-solid fa-file"></i>
                權限管理 [99.1.4]
            </li>
        </ol>
    </div>
</div>

<table>
    <tr>
        <td height="600" style="padding:20px;" valign="top" width="50%">
            <ul id="tree1">
                <li>
                    <span>權限管理</span>
                    @foreach (var item1 in Model.menu1)
                    {
                        <ul>
                            <li>
                                <span class="li-toggle">@item1.SYS_NAME</span>

                                @foreach (var item2 in Model.menu2.Where(m => m.AN_SYS_ID == item1.SYS_ID))
                                {
                                    <ul>
                                        <li>
                                            <span>@item2.SYS_NAME</span>

                                            @foreach (var item3 in Model.menu3.Where(m => m.AN_SYS_ID == item2.SYS_ID))
                                            {
                                                <ul>
                                                    <li>
                                                        <span>
                                                            <a href="#" id="@item3.SYS_ID" onClick="TreeViewClick(this)">@item3.SYS_NAME</a>
                                                        </span>
                                                    </li>
                                                </ul>
                                            }
                                        </li>
                                    </ul>
                                }
                            </li>
                        </ul>
                    }
                </li>
            </ul>
        </td>
        <td style="padding:20px;" valign="top">
            <div id="add">

            </div>
            <h1>
                擁有權限部門列表
            </h1>
            <table class="table" style="width:440px" id="auth">
                <tr>
                    <th>部門編號</th>
                    <th>部門名稱</th>
                </tr>
            </table>
        </td>
    </tr>
</table>

@section scripts {

    <script type="text/javascript" language="javascript">
        function TreeViewClick(element) {
            //所選到的權限文字變色
            const className = 'selected';
            const links = document.querySelectorAll('a.' + className);
            links.forEach(link => {
                link.classList.remove(className);
            });
            element.classList.add(className);

            var clicked_id = element.id;
            $.ajax({
                url: '@Url.Action("Index", "Auth")',
                type: 'post',
                dataType: 'json',
                /*            contentType: 'application/json; charset=utf-8',*/
                data: { sysid: clicked_id }, //json format

                success: function (returnData) {
                    var count = 0;
                    /*部門資訊*/
                @{
                string createUrl = Url.Action("Create", "Auth");
                }
                    $('#auth').empty();
                    $('#add').empty();
                    var createUrlWithId = "@createUrl" + "?SYS_ID=" + clicked_id;
                    $("#add").append("<a class='btn btn-primary' href='" + createUrlWithId + "'>新增部門</a>");
                    $("#auth").append("<th>部門編號</th><th>部門名稱</th>");
                @{
                    string deleteUrl = Url.Action("Delete", "Auth");
                }

                    var deleteUrlstring = "@deleteUrl";
                    for (var i = 0; i < returnData.length; i++) {
                        $("#auth").append(
                            "<tr id=del_'" + count + "'>" +
                            "<td>" + returnData[i].DEPT_NO + "</td>" +
                            "<td>" + returnData[i].DEPT_NAME + "</td>" +
                            "<td><a  onclick = 'del(del_'" + count + "')' class='btn btn-danger' href='" + deleteUrlstring + "?DEPT_NO=" + returnData[i].DEPT_NO + "&SYS_ID=" + returnData[i].SYS_ID + "'>刪除</a></td>" +
                            "</tr>"
                        );
                    }
                }
            });
        }

    function del(sysid) {
        $(sysid).remove();
    }
    </script>

    <script src="~/Scripts/User/tree-view.js" type="text/javascript"></script>
}