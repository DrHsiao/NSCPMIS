@using PagedList.Mvc
@model WCals.ViewModels.NewModels.PJEModel
@{ ViewBag.Title = "分支工作計劃維護 [1.1.1]";
    Layout = "~/Views/Shared/_Layout2_v2.cshtml";

}
<div class="row">
    <div class="col-lg-12">
        <h1 class="h2 border-bottom pb-2 mb-3">
            分支工作計劃維護
            <small></small>
            <br /><small>@Model.CurrentProjectName</small>
        </h1>
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <i class="fa-solid fa-dashboard"></i><a href="@Url.Content("~/")Home"> 首頁</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                <i class="fa-solid fa-file"></i>
                <a href="@Url.Content("~/")PJE0010">工作計劃維護</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                <i class="fa-solid fa-file"></i>
                分支工作計劃維護 
            </li>
        </ol>
    </div>
</div>
@using(Html.BeginForm("", "PJE0010", FormMethod.Post, new { id = "mainForm" })) {



    <input type="hidden" name="PID" id="PID" value="@Model.PID" />
    <input type="hidden" name="SYR" id="SYR" value="@Model.SYR" />
    <input type="hidden" name="page" id="page" value="@Model.page" />
    <input type="hidden" name="branchPage" id="branchPage" value="@Model.branchPage" />
    <input type="hidden" name="ANPID" id="ANPID" value="@Model.ANPID" />
    <input type="hidden" name="EditPID" id="EditPID" />




    <div style="display:flex;width:100%">
        <div style="width:50%; text-align:left;">
            <button class="btn btn-success btn-lg" name="action" type="submit" value="BranchEdit">新增分支計畫</button>
            <a href="@Url.Content("~/")PJE0010?page=@Model.page" class="btn btn-secondary btn-lg">返回列表</a>
        </div>
        <div style="width: 50%; text-align: right;">
            @Html.PagedListPager(Model.PJV_PJMFORM, branchPage => Url.Action("Branch", "PJE0010",
                 new {
                          pid = Model.PID,
                          EditPID = Model.EditPID,
                          page = Model.page,
                          ANPID = Model.ANPID,
                          branchPage = branchPage
                      }),
                 new PagedListRenderOptions {
                     DisplayItemSliceAndTotal = true,
                     DisplayPageCountAndCurrentLocation = true,
                     DisplayLinkToLastPage = PagedListDisplayMode.Never,
                     DisplayLinkToIndividualPages = false,

                     ItemSliceAndTotalFormat = "顯示第 {0} - {1}筆, 共{2}筆",
                     PageCountAndCurrentLocationFormat = "第 {0}頁 / 共 {1}頁",
                 }
             )
        </div>
    </div>










    <script>
        $(window).on('load', function () {
            $('#EditPID').val("");
        });

        function delCheck(pid) {


            if (confirm('確定刪除?')) {
                $('#EditPID').val(pid);
            } else {
                void ('')
            }

        }
    </script>



    <div class="card border-primary mb-3">
        <div class="card-header bg-primary text-white">分支計畫</div>
        <table width="100%" class="table table-hover" style="display: block; overflow-x: auto; white-space: nowrap;">
            <thead class="table-light">
                <tr>
                    <th>計畫年度</th>
                    <th>計畫名稱</th>
                    <th>工作計畫編號</th>
                    <th>分支計畫編號</th>
                    <th>會計計畫編號</th>
                    <th>計畫序號</th>
                    <th>年度預算(元)</th>
                    <th>經管單位</th>
                    <th>經管人員</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach(var c in Model.PJV_PJMFORM) {
                    <tr>
                        <td>@c.PJ_SYR</td>
                        <td width="52%">@c.PJ_NAME</td>
                        <td>@c.WK_CODE</td>
                        <td>@c.PJ_CODE</td>
                        <td>@c.W_CODE</td>
                        <td>@c.GP_ORDER</td>
                        <td align="right">@String.Format("{0:#,##0.00}", c.PJ_FUND)</td>
                        <td>@c.ADV_DP_NAME</td>
                        <td>@c.ADV_UID_NAME</td>

                        <td>
                            <button class="btn btn-primary" name="action" type="submit" value="BranchEdit" onclick="$('#EditPID').val('@c.PID')">修改</button>
                            <button class="btn btn-danger" name="action" type="submit" value="BranchDel" onClick="delCheck('@c.PID')">刪除</button>
                            <button class="btn btn-primary" name="action" type="submit" value="Assign" onclick="$('#EditPID').val('@c.PID');">資料授權</button>
                        </td>
                    </tr>

                }
            </tbody>
        </table>
    </div>






    @Html.PagedListPager(Model.PJV_PJMFORM, branchPage => Url.Action("Branch", "PJE0010",
    new { pid = Model.PID, EditPID = Model.EditPID, page = Model.page, ANPID = Model.ANPID, branchPage = branchPage }))






    <script>
        var count = 1;
        function changeformtarget(target) {
            document.getElementById("mainForm").target = target;
            count += 1;
        }
    </script>





}
