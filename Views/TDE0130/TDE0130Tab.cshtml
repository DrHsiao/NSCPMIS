@using PagedList.Mvc
@model WCals.ViewModels.NewModels.TDE0130Model
@{
    ViewBag.Title = "用戶接管及化糞池拆除統計";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/PagedList.css" rel="stylesheet" type="text/css" />
    <script type="text/javascript" src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <style>
        html, body {
            height: 100%;
            margin: 0;
            padding: 5px;
        }
        .table th, .table td {
            white-space: nowrap;
            text-align: center;
            vertical-align: middle;
        }
        .table td.num {
            text-align: right;
        }
        .pagination {
            margin: 10px 0;
        }
    </style>
    <link href="~/Content/bs3-compat.css" rel="stylesheet" />
</head>
<body>
    @{
        int currentTab = Model.tab;
        string pageName = "";
        switch (currentTab)
        {
            case 1: pageName = "用戶接管"; break;
            case 2: pageName = "化糞池拆除"; break;
        }
    }

    <div class="card shadow-sm border-0 h-100">
        <div class="card-header bg-primary text-white fw-bold">@pageName - @Model.SYR 年 @Model.SMN 月</div>
        <div class="card-body p-0" style="overflow-x: auto;">

            @* 頁籤1: 用戶接管 *@
            @if (currentTab == 1)
            {
                if (Model.List_Tab1 != null && Model.List_Tab1.Count > 0)
                {
                    <div class="d-flex justify-content-center mt-3 mb-2">
                        <div class="pagination-container">
                            @Html.PagedListPager(Model.List_Tab1, page => Url.Action("Tab",
                                new { tab = 1, SYR = Model.SYR, SMN = Model.SMN, TD_CITY = Model.TD_CITY, page1 = page }),
                                new PagedListRenderOptions { ContainerDivClasses = new[] { "pagination pagination-sm m-0" } })
                        </div>
                    </div>
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th rowspan="2">縣市</th>
                                <th rowspan="2">年度</th>
                                <th rowspan="2">月份</th>
                                <th colspan="5">數量</th>
                                <th colspan="4">達成率(%)</th>
                            </tr>
                            <tr>
                                <th>年度預定<br/>接管戶數</th>
                                <th>實際<br/>接管戶數</th>
                                <th>接管<br/>差異</th>
                                <th>自行<br/>拆除數</th>
                                <th>重點<br/>拆除數</th>
                                <th>實際<br/>接管率</th>
                                <th>差異率</th>
                                <th>自行<br/>拆除率</th>
                                <th>重點<br/>拆除率</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (System.Data.DataRow row in Model.List_Tab1)
                            {
                                <tr>
                                    <td>@row["TD_CITY"]</td>
                                    <td>@row["SYR"]</td>
                                    <td>@row["SMN"]</td>
                                    <td class="num">@(row["YEAR_PRE_CON_COUNT_01"] != DBNull.Value ? string.Format("{0:N0}", row["YEAR_PRE_CON_COUNT_01"]) : "")</td>
                                    <td class="num">@(row["REL_CON_COUNT_01"] != DBNull.Value ? string.Format("{0:N0}", row["REL_CON_COUNT_01"]) : "")</td>
                                    <td class="num">@(row["CON_DIFF"] != DBNull.Value ? string.Format("{0:N0}", row["CON_DIFF"]) : "")</td>
                                    <td class="num">@(row["SELF_REMOVE_COUNT_01"] != DBNull.Value ? string.Format("{0:N0}", row["SELF_REMOVE_COUNT_01"]) : "")</td>
                                    <td class="num">@(row["FOCUS_REMOVE_COUNT_01"] != DBNull.Value ? string.Format("{0:N0}", row["FOCUS_REMOVE_COUNT_01"]) : "")</td>
                                    <td class="num">@(row["REL_CON_COUNT_01_P"] != DBNull.Value ? string.Format("{0:N2}", row["REL_CON_COUNT_01_P"]) : "")</td>
                                    <td class="num">@(row["CON_DIFF_P"] != DBNull.Value ? string.Format("{0:N2}", row["CON_DIFF_P"]) : "")</td>
                                    <td class="num">@(row["SELF_REMOVE_COUNT_01_P"] != DBNull.Value ? string.Format("{0:N2}", row["SELF_REMOVE_COUNT_01_P"]) : "")</td>
                                    <td class="num">@(row["FOCUS_REMOVE_COUNT_01_P"] != DBNull.Value ? string.Format("{0:N2}", row["FOCUS_REMOVE_COUNT_01_P"]) : "")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="alert alert-info m-3"><i class="fa-solid fa-circle-info me-2"></i>目前無資料</div>
                }
            }

            @* 頁籤2: 化糞池拆除 *@
            @if (currentTab == 2)
            {
                if (Model.List_Tab2 != null && Model.List_Tab2.Count > 0)
                {
                    <div class="d-flex justify-content-center mt-3 mb-2">
                        <div class="pagination-container">
                            @Html.PagedListPager(Model.List_Tab2, page => Url.Action("Tab",
                                new { tab = 2, SYR = Model.SYR, SMN = Model.SMN, TD_CITY = Model.TD_CITY, page2 = page }),
                                new PagedListRenderOptions { ContainerDivClasses = new[] { "pagination pagination-sm m-0" } })
                        </div>
                    </div>
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th rowspan="2">縣市</th>
                                <th rowspan="2">年度</th>
                                <th rowspan="2">月份</th>
                                <th colspan="2">年度預定</th>
                                <th colspan="2">實際拆除</th>
                                <th colspan="2">達成率(%)</th>
                            </tr>
                            <tr>
                                <th>拆除戶數</th>
                                <th>拆除處數</th>
                                <th>拆除戶數</th>
                                <th>拆除處數</th>
                                <th>戶數達成率</th>
                                <th>處數達成率</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (System.Data.DataRow row in Model.List_Tab2)
                            {
                                <tr>
                                    <td>@row["TD_CITY"]</td>
                                    <td>@row["SYR"]</td>
                                    <td>@row["SMN"]</td>
                                    <td class="num">@(row["YEAR_PRE_REMOVE_HOLDER_02"] != DBNull.Value ? string.Format("{0:N0}", row["YEAR_PRE_REMOVE_HOLDER_02"]) : "")</td>
                                    <td class="num">@(row["YEAR_PRE_REMOVE_PLACE_02"] != DBNull.Value ? string.Format("{0:N0}", row["YEAR_PRE_REMOVE_PLACE_02"]) : "")</td>
                                    <td class="num">@(row["PRE_REMOVE_HOLDER_02"] != DBNull.Value ? string.Format("{0:N0}", row["PRE_REMOVE_HOLDER_02"]) : "")</td>
                                    <td class="num">@(row["PRE_REMOVE_PLACE_02"] != DBNull.Value ? string.Format("{0:N0}", row["PRE_REMOVE_PLACE_02"]) : "")</td>
                                    <td class="num">@(row["REMOVE_HOLDER_RATE"] != DBNull.Value ? string.Format("{0:N2}", row["REMOVE_HOLDER_RATE"]) : "")</td>
                                    <td class="num">@(row["REMOVE_PLACE_RATE"] != DBNull.Value ? string.Format("{0:N2}", row["REMOVE_PLACE_RATE"]) : "")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="alert alert-info m-3"><i class="fa-solid fa-circle-info me-2"></i>目前無資料</div>
                }
            }

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
