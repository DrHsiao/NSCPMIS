@using PagedList.Mvc
@model WCals.ViewModels.NewModels.TDE0130Model
@{
    ViewBag.Title = "3.3.6用戶接管及化糞池拆除統計";
    Layout = "~/Views/Shared/_Layout2_v2.cshtml";
}

@section head{
    <style>
        .card.with-nav-tabs {
            display: flex;
            flex-direction: column;
            min-height: 600px;
        }
        .card-body.ifr-container {
            flex: 1;
            display: flex;
            flex-direction: column;
            padding: 0;
        }
        .tab-content {
            flex: 1;
            display: flex;
            flex-direction: column;
        }
        .tab-pane {
            flex: 1;
            display: none;
        }
        .tab-pane.active {
            display: flex;
            flex-direction: column;
        }
        .tab-pane iframe {
            flex: 1;
            width: 100%;
            min-height: 500px;
            border: 0;
        }
    
        /* 頁籤顏色修正 */
        .card-header-tabs .nav-link:not(.active) {
            color: #ffffff !important;
            opacity: 0.85;
        }
        .card-header-tabs .nav-link:not(.active):hover {
            opacity: 1;
            color: #ffffff !important;
        }
        .card-header-tabs .nav-link.active {
            color: #337ab7 !important;
            font-weight: bold;
        }
</style>
}

<div class="row mb-3">
    <div class="col-12">
        <h3 class="fw-bold">
            <i class="fa-solid fa-file-pen me-2"></i>3.3.6 用戶接管及化糞池拆除統計
        </h3>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Content("~/")Home"><i class="fa-solid fa-house me-1"></i>首頁</a></li>
                <li class="breadcrumb-item active">3.3.6 用戶接管及化糞池拆除統計</li>
            </ol>
        </nav>
    </div>
</div>

@using (Html.BeginForm("Index", "TDE0130", FormMethod.Post, new { id = "mainForm" }))
{
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-primary text-white fw-bold">
            <i class="fa-solid fa-magnifying-glass me-1"></i> 查詢條件
        </div>
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-bold">年度</label>
                    @Html.DropDownListFor(x => x.SYR, (List<SelectListItem>)ViewBag.Years, new { @class = "form-select", id = "SYR", onchange = "loadMonths(this.value)" })
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">月份</label>
                    @Html.DropDownListFor(x => x.SMN, (List<SelectListItem>)ViewBag.Months, new { @class = "form-select", id = "SMN" })
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">縣市</label>
                    @Html.DropDownListFor(x => x.TD_CITY, (List<SelectListItem>)ViewBag.Cities, "全部", new { @class = "form-select", id = "TD_CITY" })
                </div>
                <div class="col-md-3">
                    <button class="btn btn-primary shadow-sm w-100" type="button" onclick="searchData()"><i class="fa-solid fa-search me-1"></i>查詢</button>
                </div>
            </div>
        </div>
    </div>

    <!-- 頁籤區域 -->
    <div class="card shadow-sm border-0 with-nav-tabs">
        <div class="card-header bg-primary text-white">
            <ul class="nav nav-tabs card-header-tabs" role="tablist">
                <li class="nav-item" role="presentation"><button id="li1" class="nav-link active" data-bs-target="#tab1" aria-controls="tab1" role="tab" data-bs-toggle="tab" type="button">用戶接管</button></li>
                <li class="nav-item" role="presentation"><button id="li2" class="nav-link" data-bs-target="#tab2" aria-controls="tab2" role="tab" data-bs-toggle="tab" type="button">化糞池拆除</button></li>
            </ul>
        </div>

        <div class="card-body ifr-container border-0 position-relative p-0 pt-2">
            <div class="tab-content" id="myTabContent">
                <div class="tab-pane fade show active" id="tab1" role="tabpanel">
                    <iframe id="iframe1" src="@Url.Content("~/TDE0130/Tab")?tab=1&SYR=@Model.SYR&SMN=@Model.SMN&TD_CITY=@Model.TD_CITY"></iframe>
                </div>
                <div class="tab-pane fade" id="tab2" role="tabpanel">
                    <iframe id="iframe2" src=""></iframe>
                </div>
            </div>
        </div>
    </div>
}

@section scripts{
    <script>
        // 年度變更時載入對應月份
        function loadMonths(syr) {
            $("#SMN").html("");
            $.ajax({
                url: '@Url.Action("GetMonths", "TDE0130")',
                type: 'POST',
                data: { SYR: syr },
                success: function (data) {
                    for (var i = 0; i < data.length; i++) {
                        $("#SMN").append("<option value='" + data[i].Value + "'>" + data[i].Text + "</option>");
                    }
                },
                error: function () {
                    for (var i = 12; i >= 1; i--) {
                        var m = i < 10 ? '0' + i : '' + i;
                        $("#SMN").append("<option value='" + m + "'>" + m + "</option>");
                    }
                }
            });
        }

        // 重新整理當前頁籤
        function refreshCurrentTab() {
            var activeTab = $('.nav-tabs button.active').attr('data-bs-target').replace('#tab', '');
            loadIframe(activeTab);
        }

        // 頁籤切換時載入對應 iframe
        $('button[data-bs-toggle="tab"]').on('shown.bs.tab', function (e) {
            
            // 樣式切換 logic
            
            

            var target = $(e.target).attr("data-bs-target");
            var tabNo = target.replace('#tab', '');
            var iframe = $('#iframe' + tabNo);

            // 如果 iframe 尚未載入，則載入
            if (!iframe.attr('src') || iframe.attr('src') === '') {
                loadIframe(tabNo);
            }
        });

        function loadIframe(tabNo) {
            var url = '@Url.Content("~/TDE0130/Tab")';
            url += '?tab=' + tabNo;
            url += '&SYR=' + encodeURIComponent($('#SYR').val());
            url += '&SMN=' + encodeURIComponent($('#SMN').val());
            url += '&TD_CITY=' + encodeURIComponent($('#TD_CITY').val());
            url += '&_t=' + new Date().getTime();

            $('#iframe' + tabNo).attr('src', url);
        }

        function searchData() {
            // 取得當前頁籤
            var activeTab = $('.nav-tabs button.active').attr('data-bs-target').replace('#tab', '');
            loadIframe(activeTab);
        }
    </script>
}
