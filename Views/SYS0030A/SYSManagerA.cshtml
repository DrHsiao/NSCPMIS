@using PagedList.Mvc
@model WCals.ViewModels.NewModels.SYS0030Model

@{Layout = null;}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>SYSManager</title>
    <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script type="text/javascript" src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <title>@ViewBag.Title - My ASP.NET Application</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="~/Scripts/modernizr-2.8.3.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://code.jquery.com/ui/1.14.1/themes/base/jquery-ui.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/Scripts/plugins/bootstrap-fileinput/icon.mini.css" crossorigin="anonymous">
    <link href="~/Scripts/plugins/bootstrap-fileinput/fileinput.min.css" media="all" rel="stylesheet" type="text/css" />
    <link href="~/Content/bs3-compat.css" rel="stylesheet" />
</head>
<body>
    @using(Html.BeginForm("", "SYS0030", FormMethod.Post, new { id = "mainForm", @class = "form-horizontal" })) {
        <div class="table-responsive" style="overflow-x:auto;">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th nowrap>蝮????</th>
                        <th nowrap>銝偌?頂蝯梁楊??/th>
                        <th nowrap>銝偌?頂蝯勗?蝔?/th>
                        <th nowrap>撱箄身?耦</th>
                        <th nowrap>?臬鋆</th>
                        <th nowrap></th>
                    </tr>
                </thead>
                <tbody>
                    <tr>

                        <td>
                            <select name="CITY" class="form-control">
                                <option value="">蝮????/option>
                                @foreach(System.Data.DataRow c in ViewBag.Cities.Rows) {

                                    if(Convert.ToString(c["CITY"]).Equals(Model.CITY)) {
                                        <option selected vlaue="@c["CITY"]">@c["CITY"]</option>
                                    } else {
                                        <option vlaue="@c["CITY"]">@c["CITY"]</option>
                                    }

                                }

                            </select>



                        </td>


                        <td>@Html.TextBoxFor(x => x.SYS_ID, new { @class = "form-control", placeholder = "蝟餌絞蝺刻?", AutoComplete = "Off" })</td>
                        <td>@Html.TextBoxFor(x => x.SYS_NAME, new { @class = "form-control", placeholder = "蝟餌絞?迂", AutoComplete = "Off" })</td>
                        <td>
                            @Html.TextBoxFor(x => x.CONST_TP, new { @class = "form-control", placeholder = "撱箄身銝?, AutoComplete = "Off" })
                        </td>
                        <td>
                            @Html.DropDownListFor(x => x.IS_SUP, new SelectList(new[] { new { Value = "Y", Text = "Y" }, new { Value = "N", Text = "N" } }, "Value", "Text"),
                           "?臬鋆", new { @class = "form-control", form = "mainForm", Onchange = "GetTowns(this.value)" })
                        </td>

                        <td>


                            <button class="btn btn-primary" type="submit" formaction="@Url.Action("SYSManagerSearchA", "SYS0030")">?亥岷</button>
                            <button class="btn btn-success" type="submit" formaction="@Url.Action("SYSManagerAddA", "SYS0030")">?啣?</button>
                        </td>
                    </tr>
                    <!-- ?舐匱蝥?鋆賢隞? -->
                </tbody>
            </table>
            @if(Model.List1 != null) {
                @Html.PagedListPager(Model.List1, page => Url.Action("SYSManagerSearch",
                new {
                    page = page,
                    CITY = Model.CITY,
                    SYS_ID = Model.SYS_ID,
                    SYS_NAME = Model.SYS_NAME,
                    CONST_TP = Model.CONST_TP,
                    IS_SUP = Model.IS_SUP,

                }))
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th nowrap>蝮????/th>
                            <th nowrap>銝偌?頂蝯梁楊??/th>
                            <th nowrap>銝偌?頂蝯勗?蝔?/th>
                            <th nowrap>撱箄身?耦</th>
                            <th nowrap>?臬鋆</th>
                            <th nowrap></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(System.Data.DataRow d in Model.List1) {
                            <tr>
                                <td>

                                    <select name="CITYS" class="form-control">
                                        <option value="">蝮????/option>
                                        @foreach(System.Data.DataRow c in ViewBag.Cities.Rows) {

                                            if(Convert.ToString(c["CITY"]).Equals(Convert.ToString(d["CITY"]))) {
                                                <option selected vlaue="@c["CITY"]">@c["CITY"]</option>
                                            } else {
                                                <option vlaue="@c["CITY"]">@c["CITY"]</option>
                                            }
                                        }
                                    </select>

                                </td>
                                <td><input type="text" name="SYS_IDS" value="@d["SYS_ID"]" class="form-control" /></td>
                                <td><input type="text" name="SYS_NAMES" value="@d["SYS_NAME"]" class="form-control" /></td>
                                <td>
                                    <input type="text" name="SYS_NAMES" value="@d["CONST_TP"]" class="form-control" />
                                </td>
                                <td>
                                    <select name="IS_SUPS" class="form-control">
                                        <option value="">蝮????/option>


                                        @if(Convert.ToString(d["IS_SUP"]).Equals("Y")) {
                                            <option selected vlaue="Y">Y</option>
                                            <option vlaue="N">N</option>
                                        } else {
                                            <option vlaue="Y">Y</option>
                                            <option selected vlaue="N">N</option>
                                        }

                                    </select>
                                </td>
                                <td>
                                    <button class="btn btn-warning" type="submit" formaction="@Url.Action("SYSManagerSearch", "SYS0030")">靽格</button>
                                    <button class="btn btn-danger" name="action" type="button" onclick="if(!confirm('蝣箏??芷嚗?)) { return false; } " value="Del" value="Save">?芷</button>
                                </td>
                            </tr>

                        }

                        <!-- ?舐匱蝥?鋆賢隞? -->
                    </tbody>
                </table>


            }
        </div>
    }
</body>
</html>
