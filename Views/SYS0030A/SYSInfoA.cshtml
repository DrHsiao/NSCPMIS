        <!-- 檔案上傳區塊 -->
        <div class="card shadow-sm border-0 mb-4 h-100">
            <div class="card-header bg-primary text-white fw-bold">附件上傳</div>
            <div class="card-body">
                <div class="form-group">
                    <div class="col-sm-12">
                        <input type="file" name="files" multiple class="form-control" style="height: auto;" accept="*/*" />
                        <small class="text-muted">可同時選擇多個檔案上傳（單檔上限 100MB）</small>
                    </div>
                </div>

                <div class="form-group">
                    <div class="col-sm-12">
                        <h4>已上傳檔案</h4>
                        <table class="table table-hover" id="fileListTable">
                            <thead>
                                <tr>
                                    <th style="width: 50%;">檔案名稱</th>
                                    <th style="width: 15%;">檔案大小(KB)</th>
                                    <th style="width: 20%;">上傳日期</th>
                                    <th style="width: 15%;">操作</th>
                                </tr>
                            </thead>
                            <tbody id="fileListBody">
                                @{
                                    var db = new WCals.Models.CMETMSModels.CMETMSEntities();
                                    var files = db.PJCFILE.Where(x => x.PJ_ID == Model.PJ_ID).OrderByDescending(x => x.ADD_DT).ToList();
                                    if(files.Count == 0) {
                                        <tr><td colspan="4" class="text-center">尚無上傳檔案</td></tr>
                                    } else {
                                        foreach(var file in files) {
                                            <tr>
                                                <td>@file.FILE_NAME</td>
                                                <td class="text-right">@(file.FILE_SIZE.HasValue ? file.FILE_SIZE.Value.ToString("N2") : "0")</td>
                                                <td>@(file.ADD_DT.HasValue ? file.ADD_DT.Value.ToString("yyyy/MM/dd HH:mm") : "")</td>
                                                <td>
                                                    <a href="@Url.Action("DownloadFile", "SYS0030A", new { fileId = file.FILE_ID })" class="btn btn-sm btn-info">下載</a>
                                                    <button type="button" class="btn btn-sm btn-danger" onclick="DeleteFile(@file.FILE_ID);">刪除</button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- 按鈕 -->
        <div class="form-group">
            <div class="col-sm-offset-2 col-sm-10">
                @if(!string.IsNullOrEmpty(Model.PJ_ID) && ViewBag.Mode != "copy") {
                    <button type="button" onclick="return DeleteRecord();" class="btn btn-danger">刪除</button>
                }
                <button type="submit" name="action" value="SaveSYSInfo" class="btn btn-primary">確定儲存</button>
                <button type="button" onclick="CloseDialog();" class="btn btn-secondary">關閉</button>
            </div>
        </div>
    }

    <script>
  function DeleteRecord() {
      if (confirm('確定要刪除本計畫?')) {
   var pjId = document.getElementById('PJ_ID').value;
  if (pjId) {
           $.ajax({
       type: 'POST',
       url: '@Url.Action("DeleteSYSInfo", "SYS0030A")',
        data: { pjId: pjId },
    dataType: 'json',
       success: function (result) {
  if (result.success) {
          alert(result.message);
   window.parent.location.reload();
          } else {
    alert(result.message);
        }
  },
   error: function () {
alert('刪除失敗，請稍後重試');
    }
      });
   }
   }
   return false;
   }

function DeleteFile(fileId) {
       if (confirm('確定要刪除此檔案嗎？')) {
    $.ajax({
  type: 'POST',
    url: '@Url.Action("DeleteFile", "SYS0030A")',
   data: { fileId: fileId },
     dataType: 'json',
    success: function (result) {
        if (result.success) {
    alert(result.message);
     window.location.reload();
   } else {
       alert('刪除失敗：' + result.message);
       }
           },
 error: function () {
     alert('刪除失敗，請稍後重試');
       }
   });
     }
  }

function CloseDialog() {
         window.parent.location.reload();
  }
    </script>

