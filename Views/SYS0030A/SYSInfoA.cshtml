                        @Html.TextBoxFor(m => m.SER_FN_3, new { @class = "form-control", maxlength = "3", style = "width:60px;display:inline-block;margin:0 5px;" })
                        <span> - </span>
                        @Html.TextBoxFor(m => m.SER_FN_4, new { @class = "form-control", maxlength = "2", style = "width:50px;display:inline-block;margin:0 5px;" })
                        @Html.TextBoxFor(m => m.SER_FN_5, new { @class = "form-control", maxlength = "2", style = "width:50px;display:inline-block;margin:0 5px;" })
                        @Html.TextBoxFor(m => m.SER_FN_6, new { @class = "form-control", maxlength = "2", style = "width:50px;display:inline-block;margin:0 5px;" })
                        @Html.TextBoxFor(m => m.SER_FN_7, new { @class = "form-control", maxlength = "2", style = "width:50px;display:inline-block;margin-left:5px;" })
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-2 col-form-label">縣市</label>
