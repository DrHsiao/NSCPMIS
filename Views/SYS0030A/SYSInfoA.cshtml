                </div>

                <div class="form-group">
                    <label class="col-sm-2 col-form-label">雨水下水道系統</label>
                    <div class="col-sm-10">
                        @Html.DropDownListFor(m => m.SYS_ID, (SelectList)ViewBag.systems, "請選擇", new { @class = "form-control" })
                    </div>
                </div>

                <div class="form-group">
