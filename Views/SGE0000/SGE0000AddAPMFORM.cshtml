@using PagedList.Mvc
@model WCals.ViewModels.NewModels.SGE0000Model
@{ ViewBag.Title = "2.2.1 提案作業";
    //Layout = "~/Views/Shared/_Layout2_v2.cshtml";
    Layout = null;

}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script type="text/javascript" src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <title>@ViewBag.Title - My ASP.NET Application</title>
    <link href="https://code.jquery.com/ui/1.14.1/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" type="text/css" />

    <link rel="stylesheet" href="~/Scripts/plugins/bootstrap-fileinput/icon.mini.css" crossorigin="anonymous">
    <link href="~/Scripts/plugins/bootstrap-fileinput/fileinput.min.css" media="all" rel="stylesheet" type="text/css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link href="~/Content/bs3-compat.css" rel="stylesheet" />
</head>
<body style="padding:5px;">
    @using(Html.BeginForm("", "SGE0000", FormMethod.Post, new { id = "mainForm", enctype = "multipart/form-data" })) {
        <div>

            <!-- Nav tabs -->
            <ul class="nav nav-tabs" role="tablist" id="syrTab">
                <li id="li1" role="presentation" class="active"><a href="#tab1" aria-controls="tab1" role="tab" data-bs-toggle="tab">申請內容基本資料</a></li>
                <li id="li2" role="presentation"><a href="#tab2" aria-controls="tab2" role="tab" data-bs-toggle="tab">實施區域</a></li>
                <li id="li3" role="presentation" onclick="CpTo3();"><a href="#tab3" aria-controls="tab3" role="tab" data-bs-toggle="tab">實行內容</a></li>
                <li id="li4" role="presentation"><a href="#tab4" aria-controls="tab4" role="tab" data-bs-toggle="tab">勘察評估事項</a></li>
                <li id="li5" role="presentation"><a href="#tab5" aria-controls="tab5" role="tab" data-bs-toggle="tab">財源分配</a></li>
                <li id="li6" role="presentation"><a href="#tab6" aria-controls="tab6" role="tab" data-bs-toggle="tab">檢附資料</a></li>
            </ul>


            <div class="tab-content">
                <!-- Tab1 panes -->
                <div role="tabpanel" class="tab-pane active" id="tab1">
                    <br />
                    <a class="btn btn-secondary" onclick="$('#syrTab li:eq(1) a').tab('show')">下一頁</a>
                    <button class="btn btn-primary" name="action" type="submit" value="SaveNewAPMFORM">儲存</button>
                    <table class="table">
                        <thead class="table-light">
                            <tr>
                                <td nowrap align="right">案件類別</td>
                                <td width="50%">
                                    @Html.DropDownListFor(x => x.APMFORM.CATY_CODE, (SelectList)ViewBag.PJ_CATY_CODE, "請選擇", new { @class = "form-select", form = "mainForm" })
                                </td>
                                <td nowrap align="right">辦理狀態</td>
                                <td width="100%">
                                    <select name="EXT_FG" class="form-select" onchange="if (this.value == 'N') { $('#s1').show('slow') } else {$('#s1').hide('slow') };">
                                        <option value="Y">新建工程</option>
                                        <option value="N">延續性工程</option>
                                    </select>
                                </td>
                            </tr>
                        </thead>
                        <tr>
                            <td width="1" nowrap align="right">工程名稱</td>
                            <td colspan="2">
                                @Html.TextBoxFor(x => x.APMFORM.AP_NAME, new { @class = "form-control", placeholder = "工程名稱", AutoComplete = "Off", tabindex = "1" })
                                @Html.TextBoxFor(x => x.APMFORM.AID)
                            </td>
                            <td>
                                <div class="btn-group" id="s1" style="display:none;">
                                    <button type="button" class="btn btn-secondary">引用</button>
                                    <button type="button" class="btn btn-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        <span class="caret"></span>
                                        <span class="sr-only">Toggle Dropdown</span>
                                    </button>
                                    <ul class="dropdown-menu">
                                        <li><a href="#">下水道管理業務</a></li>
                                        <li><a href="#">污水下水道建設計畫(公務預算)</a></li>
                                        <li><a href="#">推動下水道工程建設(業務費)</a></li>
                                        <li role="separator" class="divider"></li>
                                        <li><a href="#">擴大公共建設投資計畫(新十大特別預算)</a></li>
                                    </ul>
                                </div>
                                @Html.HiddenFor(x => x.PPID)
                                @Html.HiddenFor(x => x.YRC_ID)
                            </td>
                        </tr>
                        <tr>
                            <td width="1" nowrap align="right">縣市別</td>
                            <td>
                                @Html.DropDownListFor(x => x.APMFORM.CITY, (SelectList)ViewBag.cities, "縣市", new { @class = "form-select", onchange = "GetTown(this.value);GetPJ_NAMES(this.value);" })

                            </td>
                            <td width="1" nowrap align="right">計畫名稱*</td>
                            <td>
                                @Html.DropDownListFor(x => x.APMFORM.AP_PJ_NAME, (SelectList)ViewBag.PJ_NAMES, "請選擇", new {id= "AP_PJ_NAME", @class = "form-select", form = "mainForm" })

                            </td>
                        </tr>

                        <tr>
                            <td width="1" nowrap align="right">受補助單位*</td>
                            <td>
                                @Html.DropDownListFor(x => x.APMFORM.FILL_MCH, (SelectList)ViewBag.FILL_MCHS, "請選擇", new { @class = "form-select", form = "mainForm" })

                            </td>
                            <td width="1" nowrap align="right">預定執行單位</td>
                            <td>
                                @Html.TextBoxFor(x => x.APMFORM.EXE_MCH, new { @class = "form-control", placeholder = "預定執行單位", AutoComplete = "Off", tabindex = "1" })

                            </td>
                        </tr>
                        <tr>
                            <td width="1" nowrap align="right">預定開始日期</td>
                            <td>
                                @Html.TextBoxFor(x => x.APMFORM.START_DT, new { @class = "form-control dt", placeholder = "核定期程啟日", AutoComplete = "Off", form = "mainForm" })
                            </td>
                            <td width="1" nowrap align="right">預定完成日期</td>
                            <td>
                                @Html.TextBoxFor(x => x.APMFORM.END_DT, new { @class = "form-control dt", placeholder = "預定完成日期", AutoComplete = "Off", form = "mainForm" })
                            </td>
                        </tr>
                        <tr>
                            <td width="1" nowrap align="right">預期效益</td>
                            <td colspan="3">
                                @Html.TextAreaFor(x => x.APMFORM.BENEFITS, new { @class = "form-control", placeholder = "預期效益", AutoComplete = "Off" })

                            </td>
                        </tr>
                        <tr>
                            <td width="1" nowrap align="right">全部內容</td>
                            <td colspan="3">
                                @Html.TextAreaFor(x => x.APMFORM.AP_ALL_NOTE, new { @class = "form-control", placeholder = "全部內容", AutoComplete = "Off" })

                            </td>
                        </tr>
                        <tr>
                            <td width="1" nowrap align="right">辦理內容</td>
                            <td colspan="3">
                                @Html.TextAreaFor(x => x.APMFORM.AP_YEAR_NOTE, new { @class = "form-control", placeholder = "辦理內容", AutoComplete = "Off" })

                            </td>
                        </tr>
                        <tr>
                            <td width="1" nowrap align="right">備註說明</td>
                            <td colspan="3">
                                @Html.TextAreaFor(x => x.APMFORM.AP_NOTE, new { @class = "form-control", placeholder = "備註說明", AutoComplete = "Off" })

                            </td>
                        </tr>
                        <tr>
                            <td width="1" nowrap align="right">填表單位*</td>
                            <td>
                                @WCals.Helpers.WebSiteHelper.getDeptName(WCals.Helpers.WebSiteHelper.getUserDept())
                            </td>
                            <td width="1" nowrap align="right">計畫聯絡人*</td>
                            <td>
                                @Html.TextBoxFor(x => x.APMFORM.CONT_NAME, new { @class = "form-control", placeholder = "計畫聯絡人", AutoComplete = "Off" })

                            </td>
                        </tr>
                        <tr>
                            <td width="1" nowrap align="right">聯絡人信箱*</td>
                            <td>
                                @Html.TextBoxFor(x => x.APMFORM.CONT_EMAIL, new { @class = "form-control", placeholder = "聯絡人信箱", AutoComplete = "Off" })
                            </td>
                            <td width="1" nowrap align="right">聯絡人傳真</td>
                            <td>
                                @Html.TextBoxFor(x => x.APMFORM.CONT_FAX, new { @class = "form-control", placeholder = "聯絡人傳真", AutoComplete = "Off" })

                            </td>
                        </tr>
                        <tr>
                            <td width="1" nowrap align="right">預定徵收公告日</td>
                            <td>
                                @Html.TextBoxFor(x => x.APMFORM.TF106_DT, new { @class = "form-control dt", placeholder = "預定徵收公告日", AutoComplete = "Off", form = "mainForm" })
                            </td>
                            <td width="1" nowrap align="right">預定用地取得完成日</td>
                            <td>
                                @Html.TextBoxFor(x => x.APMFORM.TF108_DT, new { @class = "form-control dt", placeholder = "預定用地取得完成日", AutoComplete = "Off", form = "mainForm" })
                            </td>
                        </tr>
                        <tr>
                            <td width="1" nowrap align="right">預定設計完成日</td>
                            <td>
                                @Html.TextBoxFor(x => x.APMFORM.TK103_DT, new { @class = "form-control dt", placeholder = "預定設計完成日", AutoComplete = "Off", form = "mainForm" })
                            </td>
                            <td width="1" nowrap align="right">預定發包日</td>
                            <td>
                                @Html.TextBoxFor(x => x.APMFORM.TK105_DT, new { @class = "form-control dt", placeholder = "預定發包日", AutoComplete = "Off", form = "mainForm" })
                            </td>
                        </tr>
                        <tr>
                            <td width="1" nowrap align="right">預定開工日</td>
                            <td>
                                @Html.TextBoxFor(x => x.APMFORM.TK106_DT, new { @class = "form-control dt", placeholder = "預定開工日", AutoComplete = "Off", form = "mainForm" })
                            </td>
                            <td width="1" nowrap align="right">預定完工日</td>
                            <td>
                                @Html.TextBoxFor(x => x.APMFORM.TK107_DT, new { @class = "form-control dt", placeholder = "預定完工日", AutoComplete = "Off", form = "mainForm" })
                            </td>
                        </tr>

                        <tr>
                            <td width="1" nowrap align="right">系統別</td>
                            <td>
                                @Html.DropDownListFor(x => x.SYS_CATY, (SelectList)ViewBag.SYS_CATY, "其他", new { @class = "form-select" })
                            </td>
                            <td width="1" nowrap align="right">辦理層級*</td>
                            <td>
                                @Html.DropDownListFor(x => x.IPJ_CODE, (SelectList)ViewBag.IPJ_CODES, "辦理層級", new { @class = "form-select" })

                            </td>
                        </tr>

                        <tr>
                            <td width="1" nowrap align="right">縣市評估優先次序*</td>
                            <td>
                                @Html.TextBoxFor(x => x.APMFORM.S1_ORDER, new { @class = "form-control", placeholder = "縣市評估優先次序", AutoComplete = "Off" })
                            </td>
                            <td width="1" nowrap align="right">關注立委</td>
                            <td>
                                @Html.TextBoxFor(x => x.APMFORM.ATTENTION_PEOPLE, new { @class = "form-control", placeholder = "關注立委", AutoComplete = "Off" })

                            </td>
                        </tr>
                    </table>


                    <table width="99%">
                        <tr>
                            <td align="left"></td>
                            <td align="right"><a class="btn btn-secondary" onclick="$('#syrTab li:eq(1) a').tab('show')">下一頁</a></td>
                        </tr>
                    </table>



                </div>

                <!--tab2-->
                <div role="tabpanel" class="tab-pane" id="tab2">
                    <br>
                    <button type="button" class="btn btn-secondary" onclick="cp()"><span class="fa-solid fa-plus" aria-hidden="true"></span> 新增</button>
                    <a class="btn btn-secondary" onclick="$('#syrTab li:eq(0) a').tab('show')">上一頁</a>
                    <a class="btn btn-secondary" onclick="$('#syrTab li:eq(2) a').tab('show')">下一頁</a>
                    <button class="btn btn-primary" name="action" type="submit" value="SaveNewAPMFORM">儲存</button>
                    <br>
                    <table class="table" id="tab2_table">
                        <thead class="table-light">
                            <tr>
                                <th nowrap>移動</th>

                                <th nowrap>複製</th>
                                <th nowrap>刪除</th>

                                <th nowrap>鄉鎮別</th>
                                <th nowrap>地點描述</th>
                                <th nowrap>X座標</th>
                                <th nowrap>Y座標</th>
                                <th nowrap>Z座標</th>
                            </tr>
                        </thead>


                        <tbody id="pe">
                            <tr>
                                <td width="1" nowrap>
                                    <button type="button" class="btn btn-secondary" onclick="moveDown(this, 'tab2_table')"><span class="fa-solid fa-chevron-up" aria-hidden="true"></span></button>
                                    <button type="button" class="btn btn-secondary" onclick="moveUp(this, 'tab2_table')"><span class="fa-solid fa-chevron-down" aria-hidden="true"></span></button>
                                </td>
                                <td width="1"><button type="button" class="btn btn-secondary" onclick="duplicateRow(this, 'tab2_table')"><span class="fa-solid fa-copy" aria-hidden="true"></span></button></td>
                                <td width="1"><button type="button" class="btn btn-secondary" onclick="del(this, 'tab2_table');"><span class="fa-solid fa-minus" aria-hidden="true"></span></button></td>

                                <td>@Html.DropDownListFor(x => x.TOWN, (SelectList)ViewBag.towns, "鄉鎮", new { @class = "form-select TOWN", form = "mainForm" })</td>
                                <td>@Html.TextBoxFor(x => x.POS_SYB, new { @class = "form-control POS_SYB", placeholder = "地點描述", AutoComplete = "Off" })</td>
                                <td>@Html.TextBoxFor(x => x.GIS_X, new { @class = "form-control", placeholder = "X座標", AutoComplete = "Off" })</td>
                                <td>@Html.TextBoxFor(x => x.GIS_Y, new { @class = "form-control", placeholder = "Y座標", AutoComplete = "Off" })</td>
                                <td>@Html.TextBoxFor(x => x.GIS_Z, new { @class = "form-control", placeholder = "Z座標", AutoComplete = "Off" })</td>
                            </tr>
                        </tbody>
                    </table>




                    <table width="99%">
                        <tr>
                            <td align="left"> <a class="btn btn-secondary" onclick="$('#syrTab li:eq(0) a').tab('show')">上一頁</a></td>
                            <td align="right"><a class="btn btn-secondary" onclick="$('#syrTab li:eq(2) a').tab('show')">下一頁</a></td>
                        </tr>
                    </table>
                </div>
                <!--tab3-->
                <div role="tabpanel" class="tab-pane" id="tab3">
                    <br>
                    <a class="btn btn-secondary" onclick="$('#syrTab li:eq(1) a').tab('show')">上一頁</a>
                    <a class="btn btn-secondary" onclick="$('#syrTab li:eq(3) a').tab('show')">下一頁</a>
                    <button class="btn btn-primary" name="action" type="submit" value="SaveNewAPMFORM">儲存</button>
                    <br>
                    <table class="table" id="tab2_table">
                        <thead class="table-light">
                            <tr>
                                <th></th>
                                <th nowrap>鄉鎮別</th>
                                <th nowrap>地點</th>
                            </tr>
                        </thead>
                        <tbody id="table3_main_body">
                        </tbody>
                    </table>
                    <table width="99%">
                        <tr>
                            <td align="left"><a class="btn btn-secondary" onclick="$('#syrTab li:eq(1) a').tab('show')">上一頁</a></td>
                            <td align="right"><a class="btn btn-secondary" onclick="$('#syrTab li:eq(3) a').tab('show')">下一頁</a></td>
                        </tr>
                    </table>
                </div>



                <!--tab4-->
                <div role="tabpanel" class="tab-pane" id="tab4">

                    <br>
                    <a class="btn btn-secondary" onclick="$('#syrTab li:eq(2) a').tab('show')">上一頁</a>
                    <a class="btn btn-secondary" onclick="$('#syrTab li:eq(4) a').tab('show')">下一頁</a><br>
                    <button class="btn btn-primary" name="action" type="submit" value="SaveNewAPMFORM">儲存</button>
                    <table class="table">
                        <thead class="table-light">
                            <tr>
                                <th>評估事項</th>
                                <th nowrap></th>
                                <th nowrap></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td width="1" nowrap>1.符合系統規劃</td>
                                <td>
                                    @{
                                        SelectListItem item;
                                        List<SelectListItem> options = new List<SelectListItem>();
                                        item = new SelectListItem { Text = "是", Value = "Y" };
                                        options.Add(item);
                                        item = new SelectListItem { Text = "否", Value = "N" };
                                        options.Add(item);
                                    }
                                    @Html.DropDownListFor(x => x.SWW1_FG, options, "", new { @class = "form-select", form = "mainForm" })
                                </td>
                                <td width="50%"></td>
                            </tr>
                            <tr>
                                <td nowrap>2.實施計畫是否通過</td>
                                <td>
                                    @Html.DropDownListFor(x => x.SWW2_FG, options, "", new { @class = "form-select", form = "mainForm" })

                                </td>
                                <td width="50%"></td>
                            </tr>
                            <tr>
                                <td nowrap>3.用地變更程序</td>
                                <td>
                                    @Html.DropDownListFor(x => x.SWW3_FG, options, "", new { @class = "form-select", form = "mainForm" })

                                </td>
                                <td width="50%"></td>
                            </tr>
                            <tr>
                                <td>4.用地取得</td>
                                <td>
                                    @Html.DropDownListFor(x => x.SWW4_FG, options, "", new { @class = "form-select", form = "mainForm" })

                                </td>
                                <td width="50%"></td>
                            </tr>
                            <tr>
                                <td nowrap>5.下游管線廠站建設期程是否配合</td>
                                <td>
                                    @Html.DropDownListFor(x => x.SWW5_FG, options, "", new { @class = "form-select", form = "mainForm" })

                                </td>
                                <td width="50%"></td>
                            </tr>
                            <tr>
                                <td>6.交維問題可否解決</td>
                                <td>
                                    @Html.DropDownListFor(x => x.SWW6_FG, options, "", new { @class = "form-select", form = "mainForm" })

                                </td>
                                <td width="50%"></td>
                            </tr>
                            <tr>
                                <td>7.地下管線拆遷</td>
                                <td>
                                    @Html.DropDownListFor(x => x.SWW7_FG, options, "", new { @class = "form-select", form = "mainForm" })

                                </td>
                                <td width="50%"></td>
                            </tr>
                            <tr>
                                <td nowrap>8.本工程已完成設計</td>
                                <td nowrap>
                                    @Html.DropDownListFor(x => x.SWW8_FG, options, "", new { @class = "form-select", form = "mainForm" })

                                </td>
                                <td width="50%"><input type="checkbox" name="SWW81_FG" value="Y" /> 辦理中</td>
                            </tr>
                            <tr>
                                <td nowrap>9.本工程前一年度執行率%(新建工程免填)</td>
                                <td>
                                    @Html.TextBoxFor(x => x.SWW9_FG, new { @class = "form-control", form = "mainForm" })

                                </td>
                                <td width="50%"></td>
                            </tr>
                            <tr>
                                <td nowrap>10.前一年度配合款編列情形</td>
                                <td>
                                    @Html.DropDownListFor(x => x.SWW10_FG, options, "", new { @class = "form-select", form = "mainForm" })

                                </td>
                                <td width="50%"></td>
                            </tr>
                            <tr>
                                <td>11.是否可配合納入預算</td>
                                <td>
                                    @Html.DropDownListFor(x => x.SWW11_FG, options, "", new { @class = "form-select", form = "mainForm" })

                                </td>
                                <td width="50%"></td>
                            </tr>
                            <tr>
                                <td>其他</td>
                                <td>
                                    @Html.TextAreaFor(x => x.SWWOT_DESC, new { @class = "form-control", AutoComplete = "Off", tabindex = "1" })

                                </td>
                                <td width="50%"></td>
                            </tr>
                        </tbody>
                    </table>




                    <table width="99%">
                        <tr>
                            <td align="left"> <a class="btn btn-secondary" onclick="$('#syrTab li:eq(2) a').tab('show')">上一頁</a></td>
                            <td align="right"><a class="btn btn-secondary" onclick="$('#syrTab li:eq(4) a').tab('show')">下一頁</a></td>
                        </tr>
                    </table>
                </div>


                <!--tab5-->
                <div role="tabpanel" class="tab-pane" id="tab5">

                    <br>
                    <a class="btn btn-secondary" onclick="$('#syrTab li:eq(3) a').tab('show')">上一頁</a>
                    <a class="btn btn-secondary" onclick="$('#syrTab li:eq(5) a').tab('show')">下一頁</a>
                    <button class="btn btn-primary" name="action" type="submit" value="SaveNewAPMFORM">儲存</button>
