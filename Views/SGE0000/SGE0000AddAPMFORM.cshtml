                        <thead class="table-light">
                            <tr>
                                <th colspan="4">工程總經費 (元)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td align="right">中央補助款</td>
                                <td>
                                    @Html.TextBoxFor(x => x.APMFORM.TCEN_FUND, new { @class = "form-control", AutoComplete = "Off" })
                                </td>
                                <td align="right">地方配合款</td>
                                <td>@Html.TextBoxFor(x => x.APMFORM.TLOC_FUND, new { @class = "form-control", AutoComplete = "Off" })</td>
                            </tr>
                            <tr>
                                <td colspan="4">以前年度已編列 (單位：千元) </td>
                            </tr>
                            <tr>
                                <td align="right">中央補助款</td>
                                <td>
                                    @Html.TextBoxFor(x => x.APMFORM.RCEN_FUND, new { @class = "form-control", AutoComplete = "Off" })
                                </td>
                                <td align="right">地方配合款</td>
                                <td>@Html.TextBoxFor(x => x.APMFORM.RLOC_FUND, new { @class = "form-control", AutoComplete = "Off" })</td>
                            </tr>
                        </tbody>
