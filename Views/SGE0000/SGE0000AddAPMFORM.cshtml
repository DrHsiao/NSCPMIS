<script>
        $(".dt").datepickerTW({
            changeYear: true,
            changeMonth: true,
            yearRange: '68:168',
            dateFormat: 'yymmdd',
        });
        //鄉鎮對應首頁縣市
        function GetTown(city) {
            //alert(city)
            $(".TOWN").html("");
            $.ajax({
                url: '@Url.Content("~/")ASYNC/GetTowns',
                method: 'post',
                data: { "city": city },
                success: function (d) {
                    var p = jQuery.parseJSON(d);
                    $(".TOWN").prepend("<option value=''>鄉鎮</option>");
                    for (i = 0; i < p.length; i++) {
                        $(".TOWN").append("<option value='" + p[i].TOWN + "'>" + p[i].TOWN + "</option>");
                    }
                }
            });
        }

        //計畫
        function GetPJ_NAMES(city) {
            //alert(city)
            $("#AP_PJ_NAME").html("");
            $.ajax({
                url: '@Url.Content("~/")ASYNC/GetPJ_NAMES',
                method: 'post',
                data: { "city": city },
                success: function (d) {
                    var p = jQuery.parseJSON(d);
                    //$("#AP_PJ_NAME").prepend("<option value=''>請選擇</option>");
                    for (i = 0; i < p.length; i++) {
                        $("#AP_PJ_NAME").append("<option value='" + p[i].name + "'>" + p[i].name + "</option>");
                    }
                }
            });
        }

        function cp() {
            $("#pe").append($("#cp").html());
        }

        function cpFund() {
            $("#fund_table_target").append($("#fund_table").html());
        }

        function cpFile() {
            $("#file_table_target").append($("#file_table").html());
        }

        function getRowIndex(button, tbName) {
            const row = button.closest("tr"); // 找到按鈕所在的行
            const table = document.getElementById(tbName);
            const rowIndex = Array.from(table.querySelector("tbody").rows).indexOf(row); // 計算相對索引
            //console.log("Row Index:", rowIndex);
            return rowIndex;
        }

        function moveDown(button, tbName) {
            const rowIndex = getRowIndex(button, tbName);
            const table = document.getElementById(tbName);
            const tbody = table.querySelector("tbody");
            const rows = tbody.querySelectorAll("tr");
            if (rowIndex > 0 && rowIndex < rows.length) {
                const currentRow = rows[rowIndex];
                const previousRow = rows[rowIndex - 1];
                tbody.insertBefore(currentRow, previousRow);
            }
        }

        function moveUp(button, tbName) {
            const rowIndex = getRowIndex(button, tbName);
            const table = document.getElementById(tbName);
            const tbody = table.querySelector("tbody");
            const rows = tbody.querySelectorAll("tr");
            if (rowIndex >= 0 && rowIndex < rows.length - 1) {
                const currentRow = rows[rowIndex];
                const nextRow = rows[rowIndex + 1];
                tbody.insertBefore(nextRow, currentRow);
            }
        }

        function duplicateRow(button, tbName) {
            const rowIndex = getRowIndex(button, tbName);
            const table = document.getElementById(tbName);
            const tbody = table.querySelector("tbody");
            const rows = tbody.querySelectorAll("tr");

            if (rowIndex >= 0 && rowIndex < rows.length) {
                const rowToCopy = rows[rowIndex]; // 取得要複製的行
                const newRow = rowToCopy.cloneNode(true); // 深度複製行及其內容
                tbody.appendChild(newRow); // 將複製的行新增到 tbody 的最後
            } else {
                console.error("Invalid row index");
            }
        }

        function del(button, tbName) {
            const rowIndex = getRowIndex(button, tbName);
            const table = document.getElementById(tbName);
            const tbody = table.querySelector("tbody");
            const rows = tbody.querySelectorAll("tr");

            if (rowIndex >= 0 && rowIndex < rows.length) {
                const rowToRemove = rows[rowIndex];
                removeRow(rowToRemove); // 使用移除行的函式
            } else {
                console.error("Invalid row index");
            }


        }

        function removeRow(row) {
            if (row && row.parentNode) {
                row.parentNode.removeChild(row); // 從父節點中移除該行
            } else {
                console.error("Invalid row or parentNode not found");
            }
        }

        function CpTo3() {
            $("#table3_main_body").html("");

            //$("#tab3").html($("#tab2")());
            var towns = $(".TOWN");

            var i = 0;

            towns.each(function () {
                var town = $(this).val();
                var po = $(".POS_SYB").eq(i);
                if (town.length > 0) {
                    $("#table3_main_body").append(GenHtml(i, town, po.val()));
                    i++;
                }
            })
        }

        $(document).ready(function () {
            $(".file").fileinput({
                showPreview: false,
                showUpload: false,
                allowedFileExtensions: ["jpg", "jpeg", "gif", "png"],
                //elErrorContainer: "#errorBlock",
                language: "zh-TW",
            });
        });

        function GenHtml(aid, town, pos) {

            return '<tr>' +
                '    <td width="1"><button onclick="$(\'#ag'+aid+'\').show();" class="btn btn-secondary" type="button"><span class="fa-solid fa-eye-slash" aria-hidden="true"></span></button></td>' +
                '    <td nowrap width="200"><input form="mainForm" class="form-control" type="text" value="'+town+'"/></td>' +
                '    <td nowrap><input class="form-control" type="text" value="'+pos+'"/></td>' +
                '</tr>' +
                '<tr>                                ' +
                '    <td colspan="3" style="padding-left:50px;">' +
                '        <table class="table ag" id="ag'+aid+'" style="display:none;">' +
                '            <thead class="table-light">' +
                '                <tr>' +
                '                    <th nowrap>移動</th>' +
                '                    <th nowrap>複製</th>' +
                '                    <th nowrap>刪除</th>' +
                '                    ' +
                '                    <th nowrap>項目內容</th>' +
                '                    <th nowrap>單位</th>' +
                '                    <th nowrap>數量</th>' +
                '                    <th nowrap>備註</th>' +
                '                </tr>' +
                '            </thead>' +
                '            <tbody id="table3_sub_body'+aid+'">' +
                '                <tr>' +
                '                    <td width="1" nowrap>' +
                '                        <button type="button" class="btn btn-secondary" onclick="moveDown(this, \'ag' + aid +'\')"><span class="fa-solid fa-chevron-up" aria-hidden="true"></span></button>' +
                '                        <button type="button" class="btn btn-secondary" onclick="moveUp(this, \'ag' + aid +'\')"><span class="fa-solid fa-chevron-down" aria-hidden="true"></span></button>' +
                '                    </td>' +
                '                    <td width="1"><button type="button" class="btn btn-secondary" onclick="duplicateRow(this, \'ag' + aid +'\')"><span class="fa-solid fa-copy" aria-hidden="true"></span></button></td>' +
                '                    <td width="1"><button type="button" class="btn btn-secondary" onclick="del(this, \'ag' + aid +'\');"><span class="fa-solid fa-minus" aria-hidden="true"></span></button></td>                                                ' +
                '                    <td nowrap><input  form="mainForm" type="text" name="MT_AID" value="' + town +'" style="width:60px;" form = "mainForm" /><input type="text" name="MT_DESC" value="" class = "form-control" placeholder = "項目內容" AutoComplete = "Off"/></td>' +
                '                    <td><input type="text"  form="mainForm" name="MT_UNIT" value="" class="form-control" placeholder="單位" AutoComplete="Off" /></td>' +
                '                    <td><input type="text"  form="mainForm" name="MT_QTY" value="" class="form-control" placeholder="數量" AutoComplete="Off" /></td>' +
                '                    <td><input type="text"  form="mainForm" name="MT_SPEC" value="" class="form-control" placeholder="備註" AutoComplete="Off" /></td>' +
                '                </tr>' +
                '            </tbody>' +
                '        </table>' +
                '    </td>' +
                '</tr>'
        }
</script>
