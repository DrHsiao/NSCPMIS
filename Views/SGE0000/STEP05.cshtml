    <script>
        //統一顯示與加總"元"→"汙水"計畫不用自動加總請移除(雨水的保留不用移除)
        function count() {



            let t1 = 0;
            let t2 = 0;

            $('.tt1').each(function () {
                let val1 = parseFloat($(this).val());
                if (!isNaN(val1)) {
                    t1 += val1;
                }
            });

            $('.tt2').each(function () {
                let val2 = parseFloat($(this).val());
                if (!isNaN(val2)) {
                    t2 += val2;
                }
            });


            //勾選添加
            $('.ck').each(function (index) {
                let inputVal = parseFloat($('.cv').eq(index).val());
                if (!isNaN(inputVal)) {
                    if ($(this).val() === '00') {
                        t1 += inputVal;
                    } else {
                        t2 += inputVal;
                    }
                }

            });



            $("#t1").val(t1);

            $("#t2").val(t2);
        }


    </script>

