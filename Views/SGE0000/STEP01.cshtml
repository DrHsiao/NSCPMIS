                        var isR = ViewBag.isR == true; }// 只要不是 null 就是 true
                    const canUpdate =  @(canUpdate.ToString().ToLower());
                    const isR = @(isR.ToString().ToLower());

                    // 2. 先停用所有輸入欄位 (排除 hidden 確保能記錄 ID)
                    $('#mainForm :input').not('[type="hidden"]').prop('disabled', true);
                    $('button[type="submit"]').hide();
                    $('.btn-secondary').hide();

                    // 💡 關鍵修復 A：只撕掉「被鎖定欄位」的必填標籤，不干擾驗證器！
                    $('#mainForm :input:disabled').removeAttr('required');

                    if (canUpdate && isR) {

                        // 3. 強制解鎖 5 個特權欄位，並手動加回 required (這樣驗證器才會給綠色！)
                        $("#PJ_CATY_CODE").prop('disabled', false).attr('required', 'required');
                        $("#EXT_FG").prop('disabled', false).attr('required', 'required');
                        $("#AP_NAME").prop('disabled', false).prop('readonly', false).attr('required', 'required');
                        $("#TD_CODE").prop('disabled', false).prop('readonly', false); // 編號維持原樣不強制必填

                        // 🎯 【關鍵修復】：在這裡手動加回對 RSYS_NAME_SEL 的解鎖特權！
                        $("#RSYS_NAME_SEL").prop('disabled', false);

                        // 解鎖延續工程下拉選單並喚醒套件
                        $("#allap").prop('disabled', false);

                        // Tom Select：解鎖後同步啟用狀態
                        if (window.tsRsys) window.tsRsys.enable();
                        if (window.tsAllap) window.tsAllap.enable();

                        // 4. 解鎖「主儲存按鈕」與「分頁按鈕」
                        $('#MainSave').prop('disabled', false).show();
                    }

                    //$('.btn-secondary:contains("下一頁")').prop('disabled', false).show();
                    //$('.btn-secondary:contains("上一頁")').prop('disabled', false).show();

                    // 4. 執行 UI 顯示與重繪 (不再帶有解鎖權力)
                    chExt();
                         

                    // 4. 重新綁定辦理狀態切換事件 (必須保留，這是切換狀態時的守門員！)
                    $("#EXT_FG").off("change").on("change", function () {
                    // ❌ 移除了這裡的 chExt(); 因為 HTML 行內 onchange 已經觸發過一次了

                        // 切換狀態後，依據權限決定是否要再把下拉選單鎖死或打開
                        if (canUpdate && isR) {
                            $("#allap").prop('disabled', false);
                            if (window.tsAllap) window.tsAllap.enable();
                        } else {
                            $("#allap").prop('disabled', true);
                            if (window.tsAllap) window.tsAllap.disable();
                        }

                        // 喚醒驗證器，更新紅綠框
                        if ($.fn.validator) {
                            $('#mainForm').validator('update').validator('validate');
                        }
                    });

                    if ($.fn.validator) {
                        $('#mainForm').validator('update').validator('validate');
                    }

                    $('#mainForm').off('submit').on('submit', function (e) {
                        if (!e.isDefaultPrevented()) {
                            $('#mainForm :input:disabled').prop('disabled', false).attr('readonly', true);
                        }
                    });

                } catch (e) {
                    console.error("解鎖腳本發生錯誤：", e);
                }
            });
            </script>
        }
        else
        {
            <script>
                $(window).on('load', function () {
                    try {
                        $("#EXT_FG").off("change").on("change", function () {
                            // ❌ 移除了這裡的 chExt();
                            if ($.fn.validator) {
                                $('#mainForm').validator('update').validator('validate');
                            }
                        });

                        if ($.fn.validator) {
                            $('#mainForm').validator('update').validator('validate');
                        }
                    } catch (e) { }
                });
            </script>
        }
