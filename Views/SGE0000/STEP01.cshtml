                                                <script>
                                                    function GetAP_PJ_NAME(city) {
                                                        //$("#AP_PJ_NAME_T").effect("shake");
                                                        $("#AP_PJ_NAME").html("");
                                                        $.ajax({
                                                            url: '@Url.Content("~/")ASYNC/GetPJCMFORMbyCity',
                                                            method: 'post',
                                                            data: { "city": city },
                                                            success: function (d) {
                                                                var p = jQuery.parseJSON(d);
                                                                $("#AP_PJ_NAME").prepend("<option value=''>請選擇</option>");
                                                                for (i = 0; i < p.length; i++) {
                                                                    $("#AP_PJ_NAME").append("<option value='" + p[i].PJ_NAME + "'>" + p[i].PJ_NAME + "</option>");
                                                                }
                        if (window.tsAP) {
                            // 用 TomSelect API 直接換選項（不 destroy、不碰原生 select，避免競態與累積）
                            window.tsAP.clear(true);
                            window.tsAP.clearOptions();
                            window.tsAP.addOption({ value: '', text: '請選擇' });
                            for (var k = 0; k < p.length; k++) {
                                window.tsAP.addOption({ value: p[k].PJ_NAME, text: p[k].PJ_NAME });
                            }
                            window.tsAP.refreshOptions(false);
                            window.tsAP.setValue("@Model.APMFORM.AP_PJ_NAME" || '', true);
                        }
                                                            }
                                                        });
                                                        }



                                                        $("#CITY").change(function () {
                                                            GetAP_PJ_NAME(this.value);
                                                            // ✅ 加入安全防護，避免連鎖觸發時 Validator 尚未載入導致當機
                                                            if ($.fn.validator) {
                                                                $('#mainForm').validator('validate');
