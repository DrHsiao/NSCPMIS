                                                            $(this).delay(1000).queue(function (next) {
                                                                $("#CITY").focus();
                                                                next();
                                                            });
                                                        });
                                                </script>
                                                @if (string.IsNullOrEmpty(Model.APMFORM.CITY))
                                                {
                                                    <script>

                                                        //alert("@WCals.Helpers.WebSiteHelper.getDeptName(WCals.Helpers.WebSiteHelper.getUserDept()).Substring(0, 3)");

                                                        var __deptCity = "@WCals.Helpers.WebSiteHelper.getDeptName(WCals.Helpers.WebSiteHelper.getUserDept()).Substring(0, 3)";
                                                        // 部門名前3字對上縣市選項才自動載入(縣市政府帳號)；對不上(中央/建設組)保留「請選擇」讓使用者手選，避免以空 city 查詢導致清單空白
                                                        $('#CITY').val(__deptCity);
                                                        if (__deptCity !== "" && $('#CITY').val() === __deptCity) { $('#CITY').trigger('change'); } else { $('#CITY').val(''); }
                                                    </script>
                                                }
                                            </div>
                                            <span class="glyphicon form-control-feedback" aria-hidden="true"></span>
                                            <div class="form-text with-errors"></div>
                                        </div>
