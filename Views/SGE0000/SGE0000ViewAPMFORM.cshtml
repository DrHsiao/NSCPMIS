                                </tr>


                                APDWQTY = (System.Data.DataTable)d["APDWQTY"];

                                foreach(System.Data.DataRow dd in APDWQTY.Rows) {
                                    <tr>
                                        <td colspan="3" style="padding-left:50px;">

                                            <table class="table ag" id="ag1">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th nowrap>移動</th>
                                                        <th nowrap>複製</th>
                                                        <th nowrap>刪除</th>

