                                    <td><input type="text" name="GIS_Z" value="@d["GIS_Y"]" class="form-control" /></td>
                                    <td><input type="text" name="GIS_Z" value="@d["GIS_Z"]" class="form-control" /></td>
                                </tr>

                            }

                        </tbody>
                    </table>




                    


                    <div class="row row-no-gutters" style="padding:10px;">
                        <div class="col-xs-6">

                            <a class="btn btn-secondary" onclick="$('#syrTab li:eq(0) a').tab('show')">上一頁</a>
                            <a class="btn btn-secondary" onclick="$('#syrTab li:eq(2) a').tab('show')">下一頁</a>


                        </div>
                        <div class="col-xs-6" style="text-align: right; color:#808080;">
                            
                        </div>
                    </div>















