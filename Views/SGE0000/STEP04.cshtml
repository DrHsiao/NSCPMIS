</head>
<body style="padding:5px;">
    @using (Html.BeginForm("", "SGE0000", FormMethod.Post, new { id = "mainForm", enctype = "multipart/form-data" }))
    {
        @Html.HiddenFor(x => x.AID)
        <a class="btn btn-secondary" href="@Url.Content("~/SGE0000/STEP03")?aid=@Model.AID">上一頁</a>
        <a class="btn btn-secondary" href="@Url.Content("~/SGE0000/STEP05")?aid=@Model.AID">下一頁</a>
        <br>
        <br />
        <!-- Nav tabs -->
        <div class="card with-nav-tabs border-primary">
            @if (ViewBag.dis == null)
            {
                <div class="card-header bg-primary text-white">
                    <ul class="nav nav-tabs">
                        <li id="li1" class="nav-item"><a href="@Url.Content("~/SGE0000/STEP01")?aid=@Model.AID" class="nav-link">申請內容基本資料</a></li>
                        <li id="li2" class="nav-item"><a href="@Url.Content("~/SGE0000/STEP02")?aid=@Model.AID" class="nav-link">實施區域</a></li>
                        <li id="li3" class="nav-item"><a href="@Url.Content("~/SGE0000/STEP03")?aid=@Model.AID" class="nav-link">實行內容</a></li>
                        <li id="li4" class="nav-item"><a href="@Url.Content("~/SGE0000/STEP04")?aid=@Model.AID" class="nav-link active">勘察評估事項</a></li>
                        <li id="li5" class="nav-item"><a href="@Url.Content("~/SGE0000/STEP05")?aid=@Model.AID" class="nav-link">財源分配</a></li>
                        <li id="li6" class="nav-item"><a href="@Url.Content("~/SGE0000/STEP06")?aid=@Model.AID" class="nav-link">檢附資料</a></li>
                        <li id="li7" class="nav-item"><a href="@Url.Content("~/SGE0000/STEP07")?aid=@Model.AID" class="nav-link">自評分數</a></li>
                    </ul>
                </div>
            }
            else
            {
                <div class="card-header bg-primary text-white">
                    <ul class="nav nav-tabs">
                        <li id="li1" class="nav-item"><a href="@Url.Content("~/SGE0000/STEP01")?aid=@Model.AID&dis=true" class="nav-link">申請內容基本資料</a></li>
                        <li id="li2" class="nav-item"><a href="@Url.Content("~/SGE0000/STEP02")?aid=@Model.AID&dis=true" class="nav-link">實施區域</a></li>
                        <li id="li3" class="nav-item"><a href="@Url.Content("~/SGE0000/STEP03")?aid=@Model.AID&dis=true" class="nav-link">實行內容</a></li>
                        <li id="li4" class="nav-item"><a href="@Url.Content("~/SGE0000/STEP04")?aid=@Model.AID&dis=true" class="nav-link active">勘察評估事項</a></li>
                        <li id="li5" class="nav-item"><a href="@Url.Content("~/SGE0000/STEP05")?aid=@Model.AID&dis=true" class="nav-link">財源分配</a></li>
                        <li id="li6" class="nav-item"><a href="@Url.Content("~/SGE0000/STEP06")?aid=@Model.AID&dis=true" class="nav-link">檢附資料</a></li>
                        <li id="li7" class="nav-item"><a href="@Url.Content("~/SGE0000/STEP07")?aid=@Model.AID&dis=true" class="nav-link">自評分數</a></li>
                    </ul>
                </div>
            }


            <div class="tab-content">
                <div role="tabpanel" class="tab-pane active" id="tab4" style="padding:5px;">
                    <button class="btn btn-warning" name="action" type="submit" value="STEP04Save">儲存</button>
                    @*@{
                            var validStatus = new HashSet<string> { "-1", "00", "Z1", "Z2" };
                        }
                        @if (Model.APMFORM.AP_STAT != null && validStatus.Contains(Model.APMFORM.AP_STAT))
                        {
                            <button class="btn btn-warning" name="action" type="submit" value="STEP04Save">儲存</button>
                        }
                        else
                        {
                            <script>
                                $(document).ready(function () {
                                    $(":input").prop("disabled", true);
                                });
                            </script>
                        }*@
                    @{
                        SelectListItem item;
                        List<SelectListItem> options = new List<SelectListItem>();
                        item = new SelectListItem { Text = "是", Value = "Y" };
                        options.Add(item);
                        item = new SelectListItem { Text = "否", Value = "N" };
                        options.Add(item);
                    }

                    @if (Model.APMFORM.PJ_CATY_CODE.Equals("CA") ||
                        Model.APMFORM.PJ_CATY_CODE.Equals("CB") ||
                        Model.APMFORM.PJ_CATY_CODE.Equals("CC") ||
                        Model.APMFORM.PJ_CATY_CODE.Equals("CD") ||
                        Model.APMFORM.PJ_CATY_CODE.Equals("CE"))
                    {

                        <table class="table">
                            <thead class="table-light">
                                <tr>
                                    <th>評估事項</th>
                                    <th nowrap></th>
                                    <th nowrap></th>
                                </tr>
                            </thead>
                            <tbody>

                                <tr>
                                    <td nowrap id="C_SWW2_FG">1.是否完成規劃或治理計畫</td>
                                    <td>
                                        @Html.DropDownListFor(x => x.SWW2_FG, options, "", new { @class = "form-select", form = "mainForm" })
                                    </td>
                                    <td width="50%"></td>
                                </tr>

                                <tr>
                                    <td id="C_SWW4_FG">2.用地取得</td>
                                    <td>
                                        @Html.DropDownListFor(x => x.SWW4_FG, options, "", new { @class = "form-select", form = "mainForm" })

                                    </td>
                                    <td width="50%"></td>
                                </tr>

                            </tbody>
                        </table>


                    }
                    else if (Model.APMFORM.PJ_CATY_CODE.Equals("EA") ||
                    Model.APMFORM.PJ_CATY_CODE.Equals("EB") ||
                    Model.APMFORM.PJ_CATY_CODE.Equals("EC"))
                    {


                        <table class="table">
                            <thead class="table-light">
                                <tr>
                                    <th>評估事項</th>
                                    <th nowrap></th>
                                    <th nowrap></th>
                                </tr>
                            </thead>
                            <tbody>

                                <tr>
                                    <td nowrap>1.水環境空間發展藍圖是否完成&nbsp;<span class="text-danger">*</span></td>
                                    <td>
                                        @Html.DropDownListFor(x => x.SWW1_FG, options, "", new { @class = "form-select", form = "mainForm", @required = "required" })
                                        說明(延續/檢討修正，50字以內): @Html.TextAreaFor(x => x.SWWOT_DESC, new { @class = "form-control", AutoComplete = "Off", tabindex = "1" })

                                    </td>
                                    <td width="50%"></td>
                                </tr>

                                <tr>
                                    <td nowrap id="C_SWW2_FG">2.用地取得&nbsp;<span class="text-danger">*</span></td>
                                    <td>
                                        @Html.DropDownListFor(x => x.SWW2_FG, options, "", new { @class = "form-select", form = "mainForm", @required = "required" })
                                    </td>
                                    <td width="50%"></td>
                                </tr>

                            </tbody>
                        </table>


                    }
                    else
                    {

                        <table class="table">
                            <thead class="table-light">
                                <tr>
                                    <th>評估事項</th>
                                    <th nowrap></th>
                                    <th nowrap></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td width="1" nowrap>1.符合系統規劃</td>
                                    <td>

                                        @Html.DropDownListFor(x => x.SWW1_FG, options, "", new { @class = "form-select", form = "mainForm" })
                                    </td>
                                    <td width="50%"></td>
                                </tr>
                                <tr>
                                    <td nowrap id="C_SWW2_FG">2.實施計畫是否通過</td>
                                    <td>
                                        @Html.DropDownListFor(x => x.SWW2_FG, options, "", new { @class = "form-select", form = "mainForm" })
                                    </td>
                                    <td width="50%"></td>
                                </tr>
                                <tr>
                                    <td nowrap>3.用地變更程序</td>
                                    <td>
                                        @Html.DropDownListFor(x => x.SWW3_FG, options, "", new { @class = "form-select", form = "mainForm" })

                                    </td>
                                    <td width="50%"></td>
                                </tr>
                                <tr>
                                    <td id="C_SWW4_FG">4.用地取得</td>
                                    <td>
                                        @Html.DropDownListFor(x => x.SWW4_FG, options, "", new { @class = "form-select", form = "mainForm" })

                                    </td>
                                    <td width="50%"></td>
                                </tr>
                                <tr>
                                    <td nowrap>5.下游管線廠站建設期程是否配合</td>
                                    <td>
                                        @Html.DropDownListFor(x => x.SWW5_FG, options, "", new { @class = "form-select", form = "mainForm" })

                                    </td>
                                    <td width="50%"></td>
                                </tr>
                                <tr>
                                    <td>6.交維問題可否解決</td>
                                    <td>
                                        @Html.DropDownListFor(x => x.SWW6_FG, options, "", new { @class = "form-select", form = "mainForm" })

                                    </td>
                                    <td width="50%"></td>
                                </tr>
                                <tr>
                                    <td>7.地下管線拆遷</td>
                                    <td>
                                        @Html.DropDownListFor(x => x.SWW7_FG, options, "", new { @class = "form-select", form = "mainForm" })

                                    </td>
                                    <td width="50%"></td>
                                </tr>
                                <tr>
                                    <td nowrap>8.本工程已完成設計</td>
                                    <td nowrap>
                                        @Html.DropDownListFor(x => x.SWW8_FG, options, "", new { @class = "form-select", form = "mainForm" })

                                    </td>
                                    <td width="50%">
                                        <table>
                                            <tr>
                                                <td>8.1 辦理中</td>
                                                <td style="padding-left:5px;">@Html.DropDownListFor(x => x.SWW81_FG, options, "", new { @class = "form-select", form = "mainForm" })</td>
                                            </tr>
                                        </table>





                                    </td>
                                </tr>
                                <tr>
                                    <td nowrap>9.本工程前一年度執行率%(新建工程免填)</td>
                                    <td>
                                        @Html.TextBoxFor(x => x.SWW9_FG, new { @class = "form-control", form = "mainForm" })

                                    </td>
                                    <td width="50%"></td>
                                </tr>
                                <tr>
                                    <td nowrap>10.前一年度配合款編列情形</td>
                                    <td>
                                        @Html.DropDownListFor(x => x.SWW10_FG, options, "", new { @class = "form-select", form = "mainForm" })

                                    </td>
                                    <td width="50%"></td>
                                </tr>
                                <tr>
                                    <td>11.是否可配合納入預算</td>
                                    <td>
                                        @Html.DropDownListFor(x => x.SWW11_FG, options, "", new { @class = "form-select", form = "mainForm" })

                                    </td>
                                    <td width="50%"></td>
                                </tr>
                                <tr id="S_SWWOT_DESC">
                                    <td>其他</td>
                                    <td>
                                        @Html.TextAreaFor(x => x.SWWOT_DESC, new { @class = "form-control", AutoComplete = "Off", tabindex = "1" })

                                    </td>
                                    <td width="50%"></td>
                                </tr>
                            </tbody>
                        </table>


                    }



                </div>





            </div>
        </div>


    }




    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script type="text/javascript" src="https://code.jquery.com/ui/1.14.1/jquery-ui.min.js"></script>
    <script type="text/javascript" src="~/Scripts/jquery.datepick.js"></script>
    <script type="text/javascript" src="~/Scripts/MyDatepickerJ.js"></script>

    <script>
        $(document).ready(function () {
            isNormal();
        });
    </script>




    @if (ViewBag.msg != null)
    {
        <script>
        alert("@ViewBag.msg");
        </script>



    }


    <!--載入動作BEGIN-->
    @if (Model.APMFORM.PJ_CATY_CODE.Equals("CA") ||
        Model.APMFORM.PJ_CATY_CODE.Equals("CB") ||
        Model.APMFORM.PJ_CATY_CODE.Equals("CC") ||
        Model.APMFORM.PJ_CATY_CODE.Equals("CD") ||
        Model.APMFORM.PJ_CATY_CODE.Equals("CE"))
    {

        <script>
            //選擇CA,CB, CC, CD, CE五項中的一項時5項更名, 4項新欄位
            $(document).ready(function () {
                isCA_BCDE();
            });
        </script>

    }


    <script>
        $(".dt").datepickerTW({
            changeYear: true,
            changeMonth: true,
            yearRange: '68:168',
            dateFormat: 'yymmdd',
            //defaultDate: null,
        });
        $(".dt").datepickerTW({
            onSelect: function (dateText) {
                $('#mainForm').validator('validate');
            }
        });


        $('.dt').click(function () {
            //消掉前次輸入自帶的回期
            $(this).delay(600).val("");
        });
    </script>

    <script>
        //CA, CB, CC, CD, CE 9項變動
        function isCA_BCDE() {
            isNormal();//復原
            //$("#C_SWW2_FG").html("辦理期程開始時間");
            //$("#C_AP_PJ_NAME").html("雨水下水道系統及幹線名稱");
            //$("#C_EXE_MCH").html("執行機關");
            //$("#C_END_DT").html("辦理期程完成時間");
            ////$("#C_ABCDE").show("slow");//水系、改善、保護、檢討
            //$("#S_WSYS_NAME").show("slow");
            //$("#S_IMPFLDAREA").show("slow");
            //$("#S_PRTPOPS").show("slow");
            //$("#S_REXM_PRJ").show("slow");
            ////水系、改善、保護、檢討
            //$("#C_BENEFITS").hide("slow");//隱藏或不輸出預期效益欄位
            //$("#C_IMPFLDAREA").html("改善淹水面積(ha)");

            $("#li7").show("slow");//自評
            //$("#li4").show("slow");//自評
            //$("#C_SWW2_FG").html("1.是否完成規劃或治理計畫");
            //$("#C_SWW4_FG").html("2.用地是否取得");
            $("#S_SWWOT_DESC").hide();

        }

        function isPA() {
            isPA_PB();
            $("#S_NPSD_SYR").show("slow");
        }

        function isPB() {
            isPA_PB();
            $("#S_OPSD_SYR").show("slow");
            $("#S_PPSD_SYR").show("slow");
        }

        function isOA_OB_OC() {
            isNormal();//復原
            $("#li4").hide("slow");//勘查評估頁籤不顯示
            $("#S_WSYS_NAME").show("slow");//水系名稱
            $("#C_AP_NAME").html("非工程措施名稱");
            $("#C_AP_ALL_NOTE").html("辦理內容");
            $("#C_REXM_PRJ").html("其他補充說明");
            $("#li7").show("slow");//自評
        }

        function isPA_PB() {
            isNormal();//復原
            $("#li4").hide("slow");//勘查評估頁籤不顯示
            $("#S_WSYS_NAME").show("slow");//水系名稱
            $("#S_IMPFLDAREA").show("slow");//規劃(檢討)面積(ha)
            $("#S_IMPALLAREA").show("slow");//規劃總面積(ha)
            $("#C_IMPFLDAREA").html("規劃(檢討)面積(ha)");
            $("#C_IMPALLAREA").html("規劃總面積(ha) ");
            $("#C_BENEFITS").hide("slow");//隱藏或不輸出預期效益欄位
            $("#li7").show("slow");//自評
        }

        //一般
        function isNormal() {
            $("#C_AP_NAME").html("工程名稱");
            $("#C_AP_ALL_NOTE").html("工程內容");
            //CA,CB, CC, CD, CE 9項
            $("#C_START_DT").html("預定開始日期");
            $("#C_AP_PJ_NAME").html("實施計畫名稱");
            $("#C_EXE_MCH").html("預定執行單位");
            $("#C_END_DT").html("預定完成日期");
            //$("#C_ABCDE").hide("slow");//水系、改善、保護、檢討
            $("#S_WSYS_NAME").hide("slow");//水系名稱
            $("#S_IMPFLDAREA").hide("slow");//規劃(檢討)面積(ha)
            $("#S_IMPALLAREA").hide("slow");//規劃總面積(ha)
            $("#S_PRTPOPS").hide("slow");
            $("#S_REXM_PRJ").hide("slow");
            //水系、改善、保護、檢討
            $("#C_BENEFITS").show("slow");//預期效益
            //CA,CB, CC, CD, CE 9項

            //選擇PA,PB, OA, OB, O

            $("#C_REXM_PRJ").html("雨水下水道(重新)檢討規劃名稱");
            $("#S_NPSD_SYR").hide("slow");
            $("#S_OPSD_SYR").hide("slow");
            $("#S_PPSD_SYR").hide("slow");
            $("#li4").show("slow");//堪查評估事項
            $("#li7").hide("slow");//自評
        }

        $("#PJ_CATY_CODE").on("change", function () {
            var c = $(this).val();
            //選擇CA,CB, CC, CD, CE五項中的一項時5項更名, 4項新欄位
            if (c == "CA" || c == "CB" || c == "CC" || c == "CD" || c == "CE") {
                isCA_BCDE();
            }
            //選擇PA,PB中的一項
            if (c == "PA" || c == "PB") {
                //堪查評估事項
                isPA_PB();
            }
            if (c == "PA") {
                isPA();
            }
            if (c == "PB") {
                //堪查評估事項
                isPB();
            }
            //選擇OA, OB, OC中的一項
            if (c == "OA" || c == "OB" || c == "OC") {
                isOA_OB_OC();
            }
        });
        //動態判斷END/
    </script>
    @if (ViewBag.dis != null)
    {
        <script>
            //初審複審
            $(document).ready(function () {
                $('#mainForm :input').prop('disabled', true);
                $('button[type="submit"]').hide("slow");
                $('.btn-secondary').hide("slow");
            });
        </script>
    }
    <!--6/7追加-->
    @if (ViewBag.isE == true)
    {
        <script>
            //==E的
            $(document).ready(function () {
                $("#li7").show("slow");//自評
            });
        </script>
    }
    else if (ViewBag.isR == null)
    {
        <script>
            //!=R的
            $(document).ready(function () {
                $("#li7").hide("slow");//自評
            });
        </script>
    }
    else
    {
        <script>
            //==R的
            $(document).ready(function () {
                $("#li7").show("slow");//自評
            });
        </script>
    }
    <script src="~/Scripts/plugins/bootstrap-fileinput/fileinput.js"></script>
    <script src="~/Scripts/plugins/bootstrap-fileinput/zh-TW.js"></script>
    <script src="~/Scripts/SGE0000.js"></script>
</body>
</html>