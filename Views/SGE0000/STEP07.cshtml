                                    </td>
                                    <td>
                                        @Html.TextBoxFor(x => x.APMFORM.SC7_SCORE1, new { oninput = "this.value = (+this.value > 10 || isNaN(this.value)) ? 10 : this.value", id = "SC7_SCORE1", @class = "form-control", form = "mainForm" })
                                    </td>
                                    <td>
                                        @Html.TextBoxFor(x => x.APMFORM.SC7_CMT1, new { @class = "form-control", form = "mainForm" })
                                    </td>
                                </tr>
                                <tr>
                                    <td>
