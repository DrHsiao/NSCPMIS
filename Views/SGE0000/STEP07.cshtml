                                        @Html.TextBoxFor(x => x.APMFORM.SC3_SCORE1, new { oninput = "this.value = (+this.value > 6 || isNaN(this.value)) ? 6 : this.value", id = "SC3_SCORE1", @class = "form-control", form = "mainForm" })
                                    </td>
