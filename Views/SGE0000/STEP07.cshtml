                                        <small class="text-muted fs-6">優:5；良:4；中:3；可:2；差:1-0</small>
                                    </td>
                                    <td>
                                        @Html.TextBoxFor(x => x.APMFORM.SC8_SCORE1, new { oninput = "this.value = (+this.value > 5 || isNaN(this.value)) ? 5 : this.value", id = "SC8_SCORE1", @class = "form-control", form = "mainForm" })
                                    </td>
                                    <td>
                                        @Html.TextBoxFor(x => x.APMFORM.SC8_CMT1, new { @class = "form-control", form = "mainForm" })
                                    </td>
                                </tr>
                                <tr>
