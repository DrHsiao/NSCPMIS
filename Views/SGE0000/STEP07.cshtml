                                    </td>
                                    <td>
                                        @Html.TextBoxFor(x => x.APMFORM.SC6_SCORE1, new { oninput = "this.value = (+this.value > 5 || isNaN(this.value)) ? 5 : this.value", id = "SC6_SCORE1", @class = "form-control", form = "mainForm" })
                                    </td>
                                    <td>
                                        @Html.TextBoxFor(x => x.APMFORM.SC6_CMT1, new { @class = "form-control", form = "mainForm" })
                                    </td>
                                </tr>
                                <tr>
                                    <td width="1" nowrap>
                                        7.是否具其他間接效益(10分)<br />
