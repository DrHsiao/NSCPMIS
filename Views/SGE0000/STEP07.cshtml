                                    </td>
                                    <td>
                                        @Html.TextBoxFor(x => x.APMFORM.SC4_SCORE1, new { oninput = "this.value = (+this.value > 15 || isNaN(this.value)) ? 15 : this.value", id = "SC4_SCORE1", @class = "form-control", form = "mainForm" })
                                    </td>
                                    <td>
