                            <thead class="table-light">
                                <tr>
                                    <th>評比項目</th>
                                    <th width="20%">自評分數</th>
                                    <th width="80%">說明</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td width="1" nowrap>
                                        1.辦理原因(20分)<br />
                                        <small class="text-muted fs-6">需緊急打開瓶頸或增加排洪能力20 - 11；排水設施修繕更新10 - 0</small>
                                    </td>
                                    <td>
                                        @Html.TextBoxFor(x => x.APMFORM.SC1_SCORE1, new { oninput = "this.value = (+this.value > 20 || isNaN(this.value)) ? 20 : this.value", id = "SC1_SCORE1", @class = "form-control", form = "mainForm" })
                                    </td>
                                    <td>
                                        @Html.TextBoxFor(x => x.APMFORM.SC1_CMT1, new { @class = "form-control", form = "mainForm" })
                                    </td>
                                </tr>
                                <tr>
                                    <td width="1" nowrap>
