                                    <td>
                                        <input type="text" id="SCS_SCORE1" class="form-control" />
                                    </td>
                                    <td>
                                        @Html.TextBoxFor(x => x.APMFORM.SCS_CMT1, new { @class = "form-control", form = "mainForm" })
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <script>
                            $(document).ready(function () {
                                cntSCS(8);
                                $('.form-control').on('keyup', function () {
                                    cntSCS(8);
                                });
                            });
                        </script>
                    }

                    @if (Model.APMFORM.PJ_CATY_CODE.Equals("EA") ||
