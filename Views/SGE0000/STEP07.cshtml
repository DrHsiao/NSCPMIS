                            <thead class="table-light">
                                <tr>
                                    <th nowrap>評比項目</th>
                                    <th width="20%">自評分數</th>
                                    <th width="80%">說明</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td width="1" nowrap>
                                        (一)地方政府內部競爭序位分數(22分)<br />
