<script>
        $(".dt").datepickerTW({
            changeYear: true,
            changeMonth: true,
            yearRange: '68:168',
            dateFormat: 'yymmdd',
            //defaultDate: new Date()
        });

        // 通用的動態加總函式
        function cntSCS(end) {
            let total = 0;
            for (let i = @( (Model.APMFORM.PJ_CATY_CODE.Equals("EA") ||
                         Model.APMFORM.PJ_CATY_CODE.Equals("EB") ||
                         Model.APMFORM.PJ_CATY_CODE.Equals("EC")) ? 2 : 1 ); i <= end; i++) {
                const val = parseFloat($('#SC' + i + '_SCORE1').val()) || 0;
                total += val;
            }
            $('#SCS_SCORE1').val(total);
        }
</script>
