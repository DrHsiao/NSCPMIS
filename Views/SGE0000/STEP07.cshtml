                                    </td>
                                    <td>
                                        @Html.TextBoxFor(x => x.APMFORM.SC2_SCORE1, new { oninput = "this.value = (+this.value > 20 || isNaN(this.value)) ? 20 : this.value", id = "SC2_SCORE1", @class = "form-control", form = "mainForm" })
                                    </td>
                                    <td>
                                        @Html.TextBoxFor(x => x.APMFORM.SC2_CMT1, new { @class = "form-control", form = "mainForm" })
                                    </td>
                                </tr>
                                <tr>
                                    <td width="1" nowrap>
