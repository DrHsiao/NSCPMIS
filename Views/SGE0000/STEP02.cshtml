    <!--載入動作END-->
    <script>
        //CA, CB, CC, CD, CE 9項變動
        function isCA_BCDE() {
            isNormal();//復原
            $("#C_START_DT").html("辦理期程開始時間");
            $("#C_AP_PJ_NAME").html("雨水下水道系統及幹線名稱");
            $("#C_EXE_MCH").html("執行機關");
            $("#C_END_DT").html("辦理期程完成時間");
            //$("#C_ABCDE").show("slow");//水系、改善、保護、檢討
            $("#S_WSYS_NAME").show("slow");
            $("#S_IMPFLDAREA").show("slow");
            $("#S_PRTPOPS").show("slow");
            $("#S_REXM_PRJ").show("slow");
            //水系、改善、保護、檢討
            $("#C_BENEFITS").hide("slow");//隱藏或不輸出預期效益欄位
            $("#C_IMPFLDAREA").html("改善淹水面積(ha)");
            $("#li7").show("slow");//自評
        }

        // 針對 EA, EB, EC 的文字切換
        function isEA_EB_EC() {
            // 先呼叫 isNormal() 確保其他欄位回到預設狀態 (如果您有這個需求的話)
            // isNormal();

            // 將「鄉鎮別」改為「鄉鎮市區別」
            $("#th_town").html("鄉鎮市區別&nbsp;<span class='text-danger'>*</span>");
            $("#th_x").html("工程座標點位經度X座標&nbsp;<span class='text-danger'>*</span>");
            $("#th_y").html("工程座標點位緯度Y座標&nbsp;<span class='text-danger'>*</span>");
            // 2. 動態將畫面中所有的 GIS_X 與 GIS_Y 欄位設為必填 (包含既有資料與新增範本)
            $("input[name='GIS_X'], input[name='GIS_Y']").prop("required", true);
            $("#li7").show("slow");//自評
        }

        // 恢復預設文字 (建議加在 isNormal 函式裡面，或另外寫一個)
        function resetTownLabel() {
            $("#th_town").html("鄉鎮別&nbsp;<span class='text-danger'>*</span>");
            $("#th_x").html("X座標");
            $("#th_y").html("Y座標");
            // 2. 動態取消 GIS_X 與 GIS_Y 欄位的必填限制
            $("input[name='GIS_X'], input[name='GIS_Y']").prop("required", false);
        }

        function isPA() {
            isPA_PB();
            $("#S_NPSD_SYR").show("slow");
        }

        function isPB() {
            isPA_PB();
            $("#S_OPSD_SYR").show("slow");
            $("#S_PPSD_SYR").show("slow");
        }

        function isOA_OB_OC() {
            isNormal();//復原
            $("#li4").hide("slow");//勘查評估頁籤不顯示
            $("#S_WSYS_NAME").show("slow");//水系名稱
            $("#C_AP_NAME").html("非工程措施名稱");
            $("#C_AP_ALL_NOTE").html("辦理內容");
            $("#C_REXM_PRJ").html("其他補充說明");
            $("#li7").show("slow");//自評
        }

        function isPA_PB() {
            isNormal();//復原
            $("#li4").hide("slow");//勘查評估頁籤不顯示
            $("#S_WSYS_NAME").show("slow");//水系名稱
            $("#S_IMPFLDAREA").show("slow");//規劃(檢討)面積(ha)
            $("#S_IMPALLAREA").show("slow");//規劃總面積(ha)
            $("#C_IMPFLDAREA").html("規劃(檢討)面積(ha)");
            $("#C_IMPALLAREA").html("規劃總面積(ha) ");
            $("#C_BENEFITS").hide("slow");//隱藏或不輸出預期效益欄位
            $("#li7").show("slow");//自評
        }

        //一般
        function isNormal() {
            $("#C_AP_NAME").html("工程名稱");
            $("#C_AP_ALL_NOTE").html("工程內容");
            //CA,CB, CC, CD, CE 9項
            $("#C_START_DT").html("預定開始日期");
            $("#C_AP_PJ_NAME").html("實施計畫名稱");
            $("#C_EXE_MCH").html("預定執行單位");
            $("#C_END_DT").html("預定完成日期");
            //$("#C_ABCDE").hide("slow");//水系、改善、保護、檢討
            $("#S_WSYS_NAME").hide("slow");//水系名稱
            $("#S_IMPFLDAREA").hide("slow");//規劃(檢討)面積(ha)
            $("#S_IMPALLAREA").hide("slow");//規劃總面積(ha)
            $("#S_PRTPOPS").hide("slow");
            $("#S_REXM_PRJ").hide("slow");
            //水系、改善、保護、檢討
            $("#C_BENEFITS").show("slow");//預期效益
            //CA,CB, CC, CD, CE 9項

            //選擇PA,PB, OA, OB, O
            $("#li4").show("slow");//堪查評估事項
            $("#li7").hide("slow");//自評
            $("#C_REXM_PRJ").html("雨水下水道(重新)檢討規劃名稱");
            $("#S_NPSD_SYR").hide("slow");
            $("#S_OPSD_SYR").hide("slow");
            $("#S_PPSD_SYR").hide("slow");

            resetTownLabel();
        }

        $("#PJ_CATY_CODE").on("change", function () {
            var c = $(this).val();
            //選擇CA,CB, CC, CD, CE五項中的一項時5項更名, 4項新欄位
            if (c == "CA" || c == "CB" || c == "CC" || c == "CD" || c == "CE") {
                isCA_BCDE();
            }
            //選擇PA,PB中的一項
            if (c == "PA" || c == "PB") {
                //堪查評估事項
                isPA_PB();
            }
            if (c == "PA") {
                isPA();
            }
            if (c == "PB") {
                //堪查評估事項
                isPB();
            }
            //選擇OA, OB, OC中的一項
            if (c == "OA" || c == "OB" || c == "OC") {
                isOA_OB_OC();
            }

            // 💡 加入這段：選擇 EA, EB, EC 中的一項
            if (c == "EA" || c == "EB" || c == "EC") {
                isEA_EB_EC();
            } else {
                // 如果不是這三種，記得把它改回預設的「鄉鎮別」
                resetTownLabel();
            }
        });
        //動態判斷END/
    </script>
    @if (ViewBag.dis != null)
    {
        <script>
            //初審複審
            $(document).ready(function () {
                $('#mainForm :input').prop('disabled', true);
                $('button[type="submit"]').hide("slow");
                $('.btn-success').hide("slow");
                $('.btn-secondary').hide("slow");
