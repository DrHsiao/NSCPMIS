        $.ajax({
            url: '@Url.Action("Delete_Apply_Controller", "Plan")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                yrcid: yrcid,
                ppid: ppid
            }),
            success: function (response) {
                if (response.success) {
                    alert('刪除成功');
                    // 刪除成功後，從頁面中移除對應的行
                    $(this).closest('tr').remove();
                } else {
                    alert('刪除失敗');
                }
            }.bind(this),
            error: function (xhr, status, error) {
                alert('刪除失敗');
            }
        });
    });
});
</script>
