@{
    Layout = null;
    var data = ViewBag.Data as System.Data.DataRow;
}

@* 3.1.4rev3：地方預算執行數填報的單月填報視窗。
   業主指示本畫面資料來源為 CMETMS.dbo.TDDPCOS，且「開這些欄位填報」＝舊系統
   App_Data\CMETMS\TDE0020B043.Xml 有開放的 7 個金額欄位。
   原本本頁與「辦理情形及施工進度」共用 PAGE5_2_Edit（22 個欄位、且寫的是 TDDMSCD），
   欄位與資料表都不對。 *@

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>地方預算執行數填報</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script type="text/javascript" src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <style>
        body { padding: 15px; font-size: 13px; }
        .form-group { margin-bottom: 10px; }
        .form-control { font-size: 13px; }
        label { font-weight: bold; margin-bottom: 3px; }
        .section-title {
            background-color: #337ab7;
            color: white;
            padding: 8px 12px;
            margin: 15px 0 10px 0;
            border-radius: 4px;
        }
        .readonly-field { background-color: #eee; }
        .btn-toolbar { margin-top: 20px; padding-top: 15px; border-top: 1px solid #ddd; }
    </style>
</head>
<body>
    @if (TempData["Success"] != null) {
        <div class="alert alert-success alert-dismissible">
            @TempData["Success"]
            <button type="button" class="close" onclick="$(this).parent().hide();">&times;</button>
        </div>
    }
    @if (TempData["Error"] != null) {
        <div class="alert alert-danger alert-dismissible">
            @TempData["Error"]
            <button type="button" class="close" onclick="$(this).parent().hide();">&times;</button>
        </div>
    }

    @if (data == null) {
        <div class="alert alert-danger">找不到這筆資料，請關閉視窗後重新查詢。</div>
    } else {
        using (Html.BeginForm("PAGE5_3_PcosEdit_Save", "TDE0045", FormMethod.Post, new { id = "editForm" })) {
            @Html.AntiForgeryToken()
            <input type="hidden" name="ID" value="@ViewBag.ID" />

            <div class="section-title">基本資訊</div>
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label>年度</label>
                        <input type="text" class="form-control readonly-field" readonly
                               value="@(data["SYR"] != DBNull.Value ? data["SYR"] : "")" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label>月份</label>
                        <input type="text" class="form-control readonly-field" readonly
                               value="@(data["SMN"] != DBNull.Value ? data["SMN"] : "")" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label>計畫流水碼</label>
                        <input type="text" class="form-control readonly-field" readonly
                               value="@(data["PID"] != DBNull.Value ? data["PID"] : "")" />
                    </div>
                </div>
            </div>

            <div class="section-title">支用數（單位：元）</div>
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label>估驗未撥金額</label>
                        <input type="number" step="1" class="form-control" name="ECC_UPAY_FEE"
                               value="@(data["ECC_UPAY_FEE"] != DBNull.Value ? data["ECC_UPAY_FEE"] : "")" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label>當月預定支用數</label>
                        <input type="number" step="1" class="form-control" name="PRE_COST"
                               value="@(data["PRE_COST"] != DBNull.Value ? data["PRE_COST"] : "")" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label>當月實際支用數</label>
                        <input type="number" step="1" class="form-control" name="REL_COST"
                               value="@(data["REL_COST"] != DBNull.Value ? data["REL_COST"] : "")" />
                    </div>
                </div>
            </div>

            <div class="section-title">累計數（單位：元）</div>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label>累計分配數</label>
                        <input type="number" step="1" class="form-control" name="L_PLN_COST"
                               value="@(data["L_PLN_COST"] != DBNull.Value ? data["L_PLN_COST"] : "")" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>累計實際支用數</label>
                        <input type="number" step="1" class="form-control" name="L_REL_COST"
                               value="@(data["L_REL_COST"] != DBNull.Value ? data["L_REL_COST"] : "")" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>累計應付未付數</label>
                        <input type="number" step="1" class="form-control" name="L_UNPAY_COST"
                               value="@(data["L_UNPAY_COST"] != DBNull.Value ? data["L_UNPAY_COST"] : "")" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>節餘數</label>
                        <input type="number" step="1" class="form-control" name="SAVE_FEE"
                               value="@(data["SAVE_FEE"] != DBNull.Value ? data["SAVE_FEE"] : "")" />
                    </div>
                </div>
            </div>

            <div class="btn-toolbar">
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-floppy-disk me-1"></i> 儲存
                </button>
                <button type="button" class="btn btn-secondary ms-2" onclick="closeDialog();">
                    <i class="fa-solid fa-xmark me-1"></i> 取消
                </button>
            </div>
        }
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function closeDialog() {
            if (parent && typeof parent.closeEditDialog === 'function') {
                parent.closeEditDialog();
            } else {
                window.close();
            }
        }

        // 儲存成功後自動關閉並回到清單（回饋要讓使用者在清單上看得到）
        @if (TempData["SaveSuccess"] != null) {
            @:setTimeout(function () { closeDialog(); }, 600);
        }
    </script>
</body>
</html>
