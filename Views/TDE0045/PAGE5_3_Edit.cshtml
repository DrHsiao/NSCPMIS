@{
    Layout = null;
    var data = ViewBag.Data as System.Data.DataRow;
    var pjData = ViewBag.PjData as System.Data.DataRow;
    var fitCodeList = ViewBag.FIT_CODE as SelectList;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>編輯經費來源</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://code.jquery.com/ui/1.14.1/themes/base/jquery-ui.css" rel="stylesheet" />
    <script type="text/javascript" src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <style>
        body { padding: 15px; font-size: 13px; }
        .form-group { margin-bottom: 10px; }
        .form-control { font-size: 13px; }
        label { font-weight: bold; margin-bottom: 3px; }
        .section-title {
            background-color: #337ab7;
            color: white;
            padding: 8px 12px;
            margin: 15px 0 10px 0;
            border-radius: 4px;
        }
        .readonly-field { background-color: #eee; }
        .btn-toolbar { margin-top: 20px; padding-top: 15px; border-top: 1px solid #ddd; }
        .month-input { width: 100%; }
        .month-table th { text-align: center; background-color: #f5f5f5; font-size: 12px; }
        .month-table td { padding: 5px; }
        .month-table input { text-align: right; }
    
        /* 表格框線與排版美化 */
        .table-bordered { border: 0 !important; }
        .table-bordered th, .table-bordered td { border: 0 !important; border-bottom: 1px solid #e2e8f0 !important; }
        .table > thead > tr > th { 
            border-bottom: 2px solid #337ab7 !important; 
            background-color: #f8fafc; 
            color: #334155; 
        }
        .table > tbody > tr:last-child > td { border-bottom: 0 !important; }
</style>
</head>
<body>
    @if (TempData["Success"] != null) {
        <div class="alert alert-success alert-dismissible">
            @TempData["Success"]
            <button type="button" class="close" onclick="$(this).parent().hide();">&times;</button>
        </div>
    }
    @if (TempData["Error"] != null) {
        <div class="alert alert-danger alert-dismissible">
            @TempData["Error"]
            <button type="button" class="close" onclick="$(this).parent().hide();">&times;</button>
        </div>
    }

    @using (Html.BeginForm("PAGE5_3_Edit_Save", "TDE0045", FormMethod.Post, new { id = "editForm" })) {
        @Html.AntiForgeryToken()
        <input type="hidden" name="TID" value="@ViewBag.TID" />
        <input type="hidden" name="FID" value="@ViewBag.FID" />
        <input type="hidden" name="TD_CODE" value="@ViewBag.TD_CODE" />

        <!-- 計畫資訊 (唯讀) -->
        <div class="section-title">計畫資訊</div>
        <div class="row">
            <div class="col-md-2">
                <div class="form-group">
                    <label>PID</label>
                    <input type="text" class="form-control readonly-field" readonly
                           value="@(pjData != null && pjData["PID"] != DBNull.Value ? pjData["PID"] : "")" />
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-group">
                    <label>年度</label>
                    <input type="text" class="form-control readonly-field" readonly
                           value="@(pjData != null && pjData["SYR"] != DBNull.Value ? pjData["SYR"] : "")" />
                </div>
            </div>
            <div class="col-md-8">
                <div class="form-group">
                    <label>計畫名稱</label>
                    <input type="text" class="form-control readonly-field" readonly
                           value="@(pjData != null && pjData["PJ_NAME"] != DBNull.Value ? pjData["PJ_NAME"] : "")" />
                </div>
            </div>
        </div>

        <!-- 經費來源資訊 -->
        <div class="section-title">經費來源資訊</div>
        <div class="row">
            <div class="col-md-2">
                <div class="form-group">
                    <label>TID</label>
                    <input type="text" class="form-control readonly-field" readonly value="@ViewBag.TID" />
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-group">
                    <label>FID</label>
                    <input type="text" class="form-control readonly-field" readonly value="@ViewBag.FID" />
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-group">
                    <label>年度</label>
                    <input type="text" class="form-control" name="SYR" maxlength="50"
                           value="@(data != null && data["SYR"] != DBNull.Value ? data["SYR"] : "")" />
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>經費來源類型</label>
                    @Html.DropDownList("FIT_CODE", fitCodeList, "請選擇", new { @class = "form-control" })
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>經費金額</label>
                    <input type="number" step="0.01" class="form-control" name="FUND"
                           value="@(data != null && data["FUND"] != DBNull.Value ? data["FUND"] : "")" />
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-9">
                <div class="form-group">
                    <label>經費說明</label>
                    <input type="text" class="form-control" name="FUND_DESC" maxlength="500"
                           value="@(data != null && data["FUND_DESC"] != DBNull.Value ? data["FUND_DESC"] : "")" />
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>執行金額</label>
                    <input type="number" class="form-control" name="EXP_FUND"
                           value="@(data != null && data["EXP_FUND"] != DBNull.Value ? data["EXP_FUND"] : "")" />
                </div>
            </div>
        </div>

        <!-- 各月分配金額 -->
        <div class="section-title">各月分配金額</div>
        <table class="table month-table">
            <thead>
                <tr>
                    <th>1月</th>
                    <th>2月</th>
                    <th>3月</th>
                    <th>4月</th>
                    <th>5月</th>
                    <th>6月</th>
                    <th>7月</th>
                    <th>8月</th>
                    <th>9月</th>
                    <th>10月</th>
                    <th>11月</th>
                    <th>12月</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    @for (int i = 1; i <= 12; i++) {
                        var fieldName = "M_" + i.ToString("00");
                        var fieldValue = data != null && data[fieldName] != DBNull.Value ? data[fieldName].ToString() : "";
                        <td>
                            <input type="number" class="form-control month-input" name="@fieldName" value="@fieldValue" />
                        </td>
                    }
                </tr>
            </tbody>
        </table>

        <!-- 按鈕 -->
        <div class="btn-toolbar">
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-floppy-disk me-1"></i> 儲存
            </button>
            <button type="button" class="btn btn-secondary" onclick="closeDialog();">
                <span class="fa-solid fa-xmark"></span> 取消
            </button>
        </div>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function closeDialog() {
            if (parent && typeof parent.closeEditDialog === 'function') {
                parent.closeEditDialog();
            } else {
                window.close();
            }
        }

        // 儲存成功後自動關閉
        @if (TempData["SaveSuccess"] != null) {
            @:setTimeout(function() { closeDialog(); }, 500);
        }

        // 設定下拉選單預設值
        $(document).ready(function() {
            var fitCode = '@(data != null && data["FIT_CODE"] != DBNull.Value ? data["FIT_CODE"].ToString() : "")';
            if (fitCode) {
                $('select[name="FIT_CODE"]').val(fitCode);
            }
        });
    </script>
</body>
</html>
