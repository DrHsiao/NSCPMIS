@model WCals.ViewModels.NewModels.TDE0040Model
@{
    Layout = null;
    var summaryData = ViewBag.SummaryData as System.Data.DataRow;
    var listData = ViewBag.ListData as System.Data.DataTable;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script type="text/javascript" src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <title>工作控制點</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://code.jquery.com/ui/1.14.1/themes/base/jquery-ui.css" rel="stylesheet" />
    <style>
        html, body { height: 100%; margin: 0; padding: 0; }
        body { padding: 10px; box-sizing: border-box; font-size: 14px; }
        .form-group { margin-bottom: 10px; }
      
        .input{width:100%;}
        
        
        .alert { margin-top: 10px; }
    .ui-datepicker { z-index: 2200 !important; background: #ffffff; border: 1px solid #cccccc; border-radius: 4px; }
    
        /* 表格框線與排版美化 */
        .table-bordered { border: 0 !important; }
        .table-bordered th, .table-bordered td { border: 0 !important; border-bottom: 1px solid #e2e8f0 !important; }
        .table > thead > tr > th { 
            border-bottom: 2px solid #337ab7 !important; 
            background-color: #f8fafc; 
            color: #334155; 
        }
        .table > tbody > tr:last-child > td { border-bottom: 0 !important; }
</style>
</head>
<body>
    <input type="hidden" id="hidTD_CODE" value="@Model.TD_CODE" />
    
    <!-- 訊息顯示區 -->
    <div id="messageArea"></div>

    @*
        3.1.4rev：業主反映「修改」與上方框之間的關係不明。
        改為與舊系統一致的「頁面級狀態切換」：
          瀏覽狀態＝全部欄位唯讀，只有一顆「修改」；
          修改狀態＝計畫期程摘要與整張控制點清單一起開放編輯，只有「存檔／取消」。
        逐列的「修改」小按鈕已移除（那是造成混淆的來源），改為一次存檔。
    *@
    <div id="modeBar" class="d-flex align-items-center justify-content-between mb-3 p-2 rounded"
         style="background-color:#337ab7; color:#fff;">
        <span>
            <i class="fa-solid fa-eye me-1" id="modeIcon"></i>
            目前狀態：<strong id="modeText">瀏覽</strong>
            <span id="modeHint" class="ms-2" style="font-size:12px; opacity:.85;">（要修改資料請按右邊的「修改」）</span>
        </span>
        <span>
            <button type="button" class="btn btn-warning btn-sm" id="btnEdit" onclick="setMode('edit');">
                <i class="fa-solid fa-pen me-1"></i> 修改
            </button>
            <button type="button" class="btn btn-success btn-sm d-none" id="btnSave" onclick="saveAll();">
                <i class="fa-solid fa-floppy-disk me-1"></i> 存檔
            </button>
            <button type="button" class="btn btn-secondary btn-sm d-none" id="btnCancel" onclick="cancelEdit();">
                <i class="fa-solid fa-xmark me-1"></i> 取消
            </button>
        </span>
    </div>

    @*
      3.1.4rev2：業主指示「此區塊與上方框關係不明，若無必要請移除」，
      故「計畫期程摘要」整區以註解保留（未刪除），日後需要時把下方註解區塊還原即可。
      注意：還原時要同步恢復本檔 JS 區內兩處（均標記 3.1.4rev2）：
        1. EDIT_FIELDS 選擇器加回 #PRE_SDT, #PRE_EDT, #REL_SDT, #REL_EDT, #NOTE
        2. saveAll() 內先呼叫 PAGE5_1_SaveSummary 再存各控制點
      資料表：TDDSDWB 之 IT_TYPE='S' 單筆（計畫整體預定/實際起訖與執行情形說明）。
    *@
    @*
    <!-- 第一個表格：計畫期程摘要 (IT_TYPE='S') -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-primary text-white fw-bold">
   <strong>計畫期程摘要</strong>
        </div>
 
      <table class="table summary-table" id="summaryTable">
    <tbody>
             <tr>
             <th width="1" nowrap>預定開始日期</th>
             <td>
  <input type="text" id="PRE_SDT" maxlength="7" placeholder="YYYMMDD" class="form-control"
             value="@(summaryData != null && summaryData["PRE_SDT"] != DBNull.Value ? summaryData["PRE_SDT"].ToString() : "")" />
         </td>
           <th  width="1" nowrap>預定結束日期</th>
         <td>
    <input type="text" id="PRE_EDT" maxlength="7" placeholder="YYYMMDD" class="form-control"
  value="@(summaryData != null && summaryData["PRE_EDT"] != DBNull.Value ? summaryData["PRE_EDT"].ToString() : "")" />
        </td>
             </tr>
     <tr>
       <th>實際開始日期</th>
     <td>
 <input type="text" id="REL_SDT" maxlength="7" placeholder="YYYMMDD" class="form-control"
                value="@(summaryData != null && summaryData["REL_SDT"] != DBNull.Value ? summaryData["REL_SDT"].ToString() : "")" />
   </td>
          <th>實際結束日期</th>
     <td>
<input type="text" id="REL_EDT" maxlength="7" placeholder="YYYMMDD" class="form-control"
         value="@(summaryData != null && summaryData["REL_EDT"] != DBNull.Value ? summaryData["REL_EDT"].ToString() : "")" />
       </td>
     </tr>
       <tr>
     <th>執行情形說明</th>
             <td colspan="3">
           <textarea id="NOTE" class="form-control">@(summaryData != null && summaryData["NOTE"] != DBNull.Value ? summaryData["NOTE"].ToString() : "")</textarea>
              </td>
            </tr>
     </tbody>
      </table>
    </div>
    *@

    <!-- 第二個表格：工作控制點列表 (IT_TYPE!='S') -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-primary text-white fw-bold">
            <strong>工作控制點</strong>
        </div>
        <div class="card-body">
     <div class="table-responsive">
    <table class="table table-striped table-hover" id="itemTable">
         <thead>
  <tr>
    <th style="width:100px;">功能</th>
       <th>要徑名稱</th>
       <th style="width:100px;">預定完成日</th>
      <th style="width:100px;">實際完成日</th>
         <th style="width:80px;">排序</th>
          <th style="width:100px;">項目權重</th>
        <th style="width:100px;">項目代碼</th>
        </tr>
      </thead>
      <tbody>
                @if (listData != null && listData.Rows.Count > 0)
      {
            foreach (System.Data.DataRow row in listData.Rows)
    {
           var itCode = row["IT_CODE"] != DBNull.Value ? row["IT_CODE"].ToString() : "";
        var itName = row["IT_NAME"] != DBNull.Value ? row["IT_NAME"].ToString() : "";
          var preEdt = row["PRE_EDT"] != DBNull.Value ? row["PRE_EDT"].ToString() : "";
          var relEdt = row["REL_EDT"] != DBNull.Value ? row["REL_EDT"].ToString() : "";
    var gpOrder = row["GP_ORDER"] != DBNull.Value ? row["GP_ORDER"].ToString() : "";
     var itWgt = row["IT_WGT"] != DBNull.Value ? row["IT_WGT"].ToString() : "";
                        @* 3.1.4rev：發包日期(TK105)的「預定完成日」是否開放修改，依該工程的
                           TDMFORM.PRE_TK105_FG 決定：0=開放、1=關閉(不能修改) *@
                        var lockPreEdt = itCode == "TK105"
                            && Model.TDMFORM != null
                            && (Model.TDMFORM.PRE_TK105_FG ?? "").Trim() == "1";
      <tr data-itcode="@itCode">
         <td  width="1" nowrap>
        @* 3.1.4rev：移除逐列「修改」鈕（改由頁面上方一次存檔），只保留分月進度並補上文字讓功能一目瞭然 *@
         <button type="button" class="btn btn-primary btn-sm" onclick="openMonthProgress('@itCode');" title="檢視／填寫此控制點的分月進度">
            <span class="fa-solid fa-calendar me-1"></span> 分月進度
           </button>
      </td>
                <td class="text-left">
          <input type="text" class="form-control edit-it-name" value="@itName" />
           </td>
         <td>
                                @if (lockPreEdt) {
                                    <input type="text" class="form-control edit-pre-edt" maxlength="7" value="@preEdt"
                                           readonly data-locked="1" style="background-color:#f2f2f2;"
                                           title="本工程的發包日期預定完成日不開放修改" />
                                } else {
                                    <input type="text" class="form-control dt edit-pre-edt" maxlength="7" value="@preEdt" />
                                }
             </td>
 <td>
<input type="text" class="form-control dt edit-rel-edt" maxlength="7" value="@relEdt" />
         </td>
                <td>
     <input type="number" class="form-control edit-gp-order" value="@gpOrder" style="width:60px;" />
       </td>
           <td>
              <input type="number" step="0.01" class="form-control edit-it-wgt" value="@itWgt" style="width:80px;" />
       </td>
         <td>@itCode</td>
        </tr>
    }
              }
    else
           {
    <tr>
          <td colspan="7" class="text-center">無資料</td>
                   </tr>
 }
          </tbody>
          </table>
       </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/ui/1.14.1/jquery-ui.min.js"></script>
    <script type="text/javascript" src="~/Scripts/jquery.datepick.js"></script>
    <script type="text/javascript" src="~/Scripts/MyDatepickerJ.js"></script>
    <script>
        var TD_CODE = '@Model.TD_CODE';

      // 顯示訊息
  function showMessage(msg, isSuccess) {
    var cls = isSuccess ? 'alert-success' : 'alert-danger';
         $('#messageArea').html('<div class="alert ' + cls + ' alert-dismissible">' + msg +
          '<button type="button" class="close" onclick="$(this).parent().hide();">&times;</button></div>');
            if (isSuccess) {
   setTimeout(function () { $('#messageArea .alert').fadeOut(); }, 3000);
          }
        }

        // 儲存計畫期程摘要
        function saveSummary() {
 var data = {
       TD_CODE: TD_CODE,
           PRE_SDT: $('#PRE_SDT').val(),
      PRE_EDT: $('#PRE_EDT').val(),
 REL_SDT: $('#REL_SDT').val(),
     REL_EDT: $('#REL_EDT').val(),
     NOTE: $('#NOTE').val()
        };

    $.ajax({
      url: '@Url.Action("PAGE5_1_SaveSummary", "TDE0045")',
        type: 'POST',
                data: data,
        success: function (result) {
        if (result.success) {
             showMessage(result.message, true);
          // 重新整理頁面
setTimeout(function () { location.reload(); }, 1000);
  } else {
        showMessage('儲存失敗：' + result.message, false);
         }
     },
            error: function () {
     showMessage('儲存失敗：網路錯誤', false);
       }
            });
 }

        // 儲存工作控制點
      function saveItem(itCode, btn) {
    var row = $(btn).closest('tr');
      var data = {
        TD_CODE: TD_CODE,
 IT_CODE: itCode,
        IT_NAME: row.find('.edit-it-name').val(),
 PRE_EDT: row.find('.edit-pre-edt').val(),
        REL_EDT: row.find('.edit-rel-edt').val(),
        GP_ORDER: row.find('.edit-gp-order').val(),
    IT_WGT: row.find('.edit-it-wgt').val()
            };

    $.ajax({
   url: '@Url.Action("PAGE5_1_SaveItem", "TDE0045")',
    type: 'POST',
  data: data,
           success: function (result) {
          if (result.success) {
 showMessage(result.message, true);
             // 重新整理頁面
     setTimeout(function () { location.reload(); }, 1000);
     } else {
   showMessage('儲存失敗：' + result.message, false);
 }
          },
     error: function () {
        showMessage('儲存失敗：網路錯誤', false);
              }
          });
  }

        // ==========================================================
        // 3.1.4rev：頁面級「瀏覽 ↔ 修改」狀態切換
        //   瀏覽狀態：所有欄位唯讀（避免看起來能打字、按了卻沒存到）
        //   修改狀態：計畫期程摘要 + 整張控制點清單一起開放，只按一次「存檔」
        // ==========================================================
        // 3.1.4rev2：「計畫期程摘要」區塊已依業主指示註解移除，
        //            故此處不再包含 #PRE_SDT, #PRE_EDT, #REL_SDT, #REL_EDT, #NOTE
        var EDIT_FIELDS = '#itemTable .edit-it-name, #itemTable .edit-pre-edt, ' +
                          '#itemTable .edit-rel-edt, #itemTable .edit-gp-order, #itemTable .edit-it-wgt';

        function setMode(mode) {
            var editing = (mode === 'edit');

            $(EDIT_FIELDS).each(function () {
                // 由 PRE_TK105_FG 鎖住的「發包日期預定完成日」永遠維持唯讀
                if (this.hasAttribute('data-locked')) { return; }
                $(this).prop('readonly', !editing)
                       .css('background-color', editing ? '' : '#f2f2f2');
            });

            $('#btnEdit').toggleClass('d-none', editing);
            $('#btnSave').toggleClass('d-none', !editing);
            $('#btnCancel').toggleClass('d-none', !editing);
            $('#modeText').text(editing ? '修改中' : '瀏覽');
            $('#modeIcon').attr('class', editing ? 'fa-solid fa-pen me-1' : 'fa-solid fa-eye me-1');
            $('#modeHint').text(editing ? '（改好之後請按「存檔」，不要直接關閉視窗）' : '（要修改資料請按右邊的「修改」）');
            $('#modeBar').css('background-color', editing ? '#d9534f' : '#337ab7');
        }

        function cancelEdit() {
            location.reload();
        }

        // 一次存檔：先存計畫期程摘要，再存每一列工作控制點
        function saveAll() {
            var $btn = $('#btnSave').prop('disabled', true);
            showMessage('儲存中，請稍候…', true);

            // 3.1.4rev2：「計畫期程摘要」區塊已註解移除，這裡不再呼叫 PAGE5_1_SaveSummary。
            //            （若仍呼叫，$('#PRE_SDT') 等取不到值會把 TDDSDWB IT_TYPE='S'
            //              那筆的日期與說明清空，屬資料破壞。還原區塊時請一併恢復。）
            saveAllItems($btn);
        }

        function saveAllItems($btn) {
            var rows = $('#itemTable tbody tr[data-itcode]').toArray();
            var i = 0, failed = [];

            function next() {
                if (i >= rows.length) {
                    $btn.prop('disabled', false);
                    if (failed.length) {
                        showMessage('部分項目儲存失敗：' + failed.join('、'), false);
                    } else {
                        // 存檔後會重新載入回到「瀏覽」狀態，用 sessionStorage 把成功訊息帶過去，
                        // 否則訊息會被 reload 洗掉、使用者不確定到底存了沒
                        try { sessionStorage.setItem('page5_1_saved', '1'); } catch (e) { }
                        showMessage('存檔完成', true);
                        setTimeout(function () { location.reload(); }, 800);
                    }
                    return;
                }
                var row = $(rows[i++]);
                $.post('@Url.Action("PAGE5_1_SaveItem", "TDE0045")', {
                    TD_CODE: TD_CODE,
                    IT_CODE: row.data('itcode'),
                    IT_NAME: row.find('.edit-it-name').val(),
                    PRE_EDT: row.find('.edit-pre-edt').val(),
                    REL_EDT: row.find('.edit-rel-edt').val(),
                    GP_ORDER: row.find('.edit-gp-order').val(),
                    IT_WGT: row.find('.edit-it-wgt').val()
                }).done(function (res) {
                    if (!res.success) { failed.push(row.data('itcode')); }
                }).fail(function () {
                    failed.push(row.data('itcode'));
                }).always(next);
            }
            next();
        }

        // 開啟分月進度視窗
        // 3.1.4rev：分月進度（原本只有 alert 佔位，業主回報「尚未提供功能」）
        // 資料表 CMETMS.dbo.TDDWBMS，鍵＝TD_CODE + IT_CODE + SYR，月份欄位 M01~M12
        var _mpItCode = '';

        function openMonthProgress(itCode) {
            _mpItCode = itCode;
            var itName = $('tr[data-itcode="' + itCode + '"]').find('.edit-it-name').val() || itCode;
            $('#mpTitle').text(itName + '（' + itCode + '） 分月進度');
            $('#mpBody').html('<tr><td colspan="14" class="text-center">載入中…</td></tr>');
            $('#mpMessage').empty();

            $.getJSON('@Url.Action("PAGE5_1_GetMonth", "TDE0045")',
                { TD_CODE: TD_CODE, IT_CODE: itCode },
                function (res) {
                    if (!res.success) { mpMessage(res.message, false); return; }
                    var html = '';
                    for (var i = 0; i < res.rows.length; i++) {
                        html += mpRowHtml(res.rows[i].SYR, res.rows[i].M);
                    }
                    if (!html) { html = mpRowHtml('', null); }   // 無資料時給一列空白供新增
                    $('#mpBody').html(html);
                    mpRecalcAll();
                }).fail(function (xhr) { mpMessage('載入失敗：' + xhr.status, false); });

            new bootstrap.Modal(document.getElementById('monthProgressModal')).show();
        }

        function mpRowHtml(syr, months) {
            var h = '<tr><td><input type="text" class="form-control form-control-sm mp-syr" maxlength="3" value="' + (syr || '') + '" placeholder="民國年" /></td>';
            for (var m = 0; m < 12; m++) {
                var v = (months && months[m] !== null && months[m] !== undefined) ? months[m] : '';
                h += '<td><input type="number" step="0.01" class="form-control form-control-sm mp-m" value="' + v + '" /></td>';
            }
            h += '<td class="text-end mp-total">0</td></tr>';
            return h;
        }

        function mpRecalcAll() {
            $('#mpBody tr').each(function () {
                var t = 0;
                $(this).find('.mp-m').each(function () { t += parseFloat($(this).val()) || 0; });
                $(this).find('.mp-total').text(t.toLocaleString('en-US'));
            });
        }

        function mpAddRow() {
            $('#mpBody').append(mpRowHtml('', null));
        }

        function mpSave() {
            var rows = $('#mpBody tr');
            var pending = 0, failed = 0;
            rows.each(function () {
                var $r = $(this);
                var syr = $.trim($r.find('.mp-syr').val());
                if (!syr) { return; }   // 沒填年度的列略過
                var data = { TD_CODE: TD_CODE, IT_CODE: _mpItCode, SYR: syr };
                $r.find('.mp-m').each(function (i) {
                    var v = $(this).val();
                    data['M[' + i + ']'] = (v === '' ? '' : v);
                });
                pending++;
                $.post('@Url.Action("PAGE5_1_SaveMonth", "TDE0045")', data, function (res) {
                    if (!res.success) { failed++; mpMessage(res.message, false); }
                }).always(function () {
                    pending--;
                    if (pending === 0 && failed === 0) { mpMessage('分月進度儲存成功', true); }
                });
            });
            if (pending === 0) { mpMessage('請至少填寫一列的年度', false); }
        }

        function mpMessage(msg, ok) {
            $('#mpMessage').html('<div class="alert ' + (ok ? 'alert-success' : 'alert-danger') + ' py-1 my-1">' + msg + '</div>');
        }

        $(document).on('input', '.mp-m', mpRecalcAll);

        $(document).ready(function () {
            // 日期選擇器初始化
            $(".dt").datepickerTW({
         changeYear: true,
       changeMonth: true,
           yearRange: '68:168',
   dateFormat: 'yymmdd'
        });

     $('.dt').click(function () {
                // 3.1.4rev：唯讀（瀏覽狀態或 TK105 鎖定）時不可清空，否則使用者只是點一下就看到資料不見
                if (this.readOnly) { return; }
      $(this).delay(600).val("");
         });

            // 3.1.4rev：瀏覽狀態不彈出日曆
            $(document).on('focus click', '.dt', function () {
                if (this.readOnly) { try { $(this).datepicker('hide'); } catch (e) { } }
            });

            // 3.1.4rev：進頁面預設為「瀏覽」狀態
            setMode('view');

            // 顯示上一動存檔成功的訊息（reload 後才顯示，確保使用者看得到）
            try {
                if (sessionStorage.getItem('page5_1_saved')) {
                    sessionStorage.removeItem('page5_1_saved');
                    showMessage('已存檔完成，目前回到瀏覽狀態。', true);
                }
            } catch (e) { }
        });
    </script>

    @* 3.1.4rev：分月進度視窗（對應舊系統 TDE0020B041 的 年度 + 一月~十二月） *@
    <div class="modal fade" id="monthProgressModal" tabindex="-1">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="mpTitle">分月進度</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="mpMessage"></div>
                    <div class="table-responsive">
                        <table class="table table-sm table-striped table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:90px;">年度</th>
                                    @for (int m = 1; m <= 12; m++) {
                                        <th style="min-width:80px;">@(m)月</th>
                                    }
                                    <th style="width:110px;">合計</th>
                                </tr>
                            </thead>
                            <tbody id="mpBody"></tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" onclick="mpAddRow();">
                        <i class="fa-solid fa-plus me-1"></i>新增年度
                    </button>
                    <button type="button" class="btn btn-primary" onclick="mpSave();">
                        <i class="fa-solid fa-floppy-disk me-1"></i>儲存
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fa-solid fa-xmark me-1"></i>關閉
                    </button>
                </div>
            </div>
        </div>
    </div>
</body>
</html>

