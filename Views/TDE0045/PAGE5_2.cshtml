@model WCals.ViewModels.NewModels.TDE0040Model
@{
    Layout = null;
    var listData = ViewBag.ListData as System.Data.DataTable;
    var syrList = ViewBag.SyrList as System.Data.DataTable;
    var mscdData = ViewBag.MscdData as System.Data.DataTable;
    var selectedSyr = ViewBag.SelectedSyr as string;

    @* 3.1.4rev3：分月進度沒有資料時的「建立年度」用；由 controller 依工程期程算好 *@
    var suggestCount = ViewBag.MscdSuggestCount != null ? (int)ViewBag.MscdSuggestCount : 0;
    var suggestCsv = ViewBag.MscdSuggestCsv as string ?? "";
    var suggestLabel = ViewBag.MscdSuggestLabel as string ?? "";
    var defaultYear = ViewBag.MscdDefaultYear as string ?? "";
    var hasMscd = mscdData != null && mscdData.Rows.Count > 0;

    @* 3.1.4rev3：分月進度上方的經費彙總（資料來源見 controller 的 SetFundSummary） *@
    var fund1A = ViewBag.Fund1A != null ? (decimal)ViewBag.Fund1A : 0m;
    var fund1B = ViewBag.Fund1B != null ? (decimal)ViewBag.Fund1B : 0m;
    var fund1C = ViewBag.Fund1C != null ? (decimal)ViewBag.Fund1C : 0m;
    var fund2A = ViewBag.Fund2A != null ? (decimal)ViewBag.Fund2A : 0m;
    var fund2B = ViewBag.Fund2B != null ? (decimal)ViewBag.Fund2B : 0m;
    var fund2C = ViewBag.Fund2C != null ? (decimal)ViewBag.Fund2C : 0m;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script type="text/javascript" src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <title>辦理情形及施工進度</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://code.jquery.com/ui/1.14.1/themes/base/jquery-ui.css" rel="stylesheet" />
    <style>
        html, body { height: 100%; margin: 0; padding: 0; }
        body { padding: 10px; box-sizing: border-box; font-size: 14px; }
        .form-group { margin-bottom: 10px; }
        .input { width: 100%; }
        .alert { margin-top: 10px; }
        .table th { text-align: center; background-color: #f5f5f5; white-space: nowrap; }
        .table td { vertical-align: middle !important; white-space: nowrap; }
        .text-right { text-align: right; }
   .text-center { text-align: center; }
     .table-scroll-wrapper {
       overflow-x: auto;
overflow-y: auto;
     max-height: 400px;
          border: 1px solid #ddd;
        }
        .table-scroll-wrapper table {
            min-width: 2000px;
        }
        .table-scroll-wrapper2 table {
   min-width: 2500px;
        }
        .syr-select {
      display: inline-block;
   margin-left: 10px;
     }
  
        /* 表格框線與排版美化 */
        .table-bordered { border: 0 !important; }
        .table-bordered th, .table-bordered td { border: 0 !important; border-bottom: 1px solid #e2e8f0 !important; }
        .table > thead > tr > th { 
            border-bottom: 2px solid #337ab7 !important; 
            background-color: #f8fafc; 
            color: #334155; 
        }
        .table > tbody > tr:last-child > td { border-bottom: 0 !important; }
</style>
</head>
<body>
    <input type="hidden" id="hidTD_CODE" value="@Model.TD_CODE" />
    
    <!-- 訊息顯示區 -->
    <div id="messageArea"></div>

    @* 3.1.4rev：業主指示此框內容多餘，整區移除（原「計畫經費需求」表，含 TID/PID/DA_CODE/O_TID 等內部欄位）。
       ViewBag.ListData 仍由 controller 提供，未來若要復原可回溯 git 此檔。 *@

    <!-- 分月進度列表 -->
<div class="card shadow-sm border-0 mb-4">
   <div class="card-header bg-primary text-white fw-bold">
       <div class="d-flex flex-wrap align-items-center gap-2">
     <strong>分月進度</strong>
   <span class="syr-select">
        <select id="syrSelect" class="form-control form-control-sm" style="display:inline-block; width:auto;">
       @if (syrList != null && syrList.Rows.Count > 0)
    {
          foreach (System.Data.DataRow row in syrList.Rows)
           {
          var syr = row["SYR"].ToString();
      <option value="@syr" @(syr == selectedSyr ? "selected" : "")>@syr 年度</option>
 }
              }
              @* 3.1.4rev3：補充說明指定年度清單要 union 一筆「所有年度」（值為空字串） *@
              <option value="" @(string.IsNullOrEmpty(selectedSyr) ? "selected" : "")>所有年度</option>
   </select>
            </span>

            @* 3.1.4rev3：業主指示「要有[新增]當年月份的功能，預設當年度最後一個月月往後加一個月，
               如果當年度沒有值就從 01 加起」。 *@
            <span class="ms-auto d-flex align-items-center gap-1">
                <button type="button" class="btn btn-light btn-sm btn-add-month" onclick="addMonth();"
                        title="在目前選取的年度接著新增下一個月份">
                    <i class="fa-solid fa-plus me-1"></i>新增當年月份
                </button>

                @* 舊系統 TDE0020 主畫面的「新增年度」入口（一次補滿 12 個月），
                   3.1.4rev3 依指示保留，方便完全沒有資料的工程一次建立。 *@
                <label for="newSyr" class="mb-0 ms-2">新增年度</label>
                <input type="text" id="newSyr" class="form-control form-control-sm" style="width:80px;"
                       maxlength="3" placeholder="民國年" value="@defaultYear" />
                <button type="button" class="btn btn-light btn-sm btn-add-year" onclick="addYear();"
                        title="建立這個年度 1～12 月的空白列，之後就能逐月填寫">
                    <i class="fa-solid fa-calendar-plus me-1"></i>整年建立
                </button>
                @if (suggestCount > 1)
                {
                    <button type="button" class="btn btn-warning btn-sm btn-add-year"
                            onclick="addYear(this.getAttribute('data-years'));" data-years="@suggestCsv"
                            title="依本工程在工作控制點填寫的預定／實際日期，一次把缺少的年度都建立起來">
                        <i class="fa-solid fa-calendar-plus me-1"></i>依工程期程一次建立（@suggestLabel）
                    </button>
                }
            </span>
       </div>
        </div>
        <div class="card-body">
        @* 3.1.4rev3：業主指示「在這個上方增加一個區塊」，內容與資料來源依「補充說明」簡報。
           核定數 A／實支數 B／暫付款 C／實支+暫付＝B+C，最後一列為上面兩列的合計。 *@
        <div class="table-responsive mb-3">
            <table class="table table-bordered fund-summary" style="width:auto; min-width:560px;">
                <caption class="text-end" style="caption-side:top; padding:0;">(單位：元)</caption>
                <thead>
                    <tr>
                        <th style="width:120px;"></th>
                        <th class="text-end">核定數A</th>
                        <th class="text-end">實支數B</th>
                        <th class="text-end">暫付款C</th>
                        <th class="text-end">實支+暫付</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <th>公務預算</th>
                        <td class="text-end" id="fundA1">@fund1A.ToString("N0")</td>
                        <td class="text-end" id="fundB1">@fund1B.ToString("N0")</td>
                        <td class="text-end" id="fundC1">@fund1C.ToString("N0")</td>
                        <td class="text-end" id="fundD1">@((fund1B + fund1C).ToString("N0"))</td>
                    </tr>
                    <tr>
                        <th>振興經濟</th>
                        <td class="text-end" id="fundA2">@fund2A.ToString("N0")</td>
                        <td class="text-end" id="fundB2">@fund2B.ToString("N0")</td>
                        <td class="text-end" id="fundC2">@fund2C.ToString("N0")</td>
                        <td class="text-end" id="fundD2">@((fund2B + fund2C).ToString("N0"))</td>
                    </tr>
                    <tr class="table-secondary fw-bold">
                        <th>合計</th>
                        <td class="text-end" id="fundAT">@((fund1A + fund2A).ToString("N0"))</td>
                        <td class="text-end" id="fundBT">@((fund1B + fund2B).ToString("N0"))</td>
                        <td class="text-end" id="fundCT">@((fund1C + fund2C).ToString("N0"))</td>
                        <td class="text-end" id="fundDT">@((fund1B + fund1C + fund2B + fund2C).ToString("N0"))</td>
                    </tr>
                </tbody>
            </table>
        </div>

        @* 3.1.4rev3：SP 算不出來時（資料有未補零或重複的月份）不讓畫面 500，改顯示原因 *@
        <div id="mscdWarning" class="alert alert-warning @(string.IsNullOrEmpty(ViewBag.MscdWarning as string) ? "d-none" : "")">
            <i class="fa-solid fa-triangle-exclamation me-1"></i><span id="mscdWarningText">@ViewBag.MscdWarning</span>
        </div>

        @if (!hasMscd)
        {
            @* 3.1.4rev3：空清單只寫「無資料」，業主不知道要怎麼產生 → 直接把作法寫在畫面上 *@
            <div class="alert alert-warning" id="emptyHint">
                <i class="fa-solid fa-circle-info me-1"></i>
                這個工程還沒有建立分月進度。請按右上角的「新增當年月份」逐月建立，
                或輸入年度後按「整年建立」一次產生 1～12 月，再逐月按「修改」填寫。
                @if (suggestCount > 0)
                {
                    <text>（依本工程期程，建議建立民國 @suggestLabel 年度）</text>
                }
            </div>
        }
        <div class="table-scroll-wrapper table-scroll-wrapper2">
    <table class="table table-striped table-hover" id="mscdTable">
     <thead>
        @* 3.1.4rev3：欄位改對應 SP_TDE0051_TDGMSD 的輸出（原本用 PRE_COST/CT_PRE_COST 等
           經費欄位去填「進度」欄，資料是錯的），順序比照舊系統 TDE0020B042 的畫面定義。 *@
        <tr>
            <th>功能</th>
            <th>年度</th>
            <th>月份</th>
            <th>估驗未撥金額</th>
            <th>當月預定支用數</th>
            <th>原始預定進度</th>
            <th>總累計預定進度</th>
            <th>總累計實際進度</th>
            <th>年度累計預定進度</th>
            <th>年度累計實際進度</th>
            <th>當月預定進度</th>
            <th>當月實際進度</th>
            <th>中央款累計分配數</th>
            <th>中央款累計實際支用數</th>
            <th>中央款累計應付未付數</th>
            <th>節餘數</th>
            <th>作業計畫分配數</th>
            <th>當月實際支用數</th>
            <th>年度累計預定支用</th>
            <th>年度累計實際支用</th>
            <th>總累計預定支用</th>
            <th>總累計實際支用</th>
            <th>箱涵設計長(m)</th>
            <th>累積箱涵施作長度(m)</th>
            <th>設計滯洪量(m³)</th>
            <th>累積設計施作滯洪量(m³)</th>
            <th>進度差異</th>
            <th>落後原因或辦理情形說明</th>
            <th>落後解決對策</th>
            <th>備註</th>
            <th>預計解決期限</th>
        </tr>
      </thead>
               <tbody id="mscdTableBody">
    @if (mscdData != null && mscdData.Rows.Count > 0)
{
            foreach (System.Data.DataRow row in mscdData.Rows)
      {
        Func<string, string, string> num = (c, f) =>
            (mscdData.Columns.Contains(c) && row[c] != DBNull.Value)
                ? Convert.ToDecimal(row[c]).ToString(f) : (f == "N0" ? "0" : "0.00");
        Func<string, string> txt = c =>
            (mscdData.Columns.Contains(c) && row[c] != DBNull.Value) ? row[c].ToString() : "";

        var id = txt("ID");
          <tr>
    <td class="text-center">
    <button type="button" class="btn btn-warning btn-sm" onclick="top.editMscd('@id');">修改</button>
            </td>
         <td class="text-center">@txt("SYR")</td>
      <td class="text-center">@txt("SMN")</td>
       <td class="text-right">@num("ECC_UPAY_FEE", "N0")</td>
        <td class="text-right">@num("PRE_COST", "N0")</td>
          <td class="text-right">@num("ORG_SUM_PRE_SCHD", "N2")</td>
   <td class="text-right">@num("SUM_PRE_SCHD", "N2")</td>
            <td class="text-right">@num("SUM_REL_SCHD", "N2")</td>
            <td class="text-right">@num("YRS_PRE_SCHD", "N2")</td>
        <td class="text-right">@num("YRS_REL_SCHD", "N2")</td>
          <td class="text-right">@num("PRE_SCHD", "N2")</td>
         <td class="text-right">@num("REL_SCHD", "N2")</td>
             <td class="text-right">@num("L_PLN_COST", "N0")</td>
 <td class="text-right">@num("L_REL_COST", "N0")</td>
           <td class="text-right">@num("L_UNPAY_COST", "N0")</td>
  <td class="text-right">@num("SAVE_FEE", "N0")</td>
         <td class="text-right">@num("PLN_COST", "N0")</td>
         <td class="text-right">@num("REL_COST", "N0")</td>
           <td class="text-right">@num("YRS_PRE_COST", "N0")</td>
       <td class="text-right">@num("YRS_REL_COST", "N0")</td>
        <td class="text-right">@num("SUM_PRE_COST", "N0")</td>
        <td class="text-right">@num("SUM_REL_COST", "N0")</td>
          <td class="text-right">@num("PRE_CON_LEN", "N2")</td>
      <td class="text-right">@num("REL_CON_LEN", "N2")</td>
          <td class="text-right">@num("PRE_CON_FLOOD", "N2")</td>
      <td class="text-right">@num("REL_CON_FLOOD", "N2")</td>
    <td class="text-center">@txt("SCHD_DIFF_DESC")</td>
    <td>@txt("EXECT_DESC")</td>
               <td>@txt("DELAY_RESN")</td>
                  <td>@txt("CTDELAY_RESN")</td>
  <td class="text-center">@txt("RESLV_LMT_DT")</td>
    </tr>
          }
      }
            else
    {
        <tr>
      <td colspan="31" class="text-center">無資料</td>
        </tr>
    }
    </tbody>
     </table>
            </div>
        </div>
    </div>

    

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/ui/1.14.1/jquery-ui.min.js"></script>
    <script>
        var TD_CODE = '@Model.TD_CODE';

     // 顯示訊息
        function showMessage(msg, isSuccess) {
            var cls = isSuccess ? 'alert-success' : 'alert-danger';
       $('#messageArea').html('<div class="alert ' + cls + ' alert-dismissible">' + msg +
            '<button type="button" class="close" onclick="$(this).parent().hide();">&times;</button></div>');
            if (isSuccess) {
       setTimeout(function () { $('#messageArea .alert').fadeOut(); }, 3000);
         }
            else {
                // 3.1.4rev3：錯誤訊息不自動消失，並捲到看得見的位置
                try { document.getElementById('messageArea').scrollIntoView({ block: 'nearest' }); } catch (e) { }
            }
        }

        // 3.1.4rev3：建立某年度的分月進度（沒有資料時唯一的產生入口）
        //   years 有給值＝一次建立多個年度（逗號分隔），沒給＝取畫面上輸入的年度
        function addYear(years) {
            var syr = years || $.trim($('#newSyr').val());
            if (!syr) {
                showMessage('請先輸入要建立的年度（民國年，例如 ' + (new Date().getFullYear() - 1911) + '）。', false);
                $('#newSyr').focus();
                return;
            }
            var label = '民國 ' + syr.split(',').join('、') + ' 年度';
            if (!confirm('確定要建立「' + label + '」的分月進度嗎？\n\n系統會產生 1～12 月的空白列供填寫，已經有資料的月份不會被覆蓋。')) {
                return;
            }

            $('.btn-add-year').prop('disabled', true);
            $.post('@Url.Action("PAGE5_2_AddYear", "TDE0045")', { TD_CODE: TD_CODE, SYR: syr })
                .done(function (res) {
                    if (res.success) {
                        // 要重新載入年度下拉才會出現新年度；用 sessionStorage 把成功訊息帶過去，
                        // 否則訊息會被 reload 洗掉，使用者不確定到底建立了沒
                        try { sessionStorage.setItem('page5_2_added', JSON.stringify({ m: res.message, y: res.syr })); } catch (e) { }
                        location.reload();
                    } else {
                        showMessage(res.message, false);
                        $('.btn-add-year').prop('disabled', false);
                    }
                })
                .fail(function () {
                    showMessage('建立失敗：連線或伺服器發生問題，請稍後再試一次。', false);
                    $('.btn-add-year').prop('disabled', false);
                });
        }

        // 3.1.4rev3：新增當年月份（當年度最後一個月 +1；當年度沒有值就從 01 加起）
        function addMonth() {
            // 選「所有年度」或這個工程還沒有任何年度時，改用右邊「新增年度」欄位填的年度
            var syr = $('#syrSelect').val() || $.trim($('#newSyr').val());
            if (!syr) {
                showMessage('請先選擇年度，或在右邊「新增年度」欄位填入要建立的民國年。', false);
                $('#newSyr').focus();
                return;
            }
            if (!confirm('確定要在民國 ' + syr + ' 年度新增下一個月份嗎？')) { return; }

            $('.btn-add-month').prop('disabled', true);
            $.post('@Url.Action("PAGE5_2_AddMonth", "TDE0045")', { TD_CODE: TD_CODE, SYR: syr })
                .done(function (res) {
                    if (res.success) {
                        try { sessionStorage.setItem('page5_2_added', JSON.stringify({ m: res.message, y: res.syr })); } catch (e) { }
                        location.reload();
                    } else {
                        showMessage(res.message, false);
                        $('.btn-add-month').prop('disabled', false);
                    }
                })
                .fail(function () {
                    showMessage('新增失敗：連線或伺服器發生問題，請稍後再試一次。', false);
                    $('.btn-add-month').prop('disabled', false);
                });
        }

        // 切換年度查詢（分月進度與上方經費彙總都要跟著換）
        function loadMscdBySyr(syr) {
            $.ajax({
                url: '@Url.Action("PAGE5_2_GetMscdBySyr", "TDE0045")',
                type: 'POST',
                data: { TD_CODE: TD_CODE, SYR: syr },
                success: function (result) {
                    if (result.success) {
                        renderMscdTable(result.data);
                        renderFund(result.fund);
                        $('#mscdWarningText').text(result.warning || '');
                        $('#mscdWarning').toggleClass('d-none', !result.warning);
                    } else {
                        showMessage('查詢失敗：' + result.message, false);
                    }
                },
                error: function () {
                    showMessage('查詢失敗：網路錯誤', false);
                }
            });
        }

        // 上方經費彙總（核定數A／實支數B／暫付款C／實支+暫付）
        function renderFund(f) {
            if (!f) { return; }
            var a1 = +f.a1 || 0, b1 = +f.b1 || 0, c1 = +f.c1 || 0;
            var a2 = +f.a2 || 0, b2 = +f.b2 || 0, c2 = +f.c2 || 0;
            $('#fundA1').text(formatNumber(a1)); $('#fundB1').text(formatNumber(b1));
            $('#fundC1').text(formatNumber(c1)); $('#fundD1').text(formatNumber(b1 + c1));
            $('#fundA2').text(formatNumber(a2)); $('#fundB2').text(formatNumber(b2));
            $('#fundC2').text(formatNumber(c2)); $('#fundD2').text(formatNumber(b2 + c2));
            $('#fundAT').text(formatNumber(a1 + a2)); $('#fundBT').text(formatNumber(b1 + b2));
            $('#fundCT').text(formatNumber(c1 + c2)); $('#fundDT').text(formatNumber(b1 + c1 + b2 + c2));
        }

        // 渲染分月進度表格（欄位與 Razor 初次渲染一致，皆取自 SP_TDE0051_TDGMSD）
        function renderMscdTable(data) {
            var tbody = $('#mscdTableBody');
            tbody.empty();

            if (data && data.length > 0) {
                for (var i = 0; i < data.length; i++) {
                    var row = data[i];
                    var tr = '<tr>' +
                        @* 3.1.4rev2：切換年度後重建的列漏了 top.，editMscd 定義在最上層 TDE0040Index，
                           少了 top. 會 ReferenceError，按「修改」毫無反應（與 Razor 初次渲染的寫法不一致） *@
                        '<td class="text-center"><button type="button" class="btn btn-warning btn-sm" onclick="top.editMscd(\'' + row.ID + '\');">修改</button></td>' +
                        '<td class="text-center">' + (row.SYR || '') + '</td>' +
                        '<td class="text-center">' + (row.SMN || '') + '</td>' +
                        '<td class="text-right">' + formatNumber(row.ECC_UPAY_FEE) + '</td>' +
                        '<td class="text-right">' + formatNumber(row.PRE_COST) + '</td>' +
                        '<td class="text-right">' + formatDecimal(row.ORG_SUM_PRE_SCHD) + '</td>' +
                        '<td class="text-right">' + formatDecimal(row.SUM_PRE_SCHD) + '</td>' +
                        '<td class="text-right">' + formatDecimal(row.SUM_REL_SCHD) + '</td>' +
                        '<td class="text-right">' + formatDecimal(row.YRS_PRE_SCHD) + '</td>' +
                        '<td class="text-right">' + formatDecimal(row.YRS_REL_SCHD) + '</td>' +
                        '<td class="text-right">' + formatDecimal(row.PRE_SCHD) + '</td>' +
                        '<td class="text-right">' + formatDecimal(row.REL_SCHD) + '</td>' +
                        '<td class="text-right">' + formatNumber(row.L_PLN_COST) + '</td>' +
                        '<td class="text-right">' + formatNumber(row.L_REL_COST) + '</td>' +
                        '<td class="text-right">' + formatNumber(row.L_UNPAY_COST) + '</td>' +
                        '<td class="text-right">' + formatNumber(row.SAVE_FEE) + '</td>' +
                        '<td class="text-right">' + formatNumber(row.PLN_COST) + '</td>' +
                        '<td class="text-right">' + formatNumber(row.REL_COST) + '</td>' +
                        '<td class="text-right">' + formatNumber(row.YRS_PRE_COST) + '</td>' +
                        '<td class="text-right">' + formatNumber(row.YRS_REL_COST) + '</td>' +
                        '<td class="text-right">' + formatNumber(row.SUM_PRE_COST) + '</td>' +
                        '<td class="text-right">' + formatNumber(row.SUM_REL_COST) + '</td>' +
                        '<td class="text-right">' + formatDecimal(row.PRE_CON_LEN) + '</td>' +
                        '<td class="text-right">' + formatDecimal(row.REL_CON_LEN) + '</td>' +
                        '<td class="text-right">' + formatDecimal(row.PRE_CON_FLOOD) + '</td>' +
                        '<td class="text-right">' + formatDecimal(row.REL_CON_FLOOD) + '</td>' +
                        '<td class="text-center">' + (row.SCHD_DIFF_DESC || '') + '</td>' +
                        '<td>' + (row.EXECT_DESC || '') + '</td>' +
                        '<td>' + (row.DELAY_RESN || '') + '</td>' +
                        '<td>' + (row.CTDELAY_RESN || '') + '</td>' +
                        '<td class="text-center">' + (row.RESLV_LMT_DT || '') + '</td>' +
                        '</tr>';
                    tbody.append(tr);
                }
            } else {
                tbody.append('<tr><td colspan="31" class="text-center">無資料</td></tr>');
            }
        }

        // 數字格式化（整數）
        function formatNumber(val) {
     if (val === null || val === undefined || val === '') return '0';
       return parseFloat(val).toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
        }

    // 數字格式化（小數）
     function formatDecimal(val) {
          if (val === null || val === undefined || val === '') return '';
     return parseFloat(val).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        

        $(document).ready(function () {


            // 年度切換事件
            // 3.1.4rev3：空字串是合法值（＝「所有年度」），不可以在這裡擋掉
            $('#syrSelect').change(function () {
                loadMscdBySyr($(this).val() || '');
            });

            // 3.1.4rev3：顯示上一動「建立年度」的結果，並自動切到剛建立的年度
            try {
                var added = sessionStorage.getItem('page5_2_added');
                if (added) {
                    sessionStorage.removeItem('page5_2_added');
                    var info = JSON.parse(added);
                    showMessage(info.m, true);
                    if (info.y && $('#syrSelect option[value="' + info.y + '"]').length) {
                        $('#syrSelect').val(info.y).trigger('change');
                    }
                }
            } catch (e) { }

            // 年度欄位按 Enter 直接建立
            $('#newSyr').keypress(function (e) {
                if (e.which === 13) { e.preventDefault(); addYear(); }
            });
        });
</script>
