@model IEnumerable<WCals.Models.CMBASEModels.ChooseViewModel>

@{
    ViewBag.Title = "人員管理";
    Layout = "~/Views/Shared/_Layout2_v2.cshtml";
}

@section head {
    <link rel="stylesheet" href="~/Content/views/group.css">
}

<div class="model-form">
    <h2 style="color:cornflowerblue">人員詳細資料</h2>

    <table style="text-align:left">
        <tr>
            <th>
                @Html.ActionLink("編輯", "Edit", new { UserID = TempData["USERID"] }, new { @class = "btn btn-primary" })
                @Html.ActionLink("刪除", "Delete",
                    new { ID = TempData["USERID"] },
                    new { onclick = "return confirm('確定刪除嗎?');", @class = "btn btn-danger" }
               )
                <input type="button" class="btn btn-secondary  ;" onclick="history.back()" value="返回">
                <br />
                <br />
            </th>
        </tr>
        <tr>
            <th>
                員工編號:
                @TempData["USERID"]
            </th>
            <th>
                員工姓名:
                @TempData["USERNAME"]
            </th>
        </tr>
        <tr>
            <th>
                連絡電話:
                @TempData["TEL_O"]
            </th>
            <th>
                行動電話:
                @TempData["TEL_M"]
            </th>
        </tr>
        <tr>
            <th>
                電子郵件:
                @TempData["MAIL"]
            </th>
            <th>
                在職狀況:
                <input id="" type="checkbox" name="" checked="@TempData["USERSTAT"]" disabled>
            </th>
        </tr>
        <tr>
            <th>
                備註說明:
                @TempData["NOTE"]
            </th>
        </tr>
    </table>
    @*/////////////////這是選取後的顯示/////////////////////////////*@
    <br />
    <table class="table table">
        <tr><th><br />隸屬部門及群組:</th></tr>
        <tr style="background-color:deepskyblue;">
            <th>
                部門或群組名稱
            </th>
            <th>
                部門或群組
            </th>
        </tr>
        <tr>
            @foreach (var item in Model)
            {
                if (item.OGCDPUR.DATA_TP == "D")
                {
                    <td>@item.OGCDEPT.DEPT_NAME</td>
                    <td>部門</td>
                }
            }
        </tr>
        @foreach (var item in Model)
        {
            if (item.OGCDPUR.DATA_TP == "G")
            {
                <tr>
                    <td>@item.OGCDEPT.DEPT_NAME</td>
                    <td>群組</td>
                </tr>
            }
        }

    </table>
</div>