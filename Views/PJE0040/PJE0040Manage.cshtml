@using PagedList.Mvc
@model WCals.ViewModels.NewModels.PJE0011Model
@{ ViewBag.Title = "分支計畫案件管制";
    Layout = "~/Views/Shared/_Layout2_v2.cshtml"; }

<!-- DataTables CSS -->
<link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.10.25/css/jquery.dataTables.css">
<!-- jQuery library -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<!-- DataTables JS -->
<script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/1.10.25/js/jquery.dataTables.js"></script>

<div class="row">
    <div class="col-lg-12">
        <h1 class="h2 border-bottom pb-2 mb-3">
            分支計畫案件
            <small></small>
        </h1>
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <i class="fa-solid fa-dashboard"></i><a href="@Url.Content("~/")Home"> 首頁</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                <i class="fa-solid fa-file"></i>
                <a href="@Url.Content("~/")PJE0030">計畫經費</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                <i class="fa-solid fa-file"></i>
                計畫經費
            </li>
        </ol>
    </div>
</div>
@using(Html.BeginForm("", "PJE0010", FormMethod.Post, new { id = "mainForm" })) {



    <table width="100%" class="table table-hover" style="overflow-x: auto; white-space: nowrap;">
<tr>

                                <td>
    <select class="form-select">
        @{System.Data.DataTable selc = ViewBag.sels;}
        @foreach(System.Data.DataRow s in selc.Rows) {
            <option>@s["SEQ_NAME"]</option>
        }
    </select>
</td>
 <td>
<button class="btn btn-primary" name="action" type="submit" value="Add">列印</button>

</td>     
</tr>
</table>
    <br />

    <div>

        <!-- Nav tabs -->
        <ul class="nav nav-tabs" role="tablist">
            <li class="nav-item" role="presentation"><a class="nav-link active" href="#tab1" aria-controls="tab1" role="tab" data-bs-toggle="tab">執行中</a></li>
            <li class="nav-item" role="presentation"><a class="nav-link" href="#tab2" aria-controls="tab2" role="tab" data-bs-toggle="tab">經費規零</a></li>
            <li class="nav-item" role="presentation"><a class="nav-link" href="#tab3" aria-controls="tab3" role="tab" data-bs-toggle="tab">保留款</a></li>
        </ul>

        <!-- Tab panes -->
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane active" id="tab1">



                


                <table width="100%" class="table table-hover" style="overflow-x: auto; white-space: nowrap;">
                    <thead class="table-light">
                        <tr>
                            <th>工程編號</th>
                            <th>工程名稱</th>
                            <th>經費編號</th>
                            <th>年度預算(元)</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ System.Data.DataTable list1 = ViewBag.List1;}
                        @foreach(System.Data.DataRow c in list1.Rows) {
                            <tr>

                                <td>@c["TD_CODE"]</td>

                                <td>@c["TD_NAME"]</td>
                                <td>@c["FD_CODE"]</td>
                                <td align="right">@((Convert.ToDecimal(c["YR_FUND"])).ToString("N2"))</td>
                                <td>
                                    <button class="btn btn-primary" name="action" type="submit" value="Add">檢視</button>
                                </td>
                            </tr>

                        }
                    </tbody>
                </table>













            </div>
            <div role="tabpanel" class="tab-pane" id="tab2">

                <table width="100%" class="table table-hover" style="overflow-x: auto; white-space: nowrap;">
                    <thead class="table-light">
                        <tr>
                            <th>工程編號</th>
                            <th>工程名稱</th>
                            <th>經費編號</th>
                            <th>年度預算</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ System.Data.DataTable list2 = ViewBag.List2;}
                        @foreach(System.Data.DataRow c in list2.Rows) {
                            <tr>

                                <td>@c["TD_CODE"]</td>

                                <td>@c["TD_NAME"]</td>
                                <td>@c["FD_CODE"]</td>
                                <td>@c["YR_FUND"]</td>
                                <td>
                                    <button class="btn btn-primary" name="action" type="submit" value="Add">檢視</button>
                                    

                                </td>
                            </tr>

                        }
                    </tbody>
                </table>


            </div>


            <div role="tabpanel" class="tab-pane" id="tab3">

                <table width="100%" class="table table-hover" style="overflow-x: auto; white-space: nowrap;">
                    <thead class="table-light">
                        <tr>
                            <th>工程編號</th>
                            <th>工程名稱</th>
                            <th>經費編號</th>
                            <th>年度預算</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ System.Data.DataTable list3 = ViewBag.List3;}
                        @foreach(System.Data.DataRow c in list3.Rows) {
                            <tr>

                                <td>@c["TD_CODE"]</td>

                                <td>@c["TD_NAME"]</td>
                                <td>@c["FD_CODE"]</td>
                                <td>@c["YR_FUND"]</td>
                                <td>
                                    <button class="btn btn-primary" name="action" type="submit" value="Add">檢視</button>

                                </td>
                            </tr>

                        }
                    </tbody>
                </table>


            </div>

        </div>

    </div>





}
