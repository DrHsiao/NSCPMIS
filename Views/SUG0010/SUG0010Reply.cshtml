@model WCals.ViewModels.NewModels.SUG0010Model
@{
    ViewBag.Title = "回覆建議案";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <script type="text/javascript" src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <style>
        html, body {
            margin: 0;
            padding: 10px;
        }
        .form-group {
            margin-bottom: 10px;
        }
        .btn-toolbar {
            margin-top: 15px;
            text-align: center;
        }
        .readonly-content {
            background: #f5f5f5;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 4px;
            min-height: 100px;
            max-height: 200px;
            overflow-y: auto;
            white-space: pre-wrap;
        }
        .file-section {
            margin-top: 15px;
            padding: 10px;
            background: #f9f9f9;
            border: 1px solid #ddd;
            border-radius: 4px;
        }
        .file-section h5 {
            margin-top: 0;
            margin-bottom: 10px;
            padding-bottom: 5px;
            border-bottom: 1px solid #ddd;
        }
    </style>
</head>
<body>
    <form id="replyForm">
        <input type="hidden" id="SUG_ID" name="SUG_ID" value="@Model.SUG_ID" />
        <input type="hidden" id="FROM_DP" name="FROM_DP" value="@Model.FROM_DP" />
        <input type="hidden" id="TO_DP" name="TO_DP" value="@Model.TO_DP" />

        <div class="form-group">
            案件編號
            <input type="text" class="form-control" value="@Model.SUG_ID" readonly />
        </div>

        <div class="form-group">
            建議內容
            <div class="readonly-content">@Model.SUG_CONTENT</div>
        </div>

        <div class="form-group">
            回覆內容 <span class="text-danger">*</span>
            <textarea id="REPLY_CONTENT" name="REPLY_CONTENT" class="form-control" rows="6"
                      placeholder="請輸入回覆內容...">@Model.REPLY_CONTENT</textarea>
        </div>

        <div class="btn-toolbar">
            <button type="button" class="btn btn-primary" onclick="saveReply()"><i class="fa-solid fa-save"></i> 儲存回覆</button>
            <button type="button" class="btn btn-secondary" onclick="parent.closeDialogAndRefresh()"><i class="fa-solid fa-times"></i> 關閉</button>
        </div>
    </form>

    @if (Model.FileList != null && Model.FileList.Rows.Count > 0)
    {
        <div class="file-section">
            <h5>相關附件</h5>
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>檔案名稱</th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (System.Data.DataRow row in Model.FileList.Rows)
                    {
                        <tr>
                            <td>@row["F_PATH"]</td>
                            <td>
                                <a href="@Url.Action("DownloadFile", "SUG0010", new { SUG_ID = Model.SUG_ID, F_ID = row["F_ID"] })"
                                   class="btn btn-info btn-sm" target="_blank">
                                    <i class="fa-solid fa-download"></i> 下載
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <script>
        function saveReply() {
            var replyContent = $('#REPLY_CONTENT').val();
            if (!replyContent || replyContent.trim() === '') {
                alert('請輸入回覆內容');
                $('#REPLY_CONTENT').focus();
                return;
            }

            var data = {
                SUG_ID: $('#SUG_ID').val(),
                FROM_DP: $('#FROM_DP').val(),
                TO_DP: $('#TO_DP').val(),
                REPLY_CONTENT: replyContent
            };

            $.ajax({
                url: '@Url.Action("SaveReply", "SUG0010")',
                type: 'POST',
                data: data,
                success: function (result) {
                    if (result.success) {
                        alert(result.message);
                        parent.closeDialogAndRefresh();
                    } else {
                        alert(result.message);
                    }
                },
                error: function () {
                    alert('儲存失敗');
                }
            });
        }
    </script>
</body>
</html>
