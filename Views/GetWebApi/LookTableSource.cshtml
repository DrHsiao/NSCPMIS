@*@model IEnumerable<WCals.Models.CMEPMSModels.TDDSTCF>*@
@model IEnumerable<WCals.Models.TESTModels.TDDSTCF_TEST2>

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>LookTableSource</title>
</head>
<body>
    <div>
        <table>
            <tr>
                <td>ID</td>
                <td>年度</td>
                <td>月份</td>
                <td>時間</td>
            </tr>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ID</td>
                    <td>@item.SYR</td>
                    <td>@item.SMN</td>
                    <td>@item.UPD_DT</td>
                </tr>
            }

        </table>
    </div>
</body>
</html>
