@using PagedList.Mvc
@model WCals.ViewModels.NewModels.SGE0010Model
@{ ViewBag.Title = "提案複審作業[2.2.3]";
    Layout = "~/Views/Shared/_Layout2_v2.cshtml"; }

<div class="row">
    <div class="col-lg-12">
        <h1 class="h2 border-bottom pb-2 mb-3">
            提案複審作業[2.2.3]
            <small class="text-muted fs-6"></small>
        </h1>
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <i class="fa-solid fa-gauge"></i><a href="@Url.Content("~/")Home"> 首頁</a>
            </li>
            <li class="breadcrumb-item active">
                <i class="fa-solid fa-file"></i>
                提案複審作業[2.2.3]
            </li>
        </ol>
    </div>
</div>

@using(Html.BeginForm("", "SGE0060", FormMethod.Post, new { id = "mainForm" })) {

    <div style="display:flex;width:100%">
        <div style="width:50%; text-align:left;">
            <table>
                <tr>
                    <td>
                        @Html.TextBoxFor(x => x.keyword, new { @class = "form-control", placeholder = "計畫名稱", AutoComplete = "Off", tabindex = "1" })
                    </td>
                    <td style="padding-left:5px;">
                        <button class="btn btn-secondary" name="action" type="submit" value="Search">查詢</button>

                        @Html.HiddenFor(x => x.PPID)
                        @Html.HiddenFor(x => x.page1)

                    </td>
                </tr>

            </table>
        </div>
        <div style="width: 50%; text-align: right;">
            @Html.PagedListPager(Model.MainList, page1 => Url.Action("",
                new {
                         page1 = page1,
                         tab = 1
                     }),
                new PagedListRenderOptions {
                    DisplayItemSliceAndTotal = true,
                    DisplayPageCountAndCurrentLocation = true,
                    DisplayLinkToLastPage = PagedListDisplayMode.Never,
                    DisplayLinkToIndividualPages = false,

                    ItemSliceAndTotalFormat = "顯示第 {0} - {1}筆, 共{2}筆",
                    PageCountAndCurrentLocationFormat = "第 {0}頁 / 共 {1}頁",
                }
            )
        </div>
    </div>








    <script>
        $(window).on('load', function () {
            $('#PID').val("");
        });

        function delCheck(pid) {


            if (confirm('確定刪除?')) {
                $('#PID').val(pid);
            } else {
                void ('')
            }

        }
    </script>


    <div class="card border-primary">
        <div class="card-header">計畫列表</div>
        <div class="card-body responsive-table-container">
            <table width="100%" class="table table-hover" style="overflow-x: auto; white-space: nowrap;">
                <thead class="table-light">
                    <tr>
                        <th>計畫編號</th>
                        <th>計畫類型</th>
                        <th>計畫名稱</th>
                        <th>承辦單位</th>
                        <th>承辦人</th>
                        <th>開始日期</th>
                        <th>結束日期</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>

                    @foreach(System.Data.DataRow c in Model.MainList) {
                        <tr>

                            <td>@c["PPID"]</td>
                            <td>@c["PJ_CODE"]</td>
                            <td>@c["PJ_NAME"] @c["STAT_NO"]</td>
                            <td>@WCals.Helpers.WebSiteHelper.getDeptName(Convert.ToString(c["ADV_DP"]))</td>
                            <td>@WCals.Helpers.WebSiteHelper.getUserName(Convert.ToString(c["ADV_UID"]))</td>
                            <td>@c["STT_DT"]</td>
                            <td>@c["END_DT"]</td>
                            <td>
                                <button class="btn btn-primary" name="action" type="submit" onclick="$('#PPID').val('@c["PPID"]')" value="ProposalManage">提案複審</button>

                            </td>
                        </tr>

                    }
                </tbody>
            </table>
        </div>
        </div>





        @Html.PagedListPager(Model.MainList, page1 => Url.Action("",
        new {
                page1 = page1,
                tab = 1

        }))














        }
