@model IEnumerable<WCals.Models.CMBASEModels.SiteCityViewModel>

@{
    ViewBag.Title = "(雨水)例行性管考報表：F-1.相關計畫年度補助經費表";
    Layout = "~/Views/Shared/_Layout2_v2.cshtml";
}

@section head{
    <link rel="stylesheet" href="~/Content/views/report.css">

    <style>
        td {
            font-size: 24px;
            line-height: 1.8;
            vertical-align: middle;
        }
    </style>
}

<div class="row">
    <div class="col-lg-12">
        <h1 class="h2 border-bottom pb-2 mb-3">
            (雨水)例行性管考報表[0.1.2]

            <small> </small>
        </h1>
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <i class="fa-solid fa-dashboard"></i><a href="@Url.Content("~/Home")"> 首頁</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                <i class="fa-solid fa-file"></i>
                (雨水)例行性管考報表
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                <i class="fa-solid fa-file"></i>
                F-1.相關計畫年度補助經費表
            </li>
        </ol>
    </div>
</div>

<form method="post" action="@Url.Action("ReportPrint10")" class="my-text" id="dynamicForm">
    @*<h2>例行性管考報表:</h2>*@

    報表類型:
    <select id="choose">
        <option value="Index" @{if (ViewBag.State == "Index") { <text> selected</text> }}>I-1.雨水例行性管考報表</option>
        <option value="2_2" @{if (ViewBag.State == "2_2") { <text> selected</text> }}>A-2.細項執行情形表</option>
        <option value="4_2" @{if (ViewBag.State == "4_2") { <text> selected</text> }}>A-4.跨年度細項執行情形表</option>
        <option value="6_2" @{if (ViewBag.State == "6_2") { <text> selected</text> }}>B-1.修正預算作業表</option>
        <option value="9_2" @{if (ViewBag.State == "9_2") { <text> selected</text> }}>E-1.功能細項執行表(自訂欄位)</option>
        <option value="10_2" @{if (ViewBag.State == "10_2") { <text> selected</text> }}>F-1.相關計畫年度補助經費表</option>
        <option value="12_2" @{if (ViewBag.State == "12_2") { <text> selected</text> }}>H-1.在建工程抽查/查核/督導統計表</option>
    </select>
    <br />

    <table class="table table-bordered table-hover" style="text-align: left; width:95%">
        <tr>
            <td class="fixed-column">
                計畫分類:
            </td>
            <td id="Plan">
                <div>
                    <input type="checkbox" name="master_plan" value="122" />
                    <span>前瞻基礎建設計畫-縣市管河川及區域排水整體改善計畫</span>
                    <br />
                </div>
                <div>
                    <input type="checkbox" name="master_plan" value="61" />
                    <span>流域綜合治理計畫-雨水下水道(第1期)103-104年</span>
                    <br />
                </div>
                <div>
                    <input type="checkbox" name="master_plan" value="96" />
                    <span>流域綜合治理計畫-雨水下水道(第2期)105-106年</span>
                    <br />
                </div>
                <div>
                    <input type="checkbox" name="master_plan" value="139" />
                    <span>流域綜合治理計畫-雨水下水道(第3期)107-108年</span>
                    <br />
                </div>

                @foreach (var item in ViewBag.PJ_BAG)
                {
                    if (item.MASTER_PID == "118" || item.MASTER_PID == "122" || item.MASTER_PID == "134" || item.MASTER_PID == "176" || item.MASTER_PID == "198" || item.MASTER_PID == "215" || item.MASTER_PID == "246" || item.MASTER_PID == "61" || item.MASTER_PID == "96" || item.MASTER_PID == "139")
                    {
                        <div>
                            <input type="checkbox" name="plan" hidden value="@item.ProjectNameID" class="@item.MASTER_PID" />
                            <span hidden>@item.PJ_NAME</span>
                        </div>
                    }
                    else
                    {
                        <div>
                            <input type="checkbox" name="plan" value="@item.ProjectNameID" class="@item.MASTER_PID" />
                            <span>@item.PJ_NAME</span>
                            <br />
                        </div>
                    }
                }
            </td>
        </tr>
        <tr>
            <td class="fixed-column">
                縣市別:
            </td>
            <td id="Year">
                @{ int i = 0;}
                @foreach (var item in ViewBag.CITY)
                {
                    if (i > 1 && i % 8 == 0)
                    {
                        <br />
                    }
                    <input type="checkbox" value="@item.CITY" data-id="@item.CITY" name="CITY" class="Year-checkbox">
                    //超連結改成定位在鄉鎮別區塊
                    <a href="#plan-item" onclick="ShowPlan('@item.CITY')">@item.CITY</a>
                    i++;
                }
            </td>
        </tr>
        <tr>
            <td>
                鄉鎮別:
            </td>
            <td id="Town" colspan="4">
                @{ int j = 0;}
                @foreach (var item in ViewBag.CITY)
                {
                    <div class="plan-item" data-id="@item.CITY" hidden>
                        <input type="checkbox" data-id="@item.CITY" class="selectALL">
                        <span>全選框</span>
                        <br />
                        @foreach (var item2 in ViewBag.TOWN)
                        {
                            if (item2.CITY == item.CITY)
                            {
                                // 加上Town-checkbox類別確保js可動作；加上data-id以在js處理動作
                                <input type="checkbox" name="CITY_TOWN" value="@item2.CITY+@item2.TOWN" class="@item.CITY Town-checkbox" data-id="@item.CITY" />
                                <span>@item2.TOWN</span>
                                j++;
                            }
                        }
                    </div>
                }
            </td>
        </tr>
        <tr>
            <td>
                年分區間:
            </td>
            <td>
                <select name="year1">
                    @foreach (var item4 in ViewBag.Year2)
                    {
                        <option>@item4.SYR</option>
                    }
                </select>
                -
                <select name="year2">
                    @foreach (var item3 in ViewBag.Year)
                    {
                        <option>@item3.SYR</option>
                    }
                </select>
            </td>
        </tr>
        <tr>
            <td>
                實支數:
            </td>
            <td>
                <input type="checkbox" name="Row" onclick="uncheckCancel()" />
                <span> </span>
                有
                <span> </span>
                <input type="checkbox" name="Field" onclick="uncheckFinish()" />
                <span> </span>
                無
                <span> </span>
            </td>
        </tr>
        <tr>
            <td colspan="2" align="center">
                <button type="submit"> EXCEL匯出</button>
                <button type="submit" name="ods" value="1">ODS匯出</button>
            </td>
        </tr>
    </table>
    @Html.Partial("_ReportMessage")
</form>

@section scripts {
    <script type="text/javascript">
        var stateUrl = '@Url.Action("ChooseState", "Report")';
        var orderUrl = '@Url.Action("Orders", "Report")';
        var currentUser = '@Html.Raw(User.Identity.Name)';
    </script>

    <script src="~/Scripts/RainReport/State10_2.js" type="text/javascript"></script>
}