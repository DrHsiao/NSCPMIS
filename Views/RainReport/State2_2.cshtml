@model IEnumerable<WCals.Models.CMBASEModels.SiteCityViewModel>

@{
    ViewBag.Title = "(雨水)例行性管考報表：A-2.細項執行情形表";
    Layout = "~/Views/Shared/_Layout2_v2.cshtml";
}

@section head{
    <link rel="stylesheet" href="~/Content/views/report.css">

    <style>
        input[type="checkbox"] {
            transform: scale(1.8) translateY(-2px);
        }

        label {
            font-weight: normal;
        }
    </style>
}

<div class="row">
    <div class="col-lg-12">
        <h1 class="h2 border-bottom pb-2 mb-3">
            (雨水)例行性管考報表[0.1.2]

            <small> </small>
        </h1>
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <i class="fa-solid fa-dashboard"></i><a href="@Url.Content("~/Home")"> 首頁</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                <i class="fa-solid fa-file"></i>
                (雨水)例行性管考報表
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                <i class="fa-solid fa-file"></i>
                A-2.細項執行情形表
            </li>
        </ol>
    </div>
</div>

<form method="post" action="@Url.Action("ReportPrint2_22")" class="my-text" id="dynamicForm">
    @*<h2>例行性管考報表:</h2>*@

    報表類型:
    <select id="choose">
        <option value="Index" @{if (ViewBag.State == "Index") { <text> selected</text> }}>I-1.雨水例行性管考報表</option>
        <option value="2_2" @{if (ViewBag.State == "2_2") { <text> selected</text> }}>A-2.細項執行情形表</option>
        <option value="4_2" @{if (ViewBag.State == "4_2") { <text> selected</text> }}>A-4.跨年度細項執行情形表</option>
        <option value="6_2" @{if (ViewBag.State == "6_2") { <text> selected</text> }}>B-1.修正預算作業表</option>
        <option value="9_2" @{if (ViewBag.State == "9_2") { <text> selected</text> }}>E-1.功能細項執行表(自訂欄位)</option>
        <option value="10_2" @{if (ViewBag.State == "10_2") { <text> selected</text> }}>F-1.相關計畫年度補助經費表</option>
        <option value="12_2" @{if (ViewBag.State == "12_2") { <text> selected</text> }}>H-1.在建工程抽查/查核/督導統計表</option>
    </select>
    <br />

    計畫年度:
    <select id="Year" name="SYR" required>
        <option value="" disabled selected>請選擇</option>

        @foreach (var item in ViewBag.year)
        {
            <option value="@item.SYR">@item.SYR</option>
        }
    </select>
    <br />

    計畫名稱:
    <select id="Value" name="PID" required>
        <option>------</option>
    </select>

    @if (ViewBag.State == "2" || ViewBag.State == "5")
    {
        <div>資料年分: <input type="text" class="input_font" name="YearWrite" required style="width:67px; height:35px" /></div>
    }

    <div>
        資料月份:
        <select name="SMN">
            @for (int i = 1; i < 13; i++)
            {
                <option value="@i.ToString("D2")" @(i == DateTime.Now.Month ? "selected" : "" )>@string.Format("{0}月", @i)</option>
            }
        </select>
    </div>

    <div>
        縣市別:
        <input type="checkbox" value="北區" id="Site1" name="Site" onchange="checkAll('北區', 'Site1')" />
        <label for="Site1">北區</label>
        <input type="checkbox" value="中區" id="Site2" name="Site" onchange="checkAll('中區', 'Site2')" />
        <label for="Site2">中區</label>
        <input type="checkbox" value="南區" id="Site3" name="Site" onchange="checkAll('南區', 'Site3')" />
        <label for="Site3">南區</label>
        <input type="checkbox" value="全區" id="Site0" name="Site" onchange="checkAll('全區', 'Site0')" />
        <label for="Site0">全區</label>

        @{
            int count = 0;
        }

        <div>
            @foreach (var item in Model.Select(m => m.sECCITY.CITY).Distinct())
            {
                foreach (var item2 in Model.Where(m => m.sMCPOSTN.CITY == item && m.sMCPOSTN.AREA == "北區").GroupBy(m => m.sMCPOSTN.CITY).Select(g => g.First()))
                {
                    <input type="checkbox" value="@item" id="北區" name="CityList" class="city-checkbox">
                }
                foreach (var item2 in Model.Where(m => m.sMCPOSTN.CITY == item && m.sMCPOSTN.AREA == "中區").GroupBy(m => m.sMCPOSTN.CITY).Select(g => g.First()))
                {
                    <input type="checkbox" value="@item" id="中區" name="CityList" class="city-checkbox">
                }
                foreach (var item2 in Model.Where(m => m.sMCPOSTN.CITY == item && m.sMCPOSTN.AREA == "南區").GroupBy(m => m.sMCPOSTN.CITY).Select(g => g.First()))
                {
                    <input type="checkbox" value="@item" id="南區" name="CityList" class="city-checkbox">
                }
                <label for="City">@item</label>
                count++;

                if (count % 8 == 0)
                {
                    <br />
                }
            }
        </div>
    </div>

    <div>
        經費歸零案:
        <select name="funding">
            <option value="Y"> 含經費歸零案 </option>
            <option value="N"> 不含經費歸零案 </option>
        </select>
    </div>

    <div>
        <label>永續營運組</label>
        <input type="checkbox" value="1" name="group" />
    </div>
    <br />

    <button type="submit"> Excel匯出</button>
    <button type="submit" name="ods" value="1">ODS匯出</button>
    @Html.Partial("_ReportMessage")
</form>

@section scripts {
    <script type="text/javascript">
        var pjYearUrl = '@Url.Action("ChoosePJYear", "Report")';
        var stateUrl = '@Url.Action("ChooseState", "Report")';
        var orderUrl = '@Url.Action("Orders", "Report")';
        var currentUser = '@Html.Raw(User.Identity.Name)';
    </script>

    <script src="~/Scripts/RainReport/State2_2.js" type="text/javascript"></script>
}