@model WCals.Models.CMBASEModels.state9ViewModel

@{
    ViewBag.Title = "(雨水)例行性管考報表：E-1.功能細項執行表(自訂欄位)";
    Layout = "~/Views/Shared/_Layout2_v2.cshtml";
}

@section head{
    <link rel="stylesheet" href="~/Content/views/report.css">

    <link rel="stylesheet" href="~/Content/views/loading-spinner.css">
}

<div class="row">
    <div class="col-lg-12">
        <h1 class="h2 border-bottom pb-2 mb-3">
            (雨水)例行性管考報表[0.1.2]

            <small> </small>
        </h1>
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <i class="fa-solid fa-dashboard"></i><a href="@Url.Content("~/Home")"> 首頁</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                <i class="fa-solid fa-file"></i>
                (雨水)例行性管考報表
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                <i class="fa-solid fa-file"></i>
                E-1.功能細項執行表(自訂欄位)
            </li>
        </ol>
    </div>
</div>

<form method="post" action="@Url.Action("ReportPrint9")" class="my-text" id="dynamicForm">
    @*<h2>例行性管考報表:</h2>*@

    報表類型:
    <select id="choose">
        <option value="Index" @{if (ViewBag.State == "Index") { <text> selected</text> }}>I-1.雨水例行性管考報表</option>
        <option value="2_2" @{if (ViewBag.State == "2_2") { <text> selected</text> }}>A-2.細項執行情形表</option>
        <option value="4_2" @{if (ViewBag.State == "4_2") { <text> selected</text> }}>A-4.跨年度細項執行情形表</option>
        <option value="6_2" @{if (ViewBag.State == "6_2") { <text> selected</text> }}>B-1.修正預算作業表</option>
        <option value="9_2" @{if (ViewBag.State == "9_2") { <text> selected</text> }}>E-1.功能細項執行表(自訂欄位)</option>
        <option value="10_2" @{if (ViewBag.State == "10_2") { <text> selected</text> }}>F-1.相關計畫年度補助經費表</option>
        <option value="12_2" @{if (ViewBag.State == "12_2") { <text> selected</text> }}>H-1.在建工程抽查/查核/督導統計表</option>
    </select>
    <br />

    <table class="table table-bordered table-hover" style="text-align: left; width:95%">
        <tr>
            <td>
                計畫種類:
            </td>
            <td id="Water_Type" colspan="4">
                <input type="radio" name="water_type" checked value="雨水使用" class="Type-checkbox" /><span> </span>雨水
            </td>
        </tr>
        <tr>
            <td class="fixed-column">
                年度區間:
            </td>
            <td id="Year" colspan="4">
                <select name="StartYear" id="yearStart">
                    <option value="" selected disabled>選擇</option>

                    @foreach (var year in ViewBag.year2)
                    {
                        <option value="@year.SYR">@year.SYR</option>
                    }
                </select>
                <label>年度~</label>
                <select name="EndYear" id="yearEnd">
                    @foreach (var year in ViewBag.year)
                    {
                        <option value="@year.SYR">@year.SYR</option>
                    }
                </select>
                <label>年度</label>
            </td>
        </tr>
        <tr>
            <td>
                計畫名稱:
            </td>
            <td id="Plan" colspan="4">
                @foreach (var item in Model.Water_Type)
                {
                    <div class="plan-item" data-id="@item.SYR" data-PID="@item.PID" data-Water_Type="@item.Water_Type" hidden>

                        <input type="checkbox" data-id="@item.SYR" data-PID="@item.PID" data-Water_Type="@item.Water_Type" name="plan" value="@item.SYR+@item.AN_PJ_NAME+@item.PJ_NAME" class="Plan-checkbox" />
                        <span>(@item.SYR)@item.AN_PJ_NAME-@item.PJ_NAME</span>
                        <br />
                    </div>
                }
            </td>
        </tr>
        <tr>
            <td>
                排列方式:
            </td>
            <td colspan="4">
                <input type="checkbox" name="Row" onclick="uncheckCancel()" />
                <span> </span>
                縣市在列
                <span> </span>
                <input type="checkbox" name="Field" onclick="uncheckFinish()" />
                <span> </span>
                縣市在欄
                <span> </span>
            </td>
        </tr>
        <tr>
            <td>
                縣市別:
            </td>
            <td colspan="4" id="City">
                <input type="checkbox" id="selectAll" onclick="toggleCheckboxes()">
                全選框
                <br />
                @for (int i = 0; i < 23; i++)
                {
                    if (i == 7 || i == 14 || i == 21)
                    {
                        <br />
                    }
                    <input type="checkbox" name="CITY" value="@Model.SMCPOSTN[i].CITY" class="city-checkbox" />
                    <span> </span>
                    @Model.SMCPOSTN[i].CITY
                    <span> </span>

                }
            </td>
        </tr>
        <tr>
            <td rowspan="32">
                顯示欄位:
            </td>
            <td colspan="4">
                <input type="checkbox" id="selectAll2" onclick="toggleCheckboxes2()">
                全選框
                <span>　</span>
                <input type="checkbox" id="selectAll3" onclick="toggleCheckboxes3()">
                擴充工程基本資料
                <span>　</span>
                <input type="checkbox" id="selectAll4" onclick="toggleCheckboxes4()">
                經費支用情形
                <span>　</span>
                <input type="checkbox" id="selectAll5" onclick="toggleCheckboxes5()">
                工作控制點
                <br />
            </td>
        </tr>
        @for (int i = 0; i < Model.OGCTITLE.Count; i++)
        {
            if (i > 1 && i % 4 == 0)
            {
                @:<tr>
                }
                if (Model.OGCTITLE[i].TITLE == "工程地點(址)")
                {
                    <td>
                        <input type="checkbox" name="COLUMN1" checked="checked" value="@Model.OGCTITLE[i].TITLE" hidden />
                    </td>
                }
                else if (Model.OGCTITLE[i].TITLE == "縣市別")
                {

                }
                else
                {
                    <td>
                        <input type="checkbox" name="COLUMN1" data-id="@Model.OGCTITLE[i].ID" value="@Model.OGCTITLE[i].TITLE" class="column-checkbox" />
                        <span> </span>
                        @Model.OGCTITLE[i].TITLE
                        <span> </span>
                    </td>
                }
                if (i % 4 == 3)
                {
                @:</tr><tr>
                }
                    }
                </tr>
                
                <tr>
                    <td colspan="5" align="center">
                        <button type="submit"> EXCEL匯出</button>
                        <button type="submit" name="pdf" value="1">ODS匯出</button>
                    </td>
                </tr>
            </table>
@Html.Partial("_ReportMessage")
</form>

@section scripts {
    <script type="text/javascript">
        var reportUrl = '@Url.Action("ReportPrint9", "RainReport")';
        var stateUrl = '@Url.Action("ChooseState", "Report")';
        var orderUrl = '@Url.Action("Orders", "Report")';
        var currentUser = '@Html.Raw(User.Identity.Name)';
    </script>

    <script src="~/Scripts/RainReport/State9_2.js" type="text/javascript"></script>

    <script>
        $(document).ready(function () {
            // 1. 綁定事件：不論是切換單選鈕、或是改變起訖年度，都即時執行篩選
            $('input[name="water_type"], #yearStart, #yearEnd').on('change', function () {
                filterReportPlans();
            });

            // 2. 【關鍵點】網頁一載入完畢，主動呼叫一次，以便對應預設 checked 的「雨水」
            filterReportPlans();

            function filterReportPlans() {
                // 撈取當前被勾選的計畫種類 (例如預設的 "雨水使用")
                var selectedType = $('input[name="water_type"]:checked').val();

                // 撈取年度區間的數值並轉為整數
                var startYear = parseInt($('#yearStart').val());
                var endYear = parseInt($('#yearEnd').val());

                // 檢查：若起訖年度任一尚未選擇，就維持計畫清單全部隱藏
                if (!selectedType || isNaN(startYear) || isNaN(endYear)) {
                    $('.plan-item').attr('hidden', true);
                    return;
                }

                // 防呆：避免使用者故意或不小心將起點選得比終點大
                if (startYear > endYear) {
                    alert('提醒：起點年度不能大於終點年度');
                    return;
                }

                // 3. 開始交集篩選（年度與種類必須同時符合）
                $('.plan-item').each(function () {
                    var $item = $(this);
                    var planYear = parseInt($item.data('id'));        // 讀取 data-id
                    var planType = $item.data('water_type');         // 讀取 data-Water_Type

                    var isYearInRange = (planYear >= startYear && planYear <= endYear);
                    var isTypeMatched = (planType === selectedType);

                    if (isYearInRange && isTypeMatched) {
                        $item.removeAttr('hidden'); // 雙重條件皆過關：顯示
                    } else {
                        $item.attr('hidden', true);  // 條件不符：隱藏

                        // 安全防呆：隱藏的項目順手移除勾選，避免髒資料送回後端
                        $item.find('.Plan-checkbox').prop('checked', false);
                    }
                });
            }
        });
    </script>

}