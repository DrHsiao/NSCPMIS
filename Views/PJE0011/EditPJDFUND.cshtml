@using PagedList.Mvc
@model WCals.ViewModels.NewModels.PJE0011Model
@{ ViewBag.Title = "計畫經費管制[1.1.3] ";
    //Layout = "~/Views/Shared/_Layout2_v2.cshtml";
    Layout = null;

}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <title>@ViewBag.Title - My ASP.NET Application</title>
    <link href="https://code.jquery.com/ui/1.14.1/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="~/Scripts/modernizr-2.8.3.js"></script>

    <link rel="stylesheet" href="~/Scripts/plugins/bootstrap-fileinput/icon.mini.css" crossorigin="anonymous">
    <link href="~/Scripts/plugins/bootstrap-fileinput/fileinput.min.css" media="all" rel="stylesheet" type="text/css" />
</head>
<body style="padding:5px;">
    @using(Html.BeginForm("", "PJE0011", FormMethod.Post, new { id = "mainForm", enctype = "multipart/form-data" })) {
        @Html.HiddenFor(x => x.PPID);
        <input type="hidden" name="DeleteId" id="DeleteId1" />
        <input type="hidden" name="DeleteId1" id="DeleteId2" />

        <button type="button" class="btn btn-success" onclick="addOne();">新增</button>
        <button class="btn btn-warning" name="action" type="submit" value="SavePJDFUND">儲存</button>



        
        <table style="display:none;">
            <tbody id="pjdadd">
                <tr>
                    <td>     
                        <input type="hidden" name="DeleteIds" />
                        <input type="text" name="PJDFUND_SYR" class="form-control"  />
                    </td>
                    <td>
                        <select name="PJDFUND_IPJ_CODE" class="form-select">
                            @{var IPJ_CODE = ViewBag.IPJ_CODE;}
                            @foreach(System.Data.DataRow ipj in IPJ_CODE.Rows) {

                                <option value="@ipj["id"]">@ipj["name"]</option>

                            }
                        </select>
                    </td>
                    <td><input type="text" name="PJDFUND_FUND" class="form-control" /></td>
                    <td><input type="text" name="PJDFUND_FUND_DESC" class="form-control"  /></td>
                    <td><input type="text" name="PJDFUND_YBG_FUND" class="form-control"  /></td>
                    <td>
                        <button class="btn btn-warning" name="action" type="submit" value="SavePJDFUND">儲存</button>
                    </td>
                </tr>
            </tbody>
        </table>
        <table width="100%" class="table table-hover" style="overflow-x: auto; white-space: nowrap;">
            <thead class="table-light">
                <tr>
                    <th>年度</th>
                    <th>經費層級*</th>
                    <th>金額(元)*</th>
                    <th>經費說明</th>
                    <th>實際編列經費(元)</th>
                </tr>
            </thead>
            <tbody id="pjdbody">
                @{ List<WCals.Models.CMPSGSModels.PJDFUND> PJDFUND = ViewBag.PJDFUND;
                    }
                @foreach(WCals.Models.CMPSGSModels.PJDFUND c in PJDFUND) {
                    <tr>
                        <td>
                            <input type="text" name="PJDFUND_SYR" class="form-control" value="@c.SYR" />
                        </td>
                        <td>
                            <input type="hidden" name="DeleteIds" id="del_@c.PPID@c.SYR@c.IPJ_CODE"/>
                            <select name="PJDFUND_IPJ_CODE" class="form-select">
                                @foreach(System.Data.DataRow ipj in IPJ_CODE.Rows) {
                                    if(Convert.ToString(ipj["id"]).Equals(c.IPJ_CODE)) {
                                        <option selected value="@ipj["id"]">@ipj["name"]</option>
                                    } else {
                                        <option value="@ipj["id"]">@ipj["name"]</option>
                                    }
                                }
                            </select>
                        </td>
                        <td><input type="text" name="PJDFUND_FUND" class="form-control" value="@c.FUND" /></td>
                        <td><input type="text" name="PJDFUND_FUND_DESC" class="form-control" value="@c.FUND_DESC" /></td>
                        <td><input type="text" name="PJDFUND_YBG_FUND" class="form-control" value="@c.YBG_FUND" /></td>
                        <td><button class="btn btn-danger" onclick="$('#del_@c.PPID@c.SYR@c.IPJ_CODE').val('*')" name="action" type="submit" value="DelPJDFUND">刪除</button></td>
                    </tr>
                }
            </tbody>
        </table>
    }
    <script>
        function addOne() {

            $('#pjdbody').prepend($('#pjdadd').html());

        }
    </script>
    @if(ViewBag.msg != null) {
        <script>
            alert('@ViewBag.msg');
        </script>
    }
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/ui/1.14.1/jquery-ui.min.js"></script>
    <script type="text/javascript" src="~/Scripts/jquery.datepick.js"></script>
    <script type="text/javascript" src="~/Scripts/MyDatepickerJ.js"></script>


    <script src="~/Scripts/plugins/bootstrap-fileinput/fileinput.js"></script>
    <script src="~/Scripts/plugins/bootstrap-fileinput/zh-TW.js"></script>

</body>
</html>