@using PagedList.Mvc
@model WCals.ViewModels.NewModels.PJE0011Model
@{ ViewBag.Title = "計畫經費管制[1.1.3] ";
    //Layout = "~/Views/_Layout.cshtml";
    Layout = null;

}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <title>@ViewBag.Title - My ASP.NET Application</title>
    <link href="https://code.jquery.com/ui/1.14.1/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="~/Scripts/modernizr-2.8.3.js"></script>

    <link rel="stylesheet" href="~/Scripts/plugins/bootstrap-fileinput/icon.mini.css" crossorigin="anonymous">
    <link href="~/Scripts/plugins/bootstrap-fileinput/fileinput.min.css" media="all" rel="stylesheet" type="text/css" />
</head>
<body style="padding:5px;">
    @using(Html.BeginForm("", "PJE0011", FormMethod.Post, new { id = "mainForm", enctype = "multipart/form-data" })) {
        @Html.HiddenFor(x => x.PPID)
        <input type="hidden" name="DeleteId1" id="DeleteId1" />
        <table style="display:none;">
            <tbody id="addpfdcaty">
                <tr>
                    <td>
                        <input type="text" name="PJDSYRC_PSG_NAME" class="form-control" />
                    </td>
                    <td><input type="text" name="PJDSYRC_BGN_SYR" class="form-control" /></td>
                    <td><input type="text" name="PJDSYRC_END_SYR" class="form-control" /></td>
                    <td>
                        <button class="btn btn-warning" name="action" type="submit" value="SavePJDSYRC">儲存</button>
                    </td>
                </tr>
            </tbody>
        </table>
        <button type="button" class="btn btn-success" onclick="addOne();">新增</button>
        <button class="btn btn-warning" name="action" type="submit" value="SavePJDSYRC">儲存</button>
        <table width="100%" class="table table-hover" style="overflow-x: auto; white-space: nowrap;">
            <thead class="table-light">
                <tr>
                    <th>說明</th>
                    <th>啟始</th>
                    <th>終止</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="pjdcmctbody">
                @{ List<WCals.Models.CMPSGSModels.PJDSYRC> p = ViewBag.PJDSYRC;}
                @foreach(WCals.Models.CMPSGSModels.PJDSYRC c in p) {
                    <tr>
                        <td>
                            <input type="text" disabled class="form-control" value="@c.PSG_NAME" />
                        </td>
                        <td><input type="text" disabled class="form-control" value="@c.BGN_SYR" /></td>
                        <td><input type="text" disabled class="form-control" value="@c.END_SYR" /></td>
                        <td>
                            <div class="btn-group btn-toggle">
                                @if(c.OPEN_FG == true) {
                                    <button onclick="$('#DeleteId1').val('@c.YRC_ID');" name="action" value="OpenPJDSYRC" class="btn btn-primary active">開啟</button>
                                    <button onclick="$('#DeleteId1').val('@c.YRC_ID');" name="action" value="ClosePJDSYRC" class="btn btn-secondary">關閉</button>
                                } else {
                                    <button onclick="$('#DeleteId1').val('@c.YRC_ID');" name="action" value="OpenPJDSYRC" class="btn btn-secondary">開啟</button>
                                    <button onclick="$('#DeleteId1').val('@c.YRC_ID');" name="action" value="ClosePJDSYRC" class="btn btn-primary active">關閉</button>
                                }
                            </div>
                            <button onclick="return confirmDelete('@c.YRC_ID',  @c.OPEN_FG.ToString().ToLower());"class="btn btn-danger" name="action" type="submit" value="DelPJDSYRC">刪除</button>
                            @*<button onclick="$('#DeleteId1').val('@c.YRC_ID');"class="btn btn-danger" name="action" type="submit" value="DelPJDSYRC">刪除</button>*@
                        </td>
                    </tr>
                }
            </tbody>
        </table>




    }
    <script>
        function addOne() {

            $('#pjdcmctbody').prepend($('#addpfdcaty').html());

        }

        function confirmDelete(id, isOpen) {
            let message = '確定要刪除嗎？刪除後無法復原！';

            if (isOpen === true) {
                message += '\n\n⚠ 目前開啟中';
            }

            if (confirm(message)) {
                $('#DeleteId1').val(id);
                return true; // 送出表單
            }

            return false; // 取消
        }
    </script>
    @if(ViewBag.msg != null) {
        <script>
            alert('@ViewBag.msg');
        </script>
    }
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/ui/1.14.1/jquery-ui.min.js"></script>
    <script type="text/javascript" src="~/Scripts/jquery.datepick.js"></script>
    <script type="text/javascript" src="~/Scripts/MyDatepickerJ.js"></script>


    <script src="~/Scripts/plugins/bootstrap-fileinput/fileinput.js"></script>
    <script src="~/Scripts/plugins/bootstrap-fileinput/zh-TW.js"></script>

</body>
</html>