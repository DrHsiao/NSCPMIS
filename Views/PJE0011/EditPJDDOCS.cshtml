@using PagedList.Mvc
@model WCals.ViewModels.NewModels.PJE0011Model
@{ ViewBag.Title = "計畫經費管制[1.1.3] ";
    //Layout = "~/Views/Shared/_Layout2_v2.cshtml";
    Layout = null;

}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <title>@ViewBag.Title - My ASP.NET Application</title>
    <link href="https://code.jquery.com/ui/1.14.1/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="~/Scripts/modernizr-2.8.3.js"></script>

    <link rel="stylesheet" href="~/Scripts/plugins/bootstrap-fileinput/icon.mini.css" crossorigin="anonymous">
    <link href="~/Scripts/plugins/bootstrap-fileinput/fileinput.min.css" media="all" rel="stylesheet" type="text/css" />
</head>
<body style="padding:5px;">
    @using(Html.BeginForm("", "PJE0011", FormMethod.Post, new { id = "mainForm", enctype = "multipart/form-data" })) {
        @Html.HiddenFor(x => x.PPID)
        <input type="hidden" name="DeleteId1" id="DeleteId1" />
        
        <button type="button" class="btn btn-success" onclick="addOne();">新增</button>
        <button class="btn btn-warning" name="action" type="submit" value="SavePJDDOCS">儲存</button>

        <table style="display:none;">
            <tbody id="from_table">
                <tr>
                    <td>
                        <input type="hidden" name="FID" />
                        <input type="text" name="FILE_DESC" class="form-control" />
                    </td>
                    <td><input name="files" type="file" /></td>
                    <td></td>
                    <td></td>
                    <td><button class="btn btn-warning" name="action" type="submit" value="SavePJDDOCS">儲存</button></td>
                </tr>
            </tbody>
            </table>
            <table width="100%" class="table table-hover" style="overflow-x: auto; white-space: nowrap;">
                <thead class="table-light">
                    <tr>
                        <th>檔案說明</th>
                        <th>檔案名稱*</th>
                        <th>檔案大小</th>
                        <th>上傳日</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="targetTable">
                    @{ List<WCals.Models.CMPSGSModels.PJDDOCS> PJDDOCS = ViewBag.PJDDOCS;}
                    @foreach(WCals.Models.CMPSGSModels.PJDDOCS c in PJDDOCS) {
                        <tr>
                            <td>
                            <input type="hidden" name="FID" value="@c.FID" />
                            <input type="text" name="FILE_DESC" class="form-control" value="@c.FILE_DESC"/></td>
                            <td>
                                <input name="files" type="file" />
                                <a target="_blank" href="@Url.Content("~/")PJE0011/DownloadAPDFILE?fid=@c.FID">@c.FILE_NAME</a>
                            </td>
                            <td>@c.FILE_SIZE</td>
                            <td>@c.ADD_DT</td>
                            <td><button class="btn btn-danger" onclick="$('#DeleteId1').val('@c.FID');" name="action" type="submit" value="DelPJDDOCS">刪除</button></td>
                        </tr>


                    }
                </tbody>
            </table>
            }
            <script>
                function addOne() {
                    $('#targetTable').prepend($('#from_table').html());
                }
            </script>
            @if(ViewBag.msg != null) {
                <script>
            alert('@ViewBag.msg');
                </script>
            }
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
            <script src="https://code.jquery.com/ui/1.14.1/jquery-ui.min.js"></script>
            <script type="text/javascript" src="~/Scripts/jquery.datepick.js"></script>
            <script type="text/javascript" src="~/Scripts/MyDatepickerJ.js"></script>


            <script src="~/Scripts/plugins/bootstrap-fileinput/fileinput.js"></script>
            <script src="~/Scripts/plugins/bootstrap-fileinput/zh-TW.js"></script>

    </body>
</html>