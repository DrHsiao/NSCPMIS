@using PagedList.Mvc
@model WCals.ViewModels.NewModels.PJE0011Model
@{ ViewBag.Title = "計畫經費管制[1.1.3] ";
    //Layout = "~/Views/Shared/_Layout2_v2.cshtml";
    Layout = null;

}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>@ViewBag.Title - My ASP.NET Application</title>
    <link href="https://code.jquery.com/ui/1.14.1/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="~/Scripts/modernizr-2.8.3.js"></script>

    <link rel="stylesheet" href="~/Scripts/plugins/bootstrap-fileinput/icon.mini.css" crossorigin="anonymous">
    <link href="~/Scripts/plugins/bootstrap-fileinput/fileinput.min.css" media="all" rel="stylesheet" type="text/css" />

    <!-- Timepicker CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jquery-ui-timepicker-addon/1.6.3/jquery-ui-timepicker-addon.min.css" />
</head>
<body style="padding:5px;">
    <table style="display:none;">
        <tbody id="addpfdcaty">
            <tr>
     <td>
         <input type="hidden" class="form-control" name="PJDCATY_CID" />
            <input type="text" class="form-control" name="PJDCATY_CATY_CODE" />
             </td>
     <td><input type="text" class="form-control" name="PJDCATY_CATY_NAME" /></td>
<td>
        <select name="PJDCATY_EVRF_FG" class="form-select">
     <option value=""></option>
 <option value="0">否</option>
        <option value="1">是</option>
       </select>
         </td>
           <td><input type="text" class="form-control gg" name="PJDCATY_OTDSG_DT" /></td>
  <td><input type="text" class="form-control" name="PJDCATY_OTDSG_BUSS" /></td>
    <td><input type="text" class="form-control gg" name="PJDCATY_DSGRL_DT" /></td>
    <td><input type="text" class="form-control gg" name="PJDCATY_PCCJDG_DT" /></td>
      <td><input type="text" class="form-control" name="PJDCATY_PCCJDG_FUND" /></td>
 <td><button class="btn btn-warning" name="action" type="submit" value="SavePJDCATY">儲存</button></td>
            </tr>
        </tbody>
    </table>
    @using(Html.BeginForm("", "PJE0011", FormMethod.Post, new { id = "mainForm", enctype = "multipart/form-data" })) {
        @Html.HiddenFor(x => x.PPID)

        <button type="button" class="btn btn-success" onclick="addOne();">新增</button>
        <button class="btn btn-warning" name="action" type="submit" value="SavePJDCATY">儲存</button>
        <input type="hidden" name="DeleteId1" id="DeleteId" />
        <table width="100%" class="table table-hover" style="overflow-x: auto; white-space: nowrap;">
            <thead class="table-light">
                <tr>
         <th>分類代碼</th>
  <th>分類名稱</th>
        <th>總工程司核定</th>
           <th>委設招商日期</th>
     <th>委設招商名稱</th>
          <th>辦理設計原則日期</th>
        <th>工程會審議日期</th>
        <th>匡列經費(元)</th>
       <th></th>
         </tr>
      </thead>
          <tbody id="pjdcatybody">
@{ List<WCals.Models.CMPSGSModels.PJDCATY_CMPSGS> pjdcaty = ViewBag.PJDCATY;}

@foreach(WCals.Models.CMPSGSModels.PJDCATY_CMPSGS c in pjdcaty) {
<tr>
       <td>
      <input type="hidden" class="form-control" name="PJDCATY_CID" value="@c.CID" />
     <input type="text" class="form-control" name="PJDCATY_CATY_CODE" value="@c.CATY_CODE" />
 </td>
             <td><input type="text" class="form-control" name="PJDCATY_CATY_NAME" value="@c.CATY_NAME" /></td>
       <td>
  <select name="PJDCATY_EVRF_FG" class="form-select">

            @if(c.EVRF_FG == true) {
      <option value="0">否</option>
 <option selected value="1">是</option>
           } else {
     <option selected value="0">否</option>
        <option value="1">是</option>
            }
      </select>
            </td>
    <td><input type="text" class="form-control dt" name="PJDCATY_OTDSG_DT" value="@(c.OTDSG_DT.HasValue ? c.OTDSG_DT.Value.ToString("yyyy/MM/dd") : "")" /></td>
    <td><input type="text" class="form-control" name="PJDCATY_OTDSG_BUSS" value="@c.OTDSG_BUSS" /></td>
          <td><input type="text" class="form-control dt" name="PJDCATY_DSGRL_DT" value="@(c.DSGRL_DT.HasValue ? c.DSGRL_DT.Value.ToString("yyyy/MM/dd") : "")" /></td>
            <td><input type="text" class="form-control dt" name="PJDCATY_PCCJDG_DT" value="@(c.PCCJDG_DT.HasValue ? c.PCCJDG_DT.Value.ToString("yyyy/MM/dd") : "")" /></td>
       <td><input type="text" class="form-control" name="PJDCATY_PCCJDG_FUND" value="@c.PCCJDG_FUND" /></td>
            <td><button class="btn btn-danger" onclick="$('#DeleteId').val('@c.CID');return (confirm('確定刪除?')); void ('');" name="action" type="submit" value="DelPJDCATY">刪除</button></td>
   </tr>
      }
            </tbody>
        </table>
    }

    @if(ViewBag.msg != null) {
 <script>
         alert('@ViewBag.msg');
        </script>
    }
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/ui/1.14.1/jquery-ui.min.js"></script>

    <!-- jquery-ui-timepicker-addon.js -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-ui-timepicker-addon/1.6.3/jquery-ui-timepicker-addon.min.js"></script>

    <script src="~/Scripts/plugins/bootstrap-fileinput/fileinput.js"></script>

    <script>
   // 中文化設定
        $.timepicker.regional['zh-TW'] = {
      timeOnlyTitle: '選擇時間',
 timeText: '時間',
  hourText: '時',
  minuteText: '分',
  secondText: '秒',
         millisecText: '毫秒',
        microsecText: '微秒',
     timezoneText: '時區',
            currentText: '現在時間',
     closeText: '關閉',
     timeFormat: 'HH:mm',
            timeSuffix: '',
   amNames: ['上午', 'AM', 'A'],
   pmNames: ['下午', 'PM', 'P'],
            isRTL: false
      };
        $.timepicker.setDefaults($.timepicker.regional['zh-TW']);

        // datetimepicker 共用設定
    var datetimepickerOptions = {
            changeYear: true,
    changeMonth: true,
        dateFormat: 'yy/mm/dd',
        timeFormat: '',
        showTimepicker: false,
   //timeFormat: 'HH:mm',
   // showSecond: false,  // 不顯示秒
   //   showMillisec: false,    // 不顯示毫秒
   //         showMicrosec: false,    // 不顯示微秒
   //    showTimezone: false,    // 不顯示時區
   //       stepMinute: 5,          // 每5分鐘為一個選項
            // 中文化日期選擇器
            monthNames: ['一月', '二月', '三月', '四月', '五月', '六月', '七月', '八月', '九月', '十月', '十一月', '十二月'],
      monthNamesShort: ['一月', '二月', '三月', '四月', '五月', '六月', '七月', '八月', '九月', '十月', '十一月', '十二月'],
  dayNames: ['星期日', '星期一', '星期二', '星期三', '星期四', '星期五', '星期六'],
     dayNamesShort: ['週日', '週一', '週二', '週三', '週四', '週五', '週六'],
         dayNamesMin: ['日', '一', '二', '三', '四', '五', '六'],
    prevText: '上月',
    nextText: '下月',
            currentText: '今天',
    closeText: '關閉'
      };

        function addOne() {
         $('#pjdcatybody').prepend($('#addpfdcaty').html());
        setTimeout(function () {
     $(".gg").datetimepicker(datetimepickerOptions);
  }, 500);
      }

        $(function () {
         $(".dt").datetimepicker(datetimepickerOptions);
     });
    </script>
</body>
</html>