@using PagedList.Mvc
@model WCals.ViewModels.NewModels.PJE0011Model
@{ ViewBag.Title = "計畫經費管制";
    Layout = "~/Views/Shared/_Layout2_v2.cshtml"; }

<div class="row">
    <div class="col-lg-12">
        <h1 class="h2 border-bottom pb-2 mb-3">
            計畫經費管制
            <small>計畫經費管制</small>
        </h1>
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <i class="fa-solid fa-dashboard"></i><a href="@Url.Content("~/")Home"> 首頁</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                <i class="fa-solid fa-file"></i>
                計畫經費管制
            </li>
        </ol>
    </div>
</div>
@using(Html.BeginForm("", "PJE0030", FormMethod.Post, new { id = "mainForm" })) {

    <div style="display:flex;width:100%">
        <div style="width:50%; text-align:left;">

        </div>
        <div style="width: 50%; text-align: right;">
            @Html.PagedListPager(Model.MainList, page => Url.Action("ProposalDetailList",
                new {
                         page = page
                     }),
                new PagedListRenderOptions {
                    DisplayItemSliceAndTotal = true,
                    DisplayPageCountAndCurrentLocation = true,
                    DisplayLinkToLastPage = PagedListDisplayMode.Never,
                    DisplayLinkToIndividualPages = false,

                    ItemSliceAndTotalFormat = "顯示第 {0} - {1}筆, 共{2}筆",
                    PageCountAndCurrentLocationFormat = "第 {0}頁 / 共 {1}頁",
                }
            )
        </div>
    </div>
    <script>
        $(window).on('load', function () {
            $('#PID').val("");
        });

        function delCheck(pid) {
            if (confirm('確定刪除?')) {
                $('#PID').val(pid);
            } else {
                void ('')
            }
        }
    </script>
    <input type="hidden" name="PID" id="PID" value="@Model.PID" />
    <input type="hidden" name="prePage" value="@Request.Params["page"]" />
    <div class="card mb-3">
        <table class="table table-hover" style="width:100%; overflow-x: auto; white-space: nowrap;">
            <thead class="table-light">
                <tr>
                    <th>年度</th>
                    <th>年度計畫</th>
                    <th>分支計畫編號</th>
                    <th>分支計畫名稱</th>
                    <th>分支計畫經費</th>
                    <th>修正期別</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach(var c in Model.MainList) {
                    <tr>

                        <td>@c["SYR"]</td>
                        <td>@c["WPJ_NAME"]</td>
                        <td>@c["PID"]</td>
                        <td>@c["BPJ_NAME"]</td>
                        <td>@c["PJ_FUND"]</td>
                        <td>@c["SEQ_NAME"]</td>
                        <td>

                            <button class="btn btn-primary" name="action" type="submit" value="Maintain" onclick="$('#PID').val('@c["PID"]')">維護</button>
                            <button class="btn btn-primary" name="action" type="submit" value="Manage" onClick="$('#PID').val('@c["PID"]')">案件管制</button>
                            <button class="btn btn-primary" name="action" type="submit" value="BudgetCount" onclick="$('#PID').val('@c["PID"]');">預算統計</button>
                            <button class="btn btn-primary" name="action" type="submit" value="BudgetEdit" onclick="$('#PID').val('@c["PID"]');">預算調整</button>
                        </td>
                    </tr>

                }
            </tbody>
        </table>
    </div>






    @Html.PagedListPager(Model.MainList, page => Url.Action("ProposalDetailList",
    new { page = page }))


}