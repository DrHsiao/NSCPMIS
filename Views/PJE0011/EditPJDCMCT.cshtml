@using PagedList.Mvc
@model WCals.ViewModels.NewModels.PJE0011Model
@{ ViewBag.Title = "計畫經費管制[1.1.3] ";
    //Layout = "~/Views/Shared/_Layout2_v2.cshtml";
    Layout = null;

}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <title>@ViewBag.Title - My ASP.NET Application</title>
    <link href="https://code.jquery.com/ui/1.14.1/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="~/Scripts/modernizr-2.8.3.js"></script>

    <link rel="stylesheet" href="~/Scripts/plugins/bootstrap-fileinput/icon.mini.css" crossorigin="anonymous">
    <link href="~/Scripts/plugins/bootstrap-fileinput/fileinput.min.css" media="all" rel="stylesheet" type="text/css" />
</head>
<body style="padding:5px;">
    @using(Html.BeginForm("", "PJE0011", FormMethod.Post, new { id = "mainForm", enctype = "multipart/form-data" })) {
        @Html.HiddenFor(x => x.PPID)
        <input type="hidden" name="DeleteId" id="DeleteId" />
        <table style="display:none;">
            <tbody id="addpfdcaty">
                <tr>
                    <td>
                        <input type="hidden" class="form-control" name="PJDCATY_CID" />
                        <input type="text" class="form-control" name="PJDCATY_CATY_CODE" />
                    </td>
                    <td><input type="text" class="form-control" name="PJDCATY_CATY_NAME" /></td>
                    <td><input type="text" class="form-control" name="PJDCATY_EVRF_FG" /> </td>
                    <td><input type="text" class="form-control" name="PJDCATY_OTDSG_DT" /></td>
                    <td><input type="text" class="form-control" name="PJDCATY_OTDSG_BUSS" /></td>
                    <td><input type="text" class="form-control" name="PJDCATY_DSGRL_DT" /></td>
                    <td><input type="text" class="form-control" name="PJDCATY_PCCJDG_DT" /></td>
                    <td><input type="text" class="form-control" name="PJDCATY_PCCJDG_FUND" /></td>
                    <td></td>
                </tr>
            </tbody>
        </table>
        <button type="button" class="btn btn-success" onclick="addOne();">新增</button>
        <button class="btn btn-warning" name="action" type="submit" value="SavePJDCMCT">儲存</button>

        <input type="hidden" name="DeleteId1" id="DeleteId1" />
        <input type="hidden" name="DeleteId2" id="DeleteId2" />


        <table style="display:none;">
            <tbody id="pjdcmctadd">
                <tr>
                    <td>
                        <input type="hidden" name="PJDCMCT_PID" />
                        <input type="text" name="PJDCMCT_CMS_CODE" class="form-control" />
                    </td>
                    <td><input type="text" name="PJDCMCT_CMS_NAME" class="form-control" /></td>
                    <td><input type="text" name="PJDCMCT_CMS_UNIT" class="form-control" /></td>
                    <td><input type="text" name="PJDCMCT_CMS_NOTE" class="form-control" /></td>
                    <td><button class="btn btn-warning" name="action" type="submit" value="SavePJDCMCT">儲存</button></td>


                    


                </tr>
            </tbody>
        </table>
        <table width="100%" class="table table-hover" style="overflow-x: auto; white-space: nowrap;">
            <thead class="table-light">
                <tr>
                    <th>項目代碼			</th>
                    <th>項目名稱</th>
                    <th>單位別</th>
                    <th>備註說明</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="pjdcmctbody">
                @{ List<WCals.Models.CMPSGSModels.PJDCMCT> pjdcmct = ViewBag.PJDCMCT;}
                @foreach(WCals.Models.CMPSGSModels.PJDCMCT c in pjdcmct) {
                    <tr>
                        <td>
                            <input type="hidden" name="PJDCMCT_PID" value="@c.PPID" />
                            <input type="text" name="PJDCMCT_CMS_CODE" class="form-control" value="@c.CMS_CODE" />
                        </td>
                        <td><input type="text" name="PJDCMCT_CMS_NAME" class="form-control" value="@c.CMS_NAME" /></td>
                        <td><input type="text" name="PJDCMCT_CMS_UNIT" class="form-control" value="@c.CMS_UNIT" /></td>
                        <td><input type="text" name="PJDCMCT_CMS_NOTE" class="form-control" value="@c.CMS_NOTE" /></td>
                        <td><button typeof="button" class="btn btn-danger" onclick="checkDel('@c.PPID', '@c.CMS_CODE');return (confirm('確定刪除?')); void ('');" name="action" type="submit" value="DelPJDCMCT">刪除</button></td>
                    </tr>
                }
            </tbody>
        </table>




    }
<script>
        function addOne() {

            $('#pjdcmctbody').prepend($('#pjdcmctadd').html());

        }
    function checkDel(PPID, CMS_CODE) {

            $('#DeleteId1').val(PPID);
            $('#DeleteId2').val(CMS_CODE);
        }
</script>
    @if(ViewBag.msg != null) {
        <script>
            alert('@ViewBag.msg');
        </script>
    }
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/ui/1.14.1/jquery-ui.min.js"></script>
    <script type="text/javascript" src="~/Scripts/jquery.datepick.js"></script>
    <script type="text/javascript" src="~/Scripts/MyDatepickerJ.js"></script>


    <script src="~/Scripts/plugins/bootstrap-fileinput/fileinput.js"></script>
    <script src="~/Scripts/plugins/bootstrap-fileinput/zh-TW.js"></script>

</body>
</html>