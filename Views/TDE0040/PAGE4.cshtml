@using PagedList.Mvc
@using System.Collections.Generic
@model WCals.ViewModels.NewModels.TDE0040Model
@{ 
    ViewBag.Title = "工程文件對象管理";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- FontAwesome 6 -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
    <link href="https://code.jquery.com/ui/1.14.1/themes/base/jquery-ui.css" rel="stylesheet" />
    <script type="text/javascript" src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="~/Scripts/modernizr-2.8.3.js"></script>
    <style>
        body { 
            background-color: #f8f9fa;
            padding: 15px; 
            font-family: "Inter", "Microsoft JhengHei", sans-serif;
        }

        .card-header {
            background: linear-gradient(135deg, #337ab7, #286090);
            color: #fff;
        }

        .table-responsive { 
            border-radius: 0 0 0.375rem 0.375rem;
        }

        .table>thead>tr>th {
            background-color: #f1f5f9;
            color: #334155;
            font-size: 14px;
            font-weight: 600;
            vertical-align: middle;
            border-bottom: 2px solid #dee2e6;
        }

        .table>tbody>tr>td {
            vertical-align: middle;
            font-size: 14px;
        }

        /* 輸入框美化 */
        .form-control:focus {
            border-color: #337ab7;
            box-shadow: 0 0 0 0.2rem rgba(51, 122, 183, 0.25);
        }

        .btn-action {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
        }
    
        /* 表格框線與排版美化 */
        .table-bordered { border: 0 !important; }
        .table-bordered th, .table-bordered td { border: 0 !important; border-bottom: 1px solid #e2e8f0 !important; }
        .table > thead > tr > th { 
            border-bottom: 2px solid #337ab7 !important; 
            background-color: #f8fafc; 
            color: #334155; 
        }
        .table > tbody > tr:last-child > td { border-bottom: 0 !important; }
</style>
    <link href="~/Content/bs3-compat.css" rel="stylesheet" />
</head>
<body>
    <div class="container-fluid">
        @{
            var htmlAttributes = new Dictionary<string, object>
            {
                { "id", "mainForm" },
                { "enctype", "multipart/form-data" }
            };
        }
        @using(Html.BeginForm("PAGE4", "TDE0040", FormMethod.Post, htmlAttributes))
        {
            @Html.AntiForgeryToken()

            <!-- 標題與操作區 -->
            <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom border-2 border-primary">
                <h4 class="mb-0 text-primary fw-bold">
                    <i class="fa-solid fa-folder-open me-2"></i> @Model.TD_NAME
                    <span class="fs-6 text-secondary ms-2 fw-normal">文件對象管理</span>
                </h4>
                <div class="d-flex gap-2">
                    <button type="button" onclick="showAddModal();" class="btn btn-primary shadow-sm">
                        <i class="fa-solid fa-plus me-1"></i>新增文件
                    </button>
                    <button type="button" onclick="top.close4();" class="btn btn-outline-secondary shadow-sm">
                        <i class="fa-solid fa-xmark me-1"></i>關閉
                    </button>
                </div>
            </div>

            @Html.HiddenFor(m => m.TD_CODE)

            <!-- 系統訊息 -->
            <div id="messageArea" class="mb-3">
                @if(TempData["Success"] != null) {
                    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                        <i class="fa-regular fa-circle-check me-2"></i> <strong>成功！</strong> @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if(TempData["Error"] != null) {
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                        <i class="fa-solid fa-circle-exclamation me-2"></i> <strong>錯誤！</strong> @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
            </div>

            <!-- 卡片式資料列表 -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header fw-bold d-flex align-items-center">
                    <i class="fa-solid fa-list me-2"></i> 文件對象列表
                </div>
                <div class="table-responsive">
                    <table class="table table-hover  mb-0" id="cobListTable">
                        <thead>
                            <tr>
                                <th class="text-center" style="width: 5%;">序號</th>
                                <th style="width: 15%;">項目代碼</th>
                                <th style="width: 25%;">標題</th>
                                <th style="width: 30%;">說明</th>
                                <th style="width: 15%;">檔案名稱</th>
                                <th class="text-center" style="width: 10%;">操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if(Model.List1 != null && Model.List1.Count > 0) {
                                int index = 1;
                                foreach(System.Data.DataRow row in Model.List1) {
                                    var fileName = row["OBJ_NAME"].ToString() + row["OBJ_EXTNAME"].ToString();
                                    <tr>
                                        <td class="text-center text-muted">@index</td>
                                        <td class="fw-semibold">@row["IT_CODE"]</td>
                                        <td>@row["OBJ_TITLE"]</td>
                                        <td class="text-secondary">@row["OBJ_DESC"]</td>
                                        <td>
                                            @if(!string.IsNullOrEmpty(fileName)) {
                                                <i class="fa-regular fa-file me-1 text-primary"></i>@fileName
                                            } else {
                                                <span class="text-muted fst-italic"><i class="fa-solid fa-ban me-1"></i>無檔案</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <div class="btn-group shadow-sm">
                                                @if(!string.IsNullOrEmpty(fileName)) {
                                                    <a href="@Url.Action("DownloadTDDDCOBFile", "TDE0040", new { tdCode = row["TD_CODE"], itCode = row["IT_CODE"] })"
                                                       class="btn btn-sm btn-outline-info btn-action" title="下載">
                                                        <i class="fa-solid fa-download"></i>
                                                    </a>
                                                }
                                                <button type="button" class="btn btn-sm btn-outline-primary btn-action" onclick='editCOB("@row["TD_CODE"]", "@row["IT_CODE"]");' title="編輯">
                                                    <i class="fa-solid fa-pen"></i>
                                                </button>
                                                <button type="button" class="btn btn-sm btn-outline-danger btn-action" onclick='deleteCOB("@row["TD_CODE"]", "@row["IT_CODE"]");' title="刪除">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                    index++;
                                }
                            } else {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-4">
                                        <i class="fa-solid fa-folder-open fs-3 mb-2 d-block text-black-50"></i>
                                        尚無文件資料
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        } @* End of using block *@
    </div>

    <!-- Modal 對話框 -->
    <div class="modal fade" id="cobModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content shadow">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold" id="modalTitle"><i class="fa-solid fa-file-circle-plus me-2"></i>標題</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="cobForm" method="post" action="@Url.Action("PAGE4", "TDE0040")" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="TD_CODE" value="@Model.TD_CODE" />
                    <input type="hidden" name="IT_CODE" id="IT_CODE" value="" />

                    <div class="modal-body bg-light">
                        <div class="card border-0 shadow-sm p-4">
                            <div class="mb-3">
                                <label class="form-label fw-bold">項目代碼 <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="IT_CODE_INPUT" id="IT_CODE_INPUT" required placeholder="請輸入項目代碼" />
                                <div class="form-text text-muted"><i class="fa-solid fa-circle-info me-1"></i>用於標識此文件對象的唯一代碼。</div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">標題 <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="OBJ_TITLE" id="OBJ_TITLE" required placeholder="請輸入文件標題" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">說明</label>
                                <textarea class="form-control" name="OBJ_DESC" id="OBJ_DESC" rows="3" placeholder="選填，描述此文件的詳細內容..."></textarea>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">文件上傳</label>
                                <div class="input-group">
                                    <input type="file" class="form-control" name="files" id="fileUpload" />
                                    <span class="input-group-text"><i class="fa-solid fa-paperclip"></i></span>
                                </div>
                                <div class="form-text text-primary mt-2 fw-semibold" id="currentFileName"></div>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer bg-white">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><i class="fa-solid fa-xmark me-1"></i>取消</button>
                        <button type="submit" class="btn btn-primary" id="btnSave"><i class="fa-solid fa-floppy-disk me-1"></i>儲存變更</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/ui/1.14.1/jquery-ui.min.js"></script>
    <script src="~/Scripts/validator.min.js"></script>
    <script>
        // 顯示新增對話框
        function showAddModal() {
            $('#modalTitle').html('<i class="fa-solid fa-file-circle-plus me-2"></i>新增文件對象');
            $('#IT_CODE').val('');
            $('#IT_CODE_INPUT').val('').prop('readonly', false);
            $('#OBJ_TITLE').val('');
            $('#OBJ_DESC').val('');
            $('#fileUpload').val('');
            $('#currentFileName').html('');
            
            var modal = new bootstrap.Modal(document.getElementById('cobModal'));
            modal.show();
        }

        // 編輯資料
        function editCOB(tdCode, itCode) {
            $.ajax({
                url: '@Url.Action("GetTDDDCOB", "TDE0040")',
                type: 'POST',
                data: { tdCode: tdCode, itCode: itCode },
                success: function(result) {
                    if(result.success) {
                        $('#modalTitle').html('<i class="fa-solid fa-file-pen me-2"></i>編輯文件對象');
                        $('#IT_CODE').val(result.data.IT_CODE);
                        $('#IT_CODE_INPUT').val(result.data.IT_CODE).prop('readonly', true);
                        $('#OBJ_TITLE').val(result.data.OBJ_TITLE);
                        $('#OBJ_DESC').val(result.data.OBJ_DESC);
                        $('#fileUpload').val('');

                        if(result.data.OBJ_NAME) {
                            $('#currentFileName').html('<i class="fa-solid fa-clock-rotate-left me-1"></i>目前檔案: ' + result.data.OBJ_NAME + result.data.OBJ_EXTNAME);
                        } else {
                            $('#currentFileName').html('');
                        }

                        var modal = new bootstrap.Modal(document.getElementById('cobModal'));
                        modal.show();
                    } else {
                        alert('載入資料失敗：' + result.message);
                    }
                },
                error: function() {
                    alert('載入資料時發生錯誤');
                }
            });
        }

        // 刪除資料
        function deleteCOB(tdCode, itCode) {
            if(confirm('確定要永久刪除此筆資料嗎？刪除後無法復原。')) {
                $.ajax({
                    url: '@Url.Action("DeleteTDDDCOB", "TDE0040")',
                    type: 'POST',
                    data: { tdCode: tdCode, itCode: itCode },
                    success: function(result) {
                        if(result.success) {
                            $('<div class="alert alert-success alert-dismissible fade show" role="alert"><i class="fa-solid fa-check me-2"></i>' + result.message + '</div>')
                                .appendTo('#messageArea');
                            setTimeout(function(){ location.reload(); }, 1000);
                        } else {
                            alert('刪除失敗：' + result.message);
                        }
                    },
                    error: function() {
                        alert('刪除時發生錯誤');
                    }
                });
            }
        }

        // 表單提交時同步 IT_CODE，按鈕加上 Spin
        $('#cobForm').submit(function() {
            $('#IT_CODE').val($('#IT_CODE_INPUT').val());
            $('#btnSave').prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin me-1"></i>儲存中...');
        });

        // 自動關閉訊息
        setTimeout(function() {
            var alerts = document.querySelectorAll('.alert');
            alerts.forEach(function(el) {
                var bsAlert = bootstrap.Alert.getOrCreateInstance(el);
                bsAlert.close();
            });
        }, 5000);
    </script>
</body>
</html>
