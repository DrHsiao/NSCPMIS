    // 年度計畫別動態對應
    function GetPids(syr, callbackPid) {
    // 1. 先清空目前的選項
    $("#PID").html("<option value=''>請選擇</option>");

    // 2. 如果沒有選年度，就不發送請求
    if (!syr) return;

    // 3. 發送 AJAX 請求抓取當年度計畫
    $.ajax({
        url: '@Url.Content("~/TDE0040")/GetPidsBySyr', // 呼叫後端 API
        method: 'post',
        data: { "syr": syr },
        success: function (d) {
            var p = jQuery.parseJSON(d);
            for (var i = 0; i < p.length; i++) {
                var isSelected = (callbackPid && p[i].PID == callbackPid) ? " selected" : "";
                $("#PID").append("<option value='" + p[i].PID + "'" + isSelected + ">" + p[i].PJ_NAME + "</option>");
            }
            // 🎯 雙重門禁保禦：強制鎖定選取狀態
            if (callbackPid) {
                $("#PID").val(callbackPid);
            }
        },
        error: function () {
            alert("計畫資料載入失敗！");
        }
    });
    }
</script>