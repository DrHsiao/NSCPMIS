@using PagedList.Mvc
@model WCals.ViewModels.NewModels.TDE0040Model
@{
    ViewBag.Title = "估驗進度";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script type="text/javascript" src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <title>@ViewBag.Title</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="~/Scripts/modernizr-2.8.3.js"></script>
    <link href="https://code.jquery.com/ui/1.14.1/themes/base/jquery-ui.css" rel="stylesheet" />
    <style>
        html, body {
 height: 100%;
            margin: 0;
        padding: 0;
     }

  body {
            padding: 5px;
            box-sizing: border-box;
      display: flex;
      flex-direction: column;
        }

        #mainForm {
       flex: 1;
            display: flex;
            flex-direction: column;
      min-height: 0;
        }

        #mainForm > div {
       flex: 1;
   display: flex;
       flex-direction: column;
            min-height: 0;
        }

        .card.with-nav-tabs {
   flex: 1;
   display: flex;
         flex-direction: column;
        min-height: 0;
 margin-bottom: 0;
    }

        .card-header {
   flex-shrink: 0;
      }

     .card-body {
  flex: 1;
            display: flex;
            flex-direction: column;
  min-height: 0;
       overflow: hidden;
         padding: 0;
        }

        .tab-content {
 flex: 1;
      display: flex;
            flex-direction: column;
     min-height: 0;
        }

        .tab-pane {
    flex: 1;
        display: none;
      min-height: 0;
        }

        .tab-pane.active {
            display: flex;
            flex-direction: column;
        }

        .tab-pane iframe {
    flex: 1;
     width: 100%;
       border: 0;
         min-height: 0;
        }
    
        /* 頁籤顏色修正 */
        .card-header-tabs .nav-link:not(.active) {
            color: #ffffff !important;
            opacity: 0.85;
        }
        .card-header-tabs .nav-link:not(.active):hover {
            opacity: 1;
            color: #ffffff !important;
        }
        .card-header-tabs .nav-link.active {
            color: #337ab7 !important;
            font-weight: bold;
        }
</style>
    <link href="~/Content/bs3-compat.css" rel="stylesheet" />
</head>
<body>
    @using(Html.BeginForm("PAGE6_2", "TDE0040", FormMethod.Post, new { data_toggle = "validator", role = "form", id = "mainForm", enctype = "multipart/form-data" })) {

        @Html.AntiForgeryToken()

 <div>
     <div class="card shadow-sm border-0 mb-4 with-nav-tabs">
    <div class="card-header bg-primary text-white fw-bold">
        <ul class="nav nav-tabs card-header-tabs" role="tablist">
          <li id="li1" role="presentation"  class="nav-item"><button type="button" class="nav-link active" data-bs-target="#tab1"    aria-controls="tab1" role="tab"  data-bs-toggle="tab">表單內容</button></li>
   <li id="li2" role="presentation" onclick="$('#t2').attr('src', '@Url.Content("~/TDE0040/")PAGE6_2_2?TD_CODE=@Model.TD_CODE');" class="nav-item"><button type="button" class="nav-link" data-bs-target="#tab2"    aria-controls="tab2" role="tab"  data-bs-toggle="tab">附表 2</button></li>
       <li id="li3" role="presentation" onclick="$('#t3').attr('src','@Url.Content("~/TDE0040/")PAGE6_2_3?TD_CODE=@Model.TD_CODE');" class="nav-item"><button type="button" class="nav-link" data-bs-target="#tab3"    aria-controls="tab3" role="tab"  data-bs-toggle="tab">附表 3</button></li>
     </ul>
                </div>

              <div class="card-body">
      <div class="tab-content">
            <!-- Tab1 panes -->
                <div class="tab-pane fade show active" id="tab1">
        <iframe id="t1" src="PAGE6_2_1?TD_CODE=@Model.TD_CODE"></iframe>
       </div>
    <div class="tab-pane fade" id="tab2">
    <iframe id="t2" src=""></iframe>
          </div>
         <div class="tab-pane fade" id="tab3">
      <iframe id="t3" src=""></iframe>
 </div>
     </div>
                </div>
            </div>
     </div>

    }

 <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/ui/1.14.1/jquery-ui.min.js"></script>
    <script src="~/Scripts/validator.min.js"></script>
</body>
</html>
