@using PagedList.Mvc;
@model WCals.ViewModels.ManageViewModel

@{
    ViewBag.Title = "系統紀錄暨稽核統計查詢";
    Layout = "~/Views/Shared/_Layout2_v2.cshtml";
    var controllerName = this.ViewContext.RouteData.Values["controller"].ToString();
    ViewBag.CONTROLLER_NAME = controllerName;
    ViewBag.URL_SEQ_NO = controllerName.Substring(4);
}

<div class="row">
    <div class="col-lg-12">
        <h1 class="page-header">
            系統紀錄暨稽核統計查詢 [@ViewBag.URL_SEQ_NO]
            <small> 提供系統操作紀錄列表</small>
        </h1>
        <ol class="breadcrumb">
            <li>
                <i class="fa-solid fa-dashboard"></i><a href="@Url.Content("~/")Home"> 首頁</a>
            </li>
            <li class="active">
                <i class="fa-solid fa-file"></i>
                系統紀錄暨稽核統計查詢 [@ViewBag.URL_SEQ_NO]
            </li>
        </ol>
    </div>
</div>

@using (Html.BeginForm("Index", (string)ViewBag.CONTROLLER_NAME, FormMethod.Post))
{
    <div class="row">
        <div class="col-md-12">
            <div class="form-inline">
                <div class="form-group">
                    <label>紀錄等級：</label>
                    @Html.DropDownListFor(f => f.SearchParameter.ACTION_TYPE, (List<SelectListItem>)ViewBag.ACTION_TYPE, "請選擇", new { @class = "form-control" })
                </div>
                <div class="form-group">
                    <label>使用者代碼：</label>
                    @Html.EditorFor(f => f.SearchParameter.USR_ID, new { htmlAttributes = new { @class = "form-control", maxlength = "50" } })
                </div>
                <div class="form-group">
                    <label>登入IP：</label>
                    @Html.EditorFor(f => f.SearchParameter.LOGIN_IP, new { htmlAttributes = new { @class = "form-control", maxlength = "50" } })
                </div>
                <div class="form-group">
                    <label>登入日期(起)：</label>
                    @Html.EditorFor(f => f.SearchParameter.LOGIN_DT_START,
                       new { htmlAttributes = new {
                           @class = "form-control", id = "dateFrom"
                       } })
                </div>
                <div class="form-group">
                    <label>登入日期(迄)：</label>
                    @Html.EditorFor(f => f.SearchParameter.LOGIN_DT_END,
                       new { htmlAttributes = new {
                           @class = "form-control", id = "dateTo"
                       } })
                </div>
                <input type="submit" class="btn btn-primary" value="查詢" />
            </div>
        </div>
    </div>
}

<br />
<div class="row">
    <div class="col-md-12">
        <div class="table-responsive">
            <table class="table table-bordered table-striped table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>使用者ID</th>
                        <th>登入IP</th>
                        <th>系統操作</th>
                        <th>操作日期</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.SMCLOGSList)
                    {
                        <tr>
                            <td>@item.USR_ID</td>
                            <td>@item.LOGIN_IP</td>
                            <td>@item.ACTION_DESC</td>
                            <td>@item.LOGIN_DT</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @Html.PagedListPager(Model.SMCLOGSList, page => Url.Action("PagedIndex", new { page }))

    </div>
</div>

@section scripts
{
    <!-- Moment JavaScript -->
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.30.1/moment.min.js"></script>
    <!-- Bootstrap Datetime Picker JavaScript -->
    <link href="~/Content/glyphicons.css" rel="stylesheet" />
    <script type="text/javascript" src="~/Scripts/bootstrap-datetimepicker.min.js"></script>
    <script type="text/javascript">
        $(function () {
            $("#dateFrom").datetimepicker({
                locale: 'zh-tw',
                format: 'YYYY/MM/DD',
                useCurrent: false
            }).on("dp.change", function (e) {
                $('#dateTo').data("DateTimePicker").minDate(e.date);
            });

            $("#dateTo").datetimepicker({
                locale: 'zh-tw',
                format: 'YYYY/MM/DD',
                useCurrent: false
            }).on("dp.change", function (e) {
                $('#dateFrom').data("DateTimePicker").maxDate(e.date);
            });
        });

    </script>
}


