@model WCals.Models.CMETMSModels.PJCFORM
@{ Layout = null; }
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>系統資訊維護</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <style>
body { padding: 20px; font-size: 12px; }
        .form-horizontal .form-group { margin-bottom: 10px; }
            /* BS3 form-horizontal 相容 shim (BS5 移除 form-group 的 row 行為) */
        .form-horizontal .form-group{display:flex;flex-wrap:wrap;align-items:center;margin-bottom:1rem;}
        .form-horizontal .form-group>.col-form-label{text-align:right;}
</style>
</head>
<body>
    @using(Html.BeginForm("SaveSYSInfo", "SYS0030", FormMethod.Post, new { id = "mainForm", @class = "form-horizontal", enctype = "multipart/form-data" }))
    {
        @Html.HiddenFor(m => m.PJ_ID)

  if(!string.IsNullOrEmpty(ViewBag.Message as string))
        {
       <div class="alert alert-info"><strong>@ViewBag.Message</strong></div>
        }

     <!-- 基本資料 (省略其他欄位，保持與原本相同) -->
        <div class="card shadow-sm border-0 mb-4 h-100">
            <div class="card-header bg-primary text-white fw-bold">基本資料</div>
 <div class="card-body">
<div class="form-group">
          <label class="col-sm-2 col-form-label">計畫名稱</label>
   <div class="col-sm-10">
          @Html.TextBoxFor(m => m.PJ_NAME, new { @class = "form-control" })
         </div>
     </div>
         </div>
        </div>

        <!-- 檔案上傳區塊 -->
    <div class="card shadow-sm border-0 mb-4 h-100">
     <div class="card-header bg-primary text-white fw-bold">附件上傳</div>
     <div class="card-body">
  <div class="form-group">
            <div class="col-sm-12">
 <input type="file" name="files" multiple class="form-control" style="height: auto;" />
          <small class="text-muted">可同時選擇多個檔案上傳（單檔上限 100MB）</small>
  </div>
        </div>

          <div class="form-group">
               <div class="col-sm-12">
         <h4>已上傳檔案</h4>
      <table class="table table-hover">
             <thead>
         <tr>
               <th style="width:50%;">檔案名稱</th>
  <th style="width:15%;">大小(KB)</th>
    <th style="width:20%;">上傳日期</th>
     <th style="width:15%;">操作</th>
</tr>
         </thead>
             <tbody>
   @{
     var db = new WCals.Models.CMETMSModels.CMETMSEntities();
     var files = db.PJCFILE.Where(x => x.PJ_ID == Model.PJ_ID).OrderByDescending(x => x.ADD_DT).ToList();
               if(files.Count == 0)
  {
   <tr><td colspan="4" class="text-center">尚無上傳檔案</td></tr>
     }
               else
    {
              foreach(var file in files)
         {
      <tr>
        <td>@file.FILE_NAME</td>
  <td class="text-right">@(file.FILE_SIZE.HasValue ? file.FILE_SIZE.Value.ToString("N2") : "0")</td>
        <td>@(file.ADD_DT.HasValue ? file.ADD_DT.Value.ToString("yyyy/MM/dd HH:mm") : "")</td>
      <td>
   <a href="@Url.Action("DownloadFile", "SYS0030", new { fileId = file.FILE_ID })" class="btn btn-sm btn-info">下載</a>
           <button type="button" class="btn btn-sm btn-danger" onclick="return DeleteFile(@file.FILE_ID);">刪除</button>
         </td>
 </tr>
          }
              }
    }
      </tbody>
     </table>
  </div>
   </div>
     </div>
        </div>

        <!-- 按鈕 -->
        <div class="form-group">
      <div class="col-sm-offset-2 col-sm-10">
                @if(!string.IsNullOrEmpty(Model.PJ_ID))
             {
      <button type="button" onclick="return DeleteRecord();" class="btn btn-danger">刪除</button>
       }
      <button type="submit" class="btn btn-primary">確定儲存</button>
           <button type="button" onclick="CloseDialog();" class="btn btn-secondary">關閉</button>
            </div>
      </div>
    }

    <script>
        function DeleteRecord() {
     if (confirm('確定要刪除本計畫?')) {
            var pjId = document.getElementById('PJ_ID').value;
  if (pjId) {
    $.ajax({
             type: 'POST',
                  url: '@Url.Action("DeleteSYSInfo", "SYS0030")',
  data: { pjId: pjId },
  dataType: 'json',
    success: function (result) {
           if (result.success) {
  alert(result.message);
   window.parent.location.reload();
         } else {
        alert(result.message);
 }
  },
            error: function () {
      alert('刪除失敗，請稍後重試');
          }
    });
    }
                return false;
      }
return false;
        }

        function DeleteFile(fileId) {
     if (confirm('確定要刪除此檔案嗎？')) {
        $.ajax({
             type: 'POST',
         url: '@Url.Action("DeleteFile", "SYS0030")',
    data: { fileId: fileId },
     dataType: 'json',
        success: function (result) {
         if (result.success) {
             alert(result.message);
              window.location.reload();
                } else {
    alert('刪除失敗：' + result.message);
   }
              },
    error: function () {
    alert('刪除失敗，請稍後重試');
       }
         });
            }
            return false;
        }

    function CloseDialog() {
  window.parent.location.reload();
        }
    </script>
</body>
</html>
