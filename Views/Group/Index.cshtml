@model IEnumerable<WCals.Models.CMBASEModels.OGCDEPT>

@{
    ViewBag.Title = "群組管理";
    Layout = "~/Views/Shared/_Layout2_v2.cshtml";
}

<div class="model-form">
    <br />
    <div style="display: flex; align-items: center;">
        <h2 style="margin: 0;">群組資訊　</h2>
        <a href="@Url.Action("Create", "Group")" class="btn btn-primary">新增</a>
    </div>
    <br />

    <div class="table-responsiv" style="text-align:left;width:45%">
        <table class="table table-hover">
            <tr style="background-color:deepskyblue">
                <th>
                </th>
                <th>
                    群組編號
                </th>
                <th>
                    群組名稱
                </th>
            </tr>

            @foreach (var item in Model)
            {
                <tr>
                    <td style="vertical-align: middle">
                        @Html.ActionLink("選取", "choose", new { id = item.DEPT_NO }, new { @class = "btn btn-secondary" })
                    </td>
                    <td style="vertical-align: middle">
                        @item.DEPT_NO
                    </td>
                    <td style="vertical-align: middle">
                        @item.DEPT_NAME
                    </td>
                </tr>
            }
        </table>
    </div>
</div>