    <!-- 引用延續性工程 Dialog -->
    <div id="refDialog" title="選擇延續性工程" style="display:none;">
        <div style="margin-bottom:8px;">
            <input type="text" id="refSearchInput" class="form-control" placeholder="輸入關鍵字過濾..." onkeyup="filterRefList()" />
        </div>
        <select id="refProjectSelect" class="form-select" size="12" style="width:100%;" ondblclick="confirmRefSelection()">
        </select>
    </div>

    <script>
        var currentRefAid = null;
        var currentRefExtfg = null;

        function openRefDialog(aid, extfg) {
            currentRefAid = aid;
            currentRefExtfg = extfg;
            var city = $("#CITY_" + aid + " option:selected").text();

            if (!city || city === "縣市") {
                alert("請先選擇縣市");
                return;
            }

            $.ajax({
                url: '@Url.Content("~/")PJE0030/GetContinuingProjects',
                method: 'post',
                data: { city: city },
                success: function (d) {
                    var data = jQuery.parseJSON(d);
                    var select = $("#refProjectSelect");
                    select.empty();
                    $("#refSearchInput").val("");

                    if (data.length === 0) {
                        select.append("<option value=''>無符合資料</option>");
                    } else {
                        for (var i = 0; i < data.length; i++) {
                            select.append("<option value='" + data[i].TD_CODE + "' title='" + data[i].TD_CODE + " " + data[i].AP_NAME + "'>" + data[i].TD_CODE + " " + data[i].AP_NAME /*+ "[" + data[i].CITY + data[i].TOWN + "]"*/ + "</option>");
                        }
                    }

                    $("#refDialog").dialog({
                        modal: true,
                        width: 650,
                        title: "選擇延續性工程 - " + city,
                        buttons: {
                            "確認": function () { confirmRefSelection(); },
                            "取消": function () { $(this).dialog("close"); }
                        },
                        close: function () {
                            currentRefAid = null;
                            currentRefExtfg = null;
                        }
                    });
                }
            });
        }

        function confirmRefSelection() {
            var aid = currentRefAid;
            var extfg = currentRefExtfg;
            if (!aid) return;

            var selected = $("#refProjectSelect").val();
            if (!selected || selected === "" || selected === "無符合資料") {
                alert("請選擇一筆工程");
                return;
            }

            loadRefProject(aid, extfg, selected);
        }

        function loadRefProject(aid, extfg, tdcode) {
            $.ajax({
                url: '@Url.Content("~/")PJE0030/RefSelectOne',
                method: 'post',
                data: {
                    "tdcode": tdcode
                },
                success: function (d) {
                    var p = jQuery.parseJSON(d);
                    if (!p || p.length === 0) {
                        alert("查無此工程資料");
                        return;
                    }

                    // 判斷工程名稱是否不同
                    var oldName = $("#TD_NAME_" + aid).val();
                    var newName = p[0].TD_NAME;
                    var overwriteName = true;
                    if (oldName && oldName.trim() !== "" && oldName.trim() !== newName.trim()) {
                        overwriteName = confirm("原有的工程名稱\n" + oldName + "\n\n引用的工程名稱\n" + newName + "\n\n不同，是否覆蓋名稱？");
                    }

                    // 填入工程名稱
                    if (overwriteName) {
                        $("#TD_NAME_" + aid).val(newName);
                    }

                    // 工程編號 (去除 -)
                    var code = p[0].TD_CODE ? p[0].TD_CODE.replace("-", "") : tdcode;
                    $("#TD_CODE_" + aid).val(code);
                    $("#TD_CODE_" + aid).data("refSet", true); // 標記為引用設定

                    // 案件類型
                    if (p[0].CATY_CODE) {
                        $("#CATY_CODE_P_" + aid).val(p[0].CATY_CODE);
                    }

                    // 辦理層級
                    if (p[0].IPJ_CODE) {
                        $("#IPJ_CODE_" + aid).val(p[0].IPJ_CODE);
                    }

                    // 工程類別
                    if (p[0].TD_CATY) {
                        $("#TD_CATY_" + aid).val(p[0].TD_CATY);
                    }

                    // 工作類別
                    if (p[0].YR_WORK) {
                        $("#YR_WORK_" + aid).val(p[0].YR_WORK);
                    }

                    // 費用別、序碼
                    SetNo(code, aid);

                    // 縣市鄉鎮
                    selectCityTown(p, aid);

                    $("#refDialog").dialog("close");
                },
                error: function () {
                    alert("查詢工程資料失敗");
                }
            });
        }

        function filterRefList() {
            var keyword = $("#refSearchInput").val().toLowerCase();
            $("#refProjectSelect option").each(function () {
                var text = $(this).text().toLowerCase();
                $(this).toggle(text.indexOf(keyword) > -1);
            });
        }

        function SetNo(code, aid) {
            let lastPart = "";

            if (code.length === 19 || code.length === 20) {
                lastPart = code.substring(15);
            } else if (code.length === 11 || code.length === 14) {
                lastPart = code.substring(9);
            }

            let part1 = "";
            let part2 = "";
            let part3 = "";

            if (lastPart.length === 5) {
                part1 = lastPart.substring(0, 1);
                part2 = lastPart.substring(1, 3);
                part3 = lastPart.substring(3, 5);
            } else if (lastPart.length === 4) {
                part1 = lastPart.substring(0, 1);
                part2 = lastPart.substring(1, 3);
                part3 = lastPart.substring(3, 4);
            } else if (lastPart.length === 2) {
                part1 = lastPart.substring(0, 1);
                part2 = lastPart.substring(1, 2);
            }
            $("#F_TYPE_" + aid).val(part1);
            $("#S1_" + aid).val(part2);
            $("#S2_" + aid).val(part3);
        }

        function selectCityTown(p, aid) {
            var target_city = $('#CITY_' + aid);
            var target_town = $('#TOWN_' + aid);

            // 先清空
            target_city.val('');
            target_town.val('');

            if (!p[0].TD_CITY || !p[0].TD_CITY.trim()) return;

            // 選 CITY
            var city_option = target_city.find('option').filter(function () {
                return $(this).text().trim() === p[0].TD_CITY.trim();
            });

            if (city_option.length === 0) return;

            city_option.prop('selected', true);
            target_city.change();

            // 選 TOWN
            if (p[0].TD_TOWN && p[0].TD_TOWN.trim()) {
                setTimeout(function () {
                    var town_option = target_town.find('option').filter(function () {
                        return $(this).text().trim() === p[0].TD_TOWN.trim();
                    });
                    if (town_option.length > 0) {
                        town_option.prop('selected', true);
                        target_town.change();
                    } else {
                        target_town.val('');
                    }
                }, 200);
            }
        }

    </script>

