            <script>
                // 4. 全選/取消全選邏輯
                function toggleAll(source) {
                    checkboxes = document.getElementsByClassName('row-checkbox');
                    for (var i = 0, n = checkboxes.length; i < n; i++) {
                        checkboxes[i].checked = source.checked;
                    }
                }

                // 5. 批次匯入邏輯 (使用 async/await)
                async function batchSave() {
                    var checkboxes = document.querySelectorAll('.row-checkbox:checked');
                    if (checkboxes.length === 0) {
                        alert("請先勾選要匯入的資料！");
                        return;
                    }

                    if (!confirm("確定要匯入這 " + checkboxes.length + " 筆資料嗎？")) {
                        return;
                    }

                    document.getElementById('block').style.display = 'block';

                    let successCount = 0;
                    let failCount = 0;

                    for (let i = 0; i < checkboxes.length; i++) {
                        var aid = checkboxes[i].value;
                        var extfg = checkboxes[i].getAttribute('data-extfg');

                        try {
                            // 呼叫改造為 Promise 的 save 函式
                            let result = await saveAsync(aid, extfg, true);
                            if (result) successCount++;
                            else failCount++;
                        } catch (e) {
                            console.error("處理 AID: " + aid + " 時發生錯誤", e);
                            failCount++;
                        }
                    }

                    document.getElementById('block').style.display = 'none';
                    alert("批次匯入完成！\n成功: " + successCount + " 筆\n失敗: " + failCount + " 筆");
                }

                function save(aid, extfg) {
                    saveAsync(aid, extfg, false);
                }

