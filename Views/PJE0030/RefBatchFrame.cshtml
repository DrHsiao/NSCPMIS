                // 將原本的 save 邏輯封裝成回傳 Promise 的版本
                // isBatch 參數用來判斷是否為批次執行，如果是批次，遇到錯誤時用 console.log 記錄，避免彈出過多 alert
                function saveAsync(aid, extfg, isBatch) {
                    return new Promise((resolve, reject) => {
                        // 驗證邏輯
                        if ($("#TD_CODE_" + aid).val() == "") {
                            if(!isBatch) alert("工程編號不可空白"); else console.log("AID:" + aid + " 工程編號不可空白");
                            resolve(false); return;
                        }
                        if ($("#TD_CATY_" + aid).val() == "") {
                            if(!isBatch) alert("工程類別不可空白"); else console.log("AID:" + aid + " 工程類別不可空白");
                            resolve(false); return;
                        }
                        if ($("#YR_WORK_" + aid).val() == "") {
                            if(!isBatch) alert("工作類別不可空白"); else console.log("AID:" + aid + " 工作類別不可空白");
                            resolve(false); return;
                        }
                        if ($("#PJ_CATY_CODE_P_" + aid).val() == "") {
                            if(!isBatch) alert("分項計畫不可空白"); else console.log("AID:" + aid + " 分項計畫不可空白");
                            resolve(false); return;
                        }
                        if ($("#CATY_CODE_P_" + aid).val() == "") {
                            if(!isBatch) alert("案件類型不可空白，新增失敗"); else console.log("AID:" + aid + " 案件類型不可空白");
                            resolve(false); return;
                        }

                        var selectedText = $("#CITY_" + aid + " option:selected").text();
                        var selectedTown = $("#TOWN_" + aid + " option:selected").text();

                        var req = {
                            "EXT_FG": extfg,
                            "TD_CODE": $("#TD_CODE_" + aid).val(),
                            "FD_CODE": $("#FD_CODE_" + aid).val(),
                            "CATY_CODE": $("#CATY_CODE_P_" + aid).val(),
                            "AID": aid,
                            "PID": '@Model.PID',
                            "TID": '@Model.TID',
                            "TD_NAME": $("#TD_NAME_" + aid).val(),
                            "PJ_CATY_CODE": $("#PJ_CATY_CODE_P_" + aid).val(),
                            "TD_CATY": $("#TD_CATY_" + aid).val(),
                            "IPJ_CODE": $("#IPJ_CODE_" + aid).val(),
                            "CITY": selectedText,
                            "TOWN": selectedTown,
                            "YR_WORK": $("#YR_WORK_" + aid).val(),
                            "F00": $("#F00_" + aid).val().replace(/,/g, ''),
                            "F11": $("#F11_" + aid).val().replace(/,/g, ''),
                            "SYR": "@Model.SYR",
                            "YEAR": "@Model.SYR",
                            "ADV_DP": $("#ADV_DP_" + aid).val(),
                            "ADV_UID": $("#ADV_UID_" + aid).val()
                        }

                        $.ajax({
                            url: '@Url.Content("~/")PJE0030/RefBatchAddOne',
                            method: 'post',
                            data: { "data": JSON.stringify(req) },
                            success: function (d) {
                                if (d.id == undefined) {
                                    if(!isBatch) alert(d.msg);
                                    else console.log("AID:" + aid + " 失敗:" + d.msg);
                                    resolve(false);
                                } else {
                                    if(!isBatch) alert("已新增(" + d.id + "):" + $("#TD_CODE_" + aid).val());
                                    $('#tr_' + aid).hide('slow');
                                    resolve(true);
                                }
                            },
                            error: function(err) {
                                if(!isBatch) alert("發生錯誤");
                                console.error(err);
                                reject(err);
                            }
                        });
                    });
                }
            </script>





        }




