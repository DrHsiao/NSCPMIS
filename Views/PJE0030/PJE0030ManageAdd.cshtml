                        <script>
    function refs(id) {
        $('#REF_STAT').val('1');
        $.ajax({
            url: '@Url.Content("~/")PJE0030/RefSelectOne',
            method: 'post',
            data: { "tdcode": id },
            success: function (d) {
                var p = jQuery.parseJSON(d);
                $("#UCNT_FG").attr("checked", false);
                $("#B_GROUP").attr("checked", false);
                $("#F_GROUP").attr("checked", false);
                $("#TD_GROUP").attr("checked", false);
                $("#EXE_TYPE").attr("checked", false);

                if (p[0].UCNT_FG == true) {
                    $("#UCNT_FG").attr("checked", true);
                }
                if (p[0].B_GROUP == true) {
                    $("#B_GROUP").attr("checked", true);
                }
                if (p[0].F_GROUP == true) {
                    $("#F_GROUP").attr("checked", true);
                }
                if (p[0].TD_GROUP == true) {
                    $("#TD_GROUP").attr("checked", true);
                }
                if (p[0].EXE_TYPE == true) {
                    $("#EXE_TYPE").attr("checked", true);
                }
                //alert(p[0].TD_NAME);
                $("#TD_NAME").val(p[0].TD_NAME);
                $("#FD_CODE").val(p[0].SIP_TD_CODE);
                $("#TD_CODE").val(p[0].TD_CODE.replace("-", ""));

                $("#TD_CATY").val(p[0].TD_CATY);


                $("#CATY_CODE").val(p[0].CATY_CODE);
                $("#IPJ_CODE").val(p[0].IPJ_CODE);


                $("#YR_WORK").val(p[0].CATY_CODE);
                $("#EMG_CATY").val(p[0].EMG_CATY);
                $("#ADV_DP").val(p[0].ADV_DP).change();


                setTimeout(function () {
                    $("#ADV_UID").val(p[0].ADV_UID).change();
                    //$("#codgen").hide("slow");
                    $("#mainForm").validator("validate");
                }, 1000);

                selectCityTown(p);
                SetNo(p);
                SetCode(p);
            }
        });

    }
    function refsel() {
        window.parent.refsel();
    }


                            function selectCityTown(p) {
                                // 先清空
                                $('#CITY, #TOWN').val('').removeClass('select-readonly');

                                if (!p[0].TD_CITY || !p[0].TD_CITY.trim()) return; // CITY 沒值就直接返回

                                // 選 CITY
                                var city_option = $('#CITY option').filter(function () {
                                    return $(this).text().trim() === p[0].TD_CITY.trim();
                                });

                                if (city_option.length === 0) return; // 找不到對應 CITY 就返回

                                city_option.prop('selected', true);
                                $('#CITY').addClass('select-readonly').change();

                                // 選 TOWN（延遲等待選項生成）
                                if (p[0].TD_TOWN && p[0].TD_TOWN.trim()) {
                                    setTimeout(function () {
                                        var town_option = $('#TOWN option').filter(function () {
                                            return $(this).text().trim() === p[0].TD_TOWN.trim();
                                        });
                                        if (town_option.length > 0) {
                                            town_option.prop('selected', true);
                                            $('#TOWN').addClass('select-readonly').change();
                                        } else {
                                            $('#TOWN').val('').removeClass('select-readonly');
                                        }
                                    }, 200);
                                }
                            }

                            function SetNo(p) {
                                let code = p[0].TD_CODE;

                                let lastPart = "";

                                if (code.length === 19 || code.length === 20) {
                                    lastPart = code.substring(15);
                                } else if (code.length === 11 || code.length === 14) {
                                    lastPart = code.substring(9);
                                }

                                let part1 = "";
                                let part2 = "";
                                let part3 = "";

                                if (lastPart.length === 5) {
                                    part1 = lastPart.substring(0, 1);
                                    part2 = lastPart.substring(1, 3);
                                    part3 = lastPart.substring(3, 5);
                                } else if (lastPart.length === 4) {
                                    part1 = lastPart.substring(0, 1);
                                    part2 = lastPart.substring(1, 3);
                                    part3 = lastPart.substring(3, 4);
                                } else if (lastPart.length === 2) {
                                    part1 = lastPart.substring(0, 1);
                                    part2 = lastPart.substring(1, 2);
                                }
                                $("#NO7").val(part1);
                                $("#NO8").val(part2);
                                $("#NO9").val(part3);
                            }

                            function SetCode(p) {
                                if (p[0].TD_CODE.replace("-", "") === '') {
                                    $('#TD_CODE').prop('readonly', false);
                                } else {
                                    $('#TD_CODE').prop('readonly', true);
                                }
                            }
                        </script>


