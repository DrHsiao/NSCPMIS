        $("#TOWN").html("");
            $.ajax({
                url: '@Url.Content("~/")ASYNC/GetTownsById',
                method: 'post',
                data: { "city": city },
                success: function (d) {
                    var p = jQuery.parseJSON(d);
                    $("#TOWN").prepend("<option value=''>鄉鎮</option>");
                    for (i = 0; i < p.length; i++) {
                        $("#TOWN").append("<option value='" + p[i].TOWN_ID + "'>" + p[i].TOWN + "</option>");
