@using PagedList.Mvc
@model WCals.ViewModels.NewModels.PJE0030Model
@{ ViewBag.Title = "計畫經費管制[1.1.3]";
    Layout = "~/Views/Shared/_Layout2_v2.cshtml";
}

<div class="row">
    <div class="col-lg-12">
        <h1 class="h2 border-bottom pb-2 mb-3">
            <span class="fa-solid fa-link" aria-hidden="true"></span> 計畫經費管制[1.1.3]
            <small></small>
        </h1>
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <i class="fa-solid fa-dashboard"></i><a href="@Url.Content("~/")Home"> 首頁</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                <i class="fa-solid fa-file"></i>
                計畫經費管制[1.1.3]
            </li>
        </ol>
    </div>
</div>


@using(Html.BeginForm("", "PJE0030", FormMethod.Post, new { id = "mainForm" })) {

    <input type="hidden" name="PID" id="PID" value="@Model.PID" />
    <input type="hidden" name="SYR" id="SYR" value="@Model.SYR" />
    <input type="hidden" name="prePage" value="@Model.prePage" />

    <table >
        <tr>
            <td style="padding:5px;">
                <select name="stype" class="form-select">

                    <option @(Model.stype == "PJ_NAME" ? "selected" : "") value="PJ_NAME">分支計畫名稱</option>
                    <option @(Model.stype == "PJ_CODE" ? "selected" : "") value="PJ_CODE">分支計畫編號</option>
                    <option @(Model.stype == "SYR" ? "selected" : "") value="SYR">年度</option>
                </select>

            </td>
            <td style="padding:5px;"><input type="text" name="keyword" value="@Model.keyword" class="form-control" /></td>
            <td style="padding:5px;"><button class="btn btn-primary" name="action" type="submit" value="SearchIndex">查詢</button></td>
        </tr>
    </table>
    
    

    <div class="card border-primary mb-3">
        <div class="card-header bg-primary text-white">計畫列表</div>
        <div class="card-body responsive-table-container">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>年度</th>
                        <th>年度計畫</th>
                        <th>分支計畫編號</th>

                        <th>分支計畫名稱</th>
                        <th>分支計畫經費(元)</th>
                        <th>修正期別</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var c in Model.MainList) {
                        <tr>

                            <td>@c["SYR"]</td>
                            <td>@c["WPJ_NAME"]</td>
                            <td>@c["PJ_CODE"]</td>


                            <td>@c["BPJ_NAME"]</td>
                            <td align="right">@((Convert.ToDecimal(c["PJ_FUND"])).ToString("N0"))</td>

                            @if(Convert.ToString(@c["SEQ_NAME"]).Equals("第0期修正")) {
                                <td>原預算</td>
                            } else {
                                <td>@c["SEQ_NAME"]</td>
                            }

                            <td>

                                <button class="btn btn-primary" name="action" type="submit" value="Maintain" onclick="$('#PID').val('@c["PID"]');">維護</button>
                                <button class="btn btn-primary" name="action" type="submit" value="Manage" onClick="$('#PID').val('@c["PID"]');$('#SYR').val('@c["SYR"]')">案件管制</button>
                                <button class="btn btn-primary" name="action" type="submit" value="BudgetCount" onclick="$('#PID').val('@c["PID"]');">預算統計</button>
                                <button class="btn btn-primary" name="action" type="submit" value="BudgetEdit" onclick="$('#PID').val('@c["PID"]');">預算調整</button>

                            </td>
                        </tr>

                    }
                </tbody>
            </table>
        </div>
    </div>






    @Html.PagedListPager(Model.MainList, prePage => Url.Action("Index", "PJE0030",
    new { prePage = prePage, stype = Model.stype, keyword = Model.keyword }))


}

<script>
    $(window).on('load', function () {
        $('#PID').val("");
    });

    function delCheck(pid) {


        if (confirm('確定刪除?')) {
            $('#PID').val(pid);
        } else {
            void ('')
        }

    }
</script>
