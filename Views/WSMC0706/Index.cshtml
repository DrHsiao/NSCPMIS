@model WCals.ViewModels.AnnounceListViewModel
@using WCals.Helpers
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout2_v2.cshtml";
    var controllerName = this.ViewContext.RouteData.Values["controller"].ToString();
    ViewBag.CONTROLLER_NAME = controllerName;
    ViewBag.URL_SEQ_NO = controllerName.Substring(4);
}

@using (Html.BeginForm("Index", (string)ViewBag.CONTROLLER_NAME, FormMethod.Post))
{
    <div class="row">
        <div class="col-lg-12">
            <h1 class="page-header">
                公告列表 [@ViewBag.URL_SEQ_NO]
                <small> 提供公告資料列表</small>
            </h1>
            <ol class="breadcrumb">
                <li>
                    <i class="fa-solid fa-dashboard"></i><a href="/Home"> 首頁</a>
                </li>
                <li class="active">
                    <i class="fa-solid fa-file"></i>
                    公告列表 [@ViewBag.URL_SEQ_NO]
                </li>
            </ol>
        </div>
    </div>

    <div class="col-md-12">
        <div class="form-inline">
            <div class="form-group">
                <label>主旨：</label>
                @Html.EditorFor(f => f.SearchParameter.SUBJECT, new { htmlAttributes = new { @class = "form-control", maxlength = "50" } })
            </div>
            <div class="form-group">
                <label>內容：</label>
                @Html.EditorFor(f => f.SearchParameter.CONTENT, new { htmlAttributes = new { @class = "form-control", maxlength = "100" } })
            </div>
            <div class="form-group">
                <label>公告日期(起)：</label>
                @Html.EditorFor(f => f.SearchParameter.POST_DT_START,
                   new
                        {
                            htmlAttributes = new
                            {
                       @class = "form-control",
                                id = "dateFrom"
                   }
                        })
            </div>
            <div class="form-group">
                <label>公告日期(迄)：</label>
                @Html.EditorFor(f => f.SearchParameter.POST_DT_END,
                   new
                        {
                            htmlAttributes = new
                            {
                       @class = "form-control",
                                id = "dateTo"
                   }
                        })
            </div>
            <input type="submit" class="btn btn-primary" value="查詢" />
        </div>
    </div>
    <br />
    <br />
    <div class="row">
        <div class="col-md-12">
            @Html.ActionLink("新增公告", "New", null, new { @class = "btn btn-primary" })
        </div>
    </div>
    <br />
    <div class="row">
        <div class="col-md-12">
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>公告編號</th>
                            <th>公告主旨</th>
                            <th>公告日期</th>
                            <th>公告人員</th>
                            <th>開始日期</th>
                            <th>結束日期</th>
                            <th>#</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.SMCNEWS)
                        {
                            <tr>
                                <td>@item.DID</td>
                                <td>@item.SUBJECT</td>
                                <td>@(null == item.POST_DT ? "" : item.POST_DT.Value.ToString("yyyy-MM-dd"))</td>
                                <td>@WebSiteHelper.getUserName(item.ADV_UID)</td>
                                <td>@(null == item.START_DT ? "" : item.START_DT.Value.ToString("yyyy-MM-dd"))</td>
                                <td>@(null == item.END_DT ? "" : item.END_DT.Value.ToString("yyyy-MM-dd"))</td>
                                <td>
                                    <div class="form-inline">
                                        <div class="form-group">
                                            @Html.ActionLink("內容", "Edit", new { id = item.DID }, new { @class = "btn btn-secondary" })
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@section scripts
{
    <!-- Moment JavaScript -->
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.30.1/moment.min.js"></script>
    <!-- Bootstrap Datetime Picker JavaScript -->
    <link href="~/Content/glyphicons.css" rel="stylesheet" />
    <script type="text/javascript" src="~/Scripts/bootstrap-datetimepicker.min.js"></script>
    @*<script type="text/javascript" src="~/Scripts/bootstrap-datetimepicker.js"></script>*@
    <script type="text/javascript">
        $(function () {
            $("#dateFrom").datetimepicker({
                format: 'YYYY/MM/DD',
                useCurrent: false
            }).on("dp.change", function (e) {
                $('#dateTo').data("DateTimePicker").minDate(e.date);
            });

            $("#dateTo").datetimepicker({
                format: 'YYYY/MM/DD',
                useCurrent: false
            }).on("dp.change", function (e) {
                $('#dateFrom').data("DateTimePicker").maxDate(e.date);
            });
        });

    </script>
}

