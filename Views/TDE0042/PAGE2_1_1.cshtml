@model WCals.ViewModels.NewModels.TDE0040Model
@{
    Layout = null;
    var list1 = ViewBag.List1 as System.Data.DataTable;
    var seqNoList = ViewBag.SEQ_NO_List as SelectList;
    var maxSeqNo = ViewBag.MaxSeqNo != null ? ViewBag.MaxSeqNo.ToString() : "";
    var currentSeqNo = ViewBag.CurrentSeqNo != null ? ViewBag.CurrentSeqNo.ToString() : "";
    var isLatestSeq = ViewBag.IsLatestSeq != null ? (bool)ViewBag.IsLatestSeq : true;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script type="text/javascript" src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <title>計畫經費管理</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
html, body { height: 100%; margin: 0; padding: 0; }
      body { padding: 10px; box-sizing: border-box; font-size: 14px; }
        .form-group { margin-bottom: 15px; }
        .form-inline { display: flex; align-items: center; gap: 10px; }
        .table-responsive { margin-top: 10px; }
        .table th { background-color: #4472C4; color: white; text-align: center; vertical-align: middle; }
        .table td { text-align: center; vertical-align: middle; }
        .table td.text-left { text-align: left; }
        .btn-sm { padding: 2px 8px; font-size: 12px; }
  .locked { color: red; font-weight: bold; }
        .unlocked { color: green; }
        .seq-info { margin-left: 15px; font-size: 12px; color: #666; }
        .seq-latest { color: green; font-weight: bold; }
   .seq-history { color: orange; font-weight: bold; }
    
        /* 表格框線與排版美化 */
        .table-bordered { border: 0 !important; }
        .table-bordered th, .table-bordered td { border: 0 !important; border-bottom: 1px solid #e2e8f0 !important; }
        .table > thead > tr > th { 
            border-bottom: 2px solid #337ab7 !important; 
            background-color: #f8fafc; 
            color: #334155; 
        }
        .table > tbody > tr:last-child > td { border-bottom: 0 !important; }
</style>
</head>
<body>
    <div class="form-group">
        <div class="form-inline">
         <label for="SEQ_NO"><strong>選擇期別：</strong></label>
      @if (seqNoList != null)
      {
      @Html.DropDownList("SEQ_NO", seqNoList, new { @class = "form-control", id = "SEQ_NO", style = "width:200px;" })
      }
            <button type="button" class="btn btn-primary" onclick="queryBySeqNo()">查詢</button>
   <span class="seq-info">
        @if (isLatestSeq)
       {
    <span class="seq-latest">【最新期】</span>
       }
       else
{
       <span class="seq-history">【歷史資料】</span>
      }
    </span>
</div>
 </div>

    <input type="hidden" id="hidPID" value="@ViewBag.PID" />
    <input type="hidden" id="hidTD_CODE" value="@ViewBag.TD_CODE" />
    <input type="hidden" id="hidMaxSeqNo" value="@maxSeqNo" />
    <input type="hidden" id="hidCurrentSeqNo" value="@currentSeqNo" />

    <!-- 計畫經費列表 -->
    <div class="table-responsive">
        <table class="table table-striped table-hover">
         <thead>
     <tr>
     <th style="width:60px;">年度</th>
  <th>計畫名稱</th>
 <th style="width:80px;">經費已鎖</th>
           <th>計畫承辦單位</th>
<th style="width:100px;">預算期別</th>
       <th style="width:120px;">年度預算金額(元)</th>
            <th style="width:120px;">中央款金額(元)</th>
          <th style="width:80px;">預算分配</th>
      <th style="width:100px;">中央款月分配數</th>
             </tr>
            </thead>
            <tbody>
                @if (list1 != null && list1.Rows.Count > 0)
     {
         foreach (System.Data.DataRow row in list1.Rows)
            {
           var pid = row["PID"] != null ? row["PID"].ToString() : "";
            var tid = row["TID"] != null ? row["TID"].ToString() : "";
         var tdCode = row["TD_CODE"] != null ? row["TD_CODE"].ToString() : "";
    var syr = row["SYR"] != null ? row["SYR"].ToString() : "";
          var pjName = row["PJ_NAME"] != null ? row["PJ_NAME"].ToString() : "";
  var flockFg = row["FLOCK_FG"] != null ? row["FLOCK_FG"].ToString() : "0";
      var advDpName = row["ADV_DP_NAME"] != null ? row["ADV_DP_NAME"].ToString() : "";
     var seqName = row["SEQ_NAME"] != null ? row["SEQ_NAME"].ToString() : "";
   var yrFund = row["YR_FUND"] != DBNull.Value ? Convert.ToDecimal(row["YR_FUND"]).ToString("N0") : "";
       var cenFund = row["CEN_FUND"] != DBNull.Value ? Convert.ToDecimal(row["CEN_FUND"]).ToString("N0") : "";
          var isLocked = flockFg == "1";
      <tr>
<td>@syr</td>
    <td class="text-left">@pjName</td>
      <td>
             @if (isLocked)
         {
              <span class="locked">是</span>
      }
  else
          {
<span class="unlocked">否</span>
        }
    </td>
 <td>@advDpName</td>
             <td>@seqName</td>
<td style="text-align:right;">@yrFund</td>
  <td style="text-align:right;">@cenFund</td>
      <td>
      <button type="button" class="btn btn-primary btn-sm"
            onclick="openBudgetAllocation('@pid', '@tid', '@tdCode')"
           @(isLocked || !isLatestSeq ? "disabled" : "")>
                  預算分配
     </button>
                </td>
       <td>
          <button type="button" class="btn btn-info btn-sm"
        onclick="openCenFundAllocation('@pid', '@tid', '@tdCode')"
              @(isLocked || !isLatestSeq ? "disabled" : "")>
        月分配數
  </button>
     </td>
</tr>
    }
          }
            else
                {
              <tr>
                 <td colspan="9" class="text-center">無資料</td>
          </tr>
        }
     </tbody>
        </table>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
     var PID = '@ViewBag.PID';
    var TD_CODE = '@ViewBag.TD_CODE';
        var maxSeqNo = '@maxSeqNo';
        var currentSeqNo = '@currentSeqNo';

     // 查詢按鈕點擊事件
function queryBySeqNo() {
      var seqNo = $('#SEQ_NO').val();
   if (seqNo && seqNo !== '') {
                // 重新載入頁面並帶入 SEQ_NO 參數
      var url = '@Url.Action("PAGE2_1_1", "TDE0042")';
                url += '?TD_CODE=' + encodeURIComponent(TD_CODE);
       url += '&PID=' + encodeURIComponent(PID);
   url += '&SEQ_NO=' + encodeURIComponent(seqNo);
    window.location.href = url;
        }
        }

        // 開啟預算分配視窗
        function openBudgetAllocation(pid, tid, tdCode) {
            if (typeof top.open2_1_2 === 'function') {
      top.open2_1_2(pid, tid, tdCode);
         } else {
       // 直接開啟 PAGE2_1_2
      window.open('@Url.Action("PAGE2_1_2", "TDE0042")?PID=' + pid + '&TID=' + tid + '&TD_CODE=' + tdCode, '_blank');
       }
   }

        // ==========================================================
        // 3.1.4rev2：中央款月分配數（原本只有 alert「尚未實作」）
        // 對應舊系統 App_Data\CMETMS\TDE0020B020.Xml 的「中央款(補助)月分配數」，
        // 資料在 CMEPMS.dbo.CTDITFD 的 M_01~M_12（鍵：TID + FID + SYR）。
        // ==========================================================
        var _cfTid = '';

        function openCenFundAllocation(pid, tid, tdCode) {
            _cfTid = tid;
            $('#cfBody').html('<tr><td colspan="14" class="text-center">載入中…</td></tr>');
            $('#cfMessage').empty();

            $.getJSON('@Url.Action("PAGE2_1_2_GetMonth", "TDE0042")', { TID: tid }, function (res) {
                if (!res.success) { cfMessage(res.message, false); return; }
                if (!res.rows.length) {
                    $('#cfBody').html('<tr><td colspan="14" class="text-center">此期別尚無年度經費明細，請先於「預算分配」新增</td></tr>');
                    return;
                }
                var html = '';
                for (var i = 0; i < res.rows.length; i++) {
                    var r = res.rows[i], t = 0;
                    html += '<tr data-fid="' + r.FID + '">';
                    html += '<td class="text-center">' + (r.SYR || '') + '</td>';
                    for (var m = 0; m < 12; m++) {
                        var v = (r.M[m] === null || r.M[m] === undefined) ? '' : r.M[m];
                        t += parseFloat(v) || 0;
                        html += '<td><input type="number" step="1" class="form-control form-control-sm cf-m" value="' + v + '" /></td>';
                    }
                    html += '<td class="text-end cf-total">' + t.toLocaleString('en-US') + '</td></tr>';
                }
                $('#cfBody').html(html);
            }).fail(function (xhr) { cfMessage('載入失敗：' + xhr.status, false); });

            new bootstrap.Modal(document.getElementById('cenFundModal')).show();
        }

        function cfRecalc() {
            $('#cfBody tr').each(function () {
                var t = 0;
                $(this).find('.cf-m').each(function () { t += parseFloat($(this).val()) || 0; });
                $(this).find('.cf-total').text(t.toLocaleString('en-US'));
            });
        }
        $(document).on('input', '.cf-m', cfRecalc);

        function cfSave() {
            var rows = $('#cfBody tr[data-fid]');
            if (!rows.length) { cfMessage('沒有可儲存的資料', false); return; }
            var pending = 0, failed = 0;
            rows.each(function () {
                var $r = $(this);
                var data = { TID: _cfTid, FID: $r.data('fid') };
                $r.find('.cf-m').each(function (i) {
                    var v = $(this).val();
                    data['M[' + i + ']'] = (v === '' ? '' : v);
                });
                pending++;
                $.post('@Url.Action("PAGE2_1_2_Month_Ajax", "TDE0042")', data, function (res) {
                    if (!res.success) { failed++; cfMessage(res.message, false); }
                }).always(function () {
                    pending--;
                    if (pending === 0 && failed === 0) { cfMessage('月分配數儲存成功', true); }
                });
            });
        }

        function cfMessage(msg, ok) {
            $('#cfMessage').html('<div class="alert ' + (ok ? 'alert-success' : 'alert-danger') + ' py-1 my-1">' + msg + '</div>');
        }

  // 頁面載入時，預設選取當前期別
        $(document).ready(function () {
            if (currentSeqNo !== '') {
  $('#SEQ_NO').val(currentSeqNo);
         } else if (maxSeqNo !== '') {
    $('#SEQ_NO').val(maxSeqNo);
            }
  });
    </script>

    @* 3.1.4rev2：中央款月分配數視窗（對應舊系統「中央款(補助)月分配數」） *@
    <div class="modal fade" id="cenFundModal" tabindex="-1">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">中央款(補助)月分配數（元）</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="cfMessage"></div>
                    <div class="table-responsive">
                        <table class="table table-sm table-striped table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:80px;">年度</th>
                                    @for (int m = 1; m <= 12; m++) {
                                        <th style="min-width:80px;">@(m)月</th>
                                    }
                                    <th style="width:110px;">合計</th>
                                </tr>
                            </thead>
                            <tbody id="cfBody"></tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" onclick="cfSave();">
                        <i class="fa-solid fa-floppy-disk me-1"></i>儲存
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fa-solid fa-xmark me-1"></i>關閉
                    </button>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
