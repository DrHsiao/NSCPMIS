@{
    Layout = null;
    bool isNew = ViewBag.IsNew ?? false;
    var data = ViewBag.Data as System.Data.DataRow;
    var fitCodeList = ViewBag.FIT_CODE_List as SelectList;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script type="text/javascript" src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <title>經費明細@(isNew ? "新增" : "修改")</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        html, body { height: 100%; margin: 0; padding: 0; }
        body { padding: 15px; box-sizing: border-box; }
        .form-group { margin-bottom: 15px; }
     .btn-toolbar { margin-top: 20px; text-align: center; }
    </style>
</head>
<body>
    @if (TempData["Success"] != null) {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
  @if (TempData["Error"] != null) {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @using (Html.BeginForm("PAGE2_1_2_Fund_Save", "TDE0042", FormMethod.Post, new { id = "fundForm" })) {
        @Html.AntiForgeryToken()

   <input type="hidden" name="FID" value="@ViewBag.FID" />
        <input type="hidden" name="TID" value="@ViewBag.TID" />
        <input type="hidden" name="PID" value="@ViewBag.PID" />
        <input type="hidden" name="TD_CODE" value="@ViewBag.TD_CODE" />
        <input type="hidden" name="IsNew" value="@isNew.ToString().ToLower()" />

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-primary text-white fw-bold">
   <strong>經費明細 @(isNew ? "(新增)" : "(修改)")</strong>
            </div>
          <div class="card-body">
    <div class="form-group">
      <label for="SYR">年度 <span class="text-danger">*</span></label>
     <input type="text" class="form-control" name="SYR" id="SYR" maxlength="4"
         value="@(data != null && data["SYR"] != DBNull.Value ? data["SYR"] : "")" 
         placeholder="例如：113" required />
    </div>

      <div class="form-group">
    <label for="FIT_CODE">經費層級 <span class="text-danger">*</span></label>
    @if (fitCodeList != null) {
            @Html.DropDownList("FIT_CODE", fitCodeList, new { @class = "form-control", id = "FIT_CODE", required = "required" })
         }
             </div>

  <div class="form-group">
     <label for="FUND">金額(元) <span class="text-danger">*</span></label>
        <input type="number" class="form-control" name="FUND" id="FUND"
     value="@(data != null && data["FUND"] != DBNull.Value ? data["FUND"] : "")" required />
 </div>

             <div class="form-group">
       <label for="FUND_DESC">修正說明</label>
 <textarea class="form-control" name="FUND_DESC" id="FUND_DESC" rows="3">@(data != null && data["FUND_DESC"] != DBNull.Value ? data["FUND_DESC"] : "")</textarea>
                </div>
    </div>
        </div>

        <div class="btn-toolbar">
     <button type="submit" class="btn btn-primary">
      <i class="fa-solid fa-floppy-disk me-1"></i> 儲存
</button>
            <button type="button" class="btn btn-secondary" onclick="window.close();">
                <i class="fa-solid fa-xmark"></i> 取消
            </button>
        </div>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        $(document).ready(function () {
        // 設定現有的經費層級選取值
    @if (data != null && data["FIT_CODE"] != DBNull.Value) {
 <text>
   $('#FIT_CODE').val('@data["FIT_CODE"].ToString()');
  </text>
            }
        });
    </script>
</body>
</html>
