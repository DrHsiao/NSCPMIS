@model IEnumerable<WCals.Models.CMBASEModels.SMCMENU3>

@{
    ViewBag.Title = "下層功能項目";
    Layout = "~/Views/Shared/_Layout2_v2.cshtml";
}

<div class="row">
    <div class="col-lg-12">
        <h1 class="page-header">
            下層功能項目
            <small>提供下層功能項目內容管理維護</small>
        </h1>
        <ol class="breadcrumb">
            <li>
                <i class="fa-solid fa-dashboard"></i><a href="\Home"> 首頁</a>
            </li>
            <li>
                <i class="fa-solid fa-dashboard"></i><a href="\WSMC0701"> 功能授權管理 [0701]</a>
            </li>
            <li class="active">
                <i class="fa-solid fa-file"></i>
                下層功能項目
            </li>
        </ol>
    </div>
</div>
<br />
<div class="row">
    <div class="col-md-12 table-responsive">
        <div class="card shadow-sm border-0 mb-4 h-100">
            <table class="table table-bordered table-striped table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>功能編號</th>
                        <th>功能名稱</th>
                        <th>#</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        foreach(var item in Model) {
                            <tr>
                                <td>@item.SYS_ID</td>
                                <td>@item.SYS_NAME</td>
                                <td><a class="btn btn-secondary" href="/WSMC0701/Edit/@item.SYS_ID" title="功能授權"> 功能授權</a></td>
                            </tr>

                        }
                    }


                </tbody>
            </table>
        </div>
    </div>
</div>
