@model WCals.ViewModels.ADAccountViewModel
@{
    ViewBag.Title = "工程管理系統帳號申請";
    Layout = null;
}
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>@ViewBag.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style type="text/css">
        body {
            padding-top: 100px;
            padding-bottom: 50px;
        }
    </style>
</head>
<body>
    <input type="hidden" name="csrf" value="7e5bfa37d4c3d6e3c762a8b546a6a3b8" />
    <div class="container">
        <div class="row">
            <div class="col-md-4 col-md-offset-4 well">
                <legend>工程管理系統帳號申請</legend>

                @*@if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            <a class="close" data-bs-dismiss="alert" href="#">×</a>
                            @Html.ValidationSummary()
                        </div>
                    }*@

                @using (Html.BeginForm("ConnectAD", "Home", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <div class="form-group">
                        <label>請輸入您的AD(開機)帳號</label>
                        @Html.TextBoxFor(x => x.ADAccount, new { @class = "form-control", placeholder = @Html.DisplayNameFor(x => x.ADAccount), AutoComplete = "Off", tabindex = "1" })
                        @Html.ValidationMessageFor(x => x.ADAccount, "", new { @class = "text-danger" })
                    </div>
                    <div class="form-group">
                        <label>請輸入您在舊系統的帳號(若無免填)</label>
                        @Html.TextBoxFor(x => x.Account, new { @class = "form-control", placeholder = @Html.DisplayNameFor(x => x.Account), AutoComplete = "Off", tabindex = "2" })
                        @Html.ValidationMessageFor(x => x.Account, "", new { @class = "text-danger" })
                    </div>
                    <div class="form-group">
                        <label>請輸入您的姓名</label>
                        @Html.TextBoxFor(x => x.UserName, new { @class = "form-control", placeholder = @Html.DisplayNameFor(x => x.UserName), AutoComplete = "Off", tabindex = "3" })
                        @Html.ValidationMessageFor(x => x.UserName, "", new { @class = "text-danger" })
                    </div>
                    <div class="form-group">
                        <label>@Html.DisplayNameFor(x => x.DeptNo)</label>
                        @*@Html.TextBoxFor(x => x.DeptName, new { @class = "form-control", placeholder = @Html.DisplayNameFor(x => x.DeptName), AutoComplete = "Off", tabindex = "4" })*@
                        @Html.DropDownListFor(x => x.DeptNo, (SelectList)ViewBag.OGCDEPT, new { @class = "form-control" })
                    </div>

                    <div style="padding-top: 10px;">
                        <button type="submit" name="submit" class="btn btn-primary">申請</button>
                        <button type="button" name="reset" class="btn btn-secondary">清除</button>
                    </div>
                }
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script type="text/javascript">
        $(function () {
            $('#Account').focus();
            $('button[name=reset]').click(function () {
                $('#Account').val('');
                $('#Password').val('');
                $('#Remember').prop('checked', '');
                if ($('.alert>a.close').length > 0) {
                    $('.alert>a.close').trigger('click');
                }
            });
        });
    </script>
</body>
</html>

