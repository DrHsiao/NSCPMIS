@model WCals.ViewModels.HomeIndexViewModel

@{
    ViewBag.Title = "下水道工程管理系統";
    Layout = "~/Views/Shared/_Layout2_v2.cshtml";
}

<div class="row">
    <div class="col-lg-12">
        <div class="d-flex justify-content-between align-items-end border-bottom mb-3 pb-2">
            <h1 class="h2 mb-0">
                下水道工程管理系統
                <small class="text-muted fs-6">訊息公告及檔案下載</small>
            </h1>
        </div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item active" aria-current="page">
                    <i class="fa-solid fa-gauge"></i> 首頁
                </li>
            </ol>
        </nav>
    </div>
</div>

<div class="card border-primary mb-3">
    <div class="card-header bg-primary text-white">
        <ul class="nav nav-tabs card-header-tabs" id="homeTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active text-white" id="news-tab" data-bs-toggle="tab" data-bs-target="#news" type="button" role="tab" aria-controls="news" aria-selected="true">訊息公告</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="filedownload-tab" data-bs-toggle="tab" data-bs-target="#filedownload" type="button" role="tab" aria-controls="filedownload" aria-selected="false">檔案下載</button>
            </li>
        </ul>
    </div>
    <div class="card-body">
        <div class="tab-content" id="homeTabsContent">
            <div class="tab-pane fade show active" id="news" role="tabpanel" aria-labelledby="news-tab">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>主旨</th>
                                <th>公告人員</th>
                                <th>公告日期</th>
                                <th style="width: 100px;">操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach(var item in Model.ListSMCNEWS) {
                                <tr>
                                    <td>@item.HEADLINE</td>
                                    <td>@item.UPD_UID</td>
                                    <td>
                                        @if (@item.STARTDATE != null)
                                        {
                                            @item.STARTDATE.Value.ToShortDateString()
                                        }
                                    </td>
                                    <td>
                                        <a class="btn btn-outline-primary btn-sm" href="@Url.Content("~/Home/News/" + item.NEWSID)" title="@item.HEADLINE">內容</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="tab-pane fade" id="filedownload" role="tabpanel" aria-labelledby="filedownload-tab">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>文件主旨</th>
                                <th>公告人員</th>
                                <th>公告日期</th>
                                <th style="width: 100px;">操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach(var item in Model.ListSMCDOCS) {
                                <tr>
                                    <td>@item.HEADLINE</td>
                                    <td>@item.UPD_UID</td>
                                    <td>
                                        @if (@item.STARTDATE != null)
                                        {
                                            @item.STARTDATE.Value.ToShortDateString()
                                        }
                                    </td>
                                    <td>
                                        <a class="btn btn-outline-primary btn-sm" href="@Url.Content("~/Home/News/" + item.NEWSID)" title="@item.HEADLINE">內容</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>                
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function() {
            $('#homeTabs button').on('click', function (e) {
                
                
            });
        });
    </script>
}