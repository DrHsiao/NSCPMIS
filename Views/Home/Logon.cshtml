@model WCals.ViewModels.LogonViewModel
@{
    ViewBag.Title = "下水道工程管理系統登入";
    Layout = null;
    
}
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <style type="text/css">
        body {
            background-color: #f4f6f9;
            background-image: url('@Url.Content("~/")Content/img/body_bg.png');
            
            background-repeat: repeat;
            background-position: center center;
            height: 100vh;
            display: flex;
            align-items: center;
        }
        .login-card {
            border: none;
            border-radius: 8px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }
        .login-header {
            background-color: #337ab7;
            color: #ffffff;
            border-radius: 8px 8px 0 0 !important;
            padding: 20px;
            text-align: center;
        }
        .login-header h4 {
            margin: 0;
            font-weight: 600;
        }
        .btn-primary {
            background-color: #337ab7;
            border-color: #2e6da4;
        }
        .btn-primary:hover {
            background-color: #286090;
            border-color: #204d74;
        }
    </style>
</head>
<body>
    @*@if (ViewBag.Online == "N")
        {
            <div class="container">
                <div class="row">
                    <div style="background-color:yellow;" class="col-md-4 col-md-offset-4 well" align="center">
                        <legend>請注意:此處為測試用系統!!</legend>
                        <a href="http://10.100.101.238" title="正式系統URL">正式系統在這裡</a>
                    </div>
                </div>
            </div>
        }*@
    <input type="hidden" name="csrf" value="7e5bfa37d4c3d6e3c762a8b546a6a3b8" />
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="card login-card mt-5 mb-5">
                    <div class="card-header login-header">
                        <h4><i class="fa-solid fa-water me-2"></i>下水道工程管理系統</h4>
                    </div>
                    <div class="card-body p-4">
                        @using (Html.BeginForm("LogonAD", "Home", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label class="form-label fw-bold"><i class="fa-solid fa-user me-1 text-muted"></i> 帳號</label>
                                <input type="text" id="Account" name="Account" class="form-control form-control-lg" placeholder="請輸入帳號" autocomplete="off" tabindex="1" required />
                            </div>
                            <div class="mb-4">
                                <label class="form-label fw-bold"><i class="fa-solid fa-lock me-1 text-muted"></i> 密碼</label>
                                @Html.PasswordFor(x => x.Password, new { @class = "form-control form-control-lg", id = "Password", placeholder = "請輸入密碼", AutoComplete = "Off", tabindex = "2", required = "required" })
                            </div>
                            <div class="d-grid gap-2">
                                <button type="submit" name="submit" class="btn btn-primary btn-lg shadow-sm">登入</button>
                                <button type="button" name="reset" class="btn btn-outline-secondary">清除重填</button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script type="text/javascript">
        $(function () {
            $('#Account').focus();
            $('button[name=reset]').click(function () {
                $('#Account').val('');
                $('#Password').val('');
                $('#Remember').prop('checked', '');
                if ($('.alert>a.close').length > 0) {
                    $('.alert>a.close').trigger('click');
                }
            });
        });
    </script>

</body>
</html>

