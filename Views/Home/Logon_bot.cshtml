@model WCals.ViewModels.LogonViewModel
@{
    ViewBag.Title = "教學示範案例系統登入";
    Layout = null;
}
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>@ViewBag.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style type="text/css">
        body {
            padding-top: 100px;
            padding-bottom: 50px;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="row">
            <div class="col-md-4 col-md-offset-4 well">
                <legend>教學示範案例系統登入</legend>

                @if (!ViewData.ModelState.IsValid)
                {
    <div class="alert alert-danger">
        <a class="close" data-bs-dismiss="alert" href="#">×</a>
        @Html.ValidationSummary()
    </div>}

                @using (Html.BeginForm("LogonAD", "Home", FormMethod.Post))
                {
    @Html.AntiForgeryToken()
                    <div class="form-group">
                        <label>帳號</label>
                        @Html.TextBoxFor(x => x.Account, new { @class = "form-control", placeholder = "帳號", AutoComplete = "Off", tabindex = "1" })
                    </div>
                                    <div class="form-group">
                                        <label>密碼</label>
                                        @Html.PasswordFor(x => x.Password, new { @class = "form-control", placeholder = "密碼", AutoComplete = "Off", tabindex = "2" })
                                    </div>
                                                    <label>
                                                        @Html.CheckBoxFor(x => x.Remember)
                                                        @Html.DisplayNameFor(x => x.Remember)
                                                    </label>

                                                                    <div style="padding-top: 10px;">
                                                                        <button type="submit" name="submit" class="btn btn-primary">登入</button>
                                                                        <button type="button" name="reset" class="btn btn-secondary">清除</button>
                                                                    </div>}
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script type="text/javascript">
        $(function () {
            $('#Account').focus();
            $('button[name=reset]').click(function () {
                $('#Account').val('');
                $('#Password').val('');
                $('#Remember').prop('checked', '');
                if ($('.alert>a.close').length > 0) {
                    $('.alert>a.close').trigger('click');
                }
            });
        });
    </script>
    <script src="https://www.gstatic.com/dialogflow-console/fast/messenger/bootstrap.js?v=1"></script>
    <df-messenger intent="WELCOME"
                  chat-title="青農輔導智能客服"
                  agent-id="e01d8d4f-9135-42cf-a920-12e255f9552a"
                  language-code="zh-tw"></df-messenger>
</body>
</html>

