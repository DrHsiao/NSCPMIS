@using PagedList.Mvc
@model WCals.ViewModels.NewModels.TDE0070Model
@{
    ViewBag.Title = "污水下水道普及率統計";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/PagedList.css" rel="stylesheet" type="text/css" />
    <script type="text/javascript" src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <style>
        html, body {
            height: 100%;
            margin: 0;
            padding: 5px;
        }
        .table th, .table td {
            white-space: nowrap;
            text-align: center;
            vertical-align: middle;
        }
        .table td.num {
            text-align: right;
        }
        .pagination {
            margin: 10px 0;
        }
        .btn-lock {
            background-color: #d9534f;
            color: white;
        }
        .btn-unlock {
            background-color: #5cb85c;
            color: white;
        }
    </style>
    <link href="~/Content/bs3-compat.css" rel="stylesheet" />
</head>
<body>
    @{
        int currentTab = Model.tab;
        string pageName = "";
        switch (currentTab)
        {
            case 1: pageName = "統計表"; break;
            case 2: pageName = "資料設定"; break;
        }
    }

    <div class="card shadow-sm border-0 mb-4 h-100">
        <div class="card-header bg-primary text-white fw-bold">@pageName - @Model.SYR 年 @Model.SMN 月</div>
        <div class="card-body" style="overflow-x: auto;">

            @* 頁籤1: 統計表 (CCV_CCDMCNT) *@
            @if (currentTab == 1)
            {
                if (Model.List_Tab1 != null && Model.List_Tab1.Count > 0)
                {
                    @Html.PagedListPager(Model.List_Tab1, page => Url.Action("Tab",
                        new { tab = 1, SYR = Model.SYR, SMN = Model.SMN, page1 = page }))
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th rowspan="2">操作</th>
                                <th rowspan="2">縣市</th>
                                <th colspan="3">人口數</th>
                                <th colspan="3">戶數</th>
                                <th colspan="5">普及率(%)</th>
                                <th rowspan="2">異動說明</th>
                                <th rowspan="2">異常說明</th>
                                <th rowspan="2">鎖定狀態</th>
                            </tr>
                            <tr>
                                <th>人口數</th>
                                <th>接管人口</th>
                                <th>普及率(%)</th>
                                <th>戶數</th>
                                <th>接管戶數</th>
                                <th>普及率(%)</th>
                                <th>公共污水</th>
                                <th>專用污水</th>
                                <th>建築物污水</th>
                                <th>社區污水</th>
                                <th>合計</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (System.Data.DataRow row in Model.List_Tab1)
                            {
                                string isLock = row["IS_LOCK"] != DBNull.Value ? row["IS_LOCK"].ToString() : "";
                                bool locked = isLock == "Y";
                                <tr>
                                    <td>
                                        @* 3.3.4：已鎖定時編輯鈕為 disabled，原本沒有任何說明，
                                           使用者點了沒反應也不知道原因，補上提示文字 *@
                                        <button type="button" class="btn btn-sm btn-warning"
                                                onclick="top.openEditDialog('@row["SYR"]', '@row["SMN"]', '@row["CITY"]');"
                                                title="@(locked ? "此筆資料已鎖定，請先按右方的「解鎖」才能編輯" : "編輯本筆資料")"
                                                @(locked ? "disabled" : "")>編輯</button>
                                        @if (locked)
                                        {
                                            <button type="button" class="btn btn-sm btn-unlock" onclick="top.unlockRow('@row["SYR"]', '@row["SMN"]', '@row["CITY"]');">解鎖</button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-lock" onclick="top.lockRow('@row["SYR"]', '@row["SMN"]', '@row["CITY"]');">鎖定</button>
                                        }
                                    </td>
                                    <td>@row["CITY"]</td>
                                    <td class="num">@(row["C1"] != DBNull.Value ? string.Format("{0:N0}", row["C1"]) : "")</td>
                                    <td class="num">@(row["C2"] != DBNull.Value ? string.Format("{0:N0}", row["C2"]) : "")</td>
                                    <td class="num">@(row["C3"] != DBNull.Value ? string.Format("{0:N2}", row["C3"]) : "")</td>
                                    <td class="num">@(row["C4"] != DBNull.Value ? string.Format("{0:N0}", row["C4"]) : "")</td>
                                    <td class="num">@(row["C5"] != DBNull.Value ? string.Format("{0:N0}", row["C5"]) : "")</td>
                                    <td class="num">@(row["C6"] != DBNull.Value ? string.Format("{0:N2}", row["C6"]) : "")</td>
                                    <td class="num">@(row["C7"] != DBNull.Value ? string.Format("{0:N2}", row["C7"]) : "")</td>
                                    <td class="num">@(row["C8"] != DBNull.Value ? string.Format("{0:N2}", row["C8"]) : "")</td>
                                    <td class="num">@(row["C9"] != DBNull.Value ? string.Format("{0:N2}", row["C9"]) : "")</td>
                                    <td class="num">@(row["C10"] != DBNull.Value ? string.Format("{0:N2}", row["C10"]) : "")</td>
                                    <td class="num">@(row["C11"] != DBNull.Value ? string.Format("{0:N2}", row["C11"]) : "")</td>
                                    <td style="max-width:150px; white-space:normal;">@row["CHANGE_NOTE"]</td>
                                    <td style="max-width:150px; white-space:normal;">@row["UNUSUAL_NOTE"]</td>
                                    <td>@row["IS_LOCK_DESC"]</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="alert alert-info">目前無資料</div>
                }
            }

            @* 頁籤2: 資料設定 (CCEMCNT) *@
            @if (currentTab == 2)
            {
                if (Model.List_Tab2 != null && Model.List_Tab2.Count > 0)
                {
                    @Html.PagedListPager(Model.List_Tab2, page => Url.Action("Tab",
                        new { tab = 2, SYR = Model.SYR, SMN = Model.SMN, page2 = page }))
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>操作</th>
                                <th>年度</th>
                                <th>月份</th>
                                <th>縣市</th>
                                <th>人口數</th>
                                <th>戶數</th>
                                <th>戶數(內政部)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (System.Data.DataRow row in Model.List_Tab2)
                            {
                                <tr>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-warning" onclick="top.openEditDialog2('@row["SYR"]', '@row["SMN"]', '@row["CITY"]');">編輯</button>
                                    </td>
                                    <td>@row["SYR"]</td>
                                    <td>@row["SMN"]</td>
                                    <td>@row["CITY"]</td>
                                    <td class="num">@(row["POP_CNT"] != DBNull.Value ? string.Format("{0:N0}", row["POP_CNT"]) : "")</td>
                                    <td class="num">@(row["DOR_CNT"] != DBNull.Value ? string.Format("{0:N0}", row["DOR_CNT"]) : "")</td>
                                    <td class="num">@(row["DOR_COUNT"] != DBNull.Value ? string.Format("{0:N0}", row["DOR_COUNT"]) : "")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="alert alert-info">目前無資料</div>
                }
            }

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
