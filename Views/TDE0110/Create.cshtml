@{
    ViewBag.Title = "用戶接管普及率填報 - 新增";
    Layout = "~/Views/Shared/_Layout2_v2.cshtml";
}

<div class="row">
    <div class="col-lg-12">
        <h1 class="page-header">
            新增用戶接管普及率資料
        </h1>
        <ol class="breadcrumb">
            <li>
                <i class="fa-solid fa-dashboard"></i><a href="@Url.Content("~/")Home"> 首頁</a>
            </li>
            <li>
                <i class="fa-solid fa-file"></i><a href="@Url.Action("Index", "TDE0110")"> 用戶接管普及率填報</a>
            </li>
            <li class="active">
                新增
            </li>
        </ol>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card shadow-sm border-0 mb-4 h-100">
    <div class="card-header bg-primary text-white fw-bold">新增資料</div>
    <div class="card-body">
        @using (Html.BeginForm("Create", "TDE0110", FormMethod.Post, new { @class = "form-horizontal" }))
        {
            <div class="form-group">
                <label class="col-form-label col-md-2">年度<span class="text-danger">*</span></label>
                <div class="col-md-4">
                    <input type="text" class="form-control" name="SYR" placeholder="例如: 112" required />
                </div>
                <label class="col-form-label col-md-2">月份<span class="text-danger">*</span></label>
                <div class="col-md-4">
                    <input type="text" class="form-control" name="SMN" placeholder="例如: 01" required />
                </div>
            </div>
            <div class="form-group">
                <label class="col-form-label col-md-2">縣市<span class="text-danger">*</span></label>
                <div class="col-md-4">
                    @Html.DropDownList("CITY", (IEnumerable<SelectListItem>)ViewBag.CityList, "請選擇縣市", new { @class = "form-control", required = "required" })
                </div>
            </div>

            <hr />
            <h4>本月執行數</h4>
            <div class="form-group">
                <label class="col-form-label col-md-2">普及率 A</label>
                <div class="col-md-4">
                    <input type="number" step="0.01" class="form-control" name="PC_CNT" />
                </div>
                <label class="col-form-label col-md-2">接管率 B</label>
                <div class="col-md-4">
                    <input type="number" step="0.01" class="form-control" name="AC_CNT" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-form-label col-md-2">接管數 C</label>
                <div class="col-md-4">
                    <input type="number" class="form-control" name="BC_CNT" />
                </div>
                <label class="col-form-label col-md-2">總戶數 D</label>
                <div class="col-md-4">
                    <input type="number" class="form-control" name="CC_CNT" />
                </div>
            </div>

            <hr />
            <div class="form-group">
                <label class="col-form-label col-md-2">更正說明</label>
                <div class="col-md-10">
                    <input type="text" class="form-control" name="CHANGE_NOTE" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-form-label col-md-2">異常說明</label>
                <div class="col-md-10">
                    <input type="text" class="form-control" name="UNUSUAL_NOTE" />
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-offset-2 col-md-10">
                    <button type="submit" class="btn btn-primary">新增</button>
                    <a href="@Url.Action("Index", "TDE0110")" class="btn btn-secondary">取消</a>
                </div>
            </div>
        }
    </div>
</div>
