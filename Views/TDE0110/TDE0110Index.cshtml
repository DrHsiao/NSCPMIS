
@using PagedList
@using PagedList.Mvc
@using System.Data
@model WCals.ViewModels.NewModels.TDE0110Model

@{
    ViewBag.Title = "用戶接管普及率填報";
    Layout = "~/Views/Shared/_Layout2_v2.cshtml";
}

<style>
    .table th {
        text-align: center;
        background-color: #f5f5f5;
        vertical-align: middle !important;
    }
    .table td {
        vertical-align: middle !important;
    }
    .text-right {
        text-align: right;
    }
    .text-center {
        text-align: center;
    }
    .search-panel {
        background-color: #f9f9f9;
        padding: 15px;
        margin-bottom: 20px;
        border-radius: 4px;
        border: 1px solid #ddd;
    }
</style>


<div class="row">
    <div class="col-lg-12">
        <h1 class="page-header">
            3.1.8 用戶接管普及率填報
            <small></small>
        </h1>
        <ol class="breadcrumb">
            <li>
                <i class="fa-solid fa-dashboard"></i><a href="@Url.Content("~/")Home"> 首頁</a>
            </li>
            <li class="active">
                <i class="fa-solid fa-file"></i>
                <a href="@Url.Content("~/")TDE0110">用戶接管普及率填報</a>
            </li>
        </ol>
    </div>
</div>

@if (Model.List1 != null && Model.List1.Count > 0)
{
    <div class="table-responsive">
        <div class="text-right" style="margin-bottom: 10px;">
            <a href="@Url.Action("Create", "TDE0110")" class="btn btn-success">新增</a>
        </div>
        <table class="table table-hover table-striped">
            <thead>
                <tr>
                    <th rowspan="2" style="width: 80px;">功能</th>
                    <th rowspan="2">年度</th>
                    <th rowspan="2">月份</th>
                    <th rowspan="2">縣市</th>
                    <th colspan="4">本月執行數(戶)</th>
                    <th colspan="4">累計執行數(戶)</th>
                    <th rowspan="2">更正說明</th>
                    <th rowspan="2">異常說明</th>
                    <th rowspan="2">狀態</th>
                </tr>
                <tr>
                    <th>普及率<br>A</th>
                    <th>接管率<br>B</th>
                    <th>接管數<br>C</th>
                    <th>總戶數<br>D</th>
                    
                    <th>普及率<br>A</th>
                    <th>接管率<br>B</th>
                    <th>接管數<br>C</th>
                    <th>總戶數<br>D</th>
                </tr>
            </thead>
            <tbody>
                @foreach (DataRow row in Model.List1)
                {
                    <tr>
                        <td class="text-center">
                            @if (row["MODE"].ToString() == "MOD")
                            {
                                <a href="@Url.Action("Edit", "TDE0110", new { SYR = row["SYR"], SMN = row["SMN"], CITY = row["CITY"] })" class="btn btn-primary btn-sm">編輯</a>
                            }
                            else
                            {
                                <a href="@Url.Action("Edit", "TDE0110", new { SYR = row["SYR"], SMN = row["SMN"], CITY = row["CITY"] })" class="btn btn-info btn-sm">檢視</a>
                            }
                        </td>
                        <td class="text-center">@row["SYR"]</td>
                        <td class="text-center">@row["SMN"]</td>
                        <td class="text-center">@row["CITY"]</td>
                        
                        @* 本月執行數 (PC, AC, BC, CC) *@
                        <td class="text-right">@row["PC_CNT"]</td>
                        <td class="text-right">@row["AC_CNT"]</td>
                        <td class="text-right">@row["BC_CNT"]</td>
                        <td class="text-right">@row["CC_CNT"]</td>

                        @* 累計執行數 (P_PC, P_AC, P_BC, P_CC) *@
                        <td class="text-right">@row["P_PC_CNT"]</td>
                        <td class="text-right">@row["P_AC_CNT"]</td>
                        <td class="text-right">@row["P_BC_CNT"]</td>
                        <td class="text-right">@row["P_CC_CNT"]</td>

                        @* 備註欄位 *@
                        <td>@row["CHANGE_NOTE"]</td>
                        <td>@row["UNUSUAL_NOTE"]</td>
                        <td class="text-center">
                            @(row["IS_LOCK"].ToString() == "Y" ? "已鎖定" : "未鎖定")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* 分頁控制項 *@
    <div class="row">
        <div class="col-md-12 text-center">
            @Html.PagedListPager((IPagedList)Model.List1, page => Url.Action("Index", new { page, SYR = ViewBag.SYR }))
        </div>
    </div>
}
else
{
    <div class="alert alert-info">查無資料</div>
}

