@{
    ViewBag.Title = "用戶接管普及率填報 - 編輯/檢視";
    Layout = "~/Views/Shared/_Layout2_v2.cshtml";
    var data = ViewBag.Data as System.Data.DataRow;
    bool isLocked = data["IS_LOCK"].ToString() == "Y";
    string readOnlyAttr = isLocked ? "readonly" : "";
    string disabledAttr = isLocked ? "disabled" : "";
}

<div class="row">
    <div class="col-lg-12">
        <h1 class="page-header">
            @(isLocked ? "檢視" : "編輯")用戶接管普及率資料
        </h1>
        <ol class="breadcrumb">
            <li>
                <i class="fa-solid fa-dashboard"></i><a href="@Url.Content("~/")Home"> 首頁</a>
            </li>
            <li>
                <i class="fa-solid fa-file"></i><a href="@Url.Action("Index", "TDE0110")"> 用戶接管普及率填報</a>
            </li>
            <li class="active">
                @(isLocked ? "檢視" : "編輯")
            </li>
        </ol>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card shadow-sm border-0 mb-4 h-100">
    <div class="card-header bg-primary text-white fw-bold">@(isLocked ? "檢視資料" : "編輯資料")</div>
    <div class="card-body">
        @using (Html.BeginForm("Edit", "TDE0110", FormMethod.Post, new { @class = "form-horizontal" }))
        {
            <div class="form-group">
                <label class="col-form-label col-md-2">年度</label>
                <div class="col-md-4">
                    <input type="text" class="form-control" name="SYR" value="@data["SYR"]" readonly />
                </div>
                <label class="col-form-label col-md-2">月份</label>
                <div class="col-md-4">
                    <input type="text" class="form-control" name="SMN" value="@data["SMN"]" readonly />
                </div>
            </div>
            <div class="form-group">
                <label class="col-form-label col-md-2">縣市</label>
                <div class="col-md-4">
                    <input type="text" class="form-control" name="CITY" value="@data["CITY"]" readonly />
                </div>
            </div>

            <hr />
            <h4>本月執行數</h4>
            <div class="form-group">
                <label class="col-form-label col-md-2">普及率 A</label>
                <div class="col-md-4">
                    <input type="number" step="0.01" class="form-control" name="PC_CNT" value="@data["PC_CNT"]" @readOnlyAttr />
                </div>
                <label class="col-form-label col-md-2">接管率 B</label>
                <div class="col-md-4">
                    <input type="number" step="0.01" class="form-control" name="AC_CNT" value="@data["AC_CNT"]" @readOnlyAttr />
                </div>
            </div>
            <div class="form-group">
                <label class="col-form-label col-md-2">接管數 C</label>
                <div class="col-md-4">
                    <input type="number" class="form-control" name="BC_CNT" value="@data["BC_CNT"]" @readOnlyAttr />
                </div>
                <label class="col-form-label col-md-2">總戶數 D</label>
                <div class="col-md-4">
                    <input type="number" class="form-control" name="CC_CNT" value="@data["CC_CNT"]" @readOnlyAttr />
                </div>
            </div>

            <hr />
            <h4>累計執行數</h4>
            <div class="form-group">
                <label class="col-form-label col-md-2">普及率 A</label>
                <div class="col-md-4">
                    <input type="number" step="0.01" class="form-control" name="P_PC_CNT" value="@data["P_PC_CNT"]" @readOnlyAttr />
                </div>
                <label class="col-form-label col-md-2">接管率 B</label>
                <div class="col-md-4">
                    <input type="number" step="0.01" class="form-control" name="P_AC_CNT" value="@data["P_AC_CNT"]" @readOnlyAttr />
                </div>
            </div>
            <div class="form-group">
                <label class="col-form-label col-md-2">接管數 C</label>
                <div class="col-md-4">
                    <input type="number" class="form-control" name="P_BC_CNT" value="@data["P_BC_CNT"]" @readOnlyAttr />
                </div>
                <label class="col-form-label col-md-2">總戶數 D</label>
                <div class="col-md-4">
                    <input type="number" class="form-control" name="P_CC_CNT" value="@data["P_CC_CNT"]" @readOnlyAttr />
                </div>
            </div>

            <hr />
            <div class="form-group">
                <label class="col-form-label col-md-2">更正說明</label>
                <div class="col-md-10">
                    <input type="text" class="form-control" name="CHANGE_NOTE" value="@data["CHANGE_NOTE"]" @readOnlyAttr />
                </div>
            </div>
            <div class="form-group">
                <label class="col-form-label col-md-2">異常說明</label>
                <div class="col-md-10">
                    <input type="text" class="form-control" name="UNUSUAL_NOTE" value="@data["UNUSUAL_NOTE"]" @readOnlyAttr />
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-offset-2 col-md-10">
                    @if (!isLocked) {
                        <button type="submit" class="btn btn-primary">儲存</button>
                    }
                    <a href="@Url.Action("Index", "TDE0110")" class="btn btn-secondary">返回</a>
                </div>
            </div>
        }
    </div>
</div>
