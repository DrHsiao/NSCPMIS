@model WCals.ViewModels.NewModels.TDE0040Model
@{
    ViewBag.Title = "停復工紀錄";
    Layout = null;

    System.Data.DataTable dtList = ViewBag.List1 as System.Data.DataTable;
    short nextSeqNo = ViewBag.NextSeqNo ?? 1;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script type="text/javascript" src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <title>@ViewBag.Title</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://code.jquery.com/ui/1.14.1/themes/base/jquery-ui.css" rel="stylesheet" />
    <style>
        body {
            padding: 10px;
        }
        .section-header {
            background-color: #f5f5f5;
            border-left: 4px solid #0275d8;
            padding: 10px 15px;
            margin-top: 20px;
            margin-bottom: 15px;
            font-weight: bold;
            font-size: 14px;
        }
        .table th {
            background-color: #558DCC;
            color: white;
            text-align: center;
            font-size: 12px;
        }
        .table td {
            font-size: 12px;
            vertical-align: middle;
        }
        .form-control-sm {
            font-size: 12px;
            padding: 2px 5px;
            height: 28px;
        }
        textarea.form-control-sm {
            height: auto;
        }
        .btn-sm {
            font-size: 11px;
            padding: 3px 8px;
        }
        .add-row {
            background-color: #f9f9f9;
        }
        .add-row td {
            padding: 8px 4px;
        }
        .required-field {
            color: red;
        }
        .dt {
            width: 85px !important;
        }
        .ui-datepicker { z-index: 2200 !important; background: #ffffff; border: 1px solid #cccccc; border-radius: 4px; }
    
        /* 表格框線與排版美化 */
        .table-bordered { border: 0 !important; }
        .table-bordered th, .table-bordered td { border: 0 !important; border-bottom: 1px solid #e2e8f0 !important; }
        .table > thead > tr > th { 
            border-bottom: 2px solid #337ab7 !important; 
            background-color: #f8fafc; 
            color: #334155; 
        }
        .table > tbody > tr:last-child > td { border-bottom: 0 !important; }
</style>
</head>
<body>
    <div id="messageDiv"></div>

    <button type="button" onclick="top.closePage6_1();" class="btn btn-outline-secondary shadow-sm"><i class="fa-solid fa-xmark me-1"></i> 關閉</button>

    <h4 class="page-header">停復工紀錄</h4>
    <p>工程編號：@ViewBag.TD_CODE</p>

    <div class="section-header">停復工紀錄列表</div>

    <div class="table-responsive">
        <table class="table table-sm" id="dataTable">
            <thead>
                <tr>
                    <th style="width: 50px;">次數</th>
                    <th style="width: 90px;"><span class="required-field">*</span>停工日期</th>
                    <th style="width: 90px;">核准停工日期</th>
                    <th style="width: 100px;"><span class="required-field">*</span>核准停工文號</th>
                    <th style="width: 90px;">預定復工日期</th>
                    <th style="width: 90px;">復工日期</th>
                    <th style="width: 90px;">核准復工日期</th>
                    <th style="width: 100px;">核准復工文號</th>
                    <th style="width: 90px;"><span class="required-field">*</span>停工前預定完成日</th>
                    <th style="width: 90px;">復工後預定完成日</th>
                    <th style="width: 60px;">停工天數</th>
                    <th style="width: 120px;"><span class="required-field">*</span>停工原因</th>
                    <th style="width: 120px;">解決方式</th>
                    <th style="width: 100px;">操作</th>
                </tr>
            </thead>
            <tbody id="dataBody">
                <tr class="add-row">
                    <td style="text-align: center; font-weight: bold;">@nextSeqNo</td>
                    <td><input type="text" id="new_STOP_DT" class="form-control form-control-sm dt" /></td>
                    <td><input type="text" id="new_STOP_VRF_DT" class="form-control form-control-sm dt" /></td>
                    <td><input type="text" id="new_STOP_VRF_FN" class="form-control form-control-sm" /></td>
                    <td><input type="text" id="new_PRE_REWK_DT" class="form-control form-control-sm dt" /></td>
                    <td><input type="text" id="new_REWK_DT" class="form-control form-control-sm dt" /></td>
                    <td><input type="text" id="new_REWK_VRF_DT" class="form-control form-control-sm dt" /></td>
                    <td><input type="text" id="new_REWK_VRF_FN" class="form-control form-control-sm" /></td>
                    <td><input type="text" id="new_BREW_PRE_EDT" class="form-control form-control-sm dt" /></td>
                    <td><input type="text" id="new_AREW_PRE_EDT" class="form-control form-control-sm dt" /></td>
                    <td><input type="number" id="new_STOP_DAYS" class="form-control form-control-sm" value="0" style="text-align: right;" /></td>
                    <td><textarea id="new_STOP_RESN" class="form-control form-control-sm" rows="2"></textarea></td>
                    <td><textarea id="new_RELV_DESC" class="form-control form-control-sm" rows="2"></textarea></td>
                    <td style="text-align: center;">
                        <button type="button" class="btn btn-success btn-sm" onclick="addRow();">新增</button>
                    </td>
                </tr>
                @if(dtList != null && dtList.Rows.Count > 0) {
                    foreach(System.Data.DataRow row in dtList.Rows) {
                        short seqNo = row["SEQ_NO"] != DBNull.Value ? Convert.ToInt16(row["SEQ_NO"]) : (short)0;
                        string stopDt = row["STOP_DT"] != DBNull.Value ? WCals.classes.john.tools.GetDateByTWDate(Convert.ToDateTime(row["STOP_DT"])) : "";
                        string stopVrfDt = row["STOP_VRF_DT"] != DBNull.Value ? WCals.classes.john.tools.GetDateByTWDate(Convert.ToDateTime(row["STOP_VRF_DT"])) : "";
                        string stopVrfFn = row["STOP_VRF_FN"] != DBNull.Value ? row["STOP_VRF_FN"].ToString() : "";
                        string preRewkDt = row["PRE_REWK_DT"] != DBNull.Value ? WCals.classes.john.tools.GetDateByTWDate(Convert.ToDateTime(row["PRE_REWK_DT"])) : "";
                        string rewkDt = row["REWK_DT"] != DBNull.Value ? WCals.classes.john.tools.GetDateByTWDate(Convert.ToDateTime(row["REWK_DT"])) : "";
                        string rewkVrfDt = row["REWK_VRF_DT"] != DBNull.Value ? WCals.classes.john.tools.GetDateByTWDate(Convert.ToDateTime(row["REWK_VRF_DT"])) : "";
                        string rewkVrfFn = row["REWK_VRF_FN"] != DBNull.Value ? row["REWK_VRF_FN"].ToString() : "";
                        string brewPreEdt = row["BREW_PRE_EDT"] != DBNull.Value ? WCals.classes.john.tools.GetDateByTWDate(Convert.ToDateTime(row["BREW_PRE_EDT"])) : "";
                        string arewPreEdt = row["AREW_PRE_EDT"] != DBNull.Value ? WCals.classes.john.tools.GetDateByTWDate(Convert.ToDateTime(row["AREW_PRE_EDT"])) : "";
                        int stopDays = row["STOP_DAYS"] != DBNull.Value ? Convert.ToInt32(row["STOP_DAYS"]) : 0;
                        string stopResn = row["STOP_RESN"] != DBNull.Value ? row["STOP_RESN"].ToString() : "";
                        string relvDesc = row["RELV_DESC"] != DBNull.Value ? row["RELV_DESC"].ToString() : "";

                        <tr data-seqno="@seqNo">
                            <td style="text-align: center;">@seqNo</td>
                            <td><input type="text" value="@stopDt" class="form-control form-control-sm dt edit-field" data-field="STOP_DT" /></td>
                            <td><input type="text" value="@stopVrfDt" class="form-control form-control-sm dt edit-field" data-field="STOP_VRF_DT" /></td>
                            <td><input type="text" value="@stopVrfFn" class="form-control form-control-sm edit-field" data-field="STOP_VRF_FN" /></td>
                            <td><input type="text" value="@preRewkDt" class="form-control form-control-sm dt edit-field" data-field="PRE_REWK_DT" /></td>
                            <td><input type="text" value="@rewkDt" class="form-control form-control-sm dt edit-field" data-field="REWK_DT" /></td>
                            <td><input type="text" value="@rewkVrfDt" class="form-control form-control-sm dt edit-field" data-field="REWK_VRF_DT" /></td>
                            <td><input type="text" value="@rewkVrfFn" class="form-control form-control-sm edit-field" data-field="REWK_VRF_FN" /></td>
                            <td><input type="text" value="@brewPreEdt" class="form-control form-control-sm dt edit-field" data-field="BREW_PRE_EDT" /></td>
                            <td><input type="text" value="@arewPreEdt" class="form-control form-control-sm dt edit-field" data-field="AREW_PRE_EDT" /></td>
                            <td><input type="number" value="@stopDays" class="form-control form-control-sm edit-field" data-field="STOP_DAYS" style="text-align: right;" /></td>
                            <td><textarea class="form-control form-control-sm edit-field" data-field="STOP_RESN" rows="2">@stopResn</textarea></td>
                            <td><textarea class="form-control form-control-sm edit-field" data-field="RELV_DESC" rows="2">@relvDesc</textarea></td>
                            <td style="text-align: center;">
                                <button type="button" class="btn btn-primary btn-sm" onclick="updateRow(this);"><i class="fa-solid fa-floppy-disk me-1"></i> 儲存</button>
                                <button type="button" class="btn btn-danger btn-sm" onclick="deleteRow(this);">刪除</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <table class="table">
        <tr>
            <td>
                <button type="button" onclick="top.closePage6_1();" class="btn btn-outline-secondary shadow-sm"><i class="fa-solid fa-xmark me-1"></i> 關閉</button>
            </td>
        </tr>
    </table>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/ui/1.14.1/jquery-ui.min.js"></script>
    <script type="text/javascript" src="~/Scripts/jquery.datepick.js"></script>
    <script type="text/javascript" src="~/Scripts/MyDatepickerJ.js"></script>
    <script>
        var TD_CODE = '@Model.TD_CODE';
        var nextSeqNo = @nextSeqNo;

        // 日期選擇器初始化
        $(".dt").datepickerTW({
            changeYear: true,
            changeMonth: true,
            yearRange: '68:168',
            dateFormat: 'yymmdd'
        });

        $('.dt').click(function () {
            $(this).delay(600).val("");
        });

        function showMessage(type, message) {
            var alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
            var html = '<div class="alert ' + alertClass + ' alert-dismissible" role="alert">' +
                '<button type="button" class="btn-close shadow-none" data-bs-dismiss="alert" aria-label="Close"></button>' +
                message + '</div>';
            $('#messageDiv').html(html);
            setTimeout(function () {
                $('#messageDiv').html('');
            }, 3000);
        }

        // 新增資料
        function addRow() {
            var stopDt = $('#new_STOP_DT').val();
            var stopVrfFn = $('#new_STOP_VRF_FN').val();
            var brewPreEdt = $('#new_BREW_PRE_EDT').val();
            var stopResn = $('#new_STOP_RESN').val();

            // 驗證必填欄位
            if (!stopDt) {
                showMessage('error', '請填寫停工日期');
                return;
            }
            if (!stopVrfFn) {
                showMessage('error', '請填寫核准停工文號');
                return;
            }
            if (!brewPreEdt) {
                showMessage('error', '請填寫停工前預定完成日');
                return;
            }
            if (!stopResn) {
                showMessage('error', '請填寫停工原因');
                return;
            }

            $.ajax({
                url: '@Url.Action("PAGE6_1_Add", "TDE0046")',
                type: 'POST',
                data: {
                    TD_CODE: TD_CODE,
                    SEQ_NO: nextSeqNo,
                    STOP_DT: stopDt,
                    STOP_VRF_DT: $('#new_STOP_VRF_DT').val(),
                    STOP_VRF_FN: stopVrfFn,
                    PRE_REWK_DT: $('#new_PRE_REWK_DT').val(),
                    REWK_DT: $('#new_REWK_DT').val(),
                    REWK_VRF_DT: $('#new_REWK_VRF_DT').val(),
                    REWK_VRF_FN: $('#new_REWK_VRF_FN').val(),
                    BREW_PRE_EDT: brewPreEdt,
                    AREW_PRE_EDT: $('#new_AREW_PRE_EDT').val(),
                    STOP_DAYS: $('#new_STOP_DAYS').val() || 0,
                    STOP_RESN: stopResn,
                    RELV_DESC: $('#new_RELV_DESC').val()
                },
                success: function (result) {
                    if (result.success) {
                        showMessage('success', result.message);
                        location.reload();
                    } else {
                        showMessage('error', result.message);
                    }
                },
                error: function (e) {
                    showMessage('error', '新增失敗：' + e.statusText);
                }
            });
        }

        // 更新資料
        function updateRow(btn) {
            var row = $(btn).closest('tr');
            var seqNo = row.data('seqno');

            var stopDt = row.find('[data-field="STOP_DT"]').val();
            var stopVrfFn = row.find('[data-field="STOP_VRF_FN"]').val();
            var brewPreEdt = row.find('[data-field="BREW_PRE_EDT"]').val();
            var stopResn = row.find('[data-field="STOP_RESN"]').val();

            // 驗證必填欄位
            if (!stopDt) {
                showMessage('error', '請填寫停工日期');
                return;
            }
            if (!stopVrfFn) {
                showMessage('error', '請填寫核准停工文號');
                return;
            }
            if (!brewPreEdt) {
                showMessage('error', '請填寫停工前預定完成日');
                return;
            }
            if (!stopResn) {
                showMessage('error', '請填寫停工原因');
                return;
            }

            $.ajax({
                url: '@Url.Action("PAGE6_1_Update", "TDE0046")',
                type: 'POST',
                data: {
                    TD_CODE: TD_CODE,
                    SEQ_NO: seqNo,
                    STOP_DT: stopDt,
                    STOP_VRF_DT: row.find('[data-field="STOP_VRF_DT"]').val(),
                    STOP_VRF_FN: stopVrfFn,
                    PRE_REWK_DT: row.find('[data-field="PRE_REWK_DT"]').val(),
                    REWK_DT: row.find('[data-field="REWK_DT"]').val(),
                    REWK_VRF_DT: row.find('[data-field="REWK_VRF_DT"]').val(),
                    REWK_VRF_FN: row.find('[data-field="REWK_VRF_FN"]').val(),
                    BREW_PRE_EDT: brewPreEdt,
                    AREW_PRE_EDT: row.find('[data-field="AREW_PRE_EDT"]').val(),
                    STOP_DAYS: row.find('[data-field="STOP_DAYS"]').val() || 0,
                    STOP_RESN: stopResn,
                    RELV_DESC: row.find('[data-field="RELV_DESC"]').val()
                },
                success: function (result) {
                    if (result.success) {
                        showMessage('success', result.message);
                    } else {
                        showMessage('error', result.message);
                    }
                },
                error: function () {
                    showMessage('error', '更新失敗');
                }
            });
        }

        // 刪除資料
        function deleteRow(btn) {
            if (!confirm('確定要刪除此筆停復工紀錄嗎？')) {
                return;
            }

            var row = $(btn).closest('tr');
            var seqNo = row.data('seqno');

            $.ajax({
                url: '@Url.Action("PAGE6_1_Delete", "TDE0046")',
                type: 'POST',
                data: {
                    TD_CODE: TD_CODE,
                    SEQ_NO: seqNo
                },
                success: function (result) {
                    if (result.success) {
                        showMessage('success', result.message);
                        row.remove();
                    } else {
                        showMessage('error', result.message);
                    }
                },
                error: function () {
                    showMessage('error', '刪除失敗');
                }
            });
        }
    </script>
</body>
</html>
