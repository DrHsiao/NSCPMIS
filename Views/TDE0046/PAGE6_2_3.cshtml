@using PagedList.Mvc
@model WCals.ViewModels.NewModels.TDE0040Model
@{
    ViewBag.Title = "扣款金額";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
 <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://code.jquery.com/ui/1.14.1/themes/base/jquery-ui.css" rel="stylesheet" />
    <script type="text/javascript" src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <style>
 body {
      padding: 10px;
   }
     .alert {
       margin: 10px 0;
    }
  .table-responsive {
  margin-top: 10px;
}
        .table {
  font-size: 13px;
        }
    .table th {
         background-color: #f0ad4e;
      color: white;
  vertical-align: middle;
  }
    
        /* 表格框線與排版美化 */
        .table-bordered { border: 0 !important; }
        .table-bordered th, .table-bordered td { border: 0 !important; border-bottom: 1px solid #e2e8f0 !important; }
        .table > thead > tr > th { 
            border-bottom: 2px solid #337ab7 !important; 
            background-color: #f8fafc; 
            color: #334155; 
        }
        .table > tbody > tr:last-child > td { border-bottom: 0 !important; }
</style>
</head>
<body>
  @if(TempData["Success"] != null) {
        <div class="alert alert-success alert-dismissible" role="alert">
 <button type="button" class="btn-close shadow-none" data-bs-dismiss="alert" aria-label="Close"></button>
         @TempData["Success"]
        </div>
    }
    @if(TempData["Error"] != null) {
   <div class="alert alert-danger alert-dismissible" role="alert">
         <button type="button" class="btn-close shadow-none" data-bs-dismiss="alert" aria-label="Close"></button>
      @TempData["Error"]
    </div>
    }

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
<tr>
  <th style="width: 20%;">期別</th>
   <th style="width: 30%;">估驗日期</th>
      <th style="width: 25%;">認可扣款金額</th>
    <th style="width: 25%;">備註</th>
        </tr>
       </thead>
      <tbody id="listBody">
    @if(ViewBag.List3 != null) {
    System.Data.DataTable dt = ViewBag.List3;
  foreach(System.Data.DataRow row in dt.Rows) {
     <tr>
     <td>@row["SEQ_NO"]</td>
      <td>@(row["ECC_DT"] != System.DBNull.Value ? row["ECC_DT"].ToString() : "")</td>
     <td style="text-align: right;">@(row["ECCDIS_FEE"] != System.DBNull.Value ? Convert.ToDecimal(row["ECCDIS_FEE"]).ToString("N0") : "0")</td>
    <td>@(row["NOTE"] != System.DBNull.Value ? row["NOTE"].ToString() : "")</td>
      </tr>
}
    } else {
 <tr>
           <td colspan="4" style="text-align: center; color: #999;">尚無資料</td>
   </tr>
   }
 </tbody>
        </table>
 </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
