@using PagedList;
@using PagedList.Mvc;
@model WCals.ViewModels.OGCUSERListViewModel

@{
    ViewBag.Title = "使用者管理 [0702]";
    Layout = "~/Views/Shared/_Layout2_v2.cshtml";
}

<div class="row">
    <div class="col-lg-12">
        <h1 class="page-header">
            使用者管理 [0702]

            <small> 提供使用者的列表顯示</small>
        </h1>
        <ol class="breadcrumb">
            <li>
                <i class="fa-solid fa-dashboard"></i><a href="@Url.Content("~/")Home"> 首頁</a>
            </li>
            <li class="active">
                <i class="fa-solid fa-file"></i>
                使用者管理 [0702]
            </li>
        </ol>
    </div>
</div>

@using (Html.BeginForm("Index", "WSMC0702", FormMethod.Post))
{
    <div class="row">
        <div class="col-md-12">
            <div class="form-inline">
                <div class="form-group">
                    <label>使用者代碼：</label>
                    @Html.EditorFor(f => f.SearchParameter.USR_ID, new { htmlAttributes = new { @class = "form-control", maxlength = "50" } })
                </div>
                <div class="form-group">
                    <label>AD帳號：</label>
                    @Html.EditorFor(f => f.SearchParameter.AD_USR_ID, new { htmlAttributes = new { @class = "form-control", maxlength = "50" } })
                </div>
                <div class="form-group">
                    <label>使用者名稱：</label>
                    @Html.EditorFor(f => f.SearchParameter.USR_NAME, new { htmlAttributes = new { @class = "form-control", maxlength = "200" } })
                </div>
                <input type="submit" class="btn btn-primary" value="查詢" />
            </div>
        </div>
    </div>
}
<h3 class="form-inline">
    <a href="\WSMC0702\New" class="btn btn-primary">新增</a>
</h3>
<div class="row">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-12">
                <div class="card shadow-sm border-0 mb-4 h-100 table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>使用者代碼</th>
                                <th>AD帳號</th>
                                <th>使用者名稱</th>
                                <th>Email</th>
                                <th>電話</th>
                                <th>行動電話</th>
                                <th>#</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model.OGCUSER)
                            {
                                <tr>
                                    <td>
                                        @user.USR_ID
                                    </td>
                                    <td>
                                        @user.USR_ID
                                    </td>
                                    <td>
                                        @user.USR_NAME
                                    </td>
                                    <td>
                                        @user.EMAIL
                                    </td>
                                    <td>
                                        @user.TEL_O
                                    </td>
                                    <td>
                                        @user.TEL_M
                                    </td>
                                    <td>
                                        <a href="/WSMC0702/Edit/@user.USR_ID" class="btn btn-secondary">內容</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>


        @Html.PagedListPager(Model.OGCUSER, page => Url.Action("PagedIndex", new { page }))
    </div>
</div>





