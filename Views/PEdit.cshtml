        function deletePJDFDND(SYR) {
            if (confirm("確定要刪除嗎?") == true) {
                var sample;
                var sampleJsonStr = $("#txtPJDFDND").val();
                if (sampleJsonStr != "") {
                    sample = jQuery.parseJSON(sampleJsonStr);
                    for (var i = 0; i < sample.length; i++) {
                        if (sample[i].DID == null) {
                            if (sample[i].SYR == SYR) {
                                sample.splice(i, 1);
                                //sample[i].METHOD = "delete";
                            }
                        }
                        else {
                            if (sample[i].SYR == SYR) {
                                //sample.splice(i, 1);
                                sample[i].METHOD = "delete";
                            }
                        }
                    }
                    var jsonstr = JSON.stringify(sample);
                    $("#txtPJDFDND").val(jsonstr);
                    showPJDFDNDDataToList();
                }
            }
        }

