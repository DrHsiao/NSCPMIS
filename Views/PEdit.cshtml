@model WCals.ViewModels.ProjectFundViewModel
@{
    ViewBag.Title = "計畫經費維護";
    Layout = "~/Views/Shared/_Layout2_v2.cshtml";
}

<div class="row">
    <div class="col-lg-12">
        <h1 class="page-header">
            計畫經費維護
            <small> 提供計畫經費維護管理</small>
        </h1>
        <ol class="breadcrumb">
            <li>
                <i class="fa-solid fa-dashboard"></i><a href="/Home"> 首頁</a>
            </li>
            <li>
                <i class="fa-solid fa-file"></i> <a href="/WPJM0103"> 計畫經費管理 [0103]</a>
            </li>
            <li class="active">
                <i class="fa-solid fa-file"></i>
                @Model.PJV_PJDYPSC.PJ_NAME @Model.PJV_PJDYPSC.E_CODE
            </li>
        </ol>
    </div>
</div>
@using (Html.BeginForm("PEdit", "WPJM0103", FormMethod.Post))
{
    @Html.HiddenFor(f => f.PJV_PJDYPSC.PJ_CODE)
    <div class="row">
        <div class="col-md-12">
            <div class="form-group">
                <label>計畫來源名稱</label>
                @Html.TextBoxFor(f => f.PJV_PJDYPSC.PJ_NAME, new { @class = "form-control", @readonly = "readonly" })
            </div>
            <div class="form-group">
                <label>工程編號字碼</label>
                @Html.TextBoxFor(f => f.PJV_PJDYPSC.E_CODE, new { @class = "form-control", @readonly = "readonly" })
            </div>
            <div class="form-group">
                <table id="tbquery" class="table table-hover">
                    <tr>
                        <th>
                            <label>修正次數</label>
                            @Html.DropDownListFor(f => f.SearchParameteVersion, (List<SelectListItem>)ViewBag.FIX_CNT, new { @class = "form-control", @onchange = "this.form.submit();" })
                        </th>
                        <th>
                            <label>年度</label>
                            @Html.DropDownListFor(f => f.SearchParameterYear, (SelectList)ViewBag.SYR_LIST, "請選擇", new { @class = "form-control", @onchange = "this.form.submit();" })
                        </th>
                    </tr>
                </table>
            </div>
            <div class="form-group">
                <label>分年經費</label>
                @if (Convert.ToInt16(Model.SearchParameteVersion) == Model.PJV_PJDYPSC.FIX_CNT) //最新一期才允許新增
                {
                    <p><button type="button" class="btn btn-warning" onclick="javascript: newPJDFDND()">新增</button></p>
                }
                <div class="card shadow-sm border-0 mb-4 h-100">
                    <div class="card-body table-responsive">
                        <table id="tbPJDFDND" class="table table-hover">
                            <thead>
                                <tr>
                                    <th>年度</th>
                                    <th>增加資本</th>
                                    <th>營運資金</th>
                                    <th>國內借款</th>
                                    <th>合計</th>
                                    <th>成立預算比(%)</th>
                                    <th>總累計分配</th>
                                    <th>累計支用比(%)</th>
                                    <th>#</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
            @Html.HiddenFor(f => f.jsonPJDFDND, new { @id = "txtPJDFDND" })
            @Html.HiddenFor(f => f.jsonPJDDSEX, new { @id = "txtPJDDSEX" })
            @Html.HiddenFor(f => f.jsonPJDACEX, new { @id = "txtPJDACEX" })

            @{ Html.RenderPartial("PJDYPACList");}

            @{ Html.RenderPartial("PJDREVFList");}

            @if (Convert.ToInt16(Model.SearchParameteVersion) == Model.PJV_PJDYPSC.FIX_CNT) //最新一期才允許儲存
            {
                <button class="btn btn-primary" type="submit">儲存</button>
            }
            else
            {
                <label class="alert-info">本期資料僅供唯讀!!  </label>
            }
            <a class="btn btn-secondary" href="/WPJM0103">取消</a>
        </div>
    </div>
}

<div id="modalPJDFDND" class="modal fade" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                <h4 class="modal-title">分年進度</h4>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>年度</label>
                    <input class="form-control" id="txtPJDFDND_SYR" type="text" placeholder="年度" />
                </div>
                <div class="form-group">
                    <label>增加資本(元)</label>
                    <input class="form-control" id="txtPJDFDND_AST_FUND" type="text" placeholder="增加資本(元)" />
                </div>
                <div class="form-group">
                    <label>營運資金(元)</label>
                    <input class="form-control" id="txtPJDFDND_OWN_FUND" type="text" placeholder="營運資金(元)" />
                </div>
                <div class="form-group">
                    <label>國內借款(元)</label>
                    <input class="form-control" id="txtPJDFDND_LON_FUND" type="text" placeholder="國內借款(元)" />

                </div>
            </div>
            <div class="modal-footer">
                <button type="button" id="btnNewPJDFDND" class="btn btn-primary" data-bs-dismiss="modal" onclick="javascript: savePJDFDND('new')">確定</button>
                <button type="button" id="btnEditPJDFDND" class="btn btn-primary" data-bs-dismiss="modal" onclick="javascript: savePJDFDND('edit')">確定</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">離開</button>
            </div>
        </div>

    </div>
</div>


