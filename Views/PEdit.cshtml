@section scripts
{
    <script type="text/javascript">
        function newPJDFDND() {
            $("#btnNewPJDFDND").show();
            $("#btnEditPJDFDND").hide();

            $("#txtPJDFDND_SYR").val();
            $("#txtPJDFDND_AST_FUND").val();
            $("#txtPJDFDND_OWN_FUND").val();
            $("#txtPJDFDND_LON_FUND").val();
            $("#txtPJDFDND_SYR").attr('disabled', false);

            $("#modalPJDFDND").modal("show");
        }

        function savePJDFDND(method) {

            var SYR = $("#txtPJDFDND_SYR").val();
            var AST_FUND = $("#txtPJDFDND_AST_FUND").val();
            var OWN_FUND = $("#txtPJDFDND_OWN_FUND").val();
            var LON_FUND = $("#txtPJDFDND_LON_FUND").val();
            var jsonStr = $("#txtPJDFDND").val();

            var sample = null;
            if (jsonStr == "") {
                sample = [];
            }
            else {
                sample = JSON.parse(jsonStr);
            }

            if (method == "new") {
                sample.push({
                    "SYR": SYR,
                    "AST_FUND": AST_FUND,
                    "OWN_FUND": OWN_FUND,
                    "LON_FUND": LON_FUND,
                    "METHOD": "new"
                });

            }
            else if (method == "edit") {
                var currObj = null;
                for (var i = 0; i < sample.length; i++) {
                    if (sample[i].SYR == SYR) {
                        currObj = sample[i];
                    }
                }
                if (currObj != null) {
                    currObj.SYR = $("#txtPJDFDND_SYR").val();
                    currObj.AST_FUND = $("#txtPJDFDND_AST_FUND").val();
                    currObj.OWN_FUND = $("#txtPJDFDND_OWN_FUND").val();
                    currObj.LON_FUND = $("#txtPJDFDND_LON_FUND").val();
                    currObj.METHOD = "edit";
                }
            }
            $("#txtPJDFDND").val(JSON.stringify(sample));

            showPJDFDNDDataToList();
        }



        function savePJDFDNDMNDS() {
            var SYR = $("#txtPJDFDND_SYR").val();
            var jsonStr = $("#txtPJDFDND").val();

            var sample = null;
            if (jsonStr == "") {
                sample = [];
            }
            else {
                sample = JSON.parse(jsonStr);
            }

             var currObj = null;
             for (var i = 0; i < sample.length; i++) {
                 if (sample[i].SYR == SYR) {
                       currObj = sample[i];
                  }
                if (currObj != null) {
                    currObj.SYR = $("#txtPJDFDND_SYR").val();
                    currObj.M_01=$("#txtPJDFDND_M_01").val();
                    currObj.M_02=$("#txtPJDFDND_M_02").val();
                    currObj.M_03=$("#txtPJDFDND_M_03").val();
                    currObj.M_04=$("#txtPJDFDND_M_04").val();
