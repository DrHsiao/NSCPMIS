@model WCals.ViewModels.NewModels.TDE0051Model
@{
    ViewBag.Title = "工程經費檢視";
    Layout = null;

    string tdName = Model.TD_NAME ?? "";
    System.Data.DataTable dtList = ViewBag.List1 as System.Data.DataTable;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <style>
        body {
            background-color: #f8f9fa;
            padding: 20px;
        }
        .info-label {
            font-weight: 600;
            color: #495057;
        }
        .info-value {
            font-size: 1.1rem;
            color: #212529;
        }
        .amount-value {
            font-family: 'Courier New', Courier, monospace;
            font-size: 1.25rem;
            font-weight: bold;
            color: #0d6efd;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold mb-0 text-primary">
                <i class="fa-solid fa-sack-dollar me-2"></i>工程經費明細
            </h2>
            <button type="button" onclick="top.closeEditDialog4();" class="btn btn-secondary shadow-sm">
                <i class="fa-solid fa-xmark me-2"></i>關閉視窗
            </button>
        </div>

        @if (dtList != null && dtList.Rows.Count > 0)
        {
            System.Data.DataRow row = dtList.Rows[0];
            string budgetFund = row["BUDGET_FUND"] != DBNull.Value ? Convert.ToDecimal(row["BUDGET_FUND"]).ToString("N0") : "0";
            string ctrctFund = row["CTRCT_FUND"] != DBNull.Value ? Convert.ToDecimal(row["CTRCT_FUND"]).ToString("N0") : "0";
            string tdStatDesc = row["TD_STAT_DESC"] != DBNull.Value ? row["TD_STAT_DESC"].ToString() : "";

            <div class="card shadow border-0">
                <div class="card-header bg-primary text-white fw-bold">
                    <i class="fa-solid fa-circle-info me-2"></i>經費來源：由各明細表系統自動加總，無法手動覆寫
                </div>
                <div class="card-body p-4">
                    <div class="row g-4">
                        <!-- 工程編號與名稱 -->
                        <div class="col-md-6">
                            <label class="info-label text-muted small mb-1">工程編號</label>
                            <div class="info-value bg-light p-2 rounded">@Model.TD_CODE</div>
                        </div>
                        <div class="col-md-6">
                            <label class="info-label text-muted small mb-1">工程名稱</label>
                            <div class="info-value bg-light p-2 rounded">@tdName</div>
                        </div>

                        <!-- 狀態與經費 -->
                        <div class="col-md-12">
                            <hr class="text-muted" />
                        </div>

                        <div class="col-md-4">
                            <label class="info-label text-muted small mb-1">目前執行狀態</label>
                            <div class="info-value"><span class="badge bg-info text-dark">@tdStatDesc</span></div>
                        </div>
                        <div class="col-md-4">
                            <div class="card bg-light border-primary border-opacity-25 h-100">
                                <div class="card-body text-center">
                                    <label class="info-label text-primary mb-2">動態預算金額</label>
                                    <div class="amount-value">@budgetFund <span class="fs-6 text-muted ms-1">千元</span></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card bg-light border-success border-opacity-25 h-100">
                                <div class="card-body text-center">
                                    <label class="info-label text-success mb-2">動態發包金額</label>
                                    <div class="amount-value text-success">@ctrctFund <span class="fs-6 text-muted ms-1">千元</span></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-white border-0 text-center py-3">
                    <button type="button" onclick="top.closeEditDialog4();" class="btn btn-secondary px-5 py-2">
                        <i class="fa-solid fa-door-open me-2"></i>了解並關閉
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-warning shadow-sm border-0 d-flex align-items-center">
                <i class="fa-solid fa-triangle-exclamation fs-3 me-3"></i>
                <div>
                    <h5 class="mb-1 fw-bold">查無工程資料</h5>
                    <p class="mb-0 text-muted">無法取得該工程的對應經費紀錄。</p>
                </div>
            </div>
        }
    </div>

    <!-- 腳本 -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
