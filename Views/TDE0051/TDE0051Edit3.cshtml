@model WCals.ViewModels.NewModels.TDE0051Model
@{
    ViewBag.Title = "進度異常編輯";
    Layout = null;

    string tdName = Model.TD_NAME ?? "";
    System.Data.DataTable dtList = ViewBag.List1 as System.Data.DataTable;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script type="text/javascript" src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <style>
        .section-header {
            background-color: #f5f5f5;
            border-left: 4px solid #0275d8;
            padding: 10px 15px;
            margin-top: 20px;
            margin-bottom: 15px;
            font-weight: bold;
            font-size: 14px;
        }
        .form-group label {
            font-weight: bold;
        }
        .diff-warning {
            color: #d9534f;
            font-weight: bold;
        }
            /* BS3 form-horizontal 相容 shim (BS5 移除 form-group 的 row 行為) */
        .form-horizontal .form-group{display:flex;flex-wrap:wrap;align-items:center;margin-bottom:1rem;}
        .form-horizontal .form-group>.col-form-label{text-align:right;}
</style>
</head>
<body style="padding:5px;">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible" role="alert" id="successAlert">
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible" role="alert" id="errorAlert">
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            @TempData["Error"]
        </div>
    }

    <div id="messageDiv"></div>

    <button type="button" onclick="top.closeEditDialog3();" class="btn btn-secondary btn-lg">關閉</button>

    <h1 class="page-header">進度異常填報 - @tdName</h1>

    <div class="section-header">前月進度資料 (TDDMSCD)</div>

    @if (dtList != null && dtList.Rows.Count > 0)
    {
        System.Data.DataRow row = dtList.Rows[0];
        string syr = row["SYR"] != DBNull.Value ? row["SYR"].ToString() : "";
        string smn = row["SMN"] != DBNull.Value ? row["SMN"].ToString() : "";
        string preSchd = row["PRE_SCHD"] != DBNull.Value ? Convert.ToDecimal(row["PRE_SCHD"]).ToString("0.##") : "";
        string relSchd = row["REL_SCHD"] != DBNull.Value ? Convert.ToDecimal(row["REL_SCHD"]).ToString("0.##") : "";
        string diffSchd = "";
        if (row["PRE_SCHD"] != DBNull.Value && row["REL_SCHD"] != DBNull.Value)
        {
            decimal pre = Convert.ToDecimal(row["PRE_SCHD"]);
            decimal rel = Convert.ToDecimal(row["REL_SCHD"]);
            diffSchd = Math.Abs(pre - rel).ToString("0.##");
        }
        string delayResn = row["DELAY_RESN"] != DBNull.Value ? row["DELAY_RESN"].ToString() : "";
        string reslvMthd = row["RESLV_MTHD"] != DBNull.Value ? row["RESLV_MTHD"].ToString() : "";

        <div class="card shadow-sm border-0 mb-4 h-100">
            <div class="card-body">
                <form id="editForm" class="form-horizontal">
                    <input type="hidden" id="SYR" value="@syr" />
                    <input type="hidden" id="SMN" value="@smn" />

                    <div class="form-group">
                        <label class="col-sm-2 col-form-label">工程編號</label>
                        <div class="col-sm-10">
                            <p class="form-control-static">@Model.TD_CODE</p>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-2 col-form-label">工程名稱</label>
                        <div class="col-sm-10">
                            <p class="form-control-static">@tdName</p>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-2 col-form-label">年月</label>
                        <div class="col-sm-10">
                            <p class="form-control-static">@syr 年 @smn 月</p>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-2 col-form-label">預定進度(%)</label>
                        <div class="col-sm-3">
                            <input type="number" id="PRE_SCHD" name="PRE_SCHD" value="@preSchd" class="form-control" step="0.01" style="text-align: right;" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-2 col-form-label">實際進度(%)</label>
                        <div class="col-sm-3">
                            <input type="number" id="REL_SCHD" name="REL_SCHD" value="@relSchd" class="form-control" step="0.01" style="text-align: right;" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-2 col-form-label">進度差異</label>
                        <div class="col-sm-10">
                            <p class="form-control-static diff-warning" id="diffDisplay">@diffSchd %</p>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-2 col-form-label">落後原因</label>
                        <div class="col-sm-10">
                            <textarea id="DELAY_RESN" name="DELAY_RESN" class="form-control" rows="3">@delayResn</textarea>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-2 col-form-label">解決方式</label>
                        <div class="col-sm-10">
                            <textarea id="RESLV_MTHD" name="RESLV_MTHD" class="form-control" rows="3">@reslvMthd</textarea>
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-sm-offset-2 col-sm-10">
                            <button type="button" class="btn btn-primary btn-lg" onclick="saveData();">儲存</button>
                            <button type="button" onclick="top.closeEditDialog3();" class="btn btn-secondary btn-lg">關閉</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning">查無前月進度資料</div>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        var TD_CODE = '@Model.TD_CODE';

        // 計算進度差異
        function calcDiff() {
            var pre = parseFloat($('#PRE_SCHD').val()) || 0;
            var rel = parseFloat($('#REL_SCHD').val()) || 0;
            var diff = Math.abs(pre - rel).toFixed(2);
            $('#diffDisplay').text(diff + ' %');
        }

        $(document).ready(function () {
            $('#PRE_SCHD, #REL_SCHD').on('change keyup', calcDiff);
        });

        function showMessage(type, message) {
            var alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
            var html = '<div class="alert ' + alertClass + ' alert-dismissible" role="alert">' +
                '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>' +
                message + '</div>';
            $('#messageDiv').html(html);
            setTimeout(function () {
                $('#messageDiv').html('');
            }, 3000);
        }

        // 儲存資料
        function saveData() {
            var syr = $('#SYR').val();
            var smn = $('#SMN').val();
            var preSchd = $('#PRE_SCHD').val();
            var relSchd = $('#REL_SCHD').val();
            var delayResn = $('#DELAY_RESN').val();
            var reslvMthd = $('#RESLV_MTHD').val();

            $.ajax({
                url: '@Url.Action("Edit3Update", "TDE0051")',
                type: 'POST',
                data: {
                    TD_CODE: TD_CODE,
                    SYR: syr,
                    SMN: smn,
                    PRE_SCHD: preSchd || null,
                    REL_SCHD: relSchd || null,
                    DELAY_RESN: delayResn || null,
                    RESLV_MTHD: reslvMthd || null
                },
                success: function (result) {
                    if (result.success) {
                        showMessage('success', result.message);
                    } else {
                        showMessage('error', result.message);
                    }
                },
                error: function () {
                    showMessage('error', '更新失敗');
                }
            });
        }
    </script>
</body>
</html>
