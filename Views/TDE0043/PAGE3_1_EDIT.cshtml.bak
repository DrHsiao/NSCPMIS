@using PagedList.Mvc
@model WCals.ViewModels.NewModels.TDE0040Model
@{
    ViewBag.Title = "預算/契約資料編輯";
    Layout = null;

    string recTpName = "";
    string bgrcName = "";
    if(Model.TDDBGRC != null) {
        switch(Model.TDDBGRC.REC_TP) {
    case "B": recTpName = "預算資料"; break;
 case "C": recTpName = "契約資料"; break;
    case "S": recTpName = "結算資料"; break;
 case "F": recTpName = "決算資料"; break;
    }
        if(Model.TDDBGRC.SEQ_NO == 0) {
      switch(Model.TDDBGRC.REC_TP) {
          case "B": bgrcName = "原預算"; break;
                case "C": bgrcName = "原契約"; break;
case "S": bgrcName = "結算"; break;
                case "F": bgrcName = "決算"; break;
            }
        } else {
       switch(Model.TDDBGRC.REC_TP) {
        case "B": bgrcName = "第" + Model.TDDBGRC.SEQ_NO + "次修正預算"; break;
  case "C": bgrcName = "第" + Model.TDDBGRC.SEQ_NO + "次契約變更"; break;
       case "S": bgrcName = "結算"; break;
     case "F": bgrcName = "決算"; break;
        }
        }
    }
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <link href="~/Content/bootstrap-nav-panel.css" rel="stylesheet" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script type="text/javascript" src="~/Scripts/jquery-3.7.1.min.js"></script>
    <title>@ViewBag.Title - My ASP.NET Application</title>
  <link href="~/Content/themes/base/jquery-ui.theme.css" rel="stylesheet" />
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <script src="~/Scripts/modernizr-2.8.3.js"></script>
    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <link href="~/Content/bootstrap-select.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/Scripts/plugins/bootstrap-fileinput/icon.mini.css" crossorigin="anonymous">
    <link href="~/Scripts/plugins/bootstrap-fileinput/fileinput.min.css" media="all" rel="stylesheet" type="text/css" />
  <style>
        .section-header {
 background-color: #f5f5f5;
         border-left: 4px solid #0275d8;
     padding: 10px 15px;
         margin-top: 20px;
            margin-bottom: 15px;
   font-weight: bold;
   font-size: 14px;
        }
    </style>
</head>
<body style="padding:5px;">
    @if(TempData["Success"] != null) {
        <div class="alert alert-success alert-dismissible" role="alert">
            <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
       @TempData["Success"]
  </div>
    }
    @if(TempData["Error"] != null) {
        <div class="alert alert-danger alert-dismissible" role="alert">
     <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            @TempData["Error"]
  </div>
    }

    @using(Html.BeginForm("PAGE3_1_EDIT_Save", "TDE0043", FormMethod.Post, new { data_toggle = "validator", role = "form", id = "mainForm", enctype = "multipart/form-data" })) {

        @Html.AntiForgeryToken()

        <button type="submit" class="btn btn-warning btn-lg">儲存</button>
        <button type="button" onclick="top.smartClose();" class="btn btn-default btn-lg">關閉</button>

     <h1 class="page-header">@recTpName 編輯 - @Model.TDMFORM.TD_NAME</h1>
        <h4>@bgrcName</h4>

        @Html.HiddenFor(m => m.TDDBGRC.BGFID)
        @Html.HiddenFor(m => m.TDDBGRC.TD_CODE)
        @Html.HiddenFor(m => m.TDDBGRC.REC_TP)
    @Html.HiddenFor(m => m.TDDBGRC.SEQ_NO)

        <!-- 基本資料 Section -->
<div class="section-header">基本資料</div>
      <table class="table table-condensed">
  <tr>
         <td>
         <div class="row">
         <div class="col-md-6">
 <div class="form-group">
       <div class="input-group">
        <span class="input-group-addon">工程編號</span>
   @Html.TextBoxFor(m => m.TDDBGRC.TD_CODE, new { @class = "form-control", @readonly = "readonly" })
       </div>
    </div>
        </div>
     <div class="col-md-6">
  <div class="form-group">
         <div class="input-group">
          <span class="input-group-addon">期別</span>
               <input type="text" class="form-control" value="@bgrcName" readonly="readonly" />
      </div>
             </div>
            </div>
     </div>
  </td>
  </tr>
        </table>

        <!-- 送核資料 Section -->
        <div class="section-header">送核資料</div>
        <table class="table table-condensed">
            <tr>
           <td>
     <div class="row">
<div class="col-md-6">
   <div class="form-group">
     <div class="input-group">
                <span class="input-group-addon">送核日期</span>
          @Html.TextBoxFor(m => m.TDDBGRC.SVRF_DT, new { @class = "form-control dt" })
      </div>
      </div>
   </div>
    <div class="col-md-6">
   <div class="form-group">
           <div class="input-group">
    <span class="input-group-addon">送核日期文號</span>
   @Html.TextBoxFor(m => m.TDDBGRC.SVRF_FNO, new { @class = "form-control" })
</div>
        </div>
             </div>
         </div>
        </td>
    </tr>
    <tr>
     <td>
     <div class="row">
          <div class="col-md-6">
        <div class="form-group">
 <div class="input-group">
         <span class="input-group-addon">核示日期</span>
        @Html.TextBoxFor(m => m.TDDBGRC.CVRF_DT, new { @class = "form-control dt" })
           </div>
           </div>
      </div>
               <div class="col-md-6">
   <div class="form-group">
    <div class="input-group">
        <span class="input-group-addon">核示日期文號</span>
    @Html.TextBoxFor(m => m.TDDBGRC.CVRF_FNO, new { @class = "form-control" })
     </div>
 </div>
      </div>
              </div>
           </td>
            </tr>
        </table>

        <!-- 經費資料 Section -->
        <div class="section-header">經費資料</div>
        <table class="table table-condensed">
            <tr>
        <td>
    <div class="row">
 <div class="col-md-6">
         <div class="form-group">
      <div class="input-group">
       <span class="input-group-addon">預算/契約日期</span>
       @Html.TextBoxFor(m => m.TDDBGRC.BGRC_DT, new { @class = "form-control dt" })
         </div>
      </div>
     </div>
         </div>
 </td>
       </tr>
       <tr>
  <td>
    <div class="row">
  <div class="col-md-4">
            <div class="form-group">
                 <div class="input-group">
                     <span class="input-group-addon">前期經費(元)</span>
            @Html.TextBoxFor(m => m.TDDBGRC.PIROR_FEE, new { @class = "form-control", type = "number" })
 </div>
   </div>
        </div>
       <div class="col-md-4">
           <div class="form-group">
      <div class="input-group">
          <span class="input-group-addon">本期經費(元)</span>
     @Html.TextBoxFor(m => m.TDDBGRC.CUR_FEE, new { @class = "form-control", type = "number" })
  </div>
  </div>
  </div>
               <div class="col-md-4">
 <div class="form-group">
          <div class="input-group">
              <span class="input-group-addon">本期變更經費(元)</span>
       @Html.TextBoxFor(m => m.TDDBGRC.CUR_CHGFEE, new { @class = "form-control", type = "number" })
           </div>
          </div>
      </div>
     </div>
          </td>
            </tr>
   </table>

        <!-- 按鈕區 -->
      <table class="table">
   <tr>
  <td>
<button type="submit" class="btn btn-warning btn-lg">儲存</button>
   <button type="button" onclick="smartClose();" class="btn btn-default btn-lg">關閉</button>
       </td>
            </tr>
        </table>
    }

    <script src="~/Scripts/bootstrap.min.js"></script>
    <script type="text/javascript" src="https://code.jquery.com/ui/1.14.1/jquery-ui.min.js"></script>
    <script type="text/javascript" src="~/Scripts/jquery.datepick.js"></script>
    <script type="text/javascript" src="~/Scripts/MyDatepickerJ.js"></script>
    <script src="~/Scripts/plugins/bootstrap-fileinput/fileinput.js"></script>
    <script src="~/Scripts/plugins/bootstrap-fileinput/zh-TW.js"></script>
    <script src="~/Scripts/bootstrap-select.js"></script>
    <script src="~/Scripts/validator.min.js"></script>
    <script>
     // 日期選擇器初始化
        $(".dt").datepickerTW({
            changeYear: true,
            changeMonth: true,
            yearRange: '68:168',
     dateFormat: 'yymmdd'
        });

      $(".dt").datepickerTW({
    onSelect: function (dateText) {
      $('#mainForm').validator('validate');
       }
    });

   $('.dt').click(function () {
   $(this).delay(600).val("");
     });

        function smartClose() {
            try {
                // 1. 取得阿公層 (TDE0040)
                // 如果是 3 層結構 (Add Mode)，parent 是 PAGE3，parent.parent 才是 TDE0040
                // 如果是 2 層結構 (Edit Mode)，parent 就是 TDE0040
                // 我們直接找最頂層的 window.top 或是往上找

                var root = null;
                if (window.parent && window.parent.close3) {
                    root = window.parent; // 2層結構
                } else if (window.parent.parent && window.parent.parent.close3) {
                    root = window.parent.parent; // 3層結構 (您現在的情況!)
                }

                if (root) {
                    // 優先嘗試關閉「預算管制」大視窗 (因為您是在頁籤內換頁)
                    if (typeof root.close3 === 'function') {
                        root.close3();
                        return;
                    }
                    // 如果不是大視窗，嘗試關閉「編輯」小視窗
                    if (typeof root.close3_1_Edit === 'function') {
                        root.close3_1_Edit();
                        return;
                    }
                } else {
                    // 如果真的找不到，試著用暴力法關閉最近的 Dialog
                    if (window.parent.$) window.parent.$('.ui-dialog-content:visible').dialog('close');
                    else if (window.parent.parent.$) window.parent.parent.$('.ui-dialog-content:visible').dialog('close');
                }

            } catch (e) {
                alert("關閉失敗，請手動關閉視窗");
                console.error(e);
            }
        }
    </script>
</body>
</html>