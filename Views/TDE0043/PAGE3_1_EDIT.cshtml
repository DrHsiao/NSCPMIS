@using PagedList.Mvc
@model WCals.ViewModels.NewModels.TDE0040Model
@{
    ViewBag.Title = "預算/契約資料編輯";
    Layout = null;

    string recTpName = "";
    string bgrcName = "";
    if(Model.TDDBGRC != null) {
        switch(Model.TDDBGRC.REC_TP) {
    case "B": recTpName = "預算資料"; break;
 case "C": recTpName = "契約資料"; break;
    case "S": recTpName = "結算資料"; break;
 case "F": recTpName = "決算資料"; break;
    }
        if(Model.TDDBGRC.SEQ_NO == 0) {
      switch(Model.TDDBGRC.REC_TP) {
          case "B": bgrcName = "原預算"; break;
                case "C": bgrcName = "原契約"; break;
case "S": bgrcName = "結算"; break;
                case "F": bgrcName = "決算"; break;
            }
        } else {
       switch(Model.TDDBGRC.REC_TP) {
        case "B": bgrcName = "第" + Model.TDDBGRC.SEQ_NO + "次修正預算"; break;
  case "C": bgrcName = "第" + Model.TDDBGRC.SEQ_NO + "次契約變更"; break;
       case "S": bgrcName = "結算"; break;
     case "F": bgrcName = "決算"; break;
        }
        }
    }
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script type="text/javascript" src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <title>@ViewBag.Title - My ASP.NET Application</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
      <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="~/Scripts/modernizr-2.8.3.js"></script>
    <link href="https://code.jquery.com/ui/1.14.1/themes/base/jquery-ui.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/Scripts/plugins/bootstrap-fileinput/icon.mini.css" crossorigin="anonymous">
    <link href="~/Scripts/plugins/bootstrap-fileinput/fileinput.min.css" media="all" rel="stylesheet" type="text/css" />
  <style>
        .section-header {
 background-color: #f5f5f5;
         border-left: 4px solid #0275d8;
     padding: 10px 15px;
         margin-top: 20px;
            margin-bottom: 15px;
   font-weight: bold;
   font-size: 14px;
        }
        .ui-datepicker { z-index: 2200 !important; background: #ffffff; border: 1px solid #cccccc; border-radius: 4px; }
    
        /* 表格框線與排版美化 */
        .table-bordered { border: 0 !important; }
        .table-bordered th, .table-bordered td { border: 0 !important; border-bottom: 1px solid #e2e8f0 !important; }
        .table > thead > tr > th { 
            border-bottom: 2px solid #337ab7 !important; 
            background-color: #f8fafc; 
            color: #334155; 
        }
        .table > tbody > tr:last-child > td { border-bottom: 0 !important; }
</style>
    <link href="~/Content/bs3-compat.css" rel="stylesheet" />
</head>
<body style="padding:5px;">
    @if(TempData["Success"] != null) {
        <div class="alert alert-success alert-dismissible" role="alert">
            <button type="button" class="btn-close shadow-none" data-bs-dismiss="alert" aria-label="Close"></button>
       @TempData["Success"]
  </div>
    }
    @if(TempData["Error"] != null) {
        <div class="alert alert-danger alert-dismissible" role="alert">
     <button type="button" class="btn-close shadow-none" data-bs-dismiss="alert" aria-label="Close"></button>
            @TempData["Error"]
  </div>
    }

    @using(Html.BeginForm("PAGE3_1_EDIT_Save", "TDE0043", FormMethod.Post, new { data_toggle = "validator", role = "form", id = "mainForm", enctype = "multipart/form-data" })) {

        @Html.AntiForgeryToken()

        <button type="submit" class="btn btn-primary shadow-sm btn-lg"><i class="fa-solid fa-floppy-disk me-1"></i> 儲存</button>
        <button type="button" onclick="closeEdit();" class="btn btn-outline-secondary shadow-sm btn-lg"><i class="fa-solid fa-xmark me-1"></i> 關閉</button>

     <h1 class="page-header">@recTpName 編輯 - @Model.TDMFORM.TD_NAME</h1>
        <h4>@bgrcName</h4>

        @Html.HiddenFor(m => m.TDDBGRC.BGFID)
        @Html.HiddenFor(m => m.TDDBGRC.TD_CODE)
        @Html.HiddenFor(m => m.TDDBGRC.REC_TP)
    @Html.HiddenFor(m => m.TDDBGRC.SEQ_NO)

        <!-- 基本資料 Section -->
<div class="section-header">基本資料</div>
      <table class="table table-sm">
  <tr>
         <td>
         <div class="row">
         <div class="col-md-6">
 <div class="form-group">
       <div class="input-group">
        <span class="input-group-text">工程編號</span>
   @Html.TextBoxFor(m => m.TDDBGRC.TD_CODE, new { @class = "form-control", @readonly = "readonly" })
       </div>
    </div>
        </div>
     <div class="col-md-6">
  <div class="form-group">
         <div class="input-group">
          <span class="input-group-text">期別</span>
               <input type="text" class="form-control" value="@bgrcName" readonly="readonly" />
      </div>
             </div>
            </div>
     </div>
  </td>
  </tr>
        </table>

        <!-- 送核資料 Section -->
        <div class="section-header">送核資料</div>
        <table class="table table-sm">
            <tr>
           <td>
     <div class="row">
<div class="col-md-6">
   <div class="form-group">
     <div class="input-group">
                <span class="input-group-text">送核日期</span>
          @Html.TextBoxFor(m => m.TDDBGRC.SVRF_DT, new { @class = "form-control dt" })
      </div>
      </div>
   </div>
    <div class="col-md-6">
   <div class="form-group">
           <div class="input-group">
    <span class="input-group-text">送核日期文號</span>
   @Html.TextBoxFor(m => m.TDDBGRC.SVRF_FNO, new { @class = "form-control" })
</div>
        </div>
             </div>
         </div>
        </td>
    </tr>
    <tr>
     <td>
     <div class="row">
          <div class="col-md-6">
        <div class="form-group">
 <div class="input-group">
         <span class="input-group-text">核示日期</span>
        @Html.TextBoxFor(m => m.TDDBGRC.CVRF_DT, new { @class = "form-control dt" })
           </div>
           </div>
      </div>
               <div class="col-md-6">
   <div class="form-group">
    <div class="input-group">
        <span class="input-group-text">核示日期文號</span>
    @Html.TextBoxFor(m => m.TDDBGRC.CVRF_FNO, new { @class = "form-control" })
     </div>
 </div>
      </div>
              </div>
           </td>
            </tr>
        </table>

        <!-- 經費資料 Section -->
        <div class="section-header">經費資料</div>
        <table class="table table-sm">
            <tr>
        <td>
    <div class="row">
 <div class="col-md-6">
         <div class="form-group">
      <div class="input-group">
       <span class="input-group-text">預算/契約日期</span>
       @Html.TextBoxFor(m => m.TDDBGRC.BGRC_DT, new { @class = "form-control dt" })
         </div>
      </div>
     </div>
         </div>
 </td>
       </tr>
       <tr>
  <td>
    <div class="row">
  <div class="col-md-4">
            <div class="form-group">
                 <div class="input-group">
                     <span class="input-group-text">前期經費(元)</span>
            @Html.TextBoxFor(m => m.TDDBGRC.PIROR_FEE, new { @class = "form-control", type = "number" })
 </div>
   </div>
        </div>
       <div class="col-md-4">
           <div class="form-group">
      <div class="input-group">
          <span class="input-group-text">本期經費(元)</span>
     @Html.TextBoxFor(m => m.TDDBGRC.CUR_FEE, new { @class = "form-control", type = "number" })
  </div>
  </div>
  </div>
               <div class="col-md-4">
 <div class="form-group">
          <div class="input-group">
              <span class="input-group-text">本期變更經費(元)</span>
       @Html.TextBoxFor(m => m.TDDBGRC.CUR_CHGFEE, new { @class = "form-control", type = "number" })
           </div>
          </div>
      </div>
     </div>
          </td>
            </tr>
   </table>

        <!-- 按鈕區 -->
      <table class="table">
   <tr>
  <td>
<button type="submit" class="btn btn-primary shadow-sm btn-lg"><i class="fa-solid fa-floppy-disk me-1"></i> 儲存</button>
   <button type="button" onclick="closeEdit();" class="btn btn-outline-secondary shadow-sm btn-lg"><i class="fa-solid fa-xmark me-1"></i> 關閉</button>
       </td>
            </tr>
        </table>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/ui/1.14.1/jquery-ui.min.js"></script>
    <script type="text/javascript" src="~/Scripts/jquery.datepick.js"></script>
    <script type="text/javascript" src="~/Scripts/MyDatepickerJ.js"></script>
    <script src="~/Scripts/plugins/bootstrap-fileinput/fileinput.js"></script>
    <script src="~/Scripts/plugins/bootstrap-fileinput/zh-TW.js"></script>
    <script src="~/Scripts/validator.min.js"></script>
    <script>
     // 日期選擇器初始化
        $(".dt").datepickerTW({
            changeYear: true,
            changeMonth: true,
            yearRange: '68:168',
     dateFormat: 'yymmdd'
        });

      $(".dt").datepickerTW({
    onSelect: function (dateText) {
      $('#mainForm').validator('validate');
       }
    });

   $('.dt').click(function () {
   $(this).delay(600).val("");
     });

    // 3.1.4rev：本頁有兩種進入方式，關閉行為必須跟著切換
    //   (1) 列表的「修改」→ open3_1_Edit() 開在 #PAGE3_1_EDIT 對話框(iframe=PAGE3_1_EDITFrame)
    //   (2) 「新增修正」→ POST 後 RedirectToAction 直接取代預算管制頁的 iframe 內容
    // 原本一律呼叫 top.close3_1_Edit()，情況(2) 因為該對話框根本沒開，按下去毫無反應
    // (業主回報「新增跳出的畫面沒有辦法執行關閉」)，故改為依情境返回列表。
    function closeEdit() {
        var fe = null;
        try { fe = window.frameElement; } catch (e) { }
        if (fe && fe.id === "PAGE3_1_EDITFrame" && top && typeof top.close3_1_Edit === "function") {
            top.close3_1_Edit();
        } else {
            @* 3.1.4rev2：原本寫 @@Model.TD_CODE，但 controller 建立 model 時只設 TDMFORM / TDDBGRC，
               沒有設 TD_CODE，會渲染成空字串 → 導向 PAGE3_1?TD_CODE= 而出錯。改取 TDMFORM.TD_CODE。 *@
            location.href = "@Url.Action("PAGE3_1", "TDE0043")?TD_CODE=@(Model.TDMFORM != null ? Model.TDMFORM.TD_CODE : "")&REC_TP=@(Model.TDDBGRC != null ? Model.TDDBGRC.REC_TP : "B")";
        }
    }
    </script>
</body>
</html>