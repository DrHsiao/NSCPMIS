        // 顯示解析後的資料
        function displayParsedData(result) {
            // 顯示標案資訊
            if (result.tenderInfo) {
                $('#infoContractNo').text(result.tenderInfo.contractNo || '-');
                $('#infoProcuringEntity').text(result.tenderInfo.procuringEntity || '-');
                $('#infoContractTitle').text(result.tenderInfo.contractTitle || '-');
                $('#infoDocumentType').text(result.tenderInfo.documentType === 'budget' ? 'Budget' : 'Contract');
                $('#tenderInfoBar').show();
            }

            // 顯示統計資訊
            if (result.itemStats) {
                $('#statMainItem').text(result.itemStats.mainItemCount);
                $('#statGeneral').text(result.itemStats.generalCount);
                $('#statVariable').text(result.itemStats.variablePriceCount);
                $('#statSubtotal').text(result.itemStats.subtotalCount);
                $('#statsBar').show();
            }

            // 切換顯示區域
            $('#uploadPanel').hide();
            $('#existingInfoBar').hide();
            $('#dataPanel').show();
            $('#btnSaveToDb').show();

            // 載入 DetailList 並建立樹狀結構
            loadDetailListAndBuildTree();
        }

        // 載入 DetailList 資料並建立樹狀結構
        function loadDetailListAndBuildTree() {
            $('#loadingOverlay').show();

            $.ajax({
                url: '@Url.Action("PAGE3_1_EDIT_E_GetTableData", "TDE0043")',
                type: 'GET',
                data: { TD_CODE: TD_CODE, REC_TP: REC_TP, SEQ_NO: SEQ_NO, tableName: 'DetailList', page: 1, pageSize: 10000 },
                success: function (result) {
                    $('#loadingOverlay').hide();
                    if (result.success) {
                        detailListData = result.data;
                        buildTreeView(result.data);
                    } else {
                        alert('載入資料失敗：' + result.message);
                    }
                },
                error: function () {
                    $('#loadingOverlay').hide();
                    alert('載入失敗');
                }
            });
        }

        // 建立樹狀結構 (從新解析的 XML)
        function buildTreeView(data) {
            var itemMap = {};
            var rootItems = [];

            $.each(data, function (i, item) {
   item.children = [];
          itemMap[item.ItemKey] = item;
   });

            $.each(data, function (i, item) {
                if (item.ParentItemKey && itemMap[item.ParentItemKey]) {
     itemMap[item.ParentItemKey].children.push(item);
        } else {
              rootItems.push(item);
             }
            });

            var html = '<ul>' + buildTreeNodes(rootItems) + '</ul>';
          $('#treeView').html(html);
            bindTreeEvents();
      }

        // 遞迴建立樹節點 (從新解析的 XML)
 function buildTreeNodes(items) {
       var html = '';
   $.each(items, function (i, item) {
  var hasChildren = item.children && item.children.length > 0;
var itemNo = item.ItemNo || '';
                var desc = item.Description || '(無說明)';
         var displayText = itemNo ? itemNo + ' ' + desc : desc;
        var amount = item.Amount ? formatNumber(item.Amount) : '';
          var itemKind = item.ItemKind || '';
            
   // 轉換 ItemKind 為 ITEM_TYPE
                var itemType = '';
  switch (itemKind) {
           case 'mainItem': itemType = 'M'; break;
           case 'general': itemType = 'G'; break;
   case 'variablePrice': itemType = 'V'; break;
           case 'subtotal': itemType = 'S'; break;
                }

         html += '<li>';
        html += '<div class="tree-node" data-item-key="' + item.ItemKey + '" data-item-type="' + itemType + '">';

       if (hasChildren) {
 html += '<span class="toggle-icon"><i class="fa-solid fa-plus"></i></span>';
    } else {
         html += '<span class="toggle-icon"></span>';
  }

     if (hasChildren) {
         html += '<i class="fa-solid fa-folder node-icon"></i>';
    } else {
         html += '<i class="fa-solid fa-file node-icon"></i>';
         }

// 項目類型標記
                if (itemType) {
      var typeName = '';
             switch (itemType) {
            case 'M': typeName = '主'; break;
            case 'G': typeName = '一般'; break;
        case 'V': typeName = '變動'; break;
    case 'S': typeName = '小計'; break;
              }
     if (typeName) {
        html += '<span class="item-type-badge item-type-' + itemType + '">' + typeName + '</span>';
       }
   }

       html += '<span class="node-text">' + displayText + '</span>';
     if (amount) {
    html += '<span class="node-amount">(' + amount + ')</span>';
              }

      html += '</div>';

  if (hasChildren) {
  html += '<ul class="tree-children">' + buildTreeNodes(item.children) + '</ul>';
    }

            html += '</li>';
  });
  return html;
  }

        // 綁定樹狀結構事件 (新解析的 XML 資料)
