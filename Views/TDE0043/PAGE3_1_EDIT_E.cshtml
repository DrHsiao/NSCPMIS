        function saveToDatabase() {
            if (!confirm('將解析後的資料儲存到資料庫?')) {
                return;
            }

            $('#loadingOverlay').show();

            $.ajax({
                url: '@Url.Action("PAGE3_1_EDIT_E_SaveToDatabase", "TDE0043")',
                type: 'POST',
                data: {
                    TD_CODE: TD_CODE,
                    SEQ_NO: SEQ_NO,
                    REC_TP: REC_TP,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (result) {
                    $('#loadingOverlay').hide();
                    if (result.success) {
                        alert(result.message);
                        // 重新載入頁面以顯示新資料
                        location.reload();
                    } else {
                        alert('儲存失敗：' + result.message);
                    }
                },
                error: function () {
                    $('#loadingOverlay').hide();
                    alert('儲存失敗');
                }
            });
        }
