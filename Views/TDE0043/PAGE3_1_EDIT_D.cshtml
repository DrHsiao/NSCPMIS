@using PagedList.Mvc
@model WCals.ViewModels.NewModels.TDE0040Model
@{
    ViewBag.Title = "經費款項編輯";
    Layout = null;

    string recTpName = "";
    string bgrcName = "";
    string recTp = ViewBag.REC_TP as string ?? "";

    switch(recTp) {
        case "B": recTpName = "預算資料"; bgrcName = "預算"; break;
        case "C": recTpName = "契約資料"; bgrcName = "契約"; break;
        case "S": recTpName = "結算資料"; bgrcName = "結算"; break;
        case "F": recTpName = "決算資料"; bgrcName = "決算"; break;
    }

    string tdName = "";
    if(Model.TDMFORM != null) {
        tdName = Model.TDMFORM.TD_NAME;
    }

    System.Data.DataTable dtList = ViewBag.List1 as System.Data.DataTable;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script type="text/javascript" src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <title>@ViewBag.Title - My ASP.NET Application</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="~/Scripts/modernizr-2.8.3.js"></script>
    <link href="https://code.jquery.com/ui/1.14.1/themes/base/jquery-ui.css" rel="stylesheet" />
    <style>
        .section-header {
            background-color: #f5f5f5;
            border-left: 4px solid #0275d8;
            padding: 10px 15px;
            margin-top: 20px;
            margin-bottom: 15px;
            font-weight: bold;
            font-size: 14px;
        }

        
    
        /* 表格框線與排版美化 */
        .table-bordered { border: 0 !important; }
        .table-bordered th, .table-bordered td { border: 0 !important; border-bottom: 1px solid #e2e8f0 !important; }
        .table > thead > tr > th { 
            border-bottom: 2px solid #337ab7 !important; 
            background-color: #f8fafc; 
            color: #334155; 
        }
        .table > tbody > tr:last-child > td { border-bottom: 0 !important; }
</style>
</head>
<body style="padding:5px;">
    @if(TempData["Success"] != null) {
        <div class="alert alert-success alert-dismissible" role="alert" id="successAlert">
            <button type="button" class="btn-close shadow-none" data-bs-dismiss="alert" aria-label="Close"></button>
            @TempData["Success"]
        </div>
    }
    @if(TempData["Error"] != null) {
        <div class="alert alert-danger alert-dismissible" role="alert" id="errorAlert">
            <button type="button" class="btn-close shadow-none" data-bs-dismiss="alert" aria-label="Close"></button>
            @TempData["Error"]
        </div>
    }

    <div id="messageDiv"></div>

    <button type="button" onclick="top.close3_1_Edit_d();" class="btn btn-outline-secondary shadow-sm btn-lg"><i class="fa-solid fa-xmark me-1"></i> 關閉</button>

    <h1 class="page-header">@recTpName 經費款項編輯 - @tdName</h1>

    
    <div class="section-header">@bgrcName 經費款項列表</div>

    <div class="table-responsive" style="margin-top: 0px;">
        <table class="table table-sm" id="dataTable">
            <thead>
                <tr>
                    <th style="width: 60px;">項次</th>
                    <th style="width: 250px;">會計科目</th>
                    <th style="width: 120px;">預算金額(元)</th>
                    <th style="width: 60px;">委外</th>
                    <th style="width: 100px;">操作</th>
                </tr>
            </thead>
            <tbody id="dataBody">
                @if(dtList != null && dtList.Rows.Count > 0) {
                    foreach(System.Data.DataRow row in dtList.Rows) {
                        string bgfid = row["BGFID"] != DBNull.Value ? row["BGFID"].ToString() : "";
                        string itCode = row["IT_CODE"] != DBNull.Value ? row["IT_CODE"].ToString() : "";
                        string acItemCode = row["AC_ITEM_CODE"] != DBNull.Value ? row["AC_ITEM_CODE"].ToString() : "";
                        string budgetFee = row["BUDGET_FEE"] != DBNull.Value ? Convert.ToDecimal(row["BUDGET_FEE"]).ToString("0.##") : "";
                        bool outsrcFg = row["OUTSRC_FG"] != DBNull.Value && Convert.ToBoolean(row["OUTSRC_FG"]);

                        <tr data-bgfid="@bgfid">
                            <td style="text-align: center;">@itCode</td>
                            <td>
                                @if(ViewBag.AC_ITEM_CODE != null) {
                                    <select name="AC_ITEM_CODE" class="form-control form-control-sm edit-field" data-field="AC_ITEM_CODE">
                                        <option value="">請選擇</option>
                                        @foreach(SelectListItem item in ViewBag.AC_ITEM_CODE as IEnumerable<SelectListItem>) {
                                            if(item.Value == acItemCode) {
                                                <option value="@item.Value" selected="selected">@item.Text</option>
                                            } else {
                                                <option value="@item.Value">@item.Text</option>
                                            }
                                        }
                                    </select>
                                } else {
                                    <input type="text" name="AC_ITEM_CODE" value="@acItemCode" class="form-control form-control-sm edit-field" data-field="AC_ITEM_CODE" />
                                }
                            </td>
                            <td>
                                <input type="number" name="BUDGET_FEE" value="@budgetFee" class="form-control form-control-sm edit-field" data-field="BUDGET_FEE" step="0.01" style="text-align: right;" />
                            </td>
                            <td style="text-align: center;">
                                @if(outsrcFg) {
                                    <input type="checkbox" name="OUTSRC_FG" class="edit-field" data-field="OUTSRC_FG" checked="checked" />
                                } else {
                                    <input type="checkbox" name="OUTSRC_FG" class="edit-field" data-field="OUTSRC_FG" />
                                }
                            </td>
                            <td style="text-align: center;">
                                <button type="button" class="btn btn-primary btn-sm btn-update" onclick="updateRow(this);"><i class="fa-solid fa-floppy-disk me-1"></i> 儲存</button>
                                <button type="button" class="btn btn-danger btn-sm btn-delete" onclick="deleteRow(this);">刪除</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
            <tfoot>
                <tr class="add-row">
                    <td style="text-align: center; font-weight: bold;">新增</td>
                    <td>
                        @if(ViewBag.AC_ITEM_CODE != null) {
                            <select id="new_AC_ITEM_CODE" class="form-control form-control-sm">
                                <option value="">請選擇</option>
                                @foreach(SelectListItem item in ViewBag.AC_ITEM_CODE as IEnumerable<SelectListItem>) {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            </select>
                        } else {
                            <input type="text" id="new_AC_ITEM_CODE" class="form-control form-control-sm" />
                        }
                    </td>
                    <td>
                        <input type="number" id="new_BUDGET_FEE" class="form-control form-control-sm" step="0.01" style="text-align: right;" />
                    </td>
                    <td style="text-align: center;">
                        <input type="checkbox" id="new_OUTSRC_FG" />
                    </td>
                    <td style="text-align: center;">
                        <button type="button" class="btn btn-success btn-sm" onclick="addRow();">新增</button>
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>

    <!-- 按鈕區 -->
    <table class="table">
        <tr>
            <td>
                <button type="button" onclick="top.close3_1_Edit_d();" class="btn btn-outline-secondary shadow-sm btn-lg"><i class="fa-solid fa-xmark me-1"></i> 關閉</button>
            </td>
        </tr>
    </table>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/ui/1.14.1/jquery-ui.min.js"></script>
    <script>
        var TD_CODE = '@Model.TD_CODE';
    var REC_TP = '@recTp';
     var antiForgeryToken = '@Html.AntiForgeryToken()';

   function showMessage(type, message) {
    var alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
    var html = '<div class="alert ' + alertClass + ' alert-dismissible" role="alert">' +
           '<button type="button" class="btn-close shadow-none" data-bs-dismiss="alert" aria-label="Close"></button>' +
       message + '</div>';
            $('#messageDiv').html(html);
            setTimeout(function() {
       $('#messageDiv').html('');
            }, 3000);
        }

     // 新增資料
    function addRow() {
        
          var acItemCode = $('#new_AC_ITEM_CODE').val();
  var budgetFee = $('#new_BUDGET_FEE').val();
    var outsrcFg = $('#new_OUTSRC_FG').is(':checked');

      if (!acItemCode) {
         showMessage('error', '請選擇會計科目');
       return;
     }

        $.ajax({
 url: '@Url.Action("PAGE3_1_EDIT_D_Add", "TDE0043")',
     type: 'POST',
      data: {
          TD_CODE: TD_CODE,
       REC_TP: REC_TP,
        AC_ITEM_CODE: acItemCode,
  BUDGET_FEE: budgetFee || null,
     OUTSRC_FG: outsrcFg
              },
     success: function(result) {
    if (result.success) {
      showMessage('success', result.message);
       // 重新載入頁面
       location.reload();
     } else {
    showMessage('error', result.message);
              }
        },
    error: function(e) {
        showMessage('error', '新增失敗' + e.message);
                }
  });
        }

        // 更新資料
        function updateRow(btn) {
     var row = $(btn).closest('tr');
            var bgfid = row.data('bgfid');
            var acItemCode = row.find('[data-field="AC_ITEM_CODE"]').val();
            var budgetFee = row.find('[data-field="BUDGET_FEE"]').val();
 var outsrcFg = row.find('[data-field="OUTSRC_FG"]').is(':checked');

     $.ajax({
      url: '@Url.Action("PAGE3_1_EDIT_D_Update", "TDE0043")',
  type: 'POST',
       data: {
      BGFID: bgfid,
AC_ITEM_CODE: acItemCode,
       BUDGET_FEE: budgetFee || null,
   OUTSRC_FG: outsrcFg
              },
 success: function(result) {
        if (result.success) {
    showMessage('success', result.message);
         } else {
 showMessage('error', result.message);
      }
       },
            error: function() {
  showMessage('error', '更新失敗');
           }
            });
        }

        // 刪除資料
        function deleteRow(btn) {
 if (!confirm('確定要刪除此筆資料嗎？')) {
             return;
            }

    var row = $(btn).closest('tr');
     var bgfid = row.data('bgfid');

        $.ajax({
        url: '@Url.Action("PAGE3_1_EDIT_D_Delete", "TDE0043")',
                type: 'POST',
  data: {
        BGFID: bgfid
          },
           success: function(result) {
         if (result.success) {
showMessage('success', result.message);
    row.remove();
         } else {
          showMessage('error', result.message);
}
     },
     error: function() {
         showMessage('error', '刪除失敗');
       }
      });
        }
    </script>
</body>
</html>
