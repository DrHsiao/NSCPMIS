@using PagedList.Mvc
@model WCals.ViewModels.NewModels.TDE0040Model
@{ ViewBag.Title = "雨水箱(管)涵工程";
    Layout = null;

    // 取得資料
    var data = ViewBag.Data as System.Data.DataRow;
    bool isNew = ViewBag.IsNew ?? true;

    // 預設值
    string defaultPSC1 = @"(1) 面積 W×H：___ m × ___ m
(2) 長度：___ m
(3) 雨水井：___ 座
(4) 人孔：___ 座
(5) 工程總經費：___ 元。";

    string defaultPPI1 = @"(1) 主辦機關：___ 縣（市）政府
(2) 代辦機關：___
(3) 補助機關：內政部國土管理署
(4) 設計監造單位：___ 公司
(5) 經費來源：（特別預算名稱）中央 ___ 元、地方 ___ 元
(6) 施工期程：___ 日曆天（工作天），___ 年 ___ 月 ___ 日開工，
    預計 ___ 年 ___ 月 ___ 日完工
(7) 工程位置座標（TWD97）：X：___，Y：___";

    string defaultPIR1 = @"(1) 過去歷次淹水紀錄及時間（含 EMIC 紀錄）
    （淹水時間及面積、深度）
(2) 實際改善成效（完工後）至少記錄 2 次相近降雨規模比較
    （比較過去淹水時間及面積、深度）";

    string defaultPE1 = "保護面積 ___ 公頃，保護人口 ___ 千人";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script type="text/javascript" src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <title>@ViewBag.Title - My ASP.NET Application</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="~/Scripts/modernizr-2.8.3.js"></script>
    <link href="https://code.jquery.com/ui/1.14.1/themes/base/jquery-ui.css" rel="stylesheet" />

    <link rel="stylesheet" href="~/Scripts/plugins/bootstrap-fileinput/icon.mini.css" crossorigin="anonymous">
    <link href="~/Scripts/plugins/bootstrap-fileinput/fileinput.min.css" media="all" rel="stylesheet" type="text/css" />
  <style>
      /* 表格標題欄：右對齊＋垂直置中 */
        .table-form th {
        text-align: right;
            vertical-align: middle !important;
      white-space: nowrap;
            background-color: #f5f7fa;
        }

        /* 讓 textarea 在表格中不要撐爆 */
        .table-form textarea {
            resize: vertical;
 }

        .alert {
     margin: 10px 0;
        }
    
        /* 表格框線與排版美化 */
        .table-bordered { border: 0 !important; }
        .table-bordered th, .table-bordered td { border: 0 !important; border-bottom: 1px solid #e2e8f0 !important; }
        .table > thead > tr > th { 
            border-bottom: 2px solid #337ab7 !important; 
            background-color: #f8fafc; 
            color: #334155; 
        }
        .table > tbody > tr:last-child > td { border-bottom: 0 !important; }

        /* 3.1.4rev：與 PAGE9_1(汙) 統一的狀態列樣式 */
        .status-bar {
            background-color: #337ab7;
            color: white;
            padding: 8px 15px;
            margin-bottom: 10px;
            border-radius: 4px;
        }
        .status-bar .btn-group { float: right; }
</style>
</head>
<body style="padding: 10px;">
    @if(TempData["Success"] != null) {
    <div class="alert alert-success alert-dismissible" role="alert">
            <button type="button" class="btn-close shadow-none" data-bs-dismiss="alert" aria-label="Close"></button>
 @TempData["Success"]
        </div>
    }
  @if(TempData["Error"] != null) {
        <div class="alert alert-danger alert-dismissible" role="alert">
<button type="button" class="btn-close shadow-none" data-bs-dismiss="alert" aria-label="Close"></button>
            @TempData["Error"]
 </div>
  }
    @if(ViewBag.TableError != null) {
        <div class="alert alert-warning" role="alert">
            @ViewBag.TableError
        </div>
    }

    @using(Html.BeginForm("PAGE8_1_Save", "TDE0048", FormMethod.Post, new { role = "form", id = "mainForm", enctype = "multipart/form-data" })) {

        @Html.AntiForgeryToken()
        <input type="hidden" name="TD_CODE" value="@ViewBag.TD_CODE" />
        <input type="hidden" name="IsNew" value="@isNew.ToString().ToLower()" />

        @* 3.1.4rev：業主指示移除「編輯模式/新增模式」標記；並與工程填報(汙) PAGE9_1 統一配置
           （頂部狀態列＝工程編號＋儲存＋關閉，表格下方再放一組相同按鈕） *@
        <div class="status-bar">
            <span><i class="fa-solid fa-hashtag me-1"></i> 工程編號：@ViewBag.TD_CODE</span>
            <div class="btn-group">
                <button type="submit" class="btn btn-primary btn-sm">
                    <i class="fa-solid fa-floppy-disk me-1"></i> 儲存
                </button>
                <button type="button" class="btn btn-secondary btn-sm" onclick="top.close8();">
                    <i class="fa-solid fa-xmark me-1"></i> 關閉
                </button>
            </div>
        </div>

      <div class="table-responsive">
  <table class="table table-sm table-form">
         <colgroup>
          <col style="width:25%">
    <col style="width:75%">
                </colgroup>
    <tbody>

        <tr>
  <th>
      計畫緣起<br>
    <small>（說明淹水情形、原因或需改善理由）</small>
      </th>
          <td>
        <textarea class="form-control" name="P_O_1" rows="4">@(data != null && data["P_O_1"] != DBNull.Value ? data["P_O_1"].ToString() : "")</textarea>
           </td>
            </tr>

     <tr>
       <th>計畫範圍及內容</th>
            <td>
     <textarea class="form-control" name="P_S_C_1" rows="6">@(data != null && data["P_S_C_1"] != DBNull.Value ? data["P_S_C_1"].ToString() : defaultPSC1)</textarea>
          </td>
          </tr>

         <tr>
       <th>
          預期效益<br>
               <small>（面積、人口或環境改善效益）</small>
               </th>
             <td>
  <input type="text" class="form-control" name="P_E_1"
      value="@(data != null && data["P_E_1"] != DBNull.Value ? data["P_E_1"].ToString() : defaultPE1)">
       </td>
     </tr>

  <tr>
            <th>工程基本資訊</th>
              <td>
            <textarea class="form-control" name="P_P_I_1" rows="8">@(data != null && data["P_P_I_1"] != DBNull.Value ? data["P_P_I_1"].ToString() : defaultPPI1)</textarea>
         </td>
      </tr>

  <tr>
             <th>實際改善成效</th>
       <td>
          <textarea class="form-control" name="P_I_R_1" rows="6">@(data != null && data["P_I_R_1"] != DBNull.Value ? data["P_I_R_1"].ToString() : defaultPIR1)</textarea>
                </td>
         </tr>

       </tbody>
    </table>
        </div>

        <div class="row" style="margin-top: 10px;">
            <div class="col-md-12">
                <button type="submit" class="btn btn-primary btn-sm">
                    <i class="fa-solid fa-floppy-disk me-1"></i> 儲存
                </button>
                <button type="button" class="btn btn-secondary btn-sm" onclick="top.close8();">
                    <i class="fa-solid fa-xmark me-1"></i> 關閉
                </button>
            </div>
   </div>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/ui/1.14.1/jquery-ui.min.js"></script>

</body>
</html>